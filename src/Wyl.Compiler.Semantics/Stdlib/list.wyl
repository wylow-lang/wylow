// A growable array on the heap. Adding or removing elements may move the others, so while a
// reference, span, or loop into the list exists, the list is borrowed, and changing its length
// panics. Clearing or releasing the list releases its elements last to first. See
// docs/spec/03-memory-model.md.

pub final class List<T> implements Borrowable, Spannable<T> {
    pub int count() {
        return size;
    }

    pub int capacity() {
        return space;
    }

    // A copy of the first element, or null when the list is empty.
    pub T? first() {
        return size == 0 ? null : this[0];
    }

    // A copy of the last element, or null when the list is empty.
    pub T? last() {
        return size == 0 ? null : this[size - 1];
    }

    @CallerLocation
    pub ref T operator [](int index) {
        panic::checkIndex(index, size);
        unsafe {
            return ref data[index];
        }
    }

    // Like the indexer, but null instead of a panic when `index` is out of bounds.
    pub ref? T get(int index) {
        if (index < 0 || index >= size) {
            return null;
        }
        unsafe {
            return ref data[index];
        }
    }

    @CallerLocation
    pub void add(T value) {
        checkNotBorrowed();
        if (size == space) {
            grow(size + 1);
        }
        unsafe {
            memory::initialize(data + size, value);
        }
        size++;
    }

    @CallerLocation
    pub void insert(int index, T value) {
        checkNotBorrowed();
        panic::checkIndex(index, size + 1);
        if (size == space) {
            grow(size + 1);
        }
        unsafe {
            memory::moveTo(data + index, data + index + 1, size - index);
            memory::initialize(data + index, value);
        }
        size++;
    }

    @CallerLocation
    pub T removeAt(int index) {
        checkNotBorrowed();
        panic::checkIndex(index, size);
        unsafe {
            // A copy keeps the element alive, so no destructor runs while the list is rearranged.
            T removed = data[index];
            memory::drop(data + index);
            memory::moveTo(data + index + 1, data + index, size - index - 1);
            size--;
            return removed;
        }
    }

    // Like `removeAt`, but null instead of a panic when `index` is out of bounds.
    @CallerLocation
    pub T? tryRemoveAt(int index) {
        if (index < 0 || index >= size) {
            return null;
        }
        return removeAt(index);
    }

    // Removes and returns the last element, or null when the list is empty: a stack's pop.
    @CallerLocation
    pub T? removeLast() {
        if (size == 0) {
            return null;
        }
        return removeAt(size - 1);
    }

    @CallerLocation
    pub void clear() {
        checkNotBorrowed();
        int old = size;
        size = 0;
        // Dropping an element may run a destructor, which must not change the list meanwhile.
        borrows++;
        unsafe {
            mut int i = old;
            while (i > 0) {
                i--;
                memory::drop(data + i);
            }
        }
        borrows--;
    }

    // Makes room for at least `minimum` elements, so adding up to that many never moves them.
    @CallerLocation
    pub void reserve(int minimum) {
        checkNotBorrowed();
        if (minimum > space) {
            grow(minimum);
        }
    }

    // Shrinks the capacity to exactly the count, always, unlike C++'s shrink_to_fit. An empty
    // list frees its storage entirely.
    @CallerLocation
    pub void trim() {
        checkNotBorrowed();
        if (size < space) {
            reallocate(size);
        }
    }

    pub void beginBorrow() {
        borrows++;
    }

    pub void endBorrow() {
        borrows--;
    }

    pub Span<T> asSpan() {
        unsafe {
            return Span<T>(data, size);
        }
    }

    pub ReadOnlySpan<T> asReadOnlySpan() {
        unsafe {
            return ReadOnlySpan<T>(data, size);
        }
    }

    mut T* data;
    mut int size;
    mut int space;
    mut int borrows;

    @CallerLocation
    void checkNotBorrowed() {
        if (borrows > 0) {
            panic("cannot change the length or capacity of a list while it is borrowed by a reference, span, or loop");
        }
    }

    @CallerLocation
    void grow(int minimum) {
        mut int grown = space < 4 ? 4 : space * 2;
        if (grown < minimum) {
            grown = minimum;
        }
        reallocate(grown);
    }

    @CallerLocation
    void reallocate(int length) {
        unsafe {
            mut T* moved = null;
            if (length > 0) {
                moved = memory::allocate<T>(length);
                memory::moveTo(data, moved, size);
            }
            memory::free(data);
            data = moved;
        }
        space = length;
    }

    ~List() {
        unsafe {
            mut int i = size;
            while (i > 0) {
                i--;
                memory::drop(data + i);
            }
            memory::free(data);
        }
    }
}
