/// The result of an operation that can fail: a value, or an error (spec `errors.result`).
pub enum Result<T, E> {
    /// The operation's value.
    Ok(T value),
    /// Why the operation failed.
    Err(E error);

    /// Returns the value, or `fallback` if this is an error.
    pub T orElse(T fallback) {
        return switch (this) {
            case Ok(var value) -> value;
            case Err -> fallback;
        };
    }

    /// Returns the value that `f` makes of this value, or the same error.
    pub Result<U, E> map<U>(fn(T) -> U f) {
        return switch (this) {
            case Ok(var value) -> Result.Ok(f(value));
            case Err(var error) -> Result.Err(error);
        };
    }

    /// Returns the same value, or the error that `f` makes of this error.
    pub Result<T, F> mapErr<F>(fn(E) -> F f) {
        return switch (this) {
            case Ok(var value) -> Result.Ok(value);
            case Err(var error) -> Result.Err(f(error));
        };
    }

    /// Returns the value.
    ///
    /// # Panics
    ///
    /// With `message`, if this is an error.
    @CallerLocation
    pub T orPanic(String message) {
        return switch (this) {
            case Ok(var value) -> value;
            case Err -> panic(message);
        };
    }
}

/// The value of a `Result` whose success has nothing to return.
pub struct Unit { }
