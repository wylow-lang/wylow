/// A class that is told when references, spans, and loops into it start and end (spec
/// `memory.borrows.borrowable`).
///
/// Only classes can implement it, and only the compiler calls its methods.
pub interface Borrowable {
    /// Called when a reference, span, or loop into the object starts.
    void beginBorrow();

    /// Called when a reference, span, or loop into the object ends.
    void endBorrow();
}
