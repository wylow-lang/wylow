import std::iteration::RefIterator;

/// A growable array on the heap.
///
/// Adding or removing elements may move the others, so while a reference, span, or loop into the
/// list exists, the list is borrowed, and changing its length or capacity panics (spec
/// `memory.borrows`). Clearing or releasing the list releases its elements last to first.
pub final class List<T> implements Borrowable, Spannable<T> {
    mut T* data;
    mut int size;
    mut int space;
    mut int borrows;

    /// Returns the number of elements.
    pub int count() {
        return size;
    }

    /// Returns how many elements the list can hold before adding one moves them.
    pub int capacity() {
        return space;
    }

    /// Returns a reference to the first element, or null if the list is empty.
    pub ref? T first() {
        if (size == 0) {
            return null;
        }
        unsafe {
            return ref data[0];
        }
    }

    /// Returns a reference to the last element, or null if the list is empty.
    pub ref? T last() {
        if (size == 0) {
            return null;
        }
        unsafe {
            return ref data[size - 1];
        }
    }

    /// Returns a reference to the element at `index`.
    ///
    /// # Panics
    ///
    /// If `index` is out of bounds.
    @CallerLocation
    pub ref T operator [](int index) {
        panic::checkIndex(index, size);
        unsafe {
            return ref data[index];
        }
    }

    /// Returns a reference to the element at `index`, or null if `index` is out of bounds.
    pub ref? T get(int index) {
        if (index < 0 || index >= size) {
            return null;
        }
        unsafe {
            return ref data[index];
        }
    }

    /// Adds `value` after the last element.
    ///
    /// # Panics
    ///
    /// If the list is borrowed, or one more element would be too large to address.
    @CallerLocation
    pub void add(T value) {
        checkNotBorrowed();
        if (size == space) {
            grow(size + 1);
        }
        unsafe {
            memory::initialize(data + size, value);
        }
        size++;
    }

    /// Inserts `value` at `index`, moving the later elements up by one.
    ///
    /// # Panics
    ///
    /// If `index` is negative or greater than the count, if the list is borrowed, or if one more
    /// element would be too large to address.
    @CallerLocation
    pub void insert(int index, T value) {
        checkNotBorrowed();
        panic::checkIndex(index, size + 1);
        if (size == space) {
            grow(size + 1);
        }
        unsafe {
            memory::moveTo(data + index, data + index + 1, size - index);
            memory::initialize(data + index, value);
        }
        size++;
    }

    /// Removes and returns the element at `index`, moving the later elements down by one.
    ///
    /// # Panics
    ///
    /// If `index` is out of bounds, or the list is borrowed.
    @CallerLocation
    pub T removeAt(int index) {
        checkNotBorrowed();
        panic::checkIndex(index, size);
        unsafe {
            // Moving the element out keeps it alive, so no destructor runs while the list is rearranged.
            T removed = memory::moveOut(data + index);
            memory::moveTo(data + index + 1, data + index, size - index - 1);
            size--;
            return removed;
        }
    }

    /// Removes and returns the element at `index`, or returns null if `index` is out of bounds.
    ///
    /// # Panics
    ///
    /// If `index` is in bounds and the list is borrowed.
    @CallerLocation
    pub T? tryRemoveAt(int index) {
        if (index < 0 || index >= size) {
            return null;
        }
        return removeAt(index);
    }

    /// Removes and returns the last element, or returns null if the list is empty.
    ///
    /// # Panics
    ///
    /// If the list isn't empty and is borrowed.
    @CallerLocation
    pub T? removeLast() {
        if (size == 0) {
            return null;
        }
        return removeAt(size - 1);
    }

    /// Removes every element, releasing them last to first. The capacity stays.
    ///
    /// # Panics
    ///
    /// If the list is borrowed.
    @CallerLocation
    pub void clear() {
        checkNotBorrowed();
        int old = size;
        size = 0;
        // Dropping an element may run a destructor, which must not change the list meanwhile.
        borrows++;
        unsafe {
            mut int i = old;
            while (i > 0) {
                i--;
                memory::drop(data + i);
            }
        }
        borrows--;
    }

    /// Makes room for at least `minimum` elements, so that adding up to that many never moves them.
    ///
    /// # Panics
    ///
    /// If the list is borrowed, or `minimum` elements are too large to address.
    @CallerLocation
    pub void reserve(int minimum) {
        checkNotBorrowed();
        if (minimum > space) {
            grow(minimum);
        }
    }

    /// Shrinks the capacity to the count. An empty list frees its storage.
    ///
    /// # Panics
    ///
    /// If the list is borrowed.
    @CallerLocation
    pub void trim() {
        checkNotBorrowed();
        if (size < space) {
            reallocate(size);
        }
    }

    /// Counts a borrow that starts. The compiler calls it; a program can't.
    pub void beginBorrow() {
        borrows++;
    }

    /// Counts a borrow that ends. The compiler calls it; a program can't.
    pub void endBorrow() {
        borrows--;
    }

    /// Returns a frozen list that takes this list's elements without copying them, and leaves this
    /// list with no elements and no capacity.
    ///
    /// # Panics
    ///
    /// If the list is borrowed.
    @CallerLocation
    pub threading::Frozen<T> freeze() where T extends sendable & copyable {
        checkNotBorrowed();
        unsafe {
            var frozen = new threading::Frozen<T>(threading::FrozenStorage<T>(data, size));
            data = null;
            size = 0;
            space = 0;
            return frozen;
        }
    }

    /// Returns an isolated box that holds a new list of this list's elements, and leaves this list
    /// with no elements and no capacity. Another thread may receive the box. It copies no element.
    ///
    /// # Panics
    ///
    /// If the list is borrowed.
    @CallerLocation
    pub threading::Isolated<List<T>> isolate() where T extends sendable {
        checkNotBorrowed();
        T* moved = data;
        int count = size;
        int room = space;
        data = null;
        size = 0;
        space = 0;
        // The new list is made while the box's cycle buffer is the thread's, and the elements are
        // sendable, so nothing of this thread's refers into the box.
        return threading::Isolated<List<T>>(() -> {
            var list = new List<T>();
            list.data = moved;
            list.size = count;
            list.space = room;
            return list;
        }, Unit());
    }

    /// Returns an iterator over references to the elements, first to last.
    ///
    /// The iterator borrows the list until the iterator is released, so changing the length or
    /// capacity of the list while the iterator exists panics.
    pub ListIterator<T> iterator() {
        return ListIterator<T>(this);
    }

    /// Returns a span of the elements.
    pub Span<T> asSpan() {
        unsafe {
            return Span<T>(data, size);
        }
    }

    /// Returns a read-only span of the elements.
    pub ReadOnlySpan<T> asReadOnlySpan() {
        unsafe {
            return ReadOnlySpan<T>(data, size);
        }
    }

    @CallerLocation
    void checkNotBorrowed() {
        if (borrows > 0) {
            panic("cannot change the length or capacity of a list while it is borrowed by a reference, span, or loop");
        }
    }

    @CallerLocation
    void grow(int minimum) {
        mut int grown = space < 4 ? 4 : space * 2;
        if (grown < minimum) {
            grown = minimum;
        }
        reallocate(grown);
    }

    @CallerLocation
    void reallocate(int length) {
        unsafe {
            mut T* moved = null;
            if (length > 0) {
                moved = memory::allocate<T>(length);
                memory::moveTo(data, moved, size);
            }
            memory::free(data);
            data = moved;
        }
        space = length;
    }

    ~List() {
        unsafe {
            mut int i = size;
            while (i > 0) {
                i--;
                memory::drop(data + i);
            }
            memory::free(data);
        }
    }
}

/// An iterator over references to the elements of a `List`, first to last, which
/// `List.iterator()` returns.
///
/// The iterator borrows the list until the iterator is released, so changing the length or capacity
/// of the list while the iterator exists panics.
pub unique struct ListIterator<T> implements RefIterator<T> {
    List<T> list;
    Borrow borrow;
    int position;

    package ListIterator(List<T> list) {
        this.list = list;
        borrow = Borrow(list);
        position = -1;
    }

    /// Returns `true` after advancing to the next element, or `false` once the iterator has passed
    /// the last element of the list.
    pub mut bool moveNext() {
        if (position < list.count()) {
            position++;
        }
        return position < list.count();
    }

    /// Returns a reference to the element that the last call of `moveNext` advanced to.
    ///
    /// # Panics
    ///
    /// If `moveNext` has not been called yet, or its last call returned `false`.
    pub mut ref T current() {
        if (position < 0 || position >= list.count()) {
            panic("cannot read the current element of an iterator before 'moveNext' or after the last element");
        }
        return ref list[position];
    }
}
