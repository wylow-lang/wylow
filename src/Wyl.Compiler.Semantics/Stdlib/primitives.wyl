// The members and interfaces of the primitive types (spec `types.primitives.methods`). Each
// declaration only gives its type members: `int` still names the built-in type. The runtime
// implements the extern methods, and the others are written here.

@Include("wyl.h")
@CppNamespace("wyl")
extern {
    /// The members of `bool`.
    pub struct bool implements Hashable<bool>, Printable {
        /// Returns `"true"` or `"false"`.
        @Safe
        @Pure
        pub String toString();

        /// Returns whether this value equals `other`.
        pub bool equals(in bool other) {
            return this == other;
        }

        /// Adds this value to `hasher`.
        pub void hash(ref Hasher hasher) {
            hasher.add(this ? 1L : 0L);
        }
    }

    /// The members of `char`.
    pub struct char implements Comparable<char>, Hashable<char>, Printable {
        /// Returns -1, 0, or 1 as this value is less than, equal to, or greater than `other`, by code
        /// point.
        @Safe
        @Pure
        pub int compareTo(in char other);

        /// Returns the value as text, as interpolation writes it.
        @Safe
        @Pure
        pub String toString();

        /// Returns whether this value equals `other`.
        pub bool equals(in char other) {
            return this == other;
        }

        /// Adds this value to `hasher`.
        pub void hash(ref Hasher hasher) {
            hasher.add((long)this);
        }
    }

    /// The members of `sbyte`.
    pub struct sbyte implements Comparable<sbyte>, Hashable<sbyte>, Printable {
        /// Returns -1, 0, or 1 as this value is less than, equal to, or greater than `other`.
        @Safe
        @Pure
        pub int compareTo(in sbyte other);

