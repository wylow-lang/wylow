// The members and interfaces of the primitive types (spec `types.primitives.methods`). Each
// declaration only gives its type members: `int` still names the built-in type. The runtime
// implements the extern methods, and the others are written here.

/// The members of `bool`.
pub extern struct bool implements Hashable<bool>, Printable {
    /// Returns `"true"` or `"false"`.
    @Pure
    pub extern String toString();

    /// Returns whether this value equals `other`.
    pub bool equals(in bool other) {
        return this == other;
    }

    /// Adds this value to `hasher`.
    pub void hash(ref Hasher hasher) {
        hasher.add(this ? 1L : 0L);
    }
}

/// The members of `char`.
pub extern struct char implements Comparable<char>, Hashable<char>, Printable {
    /// Returns -1, 0, or 1 as this value is less than, equal to, or greater than `other`, by code
    /// point.
    @Pure
    pub extern int compareTo(in char other);

    /// Returns the value as text, as interpolation writes it.
    @Pure
    pub extern String toString();

    /// Returns whether this value equals `other`.
    pub bool equals(in char other) {
        return this == other;
    }

    /// Adds this value to `hasher`.
    pub void hash(ref Hasher hasher) {
        hasher.add((long)this);
    }
}

/// The members of `sbyte`.
pub extern struct sbyte implements Comparable<sbyte>, Hashable<sbyte>, Printable {
    /// Returns -1, 0, or 1 as this value is less than, equal to, or greater than `other`.
    @Pure
    pub extern int compareTo(in sbyte other);

    /// Returns the value as text, as interpolation writes it.
    @Pure
    pub extern String toString();

    /// Returns the sum of this value and `other`, modulo 2^n for the width `n` of `sbyte`.
    @Pure
    pub extern sbyte wrappingAdd(sbyte other);

    /// Returns this value minus `other`, modulo 2^n for the width `n` of `sbyte`.
    @Pure
    pub extern sbyte wrappingSub(sbyte other);

    /// Returns the product of this value and `other`, modulo 2^n for the width `n` of `sbyte`.
    @Pure
    pub extern sbyte wrappingMul(sbyte other);

    /// Returns the sum of this value and `other`, or `null` if the sum is not a value of `sbyte`.
    @Pure
    pub extern sbyte? checkedAdd(sbyte other);

    /// Returns this value minus `other`, or `null` if the difference is not a value of `sbyte`.
    @Pure
    pub extern sbyte? checkedSub(sbyte other);

    /// Returns the product of this value and `other`, or `null` if the product is not a value of
    /// `sbyte`.
    @Pure
    pub extern sbyte? checkedMul(sbyte other);

    /// Returns whether this value equals `other`.
    pub bool equals(in sbyte other) {
        return this == other;
    }

    /// Adds this value to `hasher`.
    pub void hash(ref Hasher hasher) {
        hasher.add((long)this);
    }
}

