// The members and interfaces of the primitive types (spec `types.primitives.methods`). Each
// declaration only gives its type members: `int` still names the built-in type, and the runtime
// implements the methods.

/// The members of `bool`.
pub extern struct bool implements Printable {
    /// Returns `"true"` or `"false"`.
    @Pure
    pub extern String toString();
}

/// The members of `char`.
pub extern struct char implements Comparable<char>, Printable {
    /// Returns -1, 0, or 1 as this value is less than, equal to, or greater than `other`, by code
    /// point.
    @Pure
    pub extern int compareTo(in char other);

    /// Returns the value as text, as interpolation writes it.
    @Pure
    pub extern String toString();
}

