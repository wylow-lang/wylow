    /// The members of `float`.
    pub struct float implements Comparable<float>, Hashable<float>, Printable {
        /// Returns -1, 0, or 1 as this value is less than, equal to, or greater than `other`, in a
        /// total order: -0 sorts before 0, and NaN after every other value, infinity included, and the
        /// same as any other NaN.
        @Safe
        @Pure
        pub int compareTo(in float other);

        /// Returns the value as text, as interpolation writes it.
        @Safe
        @Pure
        pub String toString();

        /// Returns whether this value equals `other` in the order of `compareTo`: every NaN equals
        /// every other NaN, and `-0` does not equal `0`, unlike `==`.
        pub bool equals(in float other) {
            return compareTo(other) == 0;
        }

        /// Adds this value's bits to `hasher`, with every NaN as one NaN, so that values that `equals`
        /// finds equal hash alike.
        pub void hash(ref Hasher hasher) {
            if (this != this) {
                hasher.add(0x7FC0_0000);
            } else {
                hasher.add(toBits());
            }
        }

        // The IEEE 754 bits of the value.
        @Safe
        @Pure
        package int toBits();
    }

    /// The members of `double`.
    pub struct double implements Comparable<double>, Hashable<double>, Printable {
        /// Returns -1, 0, or 1 as this value is less than, equal to, or greater than `other`, in the
        /// same total order as `float`'s.
        @Safe
        @Pure
        pub int compareTo(in double other);

        /// Returns the value as text, as interpolation writes it.
        @Safe
        @Pure
        pub String toString();

        /// Returns whether this value equals `other` in the order of `compareTo`: every NaN equals
        /// every other NaN, and `-0` does not equal `0`, unlike `==`.
        pub bool equals(in double other) {
            return compareTo(other) == 0;
        }

        /// Adds this value's bits to `hasher`, with every NaN as one NaN, so that values that `equals`
        /// finds equal hash alike.
        pub void hash(ref Hasher hasher) {
            if (this != this) {
                hasher.add(0x7FF8_0000_0000_0000L);
            } else {
                hasher.add(toBits());
            }
        }

        // The IEEE 754 bits of the value.
        @Safe
        @Pure
        package long toBits();
    }
}
