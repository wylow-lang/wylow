// A fixed-length array on the heap, written `T[]` and created with `new T[length]`. It never
// moves its elements, so a reference into it only keeps it alive and needs no borrow. Releasing it
// releases its elements last to first.

pub final class Array<T> implements Spannable<T> {
    pub int length;
    T* data;

    // Each element starts as `T`'s default value; the compiler checks that it has one.
    @CallerLocation
    pub Array(int length) {
        unsafe {
            data = memory::allocate<T>(length);
            memory::initializeDefault(data, length);
        }
        this.length = length;
    }

    @CallerLocation
    pub Array(int length, T value) {
        unsafe {
            data = memory::allocate<T>(length);
            for (int i : 0..length) {
                memory::initialize(data + i, value);
            }
        }
        this.length = length;
    }

    @CallerLocation
    pub ref T operator [](int index) {
        panic::checkIndex(index, length);
        unsafe {
            return ref data[index];
        }
    }

    // Like the indexer, but null instead of a panic when `index` is out of bounds.
    pub ref? T get(int index) {
        if (index < 0 || index >= length) {
            return null;
        }
        unsafe {
            return ref data[index];
        }
    }

    pub Span<T> asSpan() {
        unsafe {
            return Span<T>(data, length);
        }
    }

    pub ReadOnlySpan<T> asReadOnlySpan() {
        unsafe {
            return ReadOnlySpan<T>(data, length);
        }
    }

    ~Array() {
        unsafe {
            mut int i = length;
            while (i > 0) {
                i--;
                memory::drop(data + i);
            }
            memory::free(data);
        }
    }
}
