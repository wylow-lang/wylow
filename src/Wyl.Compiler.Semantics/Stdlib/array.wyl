import std::iteration::Iterator;

/// A fixed-length array on the heap, written `T[]` and created with `new T[length]`.
///
/// It never moves its elements, so a reference into it only keeps it alive and needs no borrow.
/// Releasing it releases its elements last to first.
pub final class Array<T> implements Spannable<T> {
    /// The number of elements.
    pub int length;
    T* data;

    /// Makes an array of `length` elements, each `T`'s default value. The compiler checks that `T`
    /// has one.
    ///
    /// # Panics
    ///
    /// If `length` is negative, or `length` elements are too large to address.
    @CallerLocation
    pub Array(int length) {
        unsafe {
            data = memory::allocate<T>(length);
            memory::initializeDefault(data, length);
        }
        this.length = length;
    }

    /// Makes an array of `length` copies of `value`.
    ///
    /// # Panics
    ///
    /// If `length` is negative, or `length` elements are too large to address.
    @CallerLocation
    pub Array(int length, T value) where T extends copyable {
        unsafe {
            var storage = memory::allocate<T>(length);
            for (int i : 0..length) {
                memory::initialize(storage + i, value);
            }
            this.data = storage;
        }
        this.length = length;
    }

    /// Makes an array of `length` elements whose storage is `data`.
    ///
    /// # Safety
    ///
    /// `data` must be uninitialized storage from `memory::allocate`, for `length` elements.
    package unsafe Array(int length, T* data) {
        this.data = data;
        this.length = length;
    }

    /// Returns a reference to the element at `index`.
    ///
    /// # Panics
    ///
    /// If `index` is out of bounds.
    @CallerLocation
    pub ref T operator [](int index) {
        panic::checkIndex(index, length);
        unsafe {
            return ref data[index];
        }
    }

    /// Returns a reference to the element at `index`, or null if `index` is out of bounds.
    pub ref? T get(int index) {
        if (index < 0 || index >= length) {
            return null;
        }
        unsafe {
            return ref data[index];
        }
    }

    /// Returns an iterator over copies of the elements, first to last.
    ///
    /// The length of an array never changes, so the iterator does not borrow the array.
    pub ArrayIterator<T> iterator() where T extends copyable {
        return ArrayIterator<T>(this);
    }

    /// Returns a span of the elements.
    pub Span<T> asSpan() {
        unsafe {
            return Span<T>(data, length);
        }
    }

    /// Returns a read-only span of the elements.
    pub ReadOnlySpan<T> asReadOnlySpan() {
        unsafe {
            return ReadOnlySpan<T>(data, length);
        }
    }

    ~Array() {
        unsafe {
            mut int i = length;
            while (i > 0) {
                i--;
                memory::drop(data + i);
            }
            memory::free(data);
        }
    }
}

/// An iterator over copies of the elements of an `Array`, first to last, which `Array.iterator()`
/// returns.
///
/// The iterator holds the array, and reads each element when `current` is called, so it sees a
/// change to an element that it has not reached yet.
pub struct ArrayIterator<T extends copyable> implements Iterator<T> {
    Array<T> array;
    int position;

    package ArrayIterator(Array<T> array) {
        this.array = array;
        position = -1;
    }

    /// Returns `true` after advancing to the next element, or `false` once the iterator has passed
    /// the last element of the array.
    pub mut bool moveNext() {
        if (position < array.length) {
            position++;
        }
        return position < array.length;
    }

    /// Returns a copy of the element that the last call of `moveNext` advanced to.
    ///
    /// # Panics
    ///
    /// If `moveNext` has not been called yet, or its last call returned `false`.
    pub T current() {
        if (position < 0 || position >= array.length) {
            panic("cannot read the current element of an iterator before 'moveNext' or after the last element");
        }
        return array[position];
    }
}
