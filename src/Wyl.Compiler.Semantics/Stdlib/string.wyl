/// Immutable UTF-8 text, the built-in type of string literals.
///
/// This declaration gives `String` its members and interfaces; `String` itself is a built-in type,
/// not a struct (spec `types.string`). Offsets and lengths count bytes of UTF-8, which is what a
/// string stores; a character (`char`) takes 1 to 4 of them. A null byte follows the bytes, so
/// `cstr` passes them to C++ without a copy.
pub extern struct String implements Comparable<String>, Hashable<String>, Printable {
    /// Returns the length in bytes, not in characters.
    @Pure
    pub extern int byteLength();

    /// Returns a pointer to the string's UTF-8 bytes, which a null byte follows, without a copy.
    ///
    /// # Safety
    ///
    /// The pointer is valid while the string is alive. Nothing may be written through it.
    @Pure
    pub unsafe extern byte* cstr();

    /// Returns a copy of the null-terminated UTF-8 text at `p`, without the null byte.
    ///
    /// # Panics
    ///
    /// If the bytes are not valid UTF-8. The message names the offset of the first byte that does
    /// not belong to a valid character.
    ///
    /// # Safety
    ///
    /// `p` must point to bytes that a null byte ends, and the bytes must not change during the call.
    @CallerLocation
    pub unsafe static String fromCString(byte* p) {
        mut int length = 0;
        while (p[length] != 0) {
            length += 1;
        }
        ReadOnlySpan<byte> text = ReadOnlySpan<byte>(p, length);
        if (invalidOffset(text) is int offset) {
            panic::panic($"invalid UTF-8 at byte offset {offset}");
        }
        return copyOf(text);
    }

    /// Returns a new string that holds a copy of `bytes`.
    ///
    /// # Safety
    ///
    /// `bytes` must be valid UTF-8.
    package unsafe static extern String copyOf(ReadOnlySpan<byte> bytes);

    /// Returns whether the string has no bytes.
    pub bool isEmpty() {
        return byteLength() == 0;
    }

    /// Returns the UTF-8 bytes, without a copy. The string is held while the span is used.
    pub ReadOnlySpan<byte> bytes() {
        unsafe {
            return ReadOnlySpan<byte>(cstr(), byteLength());
        }
    }

    /// Returns the number of characters (code points).
    pub int charCount() {
        mut int count = 0;
        for (byte b : bytes()) {
            if (!isContinuation(b)) {
                count += 1;
            }
        }
        return count;
    }

    /// Returns whether the string starts with the bytes of `prefix`.
    pub bool startsWith(String prefix) {
        int length = prefix.byteLength();
        return length <= byteLength() && memory::equal(bytes().slice(0, length), prefix.bytes());
    }

    /// Returns whether the string ends with the bytes of `suffix`.
    pub bool endsWith(String suffix) {
        int length = suffix.byteLength();
        return length <= byteLength() && memory::equal(bytes().slice(byteLength() - length, length), suffix.bytes());
    }

    /// Returns whether the bytes of `text` occur in the string.
    pub bool contains(String text) {
        return indexOf(text) != null;
    }

    /// Returns the byte offset where `text` first occurs, or null if it doesn't. An empty `text`
    /// occurs at offset 0.
    pub int? indexOf(String text) {
        ReadOnlySpan<byte> all = bytes();
        ReadOnlySpan<byte> wanted = text.bytes();
        int length = wanted.length();
        for (int start : 0..=all.length() - length) {
            if (memory::equal(all.slice(start, length), wanted)) {
                return start;
            }
        }
        return null;
    }

    /// Returns the `length` bytes from `start`, as a string.
    ///
    /// # Panics
    ///
    /// If any of those bytes is out of bounds, or the range would split a character.
    @CallerLocation
    pub String slice(int start, int length) {
        int size = byteLength();
        if (start < 0 || length < 0 || start > size - length) {
            panic::panic($"byte range of {length} from {start} is out of bounds for length {size}");
        }
        if (!isBoundary(start)) {
            panic::panic($"byte offset {start} is inside a character");
        }
        if (!isBoundary(start + length)) {
            panic::panic($"byte offset {start + length} is inside a character");
        }
        if (length == size) {
            return this;
        }
        unsafe {
            return copyOf(bytes().slice(start, length));
        }
    }

    /// Returns -1, 0, or 1 as this string sorts before, the same as, or after `other`: by byte,
    /// which for UTF-8 is the order of the code points.
    pub int compareTo(in String other) {
        return memory::compare(bytes(), other.bytes());
    }

    /// Returns the string itself.
    @Pure
    pub extern String toString();

    /// Returns whether this string has the same bytes as `other`.
    pub bool equals(in String other) {
        return this == other;
    }

    /// Adds the bytes of this string to `hasher`.
    pub void hash(ref Hasher hasher) {
        hasher.addBytes(bytes());
    }

    // The character that starts at `offset`, which must be where one starts. A for-each over a
    // string calls it with each such offset, so it reads the bytes without a bounds check.
    char charAt(int offset) {
        unsafe {
            byte* text = cstr();
            int lead = text[offset];
            if (lead < 0x80) {
                return (char)lead;
            }
            // A lead byte of 2, 3, or 4 bytes keeps its low 5, 4, or 3 bits, and each byte after it
            // adds 6 bits.
            int count = lead < 0xE0 ? 1 : lead < 0xF0 ? 2 : 3;
            mut int code = lead & (0x3F >> count);
            for (int k : 1..=count) {
                int next = text[offset + k];
                code = (code << 6) | (next & 0x3F);
            }
            return (char)code;
        }
    }

    // The offset after the character that starts at `offset`, which must be where one starts.
    int nextChar(int offset) {
        unsafe {
            int lead = cstr()[offset];
            return offset + (lead < 0x80 ? 1 : lead < 0xE0 ? 2 : lead < 0xF0 ? 3 : 4);
        }
    }

    // Whether a character starts at `offset`, or `offset` is the end.
    bool isBoundary(int offset) {
        return offset == byteLength() || !isContinuation(bytes()[offset]);
    }

    // Whether `b` is a byte after the first of a character's encoding.
    static bool isContinuation(byte b) {
        return (b & 0xC0) == 0x80;
    }

    // The offset where the first invalid UTF-8 sequence in `text` starts, or null if there is none.
    // The range that each lead byte allows for the next byte rules out overlong encodings,
    // surrogates, and code points above U+10FFFF.
    static int? invalidOffset(ReadOnlySpan<byte> text) {
        mut int i = 0;
        while (i < text.length()) {
            int lead = text[i];
            mut int count = 0;
            mut int low = 0x80;
            mut int high = 0xBF;
            if (lead < 0x80) {
                count = 0;
            } else if (lead >= 0xC2 && lead <= 0xDF) {
                count = 1;
            } else if (lead == 0xE0) {
                count = 2;
                low = 0xA0;
            } else if (lead == 0xED) {
                count = 2;
                high = 0x9F;
            } else if (lead >= 0xE1 && lead <= 0xEF) {
                count = 2;
            } else if (lead == 0xF0) {
                count = 3;
                low = 0x90;
            } else if (lead >= 0xF1 && lead <= 0xF3) {
                count = 3;
            } else if (lead == 0xF4) {
                count = 3;
                high = 0x8F;
            } else {
                return i;
            }
            if (count > text.length() - i - 1) {
                return i;
            }
            for (int k : 1..=count) {
                int next = text[i + k];
                if (next < (k == 1 ? low : 0x80) || next > (k == 1 ? high : 0xBF)) {
                    return i;
                }
            }
            i += count + 1;
        }
        return null;
    }
}
