/// Immutable UTF-8 text, the built-in type of string literals.
///
/// This declaration gives `String` its members and interfaces; `String` itself is a built-in type,
/// not a struct (spec `types.string`). Offsets and lengths count bytes of UTF-8, which is what a
/// string stores; a character (`char`) takes 1 to 4 of them.
pub extern struct String implements Comparable<String>, Hashable<String>, Printable {
    /// Returns the length in bytes, not in characters.
    @Pure
    pub extern int byteLength();

    /// Returns whether the string has no bytes.
    pub bool isEmpty() {
        return byteLength() == 0;
    }

    /// Returns the UTF-8 bytes, without a copy. The string is held while the span is used.
    @Pure
    pub extern ReadOnlySpan<byte> bytes();

    /// Returns the number of characters (code points).
    @Pure
    pub extern int charCount();

    /// Returns whether the string starts with the bytes of `prefix`.
    @Pure
    pub extern bool startsWith(String prefix);

    /// Returns whether the string ends with the bytes of `suffix`.
    @Pure
    pub extern bool endsWith(String suffix);

    /// Returns whether the bytes of `text` occur in the string.
    pub bool contains(String text) {
        return indexOf(text) != null;
    }

    /// Returns the byte offset where `text` first occurs, or null if it doesn't.
    @Pure
    pub extern int? indexOf(String text);

    /// Returns the `length` bytes from `start`, as a string.
    ///
    /// # Panics
    ///
    /// If any of those bytes is out of bounds, or the range would split a character.
    @CallerLocation
    pub extern String slice(int start, int length);

    /// Returns -1, 0, or 1 as this string sorts before, the same as, or after `other`: by byte,
    /// which for UTF-8 is the order of the code points.
    @Pure
    pub extern int compareTo(in String other);

    /// Returns the string itself.
    @Pure
    pub extern String toString();

    /// Returns whether this string has the same bytes as `other`.
    pub bool equals(in String other) {
        return this == other;
    }

    /// Adds the bytes of this string to `hasher`.
    pub void hash(ref Hasher hasher) {
        hasher.addBytes(bytes());
    }

    // The character that starts at `offset`, which must be where one starts.
    @Pure
    extern char charAt(int offset);

    // The offset after the character that starts at `offset`.
    @Pure
    extern int nextChar(int offset);
}
