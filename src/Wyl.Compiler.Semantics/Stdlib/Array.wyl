// A fixed-length array on the heap, written `T[]` and created with `new T[length]`. It never
// moves its elements, so a reference into it only keeps it alive and needs no borrow.

final class Array<T> implements Spannable<T> {
    public int length;

    // Each element starts as `T`'s default value; the compiler checks that it has one.
    @CallerLocation
    public Array(int length) {
        unsafe {
            data = Memory.allocate<T>(length);
            Memory.initializeDefault(data, length);
        }
        this.length = length;
    }

    @CallerLocation
    public Array(int length, T value) {
        unsafe {
            data = Memory.allocate<T>(length);
            for (int i : 0..length) {
                Memory.initialize(data + i, value);
            }
        }
        this.length = length;
    }

    @CallerLocation
    public ref T operator [](int index) {
        Bounds.check(index, length);
        unsafe {
            return ref data[index];
        }
    }

    // Like the indexer, but null instead of a panic when `index` is out of bounds.
    public ref? T get(int index) {
        if (index < 0 || index >= length) {
            return null;
        }
        unsafe {
            return ref data[index];
        }
    }

    public Span<T> asSpan() {
        unsafe {
            return Span<T>(data, length);
        }
    }

    public ReadOnlySpan<T> asReadOnlySpan() {
        unsafe {
            return ReadOnlySpan<T>(data, length);
        }
    }

    private T* data;

    ~Array() {
        unsafe {
            for (int i : 0..length) {
                Memory.drop(data + i);
            }
            Memory.free(data);
        }
    }
}
