import std::{memory, panic};
import std::iteration::InIterator;

/// The elements of a frozen list: a buffer that no code changes once a `Frozen` holds it.
package struct FrozenStorage<T> {
    package T* data;
    package int length;

    package FrozenStorage(T* data, int length) {
        this.data = data;
        this.length = length;
    }
}

/// An immutable list that every thread may read (spec `concurrency.frozen`).
///
/// Its elements are sendable and copyable, and nothing changes them, so threads read them without a
/// lock. `List.freeze` moves a list's elements into one without copying them, and `copyOf` copies
/// the elements of a span.
pub shared class Frozen<T extends sendable & copyable> implements ReadOnlySpannable<T>, unsafe memory::ElementOwner<T> {
    package FrozenStorage<T> storage;

    package Frozen(FrozenStorage<T> elements) {
        storage = elements;
    }

    /// Returns a frozen list that holds a copy of each element of `items`.
    pub static Frozen<T> copyOf(ReadOnlySpan<T> items) {
        int length = items.length();
        unsafe {
            mut T* data = null;
            if (length > 0) {
                data = memory::allocate<T>(length);
                mut int i = 0;
                while (i < length) {
                    memory::initialize(data + i, items[i]);
                    i++;
                }
            }
            return new Frozen<T>(FrozenStorage<T>(data, length));
        }
    }

    /// Returns the number of elements.
    pub int length() {
        return storage.length;
    }

    /// Returns a reference to the element at `index`.
    ///
    /// # Panics
    ///
    /// If `index` is out of bounds.
    @CallerLocation
    pub in T operator [](int index) {
        panic::checkIndex(index, storage.length);
        unsafe {
            return ref storage.data[index];
        }
    }

    /// Returns a reference to the element at `index`, or null if `index` is out of bounds.
    pub in? T get(int index) {
        if (index < 0 || index >= storage.length) {
            return null;
        }
        unsafe {
            return ref storage.data[index];
        }
    }

    /// Returns a read-only span of the elements.
    pub ReadOnlySpan<T> asReadOnlySpan() {
        unsafe {
            return ReadOnlySpan<T>(storage.data, storage.length);
        }
    }

    /// Returns an iterator over read-only references to the elements, first to last.
    pub FrozenIterator<T> iterator() {
        return FrozenIterator<T>(this);
    }

    /// Passes each element to `visitor`, for the cycle collector.
    pub void visitElements(ref memory::ElementVisitor<T> visitor) {
        unsafe {
            for (int i : 0..storage.length) {
                visitor.visit(ref storage.data[i]);
            }
        }
    }

    ~Frozen() {
        unsafe {
            mut int i = storage.length;
            while (i > 0) {
                i--;
                memory::drop(storage.data + i);
            }
            memory::free(storage.data);
        }
    }
}

/// An iterator over read-only references to the elements of a `Frozen`, first to last, which
/// `Frozen.iterator()` returns. The iterator holds the frozen list.
pub struct FrozenIterator<T extends sendable & copyable> implements InIterator<T> {
    Frozen<T> frozen;
    int position;

    package FrozenIterator(Frozen<T> frozen) {
        this.frozen = frozen;
        position = -1;
    }

    /// Returns `true` after advancing to the next element, or `false` once the iterator has passed
    /// the last element.
    pub mut bool moveNext() {
        if (position < frozen.length()) {
            position++;
        }
        return position < frozen.length();
    }

    /// Returns a read-only reference to the element that the last call of `moveNext` advanced to.
    ///
    /// # Panics
    ///
    /// If `moveNext` has not been called yet, or its last call returned `false`.
    pub mut in T current() {
        if (position < 0 || position >= frozen.length()) {
            panic::panic("cannot read the current element of an iterator before 'moveNext' or after the last element");
        }
        return ref frozen[position];
    }
}
