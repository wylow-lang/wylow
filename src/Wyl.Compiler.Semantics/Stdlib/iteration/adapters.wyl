/// An iterator over the results of a function applied to the elements of two source iterators in
/// pairs, which `zip` returns.
pub struct ZipIterator<I extends Iterator<T>, J extends Iterator<U>, T, U, V> implements Iterator<V> {
    I source;
    J other;
    fn(T, U) -> V combine;

    package ZipIterator(I source, J other, escaping fn(T, U) -> V combine) {
        this.source = source;
        this.other = other;
        this.combine = combine;
    }

    /// Returns `true` after advancing both sources to their next elements, or `false` if either
    /// source has no more elements. If the first source has no more elements, the call does not
    /// advance the second.
    pub mut bool moveNext() {
        return source.moveNext() && other.moveNext();
    }

    /// Returns the result of the function applied to the current elements of the two sources.
    pub mut V current() {
        return combine(source.current(), other.current());
    }
}

/// An iterator over the results of a function applied to references to the elements of two source
/// iterators in pairs, which `zip` returns.
pub struct RefZipIterator<I extends RefIterator<T>, J extends RefIterator<U>, T, U, V> implements Iterator<V> {
    I source;
    J other;
    fn(in T, in U) -> V combine;

    package RefZipIterator(I source, J other, escaping fn(in T, in U) -> V combine) {
        this.source = source;
        this.other = other;
        this.combine = combine;
    }

    /// Returns `true` after advancing both sources to their next elements, or `false` if either
    /// source has no more elements. If the first source has no more elements, the call does not
    /// advance the second.
    pub mut bool moveNext() {
        return source.moveNext() && other.moveNext();
    }

    /// Returns the result of the function applied to the current elements of the two sources.
    pub mut V current() {
        return combine(source.current(), other.current());
    }
}

