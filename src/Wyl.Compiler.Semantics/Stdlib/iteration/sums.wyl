/// Returns the sum of the elements that remain in `source`, or zero if none remain.
///
/// # Panics
///
/// In a debug build, if the sum overflows.
@CallerLocation
pub sbyte sum<I extends Iterator<sbyte>>(this I source) {
    mut sbyte total = 0;
    for (sbyte item : source) {
        total += item;
    }
    return total;
}

