/// A view of elements stored elsewhere.
///
/// A span is a `ref struct`: it can only be a local or a parameter, and what it views is held and
/// borrowed for as long as it is used (spec `types.spans`).
pub ref struct Span<T> implements ReadOnlySpannable<T> {
    T* elements;
    int size;

    /// Makes a span of the `length` elements at `data`.
    ///
    /// # Safety
    ///
    /// The `length` elements at `data` must stay alive and unmoved while the span is used.
    pub unsafe Span(T* data, int length) {
        elements = data;
        size = length;
    }

    /// Returns the number of elements.
    pub int length() {
        return size;
    }

    /// Returns the size of the elements in bytes.
    ///
    /// # Panics
    ///
    /// If the size is greater than the largest `int`.
    @CallerLocation
    pub int byteLength() {
        return memory::byteLength<T>(size);
    }

    /// Returns a pointer to the first element.
    ///
    /// # Safety
    ///
    /// The pointer is valid only while this span is used. It is undefined behavior to read or
    /// write through it after that.
    pub unsafe T* data() {
        return elements;
    }

    /// Returns a reference to the element at `index`.
    ///
    /// # Panics
    ///
    /// If `index` is out of bounds.
    @CallerLocation
    pub ref T operator [](int index) {
        panic::checkIndex(index, size);
        unsafe {
            return ref elements[index];
        }
    }

    /// Returns a reference to the element at `index`, or null if `index` is out of bounds.
    pub ref? T get(int index) {
        if (index < 0 || index >= size) {
            return null;
        }
        unsafe {
            return ref elements[index];
        }
    }

    /// Returns a span of the `length` elements from `start`.
    ///
    /// # Panics
    ///
    /// If `start` or `length` is negative, or `start + length` is greater than this span's length.
    @CallerLocation
    pub Span<T> slice(int start, int length) {
        panic::checkRange(start, length, size);
        unsafe {
            return Span<T>(elements + start, length);
        }
    }

    /// Returns a read-only span of the same elements.
    pub ReadOnlySpan<T> asReadOnlySpan() {
        unsafe {
            return ReadOnlySpan<T>(elements, size);
        }
    }
}

/// A read-only view of elements stored elsewhere. It is a `ref struct`, as `Span` is.
pub ref struct ReadOnlySpan<T> {
    T* elements;
    int size;

    /// Makes a read-only span of the `length` elements at `data`.
    ///
    /// # Safety
    ///
    /// The `length` elements at `data` must stay alive and unmoved while the span is used.
    pub unsafe ReadOnlySpan(T* data, int length) {
        elements = data;
        size = length;
    }

    /// Returns the number of elements.
    pub int length() {
        return size;
    }

    /// Returns the size of the elements in bytes.
    ///
    /// # Panics
    ///
    /// If the size is greater than the largest `int`.
    @CallerLocation
    pub int byteLength() {
        return memory::byteLength<T>(size);
    }

    /// Returns a pointer to the first element.
    ///
    /// # Safety
    ///
    /// The pointer is valid only while this span is used. It is undefined behavior to read or
    /// write through it after that, and to write through it at any time.
    pub unsafe T* data() {
        return elements;
    }

    /// Returns a read-only reference to the element at `index`.
    ///
    /// # Panics
    ///
    /// If `index` is out of bounds.
    @CallerLocation
    pub in T operator [](int index) {
        panic::checkIndex(index, size);
        unsafe {
            return ref elements[index];
        }
    }

    /// Returns a read-only reference to the element at `index`, or null if `index` is out of bounds.
    pub in? T get(int index) {
        if (index < 0 || index >= size) {
            return null;
        }
        unsafe {
            return ref elements[index];
        }
    }

    /// Returns a read-only span of the `length` elements from `start`.
    ///
    /// # Panics
    ///
    /// If `start` or `length` is negative, or `start + length` is greater than this span's length.
    @CallerLocation
    pub ReadOnlySpan<T> slice(int start, int length) {
        panic::checkRange(start, length, size);
        unsafe {
            return ReadOnlySpan<T>(elements + start, length);
        }
    }
}
