// Raw memory and the cycle collector (spec `library.memory`). The compiler can't check how raw
// memory is used, so its functions are `unsafe`.

/// Allocates uninitialized storage for `count` values of `T`.
///
/// # Panics
///
/// If `count` is negative, or `count` values of `T` are too large to address.
///
/// # Safety
///
/// The storage must be freed with `free`, once, after its values are dropped.
@CallerLocation
pub unsafe extern T* allocate<T>(int count);

/// Frees storage that `allocate` returned.
///
/// # Safety
///
/// `data` must come from `allocate`, not be freed already, and hold no value that isn't dropped.
pub unsafe extern void free<T>(T* data);

/// Stores `value` in uninitialized storage.
///
/// # Safety
///
/// `place` must be allocated storage that holds no value.
pub unsafe extern void initialize<T>(T* place, T value);

/// Stores `T`'s default value in each of the `count` places at `data`.
///
/// # Safety
///
/// `T` must have a default value, and the places must hold no value. The compiler can't check
/// that a generic `T` has one, so the function is the package's own.
package unsafe extern void initializeDefault<T>(T* data, int count);

/// Destroys the value at `place`, leaving its storage uninitialized.
///
/// # Safety
///
/// `place` must hold a value.
pub unsafe extern void drop<T>(T* place);

/// Moves the value at `place` out, leaving its storage uninitialized.
///
/// # Safety
///
/// `place` must hold a value.
pub unsafe extern T moveOut<T>(T* place);

/// Moves the `count` values at `from` into the uninitialized storage at `to`, leaving the source
/// uninitialized. The two ranges may overlap.
///
/// # Safety
///
/// The `count` places at `from` must hold values, and those at `to` that aren't among them must not.
pub unsafe extern void moveTo<T>(T* from, T* to, int count);

/// A class that keeps values in raw memory and reports them to the cycle collector, which looks at
/// a class through its fields otherwise (spec `library.memory`).
///
/// # Safety
///
/// `visitElements` passes each value that the class keeps in raw memory to `visitor.visit` exactly
/// once, and passes nothing else. It changes no value, creates or releases no reference, does not
/// panic, and does not call `collectCycles`.
pub unsafe interface ElementOwner<T> {
    /// Passes each value that the class keeps in raw memory to `visitor`.
    void visitElements(ref ElementVisitor<T> visitor);
}

/// The cycle collector's view of the values that an `ElementOwner` reports. Only the collector makes
/// a visitor that reports anything: a default value reports nothing.
pub unique extern struct ElementVisitor<T> {
    /// Reports `element` to the cycle collector.
    pub mut extern void visit(ref T element);
}

/// Frees every cycle of objects that nothing outside the cycle refers to, which reference counting
/// alone never frees. It runs only when called (spec `memory.cycles`).
///
/// # Panics
///
/// If it is called from a destructor.
@CallerLocation
pub extern void collectCycles();

/// Frees cycles as `collectCycles()` does, but stops after visiting about `maxVisits` objects; the
/// rest wait for the next call.
///
/// # Panics
///
/// If it is called from a destructor.
@CallerLocation
pub extern void collectCycles(int maxVisits);

/// What the cycle collector did since the last call of `cycleStats`.
pub struct CycleStats {
    /// The objects that may have been left in a cycle, which the next collection looks at.
    pub int buffered;
    /// The objects the collector looked at.
    pub int visited;
    /// The objects in cycles that the collector freed.
    pub int freed;
}

/// Returns what the cycle collector did since the last call.
pub CycleStats cycleStats() {
    mut var stats = CycleStats();
    takeCycleStats(ref stats.buffered, ref stats.visited, ref stats.freed);
    return stats;
}

extern void takeCycleStats(ref int buffered, ref int visited, ref int freed);
