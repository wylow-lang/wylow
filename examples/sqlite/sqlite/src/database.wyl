import std::Unit;
import std::Utf8Error;
import std::collections::List;

/// An error that SQLite reported, with its result code and its message. Text that is not valid UTF-8
/// is an error with the code `SQLITE_MISMATCH`.
pub struct Error implements Printable {
    /// The primary result code, or null if this version of the layer does not list it.
    pub ResultCode? primary;
    /// The extended result code, whose low byte is the primary code.
    pub int code;
    pub String message;

    /// Makes the error of the extended result code `code`.
    module Error(int code, String message) {
        primary = ResultCode.tryFrom(code & 0xFF);
        this.code = code;
        this.message = message;
    }

    /// Returns the result code and the message.
    pub String toString() {
        return $"SQLite error {code}: {message}";
    }
}

/// An open connection to a database. The destructor closes the connection.
pub final class Database {
    module Connection* handle;

    Database(Connection* handle) {
        this.handle = handle;
    }

    /// Opens the database at `path`, or an in-memory database if `path` is `":memory:"`.
    pub static Result<Database, Error> open(String path) {
        unsafe {
            mut Connection* handle = null;
            int code = sqlite3_open(path.cstr(), &handle);
            if (code != SQLITE_OK) {
                // SQLite returns a connection on most failures, and the connection holds the message.
                String message = handle == null
                    ? String.fromCString(sqlite3_errstr(code))
                    : String.fromCString(sqlite3_errmsg(handle));
                _ = sqlite3_close(handle);
                return Err(Error(code, message));
            }
            // A failed call then returns an extended result code, which names the failure exactly.
            _ = sqlite3_extended_result_codes(handle, 1);
            return Ok(new Database(handle));
        }
    }

    /// Returns a statement of the first SQL statement in `sql`.
    pub Result<Statement, Error> prepare(String sql) {
        unsafe {
            mut PreparedStatement* statement = null;
            int code = sqlite3_prepare_v2(handle, sql.cstr(), sql.byteLength(), &statement, null);
            if (code != SQLITE_OK) {
                return Err(error(code));
            }
            // SQLite returns no statement for text that holds only whitespace and comments.
            if (statement == null) {
                return Err(Error(SQLITE_MISUSE, "the SQL text holds no statement"));
            }
            return Ok(Statement(this, statement));
        }
    }

    /// Runs `sql`, a statement that returns no rows.
    pub Result<Unit, Error> execute(String sql) {
        mut Statement statement = try prepare(sql);
        if (try statement.step()) {
            return Err(Error(SQLITE_MISUSE, "the statement returned a row"));
        }
        return Ok(Unit());
    }

    /// Runs `sql`, which may hold several statements, and calls `visit` with each row's column names
    /// and values. A null value is `null`. The run stops after a row for which `visit` returns
    /// `false`, or at a name or a value that is not valid UTF-8, which the run returns as an error.
    pub Result<Unit, Error> forEachRow(String sql, fn(List<String>, List<String?>) -> bool visit) {
        mut var context = ExecContext(visit);
        unsafe {
            int code = sqlite3_exec(handle, sql.cstr(), visitRow, &context, null);
            if (context.failure is Error failure) {
                return Err(failure);
            }
            if (code != SQLITE_OK && !context.stopped) {
                return Err(error(code));
            }
        }
        return Ok(Unit());
    }

    /// Returns the error of `code`, with the message of the connection's last failed call.
    module Error error(int code) {
        unsafe {
            return Error(code, String.fromCString(sqlite3_errmsg(handle)));
        }
    }

    ~Database() {
        // No statement is left to finalize: each statement keeps its database alive.
        unsafe {
            _ = sqlite3_close(handle);
        }
    }
}

/// Returns the error of a value of `column` that is not valid UTF-8.
module Error invalidText(int column, Utf8Error error) {
    return Error(SQLITE_MISMATCH, $"column {column} holds {error}");
}

/// What `forEachRow` gives `sqlite3_exec` as the callback's context. `sqlite3_exec` calls the
/// callback only during the call, so the context holds the caller's function without owning it.
ref struct ExecContext {
    fn(List<String>, List<String?>) -> bool visit;
    bool stopped = false;
    Error? failure = null;
}

/// Calls the function of the `ExecContext` that `context` points to with one row of
/// `sqlite3_exec`'s result. Returns 1, which stops the run, if the function returns `false` or a
/// name or a value is not valid UTF-8.
@CCallback
int visitRow(void* context, int columns, byte** values, byte** names) {
    unsafe {
        ExecContext* exec = (ExecContext*) context;
        switch (visitTexts(exec[0].visit, columns, values, names)) {
            case Ok(var more) -> {
                if (more) {
                    return 0;
                }
                exec[0].stopped = true;
            }
            case Err(var error) -> exec[0].failure = error;
        }
    }
    return 1;
}

/// Returns what `visit` returns for the row's names and values, or the error of the first name or
/// value that is not valid UTF-8.
unsafe Result<bool, Error> visitTexts(fn(List<String>, List<String?>) -> bool visit, int columns, byte** values, byte** names) {
    mut var nameList = new List<String>();
    mut var valueList = new List<String?>();
    for (mut int column = 0; column < columns; column++) {
        nameList.add(try text(column, names[column]));
        if (values[column] == null) {
            valueList.add(null);
        } else {
            valueList.add(try text(column, values[column]));
        }
    }
    return Ok(visit(nameList, valueList));
}

/// Returns the null-terminated text at `p`, the name or a value of `column`, as a string.
unsafe Result<String, Error> text(int column, byte* p) {
    mut int length = 0;
    while (p[length] != 0) {
        length += 1;
    }
    return switch (String.fromUtf8(ReadOnlySpan<byte>(p, length))) {
        case Ok(var text) -> Ok(text);
        case Err(var error) -> Err(invalidText(column, error));
    };
}
