// A program that binds SQLite's C API by hand. On Windows, fetch-sqlite.ps1 puts sqlite3.h, the x64
// sqlite3.dll from sqlite.org, and the import library made from its sqlite3.def in vendor/windows.
// On Linux, the system's libsqlite3-dev gives the header and the library.
name = "sqlite_demo";
native {
    link = ["sqlite3"];
    windows {
        include = ["vendor/windows"];
        libraryPaths = ["vendor/windows"];
        copy = ["vendor/windows/sqlite3.dll"];
    }
}
