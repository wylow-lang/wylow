// A program that uses SQLite through the safe layer of the `sqlite` library, without unsafe code. It
// opens an in-memory database, creates a table, inserts rows with bound text, integers, doubles, and
// blobs, and prints each row of a query. A query runs through `forEachRow`, which SQLite's
// `sqlite3_exec` calls back for each row. An insert breaks a constraint, and the program reads the
// error's primary code as an enum. The last queries read text that is not valid UTF-8, which the
// layer returns as an error.

import std::Unit;
import sqlite::{Database, Error, ResultCode, Statement, Value};

/// A row to insert: a name, a count, a weight, and a tag of raw bytes.
struct Order {
    pub String name;
    pub long count;
    pub double weight;
    pub byte[4] tag;
}

/// Inserts each order through one statement, which is reset after each row, and then a row whose
/// columns other than the name are null.
Result<Unit, Error> insert(Database database, ReadOnlySpan<Order> orders) {
    mut Statement statement = try database.prepare("INSERT INTO orders (name, count, weight, tag) VALUES (?, ?, ?, ?)");
    for (Order order : orders) {
        try statement.bind(1, order.name);
        try statement.bind(2, order.count);
        try statement.bind(3, order.weight);
        try statement.bind(4, order.tag);
        _ = try statement.step();
        try statement.reset();
    }
    try statement.bind(1, "empty");
    for (mut int column = 2; column <= 4; column++) {
        try statement.bindNull(column);
    }
    _ = try statement.step();
    return Ok(Unit());
}

/// Prints each row of `sql`, one line a row, with each column's name.
Result<Unit, Error> query(Database database, String sql) {
    mut Statement statement = try database.prepare(sql);
    int columns = statement.columnCount();
    while (try statement.step()) {
        mut String line = "";
        for (mut int column = 0; column < columns; column++) {
            String separator = column == 0 ? "" : ", ";
            Value value = try statement.column(column);
            line = $"{line}{separator}{statement.columnName(column)} = {value}";
        }
        std::print(line);
    }
    return Ok(Unit());
}

/// The rows that the function given to `forEachRow` has printed. The function is escaping, so it
/// changes an object and not a local of `run`.
class RowCount {
    pub mut int rows;
}

Result<Unit, Error> run() {
    Order[3] orders = [
        Order("bolts", 120, 0.25, [0xDE, 0xAD, 0xBE, 0xEF]),
        Order("nuts", 300, 0.125, [0x00, 0x01, 0x02, 0x03]),
        Order("washers", 75, 1.5, [0xFF, 0x80, 0x7F, 0x00])
    ];
    Database database = try Database.open(":memory:");
    try database.execute("CREATE TABLE orders (name TEXT, count INTEGER, weight REAL, tag BLOB)");
    try insert(database, orders);
    try query(database, "SELECT name, count, weight, tag FROM orders ORDER BY name");
    try query(database, "SELECT count(*) AS rows, sum(count) AS total FROM orders");
    var count = new RowCount();
    String sql = "SELECT name, weight FROM orders WHERE weight > 0.2 ORDER BY weight";
    try database.forEachRow(sql, (names, values) -> {
        mut String line = "";
        for (mut int column = 0; column < names.count(); column++) {
            String separator = column == 0 ? "" : ", ";
            line = $"{line}{separator}{names[column]} = {values[column] ?? "null"}";
        }
        std::print(line);
        count.rows++;
        return true;
    });
    std::print($"forEachRow printed {count.rows} rows");
    switch (database.execute("INSERT INTO missing VALUES (1)")) {
        case Ok(_) -> std::print("the insert ran");
        case Err(var error) -> std::print($"{error}");
    }
    // A second row with the same key breaks the UNIQUE constraint. The error's primary code is
    // Constraint, and its extended code, SQLITE_CONSTRAINT_UNIQUE, is 2067.
    try database.execute("CREATE TABLE keys (key TEXT UNIQUE)");
    try database.execute("INSERT INTO keys VALUES ('a')");
    if (database.execute("INSERT INTO keys VALUES ('a')") is Err(var duplicate)) {
        std::print($"constraint: {duplicate.primary == ResultCode.Constraint}, code {duplicate.code}");
    }
    // The blob x'61FF' cast to text is not valid UTF-8, so reading it returns an error.
    String invalid = "SELECT CAST(x'61FF' AS TEXT) AS text";
    switch (query(database, invalid)) {
        case Ok(_) -> std::print("the text was read");
        case Err(var error) -> std::print($"{error}");
    }
    switch (database.forEachRow(invalid, (names, values) -> true)) {
        case Ok(_) -> std::print("the text was read");
        case Err(var error) -> std::print($"{error}");
    }
    return Ok(Unit());
}

void main() {
    if (run() is Err(var error)) {
        std::panic($"{error}");
    }
}
