struct Vec3 {
    float x, y, z;

    Vec3(float x, float y, float z) {
        this.x = x;
        this.y = y;
        this.z = z;
    }

    float dot(in Vec3 other) {
        return x * other.x + y * other.y + z * other.z;
    }

    static Vec3 add(Vec3 a, Vec3 b) {
        return Vec3(a.x + b.x, a.y + b.y, a.z + b.z);
    }
}

struct Particle {
    Vec3 position;
    Vec3 velocity = Vec3(0, 1, 0);
    int bounces;
}

void step(ref Particle p, float dt) {
    p.position.y += p.velocity.y * dt;
    if (p.position.y > 2) {
        p.velocity.y = -p.velocity.y;
        p.bounces++;
    }
}

void main() {
    mut var p = Particle(position: Vec3(0, 0, 0));
    for (mut int i = 0; i < 50; i++) {
        step(ref p, 0.1);
    }
    print(p.bounces);
    print(p.position.dot(Vec3(0, 1, 0)));
}
