// `byteLength()` is the size of a span's elements in bytes: the element count times the element's
// size, as C++ lays the element out (spec interop.buffers, interop.blittable).

struct Header {
    pub byte tag;
    pub double weight;
    pub int count;
}

struct Empty { }

// A unique struct is laid out as a copyable one is, and a struct with a destructor also has a
// one-byte flags field after its fields.
unique struct Handle {
    pub int id;
}

unique struct Guard {
    pub int id;

    ~Guard() { }
}

unique struct EmptyGuard {
    ~EmptyGuard() { }
}

// A nullable value is a union of its value and an empty byte, then a one-byte state, padded to the
// value's alignment. A nullable extern function holds only the pointer, and a fixed array holds
// its elements end to end.
struct Counted {
    pub int? count;
    pub byte tag;
}

struct Flag {
    pub bool? set;
}

struct Grid {
    pub int[2]? cells;
}

struct Callback {
    pub (extern fn(int) -> void)? f;
}

struct Cells {
    pub int?[2] values;
    pub byte tag;
}

void main() {
    mut int[3] ints = [1, 2, 3];
    Span<int> view = ints;
    std::print(view.byteLength());              // output: 12
    std::print(view.slice(1, 1).byteLength());  // output: 4

    // A struct's fields are padded to their alignment, and its size to the largest one.
    mut Header[2] headers = [Header(1, 2.0, 3), Header(4, 5.0, 6)];
    ReadOnlySpan<Header> readOnly = headers;
    std::print(readOnly.byteLength());          // output: 48

    mut short[3][2] grid = [[1, 2], [3, 4], [5, 6]];
    Span<short[2]> rows = grid;
    std::print(rows.byteLength());              // output: 12

    // An empty struct still takes one byte.
    mut Empty[4] empties = [Empty(), Empty(), Empty(), Empty()];
    Span<Empty> nothing = empties;
    std::print(nothing.byteLength());           // output: 4

    mut Handle[2] handles = [Handle(1), Handle(2)];
    Span<Handle> handleView = handles;
    std::print(handleView.byteLength());        // output: 8

    mut Guard[2] guards = [Guard(1), Guard(2)];
    Span<Guard> guardView = guards;
    std::print(guardView.byteLength());         // output: 16

    mut EmptyGuard[3] emptyGuards = [EmptyGuard(), EmptyGuard(), EmptyGuard()];
    Span<EmptyGuard> emptyGuardView = emptyGuards;
    std::print(emptyGuardView.byteLength());    // output: 3

    mut Counted[2] counted = [Counted(1, 2), Counted(null, 3)];
    Span<Counted> countedView = counted;
    std::print(countedView.byteLength());       // output: 24

    mut Flag[3] flags = [Flag(true), Flag(null), Flag(false)];
    Span<Flag> flagView = flags;
    std::print(flagView.byteLength());          // output: 6

    mut Grid[2] grids = [Grid(null), Grid(null)];
    Span<Grid> gridView = grids;
    std::print(gridView.byteLength());          // output: 24

    mut Callback[2] callbacks = [Callback(null), Callback(null)];
    Span<Callback> callbackView = callbacks;
    std::print(callbackView.byteLength());      // output: 16

    mut Cells[2] cells = [Cells([1, null], 2), Cells([null, 3], 4)];
    Span<Cells> cellView = cells;
    std::print(cellView.byteLength());          // output: 40

    mut int?[3][2] maybeRows = [[1, null], [null, 2], [3, 4]];
    Span<int?[2]> maybeRowView = maybeRows;
    std::print(maybeRowView.byteLength());      // output: 48

    mut char[2] chars = ['a', 'b'];
    Span<char> text = chars;
    std::print(text.byteLength());              // output: 8
    std::print("hello".bytes().byteLength());   // output: 5

    mut bool[0] none = [];
    Span<bool> zero = none;
    std::print(zero.byteLength());              // output: 0
}
