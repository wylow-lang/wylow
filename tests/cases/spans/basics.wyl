struct Samples {
    float[4] values;

    ReadOnlySpan<float> view() {
        return values;
    }

    mut Span<float> edit() {
        return values;
    }
}

class Sensor {
    mut float[3] readings;
}

float sum(ReadOnlySpan<float> values) {
    mut float total = 0;
    for (float v : values) {
        total += v;
    }
    return total;
}

void scale(Span<float> values, float factor) {
    for (ref float v : values) {
        v *= factor;
    }
}

T first<T extends copyable>(ReadOnlySpan<T> values) {
    return values[0];
}

void main() {
    mut float[4] a = [1, 2, 3, 4];
    std::print(sum(a));         // output: 10.0
    scale(a, 2);
    std::print(a[3]);           // output: 8.0
    std::print(first(a));       // output: 2.0

    Span<float> s = a;
    std::print(s.length());     // output: 4
    s[0] = 5;
    std::print(a[0]);           // output: 5.0
    var middle = s.slice(1, 2);
    std::print(sum(middle));    // output: 10.0
    ReadOnlySpan<float> view = s;
    std::print(view[0]);        // output: 5.0
    for (int i, in float v : view.slice(2, 2)) {
        std::print((float)(i * 100) + v);
    }
    // output: 6.0
    // output: 108.0

    mut Samples samples = Samples();
    samples.edit()[2] = 7;
    std::print(samples.values[2]); // output: 7.0
    std::print(sum(samples.view())); // output: 7.0

    mut var sensor = new Sensor();
    sensor.readings[1] = 2.5f;
    std::print(sum(sensor.readings)); // output: 2.5
    Span<float> readings = sensor.readings;
    sensor = new Sensor();
    readings[0] = 1;
    std::print(readings[0] + readings[1]); // output: 3.5
}
