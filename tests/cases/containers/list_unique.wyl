// A list holds unique elements: a reference reads one, and removing moves it out.

import std::collections::List;

unique struct Buffer {
    pub int length;
}

void main() {
    var list = new List<Buffer>();
    list.add(Buffer(1));
    list.add(Buffer(2));
    std::print(list.first()!.length);    // output: 1
    std::print(list.last()!.length);     // output: 2
    std::print(list.get(5) == null);     // output: true
    var removed = list.removeAt(0);
    std::print(removed.length);          // output: 1
    std::print(list.count());            // output: 1
}
