// A destructor that stores over an element keeps a loop over elements of that type holding its own
// reference wherever the loop may release an object of the destructor's class, directly or through
// what it releases. Other loops are unaffected.

import std::{List, print};

class Enemy {
    String name;

    Enemy(String name) {
        this.name = name;
    }

    ~Enemy() {
        print(name);
    }
}

class Owner {
    List<Enemy> list;

    Owner(List<Enemy> list) {
        this.list = list;
    }

    ~Owner() {
        list[0] = new Enemy("y");
    }
}

void main() {
    var list = new List<Enemy>();
    list.add(new Enemy("a"));
    list.add(new Enemy("b"));
    for (Enemy e : list) {
        mut Owner? owner = new Owner(list);
        owner = null;
        print(e.name);
    }
    // output: a
    // output: a
    // output: y
    // output: b

    // Releases nothing.
    for (Enemy e : list) { // in-place: 1
        print(e.name);
    }
    // output: y
    // output: b

    // Releases an Enemy, whose destructor stores nothing.
    for (Enemy e : list) { // in-place: 1
        var other = new Enemy("c");
        print(e.name);
    }
    // output: y
    // output: c
    // output: b
    // output: c

    // Releases a list that may hold an Owner.
    for (Enemy e : list) {
        var owners = new List<Owner>();
        print(e.name);
    }
    // output: y
    // output: b
}
// output: y
// output: b
