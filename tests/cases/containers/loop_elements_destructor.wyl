// A destructor that stores over an element keeps a loop over elements of that type holding its own
// reference wherever the loop may release an object of the destructor's class, directly or through
// what it releases. Other loops are unaffected.

import std::collections::List;

class Account {
    String name;

    Account(String name) {
        this.name = name;
    }

    ~Account() {
        std::print(name);
    }
}

class Owner {
    List<Account> list;

    Owner(List<Account> list) {
        this.list = list;
    }

    ~Owner() {
        list[0] = new Account("y");
    }
}

void main() {
    var list = new List<Account>();
    list.add(new Account("a"));
    list.add(new Account("b"));
    for (Account e : list) {
        mut Owner? owner = new Owner(list);
        owner = null;
        std::print(e.name);
    }
    // output: a
    // output: a
    // output: y
    // output: b

    // Releases nothing.
    for (Account e : list) { // in-place: 1
        std::print(e.name);
    }
    // output: y
    // output: b

    // Releases an Account, whose destructor stores nothing.
    for (Account e : list) { // in-place: 1
        var other = new Account("c");
        std::print(e.name);
    }
    // output: y
    // output: c
    // output: b
    // output: c

    // Releases a list that may hold an Owner.
    for (Account e : list) {
        var owners = new List<Owner>();
        std::print(e.name);
    }
    // output: y
    // output: b
}
// output: b
// output: y
