import std::collections::List;

class Account {
    String name;

    Account(String name) {
        this.name = name;
    }

    ~Account() {
        std::print(name);
    }
}

struct Packet {
    float x;
    bool apply;

    mut void move(float dx) {
        x += dx;
    }
}

int total(ReadOnlySpan<int> values) {
    mut int sum = 0;
    for (int v : values) {
        sum += v;
    }
    return sum;
}

void accounts() {
    var list = new List<Account>();
    list.add(new Account("a"));
    list.add(new Account("b"));
    list.add(new Account("c"));
    var removed = list.removeAt(1);
    std::print(removed.name);
    list.trim();
    std::print(list.capacity());
    list.clear();
    std::print(list.count());
}

void main() {
    var numbers = new List<int>();
    for (int i : 0..10) {
        numbers.add(i);
    }
    std::print(numbers.count()); // output: 10
    std::print(numbers.capacity() >= 10); // output: true
    std::print(numbers[9]);     // output: 9
    numbers[0] = 100;
    numbers.insert(1, 50);
    std::print(numbers[1]);     // output: 50
    std::print(numbers.removeAt(0)); // output: 100
    std::print(numbers.tryRemoveAt(numbers.count())); // output: null
    numbers.add(7);
    std::print(numbers.tryRemoveAt(numbers.count() - 1)); // output: 7
    var stack = new List<String>();
    std::print(stack.removeLast());         // output: null
    std::print(stack.first() == null);      // output: true
    stack.add("a");
    stack.add("b");
    std::print(stack.first()!);             // output: a
    std::print(stack.last()!);              // output: b
    std::print(stack.removeLast());         // output: b
    std::print(stack.removeLast());         // output: a
    std::print(stack.count());              // output: 0
    var nodes = new List<List<int>>();
    std::print(nodes.last() == null);       // output: true
    nodes.add(numbers);
    std::print(nodes.last()?.count() == numbers.count()); // output: true
    std::print(total(numbers)); // output: 95
    for (ref int n : numbers) {
        n *= 2;
    }
    std::print(numbers[0]);     // output: 100
    for (int i, int n : numbers) {
        if (i == 9) {
            std::print(n);      // output: 18
        }
    }
    numbers.clear();
    std::print(numbers.count()); // output: 0
    numbers.reserve(100);
    std::print(numbers.capacity()); // output: 100
    numbers.trim();
    std::print(numbers.capacity()); // output: 0
    numbers.add(1);
    numbers.add(2);
    numbers.add(3);
    numbers.add(4);
    numbers.add(5);
    std::print(numbers.capacity()); // output: 8
    numbers.trim();
    std::print(numbers.capacity()); // output: 5
    std::print(numbers[4]);     // output: 5
    numbers.add(6);
    std::print(numbers[5]);     // output: 6

    accounts();
    // output: b
    // output: 2
    // output: c
    // output: a
    // output: 0
    // output: b

    var packets = new List<Packet>();
    packets.add(Packet(x: 1));
    packets[0].x += 2;
    std::print(packets[0].x);   // output: 3.0
    ref Packet first = packets[0];
    first.apply = true;
    std::print(packets[0].apply); // output: true

    // A list of lists: the inner list is pinned while it is used.
    var grid = new List<List<int>>();
    grid.add(new List<int>());
    grid[0].add(7);
    std::print(grid[0][0]);     // output: 7

    // A nullable list can be looped over once it is known not to be null.
    List<int>? maybe = grid[0];
    if (maybe != null) {
        for (int n : maybe) {
            std::print(n);      // output: 7
        }
    }

    // `get` refers to an element, or to nothing when the index is out of bounds.
    var scores = new List<int>();
    scores.add(10);
    if (scores.get(0) is ref int score) {
        score += 5;
    }
    std::print(scores[0]);      // output: 15
    if (scores.get(1) is ref int missing) {
        std::print(missing);
    } else {
        scores.add(20);         // the failed test doesn't borrow the list
    }
    std::print(scores.count()); // output: 2
    ref? Packet apply = packets.get(0);
    if (apply != null) {
        apply.x = 9;
    }
    std::print(packets[0].x);   // output: 9.0
    std::print(packets.get(-1) == null); // output: true

    // `?.` on a reference reaches the element itself, so a method changes it in place.
    packets.get(0)?.move(1);
    packets.get(5)?.move(1);
    std::print(packets[0].x);   // output: 10.0
    std::print(packets.get(0)?.x); // output: 10.0
    std::print(packets.get(5)?.x); // output: null
    ref? Packet maybe2 = packets.get(0);
    maybe2?.move(2);
    std::print(packets[0].x);   // output: 12.0
}
