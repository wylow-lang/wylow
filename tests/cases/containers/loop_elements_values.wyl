// A loop element of any type whose copy costs something refers to the element in place, unless
// something the loop runs may write an element of its type or a part of one. Storage of one type
// is never another's (spec unsafe.aliasing), so a write of an unrelated type doesn't
// count.

import std::List;

struct Vec {
    int x;
}

class Tally {
    mut int sum;

    Tally() { }
}

void bump(ref int n) {
    n++;
}

void scale(ref float f) {
    f = f * 2.0f;
}

void main() {
    var vecs = new List<Vec>();
    vecs.add(Vec(1));
    vecs.add(Vec(2));

    for (Vec v : vecs) { // in-place: 1
        std::print(v.x);
    }
    // output: 1
    // output: 2

    // A store into a field of an element changes an element.
    for (Vec v : vecs) {
        vecs[0].x = 9;
        std::print(v.x);
    }
    // output: 1
    // output: 2

    // So does one through a reference that a call is given.
    for (Vec v : vecs) {
        bump(ref vecs[1].x);
        std::print(v.x);
    }
    // output: 9
    // output: 3

    // A float is never part of a Vec.
    mut float total = 1.0f;
    for (Vec v : vecs) { // in-place: 1
        scale(ref total);
        std::print(v.x);
    }
    // output: 9
    // output: 4
    std::print(total);
    // output: 4.0

    // Nor is a field of an object, which lies in nothing else.
    var tally = new Tally();
    for (Vec v : vecs) { // in-place: 1
        tally.sum = tally.sum + v.x;
    }
    std::print(tally.sum);
    // output: 13

    var names = new List<String>();
    names.add("a");
    names.add("b");
    for (String name : names) { // in-place: 1
        std::print(name);
    }
    // output: a
    // output: b

    // A copy of an element in place is the value itself, so it outlives the loop's span.
    mut String last = "";
    for (String name : names) { // in-place: 1
        last = name;
    }
    std::print(last);
    // output: b
}
