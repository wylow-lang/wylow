class Tag {
    String name;

    Tag(String name) {
        this.name = name;
    }

    ~Tag() {
        std::print(name);
    }
}

int total(ReadOnlySpan<int> values) {
    mut int sum = 0;
    for (int v : values) {
        sum += v;
    }
    return sum;
}

void tags() {
    Tag[] tags = new Array<Tag>(2, new Tag("shared"));
    tags[1] = new Tag("own");
    std::print(tags[0].name);
}

void main() {
    int[] squares = new int[4];
    for (int i : 0..squares.length) {
        squares[i] = i * i;
    }
    std::print(total(squares)); // output: 14
    for (ref int s : squares) {
        s += 1;
    }
    std::print(squares[3]);     // output: 10

    String[] names = new Array<String>(2, "x");
    std::print(names[1]);       // output: x
    Tag?[] maybe = new Tag?[3];
    std::print(maybe[2] == null); // output: true

    // Arrays are objects: copying one shares it.
    int[] alias = squares;
    alias[0] = 42;
    std::print(squares[0]);     // output: 42

    // `get` refers to an element, or to nothing when the index is out of bounds.
    if (squares.get(1) is ref int second) {
        second = 7;
    }
    std::print(squares[1]);     // output: 7
    std::print(squares.get(squares.length) == null); // output: true

    // Destroying the array releases its elements last to first.
    tags();
    // output: shared
    // output: own
    // output: shared
}
