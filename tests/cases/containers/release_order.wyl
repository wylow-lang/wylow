// Every container releases its elements last to first, as locals and fields are released in the
// reverse of the order they were created.

import std::collections::List;

class Tag {
    String name;

    Tag(String name) {
        this.name = name;
    }

    ~Tag() {
        std::print(name);
    }
}

void list() {
    var tags = new List<Tag>();
    tags.add(new Tag("l1"));
    tags.add(new Tag("l2"));
    tags.add(new Tag("l3"));
}

void cleared() {
    var tags = new List<Tag>();
    tags.add(new Tag("c1"));
    tags.add(new Tag("c2"));
    tags.clear();
    std::print("cleared");
}

void heapArray() {
    Tag?[] tags = new Tag?[3];
    tags[0] = new Tag("h1");
    tags[1] = new Tag("h2");
    tags[2] = new Tag("h3");
}

void fixedArray() {
    Tag[3] tags = [new Tag("f1"), new Tag("f2"), new Tag("f3")];
}

void main() {
    list();
    // output: l3
    // output: l2
    // output: l1
    cleared();
    // output: c2
    // output: c1
    // output: cleared
    heapArray();
    // output: h3
    // output: h2
    // output: h1
    fixedArray();
    // output: f3
    // output: f2
    // output: f1
}
