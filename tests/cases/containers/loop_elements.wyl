// A loop element refers to the element in place unless something the loop runs may store over an
// element of its type; then it holds its own reference, so the object it refers to stays the same.

import std::collections::List;

class Account {
    String name;
    mut Account? target;

    Account(String name) {
        this.name = name;
    }

    String label() {
        return name;
    }

    void aim(Account other) {
        target = other;
    }

    ~Account() {
        std::print(name);
    }
}

class Visitor {
    virtual void visit(List<Account> list) {
    }
}

class Replacer extends Visitor {
    override void visit(List<Account> list) {
        list[0] = new Account("x");
    }
}

void replaceFirst(List<Account> list) {
    list[0] = new Account("new");
}

void setFirst<T>(List<T> list, T value) {
    list[0] = value;
}

void main() {
    var list = new List<Account>();
    list.add(new Account("a"));
    list.add(new Account("b"));

    // Getters and setters of fields never store over an element.
    for (Account e : list) { // in-place: 1
        e.aim(e);
        std::print(e.label());
        e.target = null;
    }
    // output: a
    // output: b

    for (Account e : list) {
        replaceFirst(list);
        std::print(e.name);
    }
    // output: a
    // output: a
    // output: new
    // output: b

    Visitor visitor = new Replacer();
    for (Account e : list) {
        visitor.visit(list);
        std::print(e.name);
    }
    // output: new
    // output: new
    // output: x
    // output: b

    for (Account e : list) {
        setFirst(list, new Account("g"));
        std::print(e.name);
    }
    // output: x
    // output: x
    // output: g
    // output: b

    mut Account[2] pair = [new Account("p"), new Account("q")];
    for (Account e : pair) {
        pair[0] = e;
        std::print(e.name);
    }
    // output: p
    // output: p
    // output: q

    // Reassigning the loop variable makes it hold its own reference.
    var other = new Account("o");
    for (mut Account e : list) {
        e = other;
        std::print(e.name);
    }
    // output: o
    // output: o
}
// output: o
// output: q
// output: b
// output: g
