// The files of a module see each other's names without importing them, and each may keep a
// private declaration of a name another file also uses privately.

struct Node {
    String name;
}

String helper() {
    return "main's helper";
}

// Overloads of greeting.wyl's 'describe': one the module sees, and one only this file does.
module String describe(Shape shape) {
    return $"a shape with {sides(shape)} sides";
}

String describe(int count) {
    return $"{count} things";
}

void main() {
    std::print(greeting());                 // output: hello from greeting.wyl
    std::print(describe(Point(x: 1, y: 2))); // output: (1, 2)
    std::print(helper());                   // output: main's helper
    std::print(otherHelper());              // output: greeting's helper
    var node = Node(name: "main's node");
    std::print(node.name);                  // output: main's node
    std::print(otherNode());                // output: 7
    var shape = Shape.Square;
    std::print(sides(shape));               // output: 4
    std::print(describe(shape));            // output: a shape with 4 sides
    std::print(describe(3));                // output: 3 things
    std::print(describeFromGreeting());     // output: a shape with 3 sides
}
