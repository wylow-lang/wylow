// Module 'world': its names may repeat the root module's, and nothing in the root uses them yet,
// but they are compiled with the package, and equal names must stay apart in C++. No path reaches a
// name of the root module, so a bare call of 'rootName' is no warning.

import rootName;

pub struct Point {
    pub float x;
    pub float z;
}

pub enum Shape { Cube }

String helper() {
    return "world's helper";
}

pub Point origin() {
    std::print(helper());
    std::print(rootName());
    return Point(x: 0, z: 0);
}
