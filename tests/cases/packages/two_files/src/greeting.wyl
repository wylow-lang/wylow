package String rootName() {
    return "root";
}

module String greeting() {
    return "hello from greeting.wyl";
}

module struct Point {
    pub int x;
    pub int y;
}

module String describe(Point p) {
    return $"({p.x}, {p.y})";
}

module enum Shape { Triangle, Square }

module int sides(Shape shape) {
    return switch (shape) {
        case Triangle -> 3;
        case Square -> 4;
    };
}

// Private to this file, like main.wyl's of the same names.
struct Node {
    int value;
}

String helper() {
    return "greeting's helper";
}

module String otherHelper() {
    return helper();
}

module String describeFromGreeting() {
    return describe(Shape.Triangle);
}

module int otherNode() {
    return Node(value: 7).value;
}
