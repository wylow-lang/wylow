// Names a '*' import brings in give way to the module's own and to named imports, and two of them
// bringing one name in is an error only where it is used.

import alpha::*;
import beta::*;
import beta::named;

int fromAll() {
    return only() + named() + value();  // error[WYL0045]: 'value' is ambiguous here
}

int fromOwn() {
    return common();
}

int common() {
    return 0;
}
