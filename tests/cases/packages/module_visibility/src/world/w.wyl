// A re-export reaches no farther than what it names, and a module's submodule is one of its names.
pub import world::gen::deep as deepAlias;   // error[WYL0055]: 'deep' cannot be re-exported to reach farther than it is visible
import world::gen;                          // error[WYL0044]: 'gen' is already a name of this module

module int local() { return 1; }
package int count() { return 2; }
package struct Shared { }
struct Hidden { }

// A struct pattern lists every field, so it can be written only where they are all visible.
package struct Corner {
    package int x;
    int hidden;
}
package Corner corner() { return Corner(1, 2); }

// An indexer's 'operator []=' may reach less far than its 'operator []', as C#'s 'private set'.
package class Cells {
    mut int[2] items;
    package int operator [](int i) { return items[i]; }
    module void operator []=(int i, int value) { items[i] = value; }
}
package Cells cells() { return new Cells(); }
