// Imports and paths across modules (spec programs.imports, programs.paths).

import world::Chunk;                        // one name
import world::{Block, Kind as BlockKind};   // several, one renamed
import world::gen;                          // a module itself
import world::gen::*;                       // every name of 'world::gen' visible here

void main() {
    var c = Chunk.make(3);
    std::print(c.x);                        // output: 3
    std::print(world::describe(c));         // output: chunk 3
    std::print(gen::seed());                // output: 42
    std::print(noise(2));                   // output: 20
    var b = Block(id: 7);
    std::print(b.id);                       // output: 7
    BlockKind kind = BlockKind.Dirt;
    std::print(world::name(kind));          // output: dirt
    world::Chunk other = world::Chunk.make(5);
    std::print(other.x);                    // output: 5
    std::print(origin().x);                 // output: 0
    std::print(world::worldSeed());         // output: 42
    // The int overload is visible only in 'world', so it never wins here.
    std::print(world::pick(1));             // output: long
    std::print(world::pickHere());          // output: int
    fn(int) -> int f = gen::noise;
    std::print(f(4));                       // output: 40
    bool isBlock = describeAny(b);
    std::print(isBlock);                    // output: true
}

bool describeAny(Block b) {
    return switch (world::kindOf(b)) {
        case world::Kind.Stone -> false;
        case Dirt -> true;
    };
}
