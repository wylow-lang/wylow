// Two files of a module may not both give a name beyond themselves, or give one that the other
// keeps private, since a file would then see two meanings of it (spec programs.names). A
// function's overloads may be in any of its files, but no file may see one signature twice.

module struct Shared { }
struct Mine { }
module void overloaded(int x) { }
module void repeated(int x) { }
void quiet(int x) { }
void alone(int x) { }

module enum Shape { Dot }
package int corners(Shape shape) { return 0; }   // error[WYL0056]: parameter type 'Shape' is less visible than function 'corners'

void main() {
    secret();                       // error[WYL0054]: function 'secret' is not visible here
    Hidden h;                       // error[WYL0054]: type 'Hidden' is not visible here
    var n = Hidden();               // error[WYL0054]: type 'Hidden' is not visible here
    var f = secretValue;            // error[WYL0054]: function 'secretValue' is not visible here
}
