// A method that isn't visible can't be overridden (spec 06-syntax.md §6.2): a subclass's method
// with its signature is a method of the subclass's own, which calls through the base never reach.

import std::print;
import shapes::{Shape, Circle, show, reveal};

class Square extends Shape {
    // Shape's describe is pub(module), visible only in 'shapes'.
    virtual String describe() {
        return "a square";
    }
}

class Tile extends Square {
    override String describe() {
        return "a tile";
    }
}

void main() {
    var square = new Square();
    print(square.describe());           // output: a square
    print(show(square));                // output: a shape
    Square tile = new Tile();
    print(tile.describe());             // output: a tile
    print(show(tile));                  // output: a shape
    var circle = new Circle();
    print(circle.secretOf());           // output: a circle's secret
    print(reveal(circle));              // output: a shape's secret
    print(show(circle));                // output: a circle
}
