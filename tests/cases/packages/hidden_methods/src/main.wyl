// A method that isn't visible can't be overridden (spec programs.visibility): a subclass's method
// with its signature is a method of the subclass's own, which calls through the base never reach.

import shapes::{Shape, Circle};

class Square extends Shape {
    // Shape's describe is visible only in 'shapes': it is marked 'module'.
    virtual String describe() {
        return "a square";
    }
}

class Cell extends Square {
    override String describe() {
        return "a cell";
    }
}

void main() {
    var square = new Square();
    std::print(square.describe());      // output: a square
    std::print(shapes::show(square));   // output: a shape
    Square cell = new Cell();
    std::print(cell.describe());        // output: a cell
    std::print(shapes::show(cell));     // output: a shape
    var circle = new Circle();
    std::print(circle.secretOf());      // output: a circle's secret
    std::print(shapes::reveal(circle)); // output: a shape's secret
    std::print(shapes::show(circle));   // output: a circle
}
