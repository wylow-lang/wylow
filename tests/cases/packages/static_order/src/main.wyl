class MainValue {
    static int VALUE = mainValue();
}

int mainValue() {
    std::print("main value");
    return 3;
}

// output: early
// output: late
// output: main value

void main() {
    std::print(Early.VALUE);    // output: 1
    std::print(Late.VALUE);     // output: 2
    std::print(MainValue.VALUE); // output: 3
    std::print("done");         // output: done
}
