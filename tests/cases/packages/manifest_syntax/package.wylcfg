// Comments, strings, and names are read as in a .wyl file; line breaks don't matter.
name
    = "manifest_syntax"
;
native { include = ["a", "b"] link = ["c"]; }   // error[WYL0021]: expected ';'
native "x";                             // error[WYL0021]: expected '=' or '{' after 'native'
= "x";                                  // error[WYL0021]: expected a key
dependencies = 3;                       // error[WYL0021]: expected a string
dependencies = $"x{name}";              // error[WYL0022]: manifest strings cannot be interpolated // error[WYL0025]: 'dependencies' takes a block of entries
}                                       // error[WYL0021]: expected a key
