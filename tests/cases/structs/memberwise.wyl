import std::print;

struct Vec2 {
    float x, y;
}

struct Transform {
    Vec2 position;
    float scale = 1;
}

struct Pair<A, B> {
    A first;
    B second;
}

class Player {
    String name;
    Player(String name) { this.name = name; }
}

// Without a default value, a memberwise constructor is the only way to build it positionally.
struct Hit {
    Player target;
    int damage = 10;
}

struct Samples {
    int[2] values;
}

struct Hidden {
    static Hidden make(int secret) { return Hidden(secret); }
    int reveal() { return secret; }

    int secret;
}

struct Enemy {
    Vec2 position;
    int health = 100;
    Player? target;
}

int announce(int value) {
    print($"init {value}");
    return value;
}

struct Counted {
    int id = announce(7);
    String label;
}

float next(float value) {
    print(value);
    return value;
}

String shout(String text) {
    print(text);
    return text;
}

Pair<T, int> withFirst<T>(T x) {
    return Pair<T, int>(first: x);
}

void main() {
    var v = Vec2(1, 2);
    print(v.x);                       // output: 1.0
    print(v.y);                       // output: 2.0
    print(Vec2() == Vec2(0, 0));      // output: true

    var t = Transform(Vec2(3, 4), 2);
    print(t.position.y);              // output: 4.0
    print(t.scale);                   // output: 2.0
    print(Transform().scale);         // output: 1.0

    var moved = Transform(v, scale: 6);
    print(moved.scale);               // output: 6.0

    var p = Pair<int, String>(1, "one");
    print(p.second);                  // output: one

    var hit = Hit(new Player("Ana"), 3);
    print(hit.target.name);           // output: Ana
    print(hit.damage);                // output: 3

    mut int[2] values = [4, 5];
    var samples = Samples(values);
    values[0] = 9;
    print(samples.values[0]);         // output: 4

    print(Hidden.make(7).reveal());   // output: 7

    var ordered = Vec2(next(1), next(2));
    // output: 1.0
    // output: 2.0
    print(ordered.y);                 // output: 2.0

    // Fields left out take their initializers or their types' default values, and fields may be named.
    var idle = Enemy();
    print($"{idle.health} {idle.target?.name}");          // output: 100 null
    var placed = Enemy(Vec2(1, 2));
    print($"{placed.position.y} {placed.health}");      // output: 2.0 100
    print(Enemy(health: 50).health);                   // output: 50
    var chasing = Enemy(position: v, target: new Player("Bo"));
    print($"{chasing.health} {chasing.target?.name}");  // output: 100 Bo
    print(Hit(new Player("Cy")).damage);               // output: 10
    print(Hit(target: new Player("Di"), damage: 4).damage); // output: 4
    print(withFirst("x").second);                      // output: 0

    // A field's initializer runs only when the call leaves it out, after the arguments.
    var counted = Counted(label: shout("a"));
    // output: a
    // output: init 7
    print(counted.id);                                 // output: 7
    print(Counted(id: 1, label: "b").id);              // output: 1
    print($"[{Counted(2).label}]");                    // output: []
}
