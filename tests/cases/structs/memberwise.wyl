struct Vec2 {
    float x, y;
}

struct Transform {
    Vec2 position;
    float scale = 1;
}

struct Pair<A, B> {
    A first;
    B second;
}

class Customer {
    String name;
    Customer(String name) { this.name = name; }
}

// Without a default value, a memberwise constructor is the only way to build it positionally.
struct Event {
    Customer target;
    int amount = 10;
}

struct Samples {
    int[2] values;
}

struct Hidden {
    static Hidden make(int secret) { return Hidden(secret); }
    int reveal() { return secret; }

    int secret;
}

struct Account {
    Vec2 position;
    int balance = 100;
    Customer? target;
}

int announce(int value) {
    std::print($"init {value}");
    return value;
}

struct Counted {
    int id = announce(7);
    String label;
}

float next(float value) {
    std::print(value);
    return value;
}

String shout(String text) {
    std::print(text);
    return text;
}

Pair<T, int> withFirst<T>(T x) {
    return Pair<T, int>(first: x);
}

void main() {
    var v = Vec2(1, 2);
    std::print(v.x);                  // output: 1.0
    std::print(v.y);                  // output: 2.0
    std::print(Vec2() == Vec2(0, 0)); // output: true

    var t = Transform(Vec2(3, 4), 2);
    std::print(t.position.y);         // output: 4.0
    std::print(t.scale);              // output: 2.0
    std::print(Transform().scale);    // output: 1.0

    var moved = Transform(v, scale: 6);
    std::print(moved.scale);          // output: 6.0

    var p = Pair<int, String>(1, "one");
    std::print(p.second);             // output: one

    var apply = Event(new Customer("Ana"), 3);
    std::print(apply.target.name);      // output: Ana
    std::print(apply.amount);           // output: 3

    mut int[2] values = [4, 5];
    var samples = Samples(values);
    values[0] = 9;
    std::print(samples.values[0]);    // output: 4

    std::print(Hidden.make(7).reveal()); // output: 7

    var ordered = Vec2(next(1), next(2));
    // output: 1.0
    // output: 2.0
    std::print(ordered.y);            // output: 2.0

    // Fields left out take their initializers or their types' default values, and fields may be named.
    var idle = Account();
    std::print($"{idle.balance} {idle.target?.name}");     // output: 100 null
    var placed = Account(Vec2(1, 2));
    std::print($"{placed.position.y} {placed.balance}"); // output: 2.0 100
    std::print(Account(balance: 50).balance);              // output: 50
    var chasing = Account(position: v, target: new Customer("Bo"));
    std::print($"{chasing.balance} {chasing.target?.name}"); // output: 100 Bo
    std::print(Event(new Customer("Cy")).amount);          // output: 10
    std::print(Event(target: new Customer("Di"), amount: 4).amount); // output: 4
    std::print(withFirst("x").second);                 // output: 0

    // A field's initializer runs only when the call leaves it out, after the arguments.
    var counted = Counted(label: shout("a"));
    // output: a
    // output: init 7
    std::print(counted.id);                            // output: 7
    std::print(Counted(id: 1, label: "b").id);         // output: 1
    std::print($"[{Counted(2).label}]");               // output: []
}
