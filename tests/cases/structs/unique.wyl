// A unique struct is moved where a copyable one is copied: into a local, an argument, and back out
// of a return. The value the source held is not released when the source goes out of scope.

class Item {
    String name;

    Item(String name) { this.name = name; }

    ~Item() { std::print($"release {name}"); }
}

unique struct Buffer {
    pub Item item;
}

Buffer make(String name) {
    var buffer = Buffer(new Item(name));
    return buffer;
}

Item take(Buffer buffer) {
    return buffer.item;
}

class Box {
    mut Buffer buffer;

    Box(Buffer buffer) {
        this.buffer = buffer;
    }
}

void main() {
    var first = make("first");
    std::print("made first");
    // output: made first
    var second = first;
    std::print("moved first");
    // output: moved first
    var item = take(second);
    std::print(item.name);
    // output: first

    // A class may hold a unique value; the object releases it when it is destroyed.
    var box = new Box(make("box"));
    std::print("end");
    // output: end
    // output: release box
    // output: release first
}
