struct Box {
    Box(int width, int height) {
        this.width = width;
        this.height = height;
    }

    int area() {
        return width * height;
    }

    bool isBiggerThan(in Box other) {
        return area() > other.area();
    }

    mut void grow() {
        width = doubled(width);
        height = doubled(height);
    }

    static Box square(int size) {
        return Box(size, size);
    }

    int width;
    int height;

    static int doubled(int n) {
        return n * 2;
    }
}

void main() {
    mut var small = Box(2, 3);
    var big = Box.square(4);
    std::print(small.area());               // output: 6
    std::print(big.isBiggerThan(small));    // output: true
    small.grow();
    std::print(small.area());               // output: 24
    std::print(Box(1, 1).area());           // output: 1
    std::print(Box.square(3).isBiggerThan(big)); // output: false
}
