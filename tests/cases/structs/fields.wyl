import std::print;

int next(String label, int value) {
    print(label);
    return value;
}

struct Stats {
    int balance = 100;
    int margin;
    float speed = 2.5f;
}

struct Account {
    Stats stats;
    int id = next("id initializer", 7);
    bool alive = true;
}

void main() {
    var s = Stats();
    print(s.balance);       // output: 100
    print(s.margin);        // output: 0
    print(s.speed);        // output: 2.5

    mut var e = Account(alive: false);
    // output: id initializer
    print(e.stats.balance); // output: 100
    print(e.id);           // output: 7
    print(e.alive);        // output: false

    e.stats.margin = 5;
    e.stats.balance -= 30;
    print(e.stats.margin);  // output: 5
    print(e.stats.balance); // output: 70

    var ordered = Account(id: next("first", 1), alive: next("second", 2) > 1);
    // output: first
    // output: second
    print(ordered.id);     // output: 1

    // A local declared without a value has none until assigned, so no initializer runs for it.
    Account later;
    later = Account(id: 3);
    print(later.id);       // output: 3

    // A fixed array holds its elements' defaults from the start.
    Account[2] pair;
    // output: id initializer
    // output: id initializer
    print(pair[1].id);     // output: 7
}
