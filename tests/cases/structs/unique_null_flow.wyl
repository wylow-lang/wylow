// '!' and '??' move a unique operand, so it is used after being moved; '?.' and a member that
// does not take its receiver by value use it in place.

import std::print;

unique struct Buffer {
    pub int length;
}

unique struct Holder {
    pub Buffer buffer;
}

void forced(Buffer? maybe) {
    var value = maybe!;
    print(maybe!.length);                   // error[WYL0440]: 'maybe' is used after being moved
}

void coalesced(Buffer? maybe) {
    var value = maybe ?? Buffer(0);
    print(maybe!.length);                   // error[WYL0440]: 'maybe' is used after being moved
}

void field(Holder holder) {
    var value = holder.buffer;              // error[WYL0441]: cannot move a field out of 'holder'
}

void main() {
}
