// A reference binding into an enum's variant makes the enum in use for the binding's scope, so
// replacing the enum then panics.

unique struct Buffer {
    pub int id;

    ~Buffer() { std::print($"release {id}"); }
}

unique enum Maybe {
    None,
    Some(Buffer buffer);
}

void main() {
    mut var maybe = Maybe.Some(Buffer(id: 1));
    switch (maybe) {
        case Some(in var buffer) -> {
            var previous = std::replace(ref maybe, Maybe.None);
            // panic: cannot replace a value that is in use
            std::print(buffer.id);
        }
        case None -> { }
    }
}
