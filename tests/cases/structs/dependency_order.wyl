// A definition comes after every type it holds by value, including a fixed array's element.

import std::print;

struct Holder {
    Account[2] accounts;
}

struct Account {
    int id = 5;
}

void main() {
    var h = Holder();
    print(h.accounts[0].id);   // output: 5
    print(h.accounts[1].id);   // output: 5
}
