// 'replace', 'swap', and 'take' move a value out of a place that cannot be moved from. Nothing is
// released, so no destructor runs until the value's scope ends.

unique struct Buffer {
    pub int length;

    ~Buffer() { std::print($"release {length}"); }
}

struct Point {
    pub int x;
    pub int y;
}

void main() {
    mut var buffer = Buffer(length: 1);
    var old = std::replace(ref buffer, Buffer(length: 2));
    std::print(old.length);
    // output: 1
    std::print(buffer.length);
    // output: 2

    mut var a = Buffer(length: 3);
    mut var b = Buffer(length: 4);
    std::swap(ref a, ref b);
    std::print(a.length);
    // output: 4
    std::print(b.length);
    // output: 3
    std::swap(ref a, ref a);
    std::print(a.length);
    // output: 4

    mut Buffer? maybe = Buffer(length: 5);
    var taken = std::take(ref maybe);
    std::print(taken != null);
    // output: true
    std::print(maybe != null);
    // output: false

    mut var point = Point(x: 1, y: 2);
    var previous = std::replace(ref point, Point(x: 3, y: 4));
    std::print(previous.x);
    // output: 1
    std::print(point.x);
    // output: 3

    mut int? count = 6;
    var number = std::take(ref count);
    std::print(number != null);
    // output: true
    std::print(count != null);
    // output: false

    std::print("end");
    // output: end
    // output: release 5
    // output: release 3
    // output: release 4
    // output: release 1
    // output: release 2
}
