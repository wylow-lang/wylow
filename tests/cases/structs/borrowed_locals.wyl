// A struct local copied from a place is a copy, whether or not the compiler refers to the place
// instead: a later write into a part of the place, directly or by a call, doesn't change it.

struct Vec {
    int x;
}

class Holder {
    mut Vec v;

    Holder() {
        v = Vec(1);
    }

    void bumpX() {
        v.x++;
    }
}

void bump(ref int n) {
    n++;
}

void main() {
    var holder = new Holder();

    {
        Vec quiet = holder.v;
        std::print(quiet.x); // output: 1
    }

    Vec stored = holder.v;
    holder.v.x = 5;
    std::print(stored.x);   // output: 1

    Vec referred = holder.v;
    bump(ref holder.v.x);
    std::print(referred.x); // output: 5

    Vec called = holder.v;
    holder.bumpX();
    std::print(called.x);   // output: 6
    std::print(holder.v.x); // output: 7
}
