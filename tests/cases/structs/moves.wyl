// Using a value after it is moved, moving it out of what is not a whole local, and moving it while
// an earlier operand refers to it are flow errors.

import std::List;

unique struct Counter {
    pub int value;
}

unique struct Pair {
    pub Counter first;
}

unique enum MaybeCounter {
    None,
    Some(Counter counter),
}

void use(ref Counter counter) {
    var copy = counter;                 // error[WYL0441]: cannot move out of what 'counter' refers to
}

class Slot {
    mut Counter counter = Counter(0);
}

void choose(in Counter counter, Counter moved) { }

void optional(Counter? maybe) { }

void both(Counter? maybe, ref Counter counter) { }

// A unique value converted to a nullable value is moved into it, so the source is spent.
void converted(Counter counter) {
    optional(counter);
    std::print(counter.value);          // error[WYL0440]: 'counter' is used after being moved
}

void conflict(mut Counter counter) {
    both(counter, ref counter);         // error[WYL0440]: 'counter' is used after being moved
}

void from_object(Slot slot) {
    var taken = slot.counter;           // error[WYL0441]: cannot move a field out of 'slot'
}

void from_list(List<Counter> counters) {
    var taken = counters[0];            // error[WYL0441]: cannot move out of what a reference refers to
}

void each(List<Counter> counters) {
    for (Counter counter : counters) { }  // error[WYL0441]: cannot move out of what a reference refers to
}

struct Holder<T> {
    T value;

    T grab() {
        return take(() -> value);       // error[WYL0441]: cannot move out of 'this'
    }
}

T take<T>(fn() -> T f) {
    return f();
}

void bind(MaybeCounter maybe) {
    switch (maybe) {
        case MaybeCounter.Some(var counter) -> std::print(counter.value);
        default -> std::print(-1);
    }
}

void main() {
    var counter = Counter(1);
    var kept = counter;
    std::print(counter.value);          // error[WYL0440]: 'counter' is used after being moved

    var pair = Pair(Counter(2));
    var taken = pair.first;             // error[WYL0441]: cannot move a field out of 'pair'

    var a = Counter(3);
    choose(a, a);                       // error[WYL0443]: cannot move 'a' while it is passed by 'in'
}
