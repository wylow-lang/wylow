// The null operators take a unique value by value where the language says they do: '!' and '??'
// move it, and '?.' uses it in place unless the member takes its receiver by value.

unique struct Buffer {
    pub int length;

    pub int twice() {
        return length * 2;
    }
}

void main() {
    mut Buffer? maybe = Buffer(1);
    var taken = maybe!;
    std::print(taken.length);
    // output: 1

    maybe = Buffer(2);
    std::print(maybe?.length ?? 0);
    // output: 2
    // '?.' reached the value in place, so 'maybe' still holds it.
    std::print(maybe!.twice());
    // output: 4

    mut Buffer? full = Buffer(3);
    var value = full ?? Buffer(0);
    std::print(value.length);
    // output: 3

    Buffer? empty = null;
    var fallback = empty ?? Buffer(9);
    std::print(fallback.length);
    // output: 9
}
