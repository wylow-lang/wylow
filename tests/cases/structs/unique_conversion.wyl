// A unique value converted to a nullable value is moved into it: the parameter that takes it owns
// it and releases it when the function returns, so the source holds nothing afterwards.

class C {
    String name;

    C(String name) {
        this.name = name;
    }

    ~C() {
        std::print($"destroyed {name}");
    }
}

unique struct S {
    C c;
}

int f(S? maybe) {
    return 1;
}

void main() {
    var value = S(new C("only"));
    int n = f(value);
    // output: destroyed only
    std::print(n);
    // output: 1
}
