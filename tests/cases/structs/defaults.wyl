// 'T()' builds a struct whose fields each take their default value, and a struct's own
// 'make_default' makes the values a field of that type starts with.

struct Empty { }

struct Inner {
    int x;
    String label;
}

struct Wide {
    String label;
    int n;
    Inner inner;
}

void main() {
    var w = Wide();
    std::print(w.n);                        // output: 0
    std::print(w.label == "");              // output: true
    std::print(w.inner.x);                  // output: 0
    std::print(w.inner.label == "");        // output: true
    var e = Empty();
    std::print(e == Empty());               // output: true
}
