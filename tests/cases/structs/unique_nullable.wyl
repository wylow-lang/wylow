// A nullable type whose value type is unique is a unique type: assigning it moves it, and the
// variable holds nothing until it is assigned again.

import std::print;

unique struct Buffer {
    pub int length;
}

void main() {
    mut Buffer? maybe = Buffer(1);
    var taken = maybe;
    print(taken != null);
    // output: true
    maybe = Buffer(2);
    print(maybe != null);
    // output: true
}
