// Replacing a value that a 'ref' variable refers into panics.

unique struct Handle {
    pub int id;

    ~Handle() { }
}

void main() {
    mut var handle = Handle(id: 1);
    ref int id = handle.id;
    var previous = std::replace(ref handle, Handle(id: 2));
    // panic: cannot replace a value that is in use
    id = 3;
}
