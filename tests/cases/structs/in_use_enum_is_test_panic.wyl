// A reference binding in an 'is' test keeps the enum in use for the statement that holds the
// test, so replacing the enum inside the 'if' panics.

unique struct Handle {
    pub int id;

    ~Handle() { }
}

unique enum Maybe {
    None,
    Some(Handle h);
}

void main() {
    mut var maybe = Maybe.Some(Handle(id: 1));
    if (maybe is Maybe.Some(in var h)) {
        var previous = std::replace(ref maybe, Maybe.None);
        // panic: cannot replace a value that is in use
        std::print(h.id);
    }
}
