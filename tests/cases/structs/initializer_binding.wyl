// A field initializer is lowered into every constructor form that leaves its field out, so a name it
// binds must not clash with any form's parameters: here the name is another field's, which a form
// passing that field takes as a parameter.
int? maybe() {
    return 6;
}

struct Box {
    int width = 4;
    int height = maybe() is int width ? width : 2;
}

void main() {
    var passed = Box(width: 9);
    print(passed.width);        // output: 9
    print(passed.height);       // output: 6
    var defaulted = Box();
    print(defaulted.width);     // output: 4
    print(defaulted.height);    // output: 6
}
