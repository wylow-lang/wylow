// A reference into a unique struct makes it in use for the reference's scope. Replacing it after
// the reference's scope ends is allowed.

unique struct Handle {
    pub int id;

    ~Handle() { std::print($"release {id}"); }
}

void main() {
    mut var handle = Handle(id: 1);
    {
        ref int id = handle.id;
        id = 5;
    }
    var previous = std::replace(ref handle, Handle(id: 2));
    std::print(previous.id);
    // output: 5
    std::print(handle.id);
    // output: 2
    // output: release 5
    // output: release 2
}
