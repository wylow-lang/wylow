// Assigning a struct stores every field before releasing any old one, so the old fields' destructors
// run in reverse declaration order, after the new fields are in place.

class Tag {
    int id;

    Tag(int id) {
        this.id = id;
    }

    ~Tag() {
        std::print(id);
    }
}

struct Pair {
    Tag first;
    Tag second;
}

void main() {
    mut Pair p = Pair(first: new Tag(1), second: new Tag(2));
    var q = Pair(first: new Tag(3), second: new Tag(4));
    p = q;
    // output: 2
    // output: 1
    std::print(-1);                 // output: -1
}
// output: 4
// output: 3
