struct Counter {
    int value;

    mut void increment() {
        value++;
    }

    int get() {
        return value;
    }
}

struct Holder {
    Counter counter;
}

void bump(ref Counter c) {
    c.increment();
}

void bumpCopy(mut Counter c) {
    c.increment();
}

int peek(in Counter c) {
    return c.get();
}

void swap(ref int a, ref int b) {
    int t = a;
    a = b;
    b = t;
}

int incremented(ref int x) {
    x++;
    return x;
}

void main() {
    mut var c = Counter();
    bump(ref c);
    bump(ref c);
    bumpCopy(c);
    std::print(c.value);            // output: 2
    std::print(peek(c));            // output: 2

    mut int a = 1;
    mut int b = 2;
    swap(ref a, ref b);
    std::print(a);                  // output: 2
    std::print(b);                  // output: 1

    mut var h = Holder();
    bump(ref h.counter);
    h.counter.increment();
    std::print(h.counter.value);    // output: 2

    // Left to right: the read of x happens before the call that changes it.
    mut int x = 10;
    std::print(x + incremented(ref x)); // output: 21
    mut int y = 10;
    std::print(incremented(ref y) + y); // output: 22
}
