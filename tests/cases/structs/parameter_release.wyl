unique struct Tracked {
    int id;

    ~Tracked() { std::print($"release {id}"); }
}

String show(Tracked value) {
    std::print($"show {value.id}");
    return "result";
}

void main() {
    var value = Tracked(id: 1);
    std::print(show(value));
    // output: show 1
    // output: release 1
    // output: result
}
