// An unbounded type parameter moves, so generic code works for a unique type argument.

unique struct Buffer {
    pub int length;
}

T identity<T>(T value) {
    return value;
}

T take<T>(T value) {
    T moved = value;
    return moved;
}

void main() {
    var buffer = take(Buffer(3));
    std::print(buffer.length);       // output: 3
    std::print(identity(4));         // output: 4
    std::print(identity("text"));    // output: text
}
