// Generic code copies a value of its type parameter, so a unique type cannot be an argument for
// it, whether it is written or inferred.

unique struct Buffer {
    pub int length;
}

struct Box<T> {
    pub T value;
}

T identity<T>(T value) {
    return value;
}

void main() {
    var box = Box<Buffer>(Buffer(1));   // error[WYL0442]: 'Buffer' cannot be a type argument
    var buffer = Buffer(2);
    var copy = identity(buffer);        // error[WYL0442]: 'Buffer' cannot be a type argument
}
