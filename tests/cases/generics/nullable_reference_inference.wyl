// `null` for a `ref?` parameter says nothing about its type parameter, which a lambda can still give.

T pick<T extends copyable>(ref? T r, fn() -> T make) {
    if (r is ref T value) {
        return value;
    }
    return make();
}

void main() {
    std::print(pick(null, () -> 5)); // output: 5
    mut int x = 7;
    std::print(pick(ref x, () -> 5)); // output: 7
}
