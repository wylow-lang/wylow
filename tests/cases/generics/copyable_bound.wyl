// A copyable bound makes generic code copy a type parameter.

import std::print;

struct Box<T> {
    pub T value;
}

T copyTwice<T extends copyable>(T value) {
    T first = value;
    Box<T> box = Box<T>(value);
    return value;
}

struct Pair<A extends copyable, B> {
    A first;
    B second;

    A firstCopy() {
        return first;
    }
}

void main() {
    print(copyTwice(5));                 // output: 5
    var pair = Pair<int, String>(1, "two");
    print(pair.firstCopy());             // output: 1
}
