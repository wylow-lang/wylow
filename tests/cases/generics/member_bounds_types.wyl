// A type written in a member's signature or body takes the type's parameter as an argument when the
// member's where clause gives the parameter the bound that the argument needs.

struct Pair<U extends copyable> {
    U first;
    U second;
}

struct Shown<U extends Printable> {
    U value;

    String text() {
        return value.toString();
    }
}

struct Holder<T> {
    T value;

    T copy() where T extends copyable {
        Pair<T> pair = Pair<T>(value, value);
        return pair.second;
    }

    Pair<T> pair(Pair<T> other) where T extends copyable {
        return Pair<T>(value, other.second);
    }

    String show() where T extends Printable & copyable {
        Shown<T> shown = Shown<T>(value);
        return shown.text();
    }
}

void main() {
    var holder = Holder<int>(7);
    std::print(holder.copy());           // output: 7
    std::print(holder.show());           // output: 7
    std::print(holder.pair(Pair<int>(1, 2)).second); // output: 2
}
