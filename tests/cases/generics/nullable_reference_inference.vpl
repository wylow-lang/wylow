// `null` for a `ref?` parameter says nothing about its type parameter, which a lambda can still give.
T pick<T>(ref? T r, () -> T make) {
    if (r is ref T value) {
        return value;
    }
    return make();
}

void main() {
    print(pick(null, () -> 5));     // output: 5
    mut int x = 7;
    print(pick(ref x, () -> 5));    // output: 7
}
