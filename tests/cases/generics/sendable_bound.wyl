// A sendable bound accepts the types a value of which may reach another thread.

import std::print;

struct Pair {
    int first;
    String second;
}

T same<T extends sendable>(T value) {
    return value;
}

struct Box<T> {
    T value;

    void nothing() where T extends sendable {
    }
}

void main() {
    print(same(5));                                  // output: 5
    print(same("text"));                             // output: text
    print(same(Pair(first: 1, second: "two")).first);   // output: 1
    Box<int>(1).nothing();
}
