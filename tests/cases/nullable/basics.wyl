enum Direction { North, East, South, West }

int? find(int[4] values, int wanted) {
    for (int i, int value : values) {
        if (value == wanted) {
            return i;
        }
    }
    return null;
}

int? half(int value) {
    return value % 2 == 0 ? value / 2 : null;
}

long widen(long? value) {
    return value ?? -1L;
}

void main() {
    int? missing = null;
    int? present = 4;
    std::print(missing);                    // output: null
    std::print(present);                    // output: 4
    std::print(missing == null);            // output: true
    std::print(present != null);            // output: true
    std::print(null == missing);            // output: true

    // A null check narrows a local, as for references.
    if (present != null) {
        std::print(present + 1);            // output: 5
        int plain = present;
        std::print(plain * 2);              // output: 8
        long wider = present;               // the narrowed 'int' converts to 'long'
        std::print(wider);                  // output: 4
    }
    if (missing == null) {
        std::print("missing");              // output: missing
    }
    // A condition narrows where it is known, through '&&', '||', '!', and '?:'.
    bool either = present! > 0;
    if (either ? present != null : present != null && missing == null) {
        std::print(present + 2);            // output: 6
    }
    if (!(present == null || missing != null)) {
        std::print(present + 3);            // output: 7
    }

    // Assigning a value narrows too, until the local may be null again.
    mut int? counter = 0;
    counter++;
    counter += 10;
    std::print(counter);                    // output: 11
    counter = half(7);
    std::print(counter ?? -1);              // output: -1

    std::print(present! * 3);               // output: 12
    std::print(missing ?? 7);               // output: 7
    std::print(half(10) ?? 0);              // output: 5

    int[4] values = [3, 1, 4, 1];
    std::print(find(values, 4));            // output: 2
    std::print(find(values, 9));            // output: null
    if (find(values, 1) is int index) {
        std::print(index);                  // output: 1
    }
    std::print(find(values, 9) is int);     // output: false

    // Equality compares values, and null equals only null.
    int? other = 4;
    std::print(present == other);           // output: true
    std::print(present == 4);               // output: true
    std::print(missing == other);           // output: false
    int? alsoMissing = null;
    std::print(missing == alsoMissing);     // output: true
    float? scale = 2;
    std::print(scale == 2);                 // output: true
    std::print(scale);                      // output: 2.0

    // Implicit conversions widen the value inside.
    long? wide = present;
    std::print(wide);                       // output: 4
    std::print(widen(missing));             // output: -1
    std::print(widen(9));                   // output: 9
    double? precise = scale;
    std::print(precise);                    // output: 2.0

    mut bool? flag = null;
    std::print(flag);                       // output: null
    flag = true;
    if (flag) {
        std::print("flag");                 // output: flag
    }

    // A variant can still leave out its enum.
    mut Direction? heading = East;
    std::print(heading == East);            // output: true
    std::print(heading == Direction.West);  // output: false
    if (heading != null) {
        switch (heading) {
            case North, South -> std::print("vertical");
            case East, West -> std::print("horizontal"); // output: horizontal
        }
    }
    heading = null;
    std::print(heading == null);            // output: true

    var chosen = present != null ? present : null;
    std::print(chosen);                     // output: 4
}
