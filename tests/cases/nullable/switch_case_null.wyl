// A switch with a 'case null' takes a nullable value as it is. 'null' matches only null, 'default'
// every value but null, and the other patterns the non-null value, wherever 'case null' is written.

class Account {
    int total;

    Account(int total) {
        this.total = total;
    }
}

class Manager extends Account {
    Manager() {
        super(9);
    }
}

struct Vec3 {
    int x;
    int y;
    int z;
}

enum State { Idle, Chasing(Account target), Moved(Vec3? to) }

struct Ship {
    Vec3? pos;
    State? state;
}

Account? find(int i) {
    if (i == 0) {
        return null;
    }
    return i == 1 ? new Account(3) : new Manager();
}

int? number(int i) {
    return i == 0 ? null : i;
}

Vec3? spot(int i) {
    return i == 0 ? null : Vec3(i, i * 10, i * 100);
}

String describe<T>(T? value) {
    return switch (value) {
        case null -> "nothing";
        default -> "something";
    };
}

void main() {
    for (int i : 0..3) {
        // On an object, after the cases that test it.
        switch (find(i)) {
            case Manager b -> std::print($"manager {b.total}");
            case null -> std::print("no account");
            case var e -> std::print($"account {e.total}");
        }
        // On a value, first, with a constant and 'default'.
        switch (number(i)) {
            case null -> std::print("no number");
            case 1 -> std::print("one");
            default -> std::print("more");
        }
        // 'case null, default' covers both.
        switch (number(i)) {
            case 2 -> std::print("two");
            case null, default -> std::print("not two");
        }
        // A struct pattern matches the non-null struct.
        switch (spot(i)) {
            case Vec3(1, var y, _) -> std::print($"y {y}");
            case Vec3(_, _, var z) -> std::print($"z {z}");
            case null -> std::print("nowhere");
        }
    }
    // output: no account
    // output: no number
    // output: not two
    // output: nowhere
    // output: account 3
    // output: one
    // output: not two
    // output: y 10
    // output: manager 9
    // output: more
    // output: two
    // output: z 200

    // 'var v' binds the non-null value.
    int? n = number(4);
    switch (n) {
        case null -> std::print("none");
        case var v -> std::print(v + 1);                // output: 5
    }

    // A case's test narrows the local, as in an 'if'.
    Account? target = find(1);
    switch (target) {
        case Account e -> std::print(target.total);          // output: 3
        case null -> std::print("none");
    }

    // A field may be switched on with 'case null', which narrowing couldn't do.
    Ship ship = Ship(pos: Vec3(1, 2, 3), state: null);
    switch (ship.pos) {
        case null -> std::print("docked");
        case Vec3(var x, _, _) -> std::print($"at {x}"); // output: at 1
    }
    switch (ship.state) {
        case Idle, null -> std::print("idle or none");  // output: idle or none
        case Chasing(var t) -> std::print(t.total);
        case Moved(_) -> std::print("moved");
    }

    // 'null' nested in a pattern matches a nullable field.
    State[3] states = [State.Moved(null), State.Moved(Vec3(7, 8, 9)), State.Chasing(new Account(1))];
    for (State s : states) {
        switch (s) {
            case Moved(null) -> std::print("moved nowhere");
            case Moved(Vec3(var x, _, _)) -> std::print($"moved to {x}");
            default -> std::print("other");
        }
    }
    // output: moved nowhere
    // output: moved to 7
    // output: other
    std::print(states[0] is Moved(null));               // output: true
    std::print(states[1] is Moved(null));               // output: false

    // A switch expression with a case that produces null has a nullable type, with or without an
    // expected one.
    var doubled = switch (number(0)) {
        case null -> null;
        case var v -> v * 2;
    };
    std::print(doubled ?? -1);                          // output: -1
    String? named = switch (number(1)) {
        case null -> null;
        case 1 -> "one";
        default -> "many";
    };
    std::print(named ?? "unnamed");                     // output: one

    // A generic value's null.
    std::print(describe<int>(null));                    // output: nothing
    std::print(describe<Account>(new Account(2)));          // output: something
}
