struct Vec {
    internal {
        int x;
        int y;

        Vec(int x, int y) {
            this.x = x;
            this.y = y;
        }

        mut void move(int dx) {
            x += dx;
        }

        int sum() {
            return x + y;
        }
    }
}

class Token {
    internal {
        String name;

        Token(String name) {
            this.name = name;
        }
    }

    ~Token() {
        print(name);
    }
}

struct Holder {
    internal {
        Token token;
        int? count;

        Holder(Token token, int? count) {
            this.token = token;
            this.count = count;
        }
    }
}

enum Shape {
    Empty,
    Point(Vec? at),
}

enum Slot {
    Free,
    Taken(Holder? holder),
}

struct Grid {
    internal {
        int[3] cells;
    }
}

int total(in int[3] cells) {
    return cells[0] + cells[1] + cells[2];
}

class Body {
    internal {
        mut Vec? velocity;
        mut Holder? held;
    }
}

Vec? offset(bool some) {
    return some ? Vec(1, 2) : null;
}

void main() {
    mut Vec? v = Vec(3, 4);
    print(v?.x);                            // output: 3
    print(v?.sum());                        // output: 7
    print(v!.y);                            // output: 4

    // A narrowed local is changed in place.
    if (v != null) {
        v.x = 10;
        v.move(5);
        print(v.x);                         // output: 15
    }
    print(v?.x);                            // output: 15

    Vec? none = null;
    print(none?.x);                         // output: null
    print(none?.sum() ?? -1);               // output: -1
    print(offset(true)?.y);                 // output: 2
    print(offset(false) == null);           // output: true
    print(v == Vec(15, 4));                 // output: true
    print(v == none);                       // output: false

    // Fields of nullable type default to null.
    mut var body = new Body();
    print(body.velocity == null);           // output: true
    body.velocity = Vec(1, 1);
    print(body.velocity?.sum());            // output: 2

    // Assigning null destroys the value inside, releasing what it holds.
    mut Holder? holder = Holder(new Token("first"), null);
    print(holder?.count);                   // output: null
    holder = Holder(new Token("second"), 2);    // output: first
    print(holder?.token?.name);             // output: second
    print(holder?.count);                   // output: 2
    holder = null;                          // output: second
    print(holder == null);                  // output: true

    // A narrowed local that isn't 'mut' is never set to null, so it can be referred into.
    Grid? grid = Grid(cells: [1, 2, 3]);
    if (grid != null) {
        in int first = grid.cells[0];
        in int[3] cells = grid.cells;
        ReadOnlySpan<int> view = grid.cells;
        mut int sum = 0;
        for (int c : grid.cells) {
            sum += c;
        }
        print(first + cells[1] + view[2] + sum + total(grid.cells));   // output: 18
    }

    // The value itself, not only a field of it, can be referred into when it can't be reassigned.
    int[3]? numbers = [4, 5, 6];
    if (numbers != null) {
        in int[3] whole = numbers;
        ReadOnlySpan<int> all = numbers;
        print(whole[0] + all[2] + total(numbers));  // output: 25
    }

    body.held = Holder(new Token("field"), 1);
    body = new Body();                      // output: field

    // Containers hold nullable values.
    List<int?> list = new List<int?>();
    for (int i : 0..6) {
        list.add(i % 2 == 0 ? i : null);
    }
    mut int total = 0;
    for (int? item : list) {
        total += item ?? 100;
    }
    print(total);                           // output: 306
    int?[] slots = new int?[3];
    print(slots[1]);                        // output: null
    slots[1] = 5;
    print(slots[1]);                        // output: 5

    mut Shape shape = Shape.Point(null);
    if (shape is Point(var at)) {
        print(at == null);                  // output: true
    }
    shape = Shape.Point(Vec(2, 2));
    if (shape is Point(Vec at)) {
        print(at.sum());                    // output: 4
    }

    mut Slot slot = Slot.Taken(Holder(new Token("slot"), null));
    mut Slot copy = slot;
    slot = Slot.Free;
    print(copy is Taken(Holder held));      // output: true
    copy = Slot.Taken(null);
    print(copy is Taken(Holder h2));        // output: false
}
// output: slot
