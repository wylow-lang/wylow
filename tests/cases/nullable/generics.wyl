import std::collections::List;

struct Score implements Comparable<Score> {
    int points;

    Score(int points) {
        this.points = points;
    }

    pub int compareTo(in Score other) {
        return points - other.points;
    }

    pub bool equals(in Score other) {
        return points == other.points;
    }
}

class Node {
    int value;

    Node(int value) {
        this.value = value;
    }
}

// `T?` is a nullable value or a nullable reference, whichever `T` stands for.
T? first<T extends copyable>(List<T> items) {
    if (items.count() == 0) {
        return null;
    }
    return items[0];
}

T orElse<T>(T? value, T fallback) {
    if (value != null) {
        return value;
    }
    return fallback;
}

T? largest<T extends Comparable<T> & copyable>(List<T> items) {
    mut T? best = null;
    for (T item : items) {
        if (best == null || item.compareTo(best) > 0) {
            best = item;
        }
    }
    return best;
}

struct Slot<T> {
    T? value;

    bool isEmpty() {
        return value == null;
    }
}

void main() {
    var numbers = new List<int>();
    std::print(first(numbers));             // output: null
    numbers.add(7);
    numbers.add(9);
    std::print(first(numbers));             // output: 7
    std::print(orElse(first(new List<int>()), 3)); // output: 3
    std::print(orElse<int>(5, 3));          // output: 5

    var nodes = new List<Node>();
    std::print(first(nodes) == null);       // output: true
    nodes.add(new Node(4));
    std::print(first(nodes)?.value);        // output: 4
    std::print(orElse(first(nodes), new Node(0)).value); // output: 4

    // A nullable type argument: `T?` is then the same type as `T`.
    var maybes = new List<int?>();
    maybes.add(null);
    std::print(first(maybes));              // output: null
    std::print(orElse<int?>(null, 2));      // output: 2

    var scores = new List<Score>();
    std::print(largest(scores) == null);    // output: true
    scores.add(Score(3));
    scores.add(Score(8));
    scores.add(Score(5));
    std::print(largest(scores)?.points);    // output: 8

    mut Slot<int> slot = Slot<int>();
    std::print(slot.isEmpty());             // output: true
    slot.value = 1;
    std::print(slot.isEmpty());             // output: false
    Slot<Node> nodeSlot = Slot<Node>();
    std::print(nodeSlot.isEmpty());         // output: true
}
