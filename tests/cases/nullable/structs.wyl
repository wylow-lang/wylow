import std::collections::List;

struct Vec {
    int x;
    int y;

    Vec(int x, int y) {
        this.x = x;
        this.y = y;
    }

    mut void move(int dx) {
        x += dx;
    }

    int sum() {
        return x + y;
    }
}

class Token {
    String name;

    Token(String name) {
        this.name = name;
    }

    ~Token() {
        std::print(name);
    }
}

struct Holder {
    Token token;
    int? count;

    Holder(Token token, int? count) {
        this.token = token;
        this.count = count;
    }
}

enum Shape {
    Empty,
    Point(Vec? at),
}

enum Slot {
    Free,
    Taken(Holder? holder),
}

struct Grid {
    int[3] cells;
}

int total(in int[3] cells) {
    return cells[0] + cells[1] + cells[2];
}

class Body {
    mut Vec? rate;
    mut Holder? held;
}

Vec? offset(bool some) {
    return some ? Vec(1, 2) : null;
}

void main() {
    mut Vec? v = Vec(3, 4);
    std::print(v?.x);                       // output: 3
    std::print(v?.sum());                   // output: 7
    std::print(v!.y);                       // output: 4

    // A narrowed local is changed in place.
    if (v != null) {
        v.x = 10;
        v.move(5);
        std::print(v.x);                    // output: 15
    }
    std::print(v?.x);                       // output: 15

    Vec? none = null;
    std::print(none?.x);                    // output: null
    std::print(none?.sum() ?? -1);          // output: -1
    std::print(offset(true)?.y);            // output: 2
    std::print(offset(false) == null);      // output: true
    std::print(v == Vec(15, 4));            // output: true
    std::print(v == none);                  // output: false

    // Fields of nullable type default to null.
    mut var body = new Body();
    std::print(body.rate == null);      // output: true
    body.rate = Vec(1, 1);
    std::print(body.rate?.sum());       // output: 2

    // Assigning null destroys the value inside, releasing what it holds.
    mut Holder? holder = Holder(new Token("first"), null);
    std::print(holder?.count);              // output: null
    holder = Holder(new Token("second"), 2);    // output: first
    std::print(holder?.token?.name);        // output: second
    std::print(holder?.count);              // output: 2
    holder = null;                          // output: second
    std::print(holder == null);             // output: true

    // A narrowed local that isn't 'mut' is never set to null, so it can be referred into.
    Grid? grid = Grid(cells: [1, 2, 3]);
    if (grid != null) {
        in int first = grid.cells[0];
        in int[3] cells = grid.cells;
        ReadOnlySpan<int> view = grid.cells;
        mut int sum = 0;
        for (int c : grid.cells) {
            sum += c;
        }
        std::print(first + cells[1] + view[2] + sum + total(grid.cells)); // output: 18
    }

    // The value itself, not only a field of it, can be referred into when it can't be reassigned.
    int[3]? numbers = [4, 5, 6];
    if (numbers != null) {
        in int[3] whole = numbers;
        ReadOnlySpan<int> all = numbers;
        std::print(whole[0] + all[2] + total(numbers)); // output: 25
    }

    body.held = Holder(new Token("field"), 1);
    body = new Body();                      // output: field

    // Containers hold nullable values.
    List<int?> list = new List<int?>();
    for (int i : 0..6) {
        list.add(i % 2 == 0 ? i : null);
    }
    mut int total = 0;
    for (int? item : list) {
        total += item ?? 100;
    }
    std::print(total);                      // output: 306
    int?[] slots = new int?[3];
    std::print(slots[1]);                   // output: null
    slots[1] = 5;
    std::print(slots[1]);                   // output: 5

    mut Shape shape = Shape.Point(null);
    if (shape is Point(var at)) {
        std::print(at == null);             // output: true
    }
    shape = Shape.Point(Vec(2, 2));
    if (shape is Point(Vec at)) {
        std::print(at.sum());               // output: 4
    }

    mut Slot slot = Slot.Taken(Holder(new Token("slot"), null));
    mut Slot copy = slot;
    slot = Slot.Free;
    std::print(copy is Taken(Holder held)); // output: true
    copy = Slot.Taken(null);
    std::print(copy is Taken(Holder h2));   // output: false
}
// output: slot
