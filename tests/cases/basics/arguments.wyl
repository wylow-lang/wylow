struct Vec3 {
    float x, y, z;
}

// A declared constructor runs code, which shows when a default value is evaluated.
struct Tag {
    int id;

    Tag(int value) {
        std::print($"tag {value}");
        id = value;
    }
}

enum Color { Red, Green }

enum Shape {
    Circle(float radius),
    Rect(float width, float height);
}

int say(int value) {
    std::print(value);
    return value;
}

String create(Vec3 pos, int count = 1, float spread = 0.5f) {
    return $"{pos.y} x{count} ~{spread}";
}

String constants(int offset = -1, String name = "none", char letter = 'c', bool flag = true, Color color = Color.Green, int mask = 1 << 4) {
    return $"{offset} {name} {letter} {flag} {color == Color.Green} {mask}";
}

String unary(int mask = ~0, bool flag = !true) {
    return $"{mask} {flag}";
}

void tagged(int first, Tag tag = Tag(2), int last = 3) {
    std::print($"{first} {tag.id} {last}");
}

void bump(ref int x, int by = 1) {
    x += by;
}

float height(in Vec3 at = Vec3(0, 1, 0)) {
    return at.y;
}

String pick(int a) { return "one"; }
String pick(int a, int b = 0) { return "two"; }

T? orFallback<T>(T? value, T? fallback = null) {
    return value ?? fallback;
}

class Box<T> {
    mut T? item;

    void put(T? item = null, int times = 1) {
        this.item = item;
        std::print($"put {times}");
    }
}

class Product {
    String name;
    int amount;

    Product(String name, int amount = 10) {
        this.name = name;
        this.amount = amount;
    }
}

class Sword extends Product {
    Sword(int amount = 25) { super(name: "sword", amount: amount); }
}

class Animal {
    virtual String speak(int times = 1, String sound = "...") { return $"{times} {sound}"; }
}

class Dog extends Animal {
    override String speak(int times, String sound) { return $"woof {times} {sound}"; }
}

interface Greeter {
    mut String greet(String name = "you");
}

class Friendly implements Greeter {
    String greet(String name) { return $"hi {name}"; }
}

void main() {
    var pos = Vec3(0, 2, 0);
    // Parameters left out take their defaults; named arguments skip over them.
    std::print(create(pos));                             // output: 2.0 x1 ~0.5
    std::print(create(pos, 5));                          // output: 2.0 x5 ~0.5
    std::print(create(pos, spread: 2.0f));                // output: 2.0 x1 ~2.0
    std::print(create(pos, count: 3, spread: 1.5f));      // output: 2.0 x3 ~1.5
    std::print(create(pos: pos, count: 4));              // output: 2.0 x4 ~0.5
    std::print(constants());                            // output: -1 none c true true 16
    std::print(unary());                                // output: -1 false
    std::print(constants(name: "set", color: Color.Red)); // output: -1 set c true false 16

    // Each parameter's value is evaluated in parameter order: its argument, or its default.
    tagged(say(1));
    // output: 1
    // output: tag 2
    // output: 1 2 3
    tagged(say(1), last: say(4));
    // output: 1
    // output: tag 2
    // output: 4
    // output: 1 2 4

    mut int n = 1;
    bump(ref n);
    bump(x: ref n, by: 5);
    std::print(n);                                      // output: 7
    std::print(height());                               // output: 1.0

    // An overload that leaves fewer parameters to their defaults is preferred.
    std::print(pick(1));                                // output: one
    std::print(pick(1, 2));                             // output: two
    std::print(pick(a: 1, b: 2));                       // output: two

    // In generic code, a default of a type involving a type parameter is null.
    std::print(orFallback<int>(null));                  // output: null
    std::print(orFallback<int>(null, 3));               // output: 3
    var box = new Box<String>();
    box.put();                                          // output: put 1
    std::print(box.item);                               // output: null
    box.put("gem", times: 2);                           // output: put 2
    std::print(box.item);                               // output: gem

    // Constructors take them too, including through super(...).
    var club = new Product("club");
    std::print($"{club.name} {club.amount}");           // output: club 10
    var axe = new Product(name: "axe", amount: 15);
    std::print($"{axe.name} {axe.amount}");             // output: axe 15
    var sword = new Sword();
    std::print($"{sword.name} {sword.amount}");         // output: sword 25

    // Overrides and implementations take the defaults of what they override.
    Animal pet = new Dog();
    std::print(pet.speak());                            // output: woof 1 ...
    std::print(new Dog().speak(sound: "arf"));          // output: woof 1 arf
    Greeter greeter = new Friendly();
    std::print(greeter.greet());                        // output: hi you
    std::print(new Friendly().greet());                 // output: hi you

    // Variants take their fields by name.
    var shape = Shape.Rect(width: 2, height: 3);
    if (shape is Rect(var w, var h)) {
        std::print(w * h);                              // output: 6.0
    }
}
