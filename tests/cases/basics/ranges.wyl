int next(int value) {
    std::print(value);
    return value;
}

void main() {
    mut int total = 0;
    for (int i : 0..5) {
        total += i;
    }
    std::print(total);      // output: 10

    for (var i : 3..=5) {
        std::print(i);
    }
    // output: 3
    // output: 4
    // output: 5

    for (int i : 5..2) {
        std::print(i);
    }
    for (int i : 2..=1) {
        std::print(i);
    }

    // The bounds are evaluated once, start first.
    for (int i : next(1)..next(3)) {
        if (i == 1) {
            continue;
        }
        std::print(i * 100);
    }
    // output: 1
    // output: 3
    // output: 200

    // An inclusive range up to the largest value ends without overflowing.
    mut int count = 0;
    for (int i : 2147483646..=2147483647) {
        count++;
    }
    std::print(count);      // output: 2

    for (long big : 0L..3) {
        std::print(big);
    }
    // output: 0
    // output: 1
    // output: 2

    for (int i : 0..10) {
        if (i == 2) {
            break;
        }
        std::print(i);
    }
    // output: 0
    // output: 1
}
