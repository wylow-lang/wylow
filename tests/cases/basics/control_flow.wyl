int sign(int n) {
    if (n < 0) {
        return -1;
    } else if (n == 0) {
        return 0;
    } else {
        return 1;
    }
}

void main() {
    std::print(sign(-5)); // output: -1
    std::print(sign(0)); // output: 0
    std::print(sign(9)); // output: 1

    mut int sum = 0;
    mut int i = 0;
    while (true) {
        i++;
        if (i > 10) {
            break;
        }
        if (i % 2 == 0) {
            continue;
        }
        sum += i;
    }
    std::print(sum); // output: 25

    for (mut int j = 0; j < 3; j++) {
        std::print(j > 0 ? j * 10 : -1);
    }
    // output: -1
    // output: 10
    // output: 20

    bool a = true;
    bool b = false;
    std::print(a && !b); // output: true
    std::print(a || b); // output: true
    std::print(!(a == b)); // output: true

    // A constant condition is not evaluated.
    if (true) {
        std::print("then"); // output: then
    }
    while (false) {
        std::print("never");
    }

    // A statement after one that never returns does nothing.
    std::print(early(true)); // output: early
    std::print(early(false)); // output: late
    std::print(switchPick(0)); // output: zero

    // A switch whose only case is 'default' still evaluates its value once.
    std::print(switch (7) { default -> 7; }); // output: 7

    // A pattern can be a literal of another integer type, and `var` matches anything.
    byte small = 1;
    switch (small) {
        case 1 -> {
            std::print("one"); // output: one
        }
        default -> {
            std::print("other");
        }
    }
    mut int picked = 0;
    switch (small) {
        case var any -> {
            picked = any;
        }
    }
    std::print(picked);     // output: 1
}

String switchPick(int n) {
    switch (n) {
        default -> {
            return "zero";
            std::print("never");
        }
    }
}

String early(bool stop) {
    if (stop) {
        return "early";
        std::print("never");
    }
    while (true) {
        break;
        std::print("never");
    }
    return "late";
}
