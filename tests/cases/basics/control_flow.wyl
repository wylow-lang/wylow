import std::print;

int sign(int n) {
    if (n < 0) {
        return -1;
    } else if (n == 0) {
        return 0;
    } else {
        return 1;
    }
}

void main() {
    print(sign(-5)); // output: -1
    print(sign(0));  // output: 0
    print(sign(9));  // output: 1

    mut int sum = 0;
    mut int i = 0;
    while (true) {
        i++;
        if (i > 10) {
            break;
        }
        if (i % 2 == 0) {
            continue;
        }
        sum += i;
    }
    print(sum); // output: 25

    for (mut int j = 0; j < 3; j++) {
        print(j > 0 ? j * 10 : -1);
    }
    // output: -1
    // output: 10
    // output: 20

    bool a = true;
    bool b = false;
    print(a && !b);     // output: true
    print(a || b);      // output: true
    print(!(a == b));   // output: true

    // A constant condition is not evaluated.
    if (true) {
        print("then");  // output: then
    }
    while (false) {
        print("never");
    }

    // A statement after one that never returns does nothing.
    print(early(true));     // output: early
    print(early(false));    // output: late
    print(switchPick(0));   // output: zero

    // A switch whose only case is 'default' still evaluates its value once.
    print(switch (7) { default -> 7; });    // output: 7

    // A pattern can be a literal of another integer type, and `var` matches anything.
    byte small = 1;
    switch (small) {
        case 1 -> {
            print("one");   // output: one
        }
        default -> {
            print("other");
        }
    }
    mut int picked = 0;
    switch (small) {
        case var any -> {
            picked = any;
        }
    }
    print(picked);          // output: 1
}

String switchPick(int n) {
    switch (n) {
        default -> {
            return "zero";
            print("never");
        }
    }
}

String early(bool stop) {
    if (stop) {
        return "early";
        print("never");
    }
    while (true) {
        break;
        print("never");
    }
    return "late";
}
