void show(int x) {
    print("int");
}

void show(long x) {
    print("long");
}

void show(float x) {
    print("float");
}

void show(double x) {
    print("double");
}

// Overloads that differ only in trailing defaults are equally specific; the one with fewer defaults wins.
void pick(long a, int b = 0) {
    print($"two {a} {b}");
}

void pick(long a, int b = 0, int c = 0) {
    print($"three {a} {b} {c}");
}

void main() {
    show(1);    // output: int
    show(1L);   // output: long
    show(1.5);  // output: float
    show(1.5d); // output: double
    int i = 3;
    show(i);    // output: int
    short narrow = 1;
    pick(narrow);   // output: two 1 0
}
