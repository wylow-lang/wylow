String describe(char c) {
    return switch (c) {
        case 'a' -> "first";
        case '\n' -> "newline";
        case '\u{1F600}' -> "grin";
        default -> "other";
    };
}

void main() {
    char a = 'a';
    std::print(a);                  // output: a
    std::print('\'');               // output: '
    std::print('\\');               // output: \
    std::print('\u{41}');           // output: A
    std::print('\u{e9}' == 'é');    // output: true
    std::print('😀' == '\u{1F600}'); // output: true

    // Characters compare by code point, and convert to integers of 32 bits or more.
    std::print(1 + 'a');            // output: 98
    std::print('a' < 'b');          // output: true
    std::print('z' >= 'a');         // output: true
    int code = 'a';
    std::print(code);               // output: 97
    long wide = '\u{10FFFF}';
    std::print(wide);               // output: 1114111
    std::print((byte)'a');          // output: 97
    char next = (char)('a' + 1);
    std::print(next);               // output: b

    std::print(describe('a'));      // output: first
    std::print(describe('\n'));     // output: newline
    std::print(describe('😀'));     // output: grin
    std::print(describe('x'));      // output: other

    char? none = null;
    std::print(none ?? '-');        // output: -
    char[3] letters = ['x', 'y', 'z'];
    std::print(letters[2]);         // output: z

    std::print("tab\there");        // output: tab	here
    std::print("\u{48}i \u{1F600}"); // output: Hi 😀
    std::print("caf\u{e9}");        // output: café
}
