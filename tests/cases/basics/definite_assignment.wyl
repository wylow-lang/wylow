import std::print;

void main() {
    bool flag = true;
    int x;
    if (flag) {
        x = 1;
    } else {
        x = 2;
    }
    print(x); // output: 1

    mut int y;
    while (true) {
        y = 5;
        break;
    }
    print(y); // output: 5

    mut var z = 3L;
    z *= 2;
    print(z); // output: 6
}
