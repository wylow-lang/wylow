// A choice between a value and a constant folds to && or || only for the constant it drops: false
// on the false side and true on the true side.

bool no() {
    return false;
}

bool yes() {
    return true;
}

void main() {
    std::print(no() ? no() : true); // output: true
    std::print(yes() ? false : no()); // output: false
    std::print(yes() ? no() : true); // output: false
    std::print(no() ? yes() : false); // output: false
    std::print(yes() ? yes() : false); // output: true
}
