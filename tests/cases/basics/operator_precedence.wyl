// Each line tells one level of expressions.precedence from the next: grouped the other way, it
// prints something else or doesn't type-check.

class Animal { }
class Dog extends Animal { }

void main() {
    std::print(1 + 2 * 3);                  // output: 7
    std::print(7 - 2 - 1);                  // output: 4
    std::print(1 << 1 + 1);                 // output: 4
    std::print(1 << 2 < 5);                 // output: true
    std::print(1 < 2 == 2 > 1);             // output: true
    std::print(true & 1 == 1);              // output: true
    std::print(6 | 1 ^ 3 & 2);              // output: 7
    std::print(1 ^ 1 | 1);                  // output: 1
    std::print(true || false && false);     // output: true

    Animal a = new Dog();
    std::print(a is Dog == true);           // output: true

    bool? b = false;
    std::print(b ?? false || true);         // output: false
    int? none = null;

    std::print(false ? 1 : true ? 2 : 3);   // output: 2
    std::print(1 + 1 == 2 ? 5 : 6);         // output: 5
    std::print(none == null ? 1 : 2);       // output: 1

    std::print(-2 * 3);                     // output: -6
    std::print((int)1.5 + 1);               // output: 2
    std::print(!false && false);            // output: false
}
