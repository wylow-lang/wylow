// Each line tells one level of expressions.precedence from the next: grouped the other way, it
// prints something else or doesn't type-check.

import std::print;

class Animal { }
class Dog extends Animal { }

void main() {
    print(1 + 2 * 3);                       // output: 7
    print(7 - 2 - 1);                       // output: 4
    print(1 << 1 + 1);                      // output: 4
    print(1 << 2 < 5);                      // output: true
    print(1 < 2 == 2 > 1);                  // output: true
    print(true & 1 == 1);                   // output: true
    print(6 | 1 ^ 3 & 2);                   // output: 7
    print(1 ^ 1 | 1);                       // output: 1
    print(true || false && false);          // output: true

    Animal a = new Dog();
    print(a is Dog == true);                // output: true

    bool? b = false;
    print(b ?? false || true);              // output: false
    int? none = null;

    print(false ? 1 : true ? 2 : 3);        // output: 2
    print(1 + 1 == 2 ? 5 : 6);              // output: 5
    print(none == null ? 1 : 2);            // output: 1

    print(-2 * 3);                          // output: -6
    print((int)1.5 + 1);                    // output: 2
    print(!false && false);                 // output: false
}
