// `loop` repeats until a jump ends it, and code after a loop with no `break` is unreachable.

import std::print;

int firstAbove(int limit) {
    mut int i = 0;
    loop {
        i++;
        if (i == 2) {
            continue;
        }
        print(i);
        if (i > limit) {
            return i;
        }
    }
}

void main() {
    mut int n = 0;
    loop {
        n++;
        if (n == 3) {
            break;
        }
    }
    print(n);                           // output: 3
    print(firstAbove(2));
    // output: 1
    // output: 3
    // output: 3
    int do = 4;                         // an ordinary name
    print(do);                          // output: 4
}
