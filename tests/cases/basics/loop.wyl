// `loop` repeats until a jump ends it, and code after a loop with no `break` is unreachable.

int firstAbove(int limit) {
    mut int i = 0;
    loop {
        i++;
        if (i == 2) {
            continue;
        }
        std::print(i);
        if (i > limit) {
            return i;
        }
    }
}

void main() {
    mut int n = 0;
    loop {
        n++;
        if (n == 3) {
            break;
        }
    }
    std::print(n);                      // output: 3
    std::print(firstAbove(2));
    // output: 1
    // output: 3
    // output: 3
    int do = 4;                         // an ordinary name
    std::print(do);                     // output: 4
}
