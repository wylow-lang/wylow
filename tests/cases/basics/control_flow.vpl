int sign(int n) {
    if (n < 0) {
        return -1;
    } else if (n == 0) {
        return 0;
    } else {
        return 1;
    }
}

void main() {
    print(sign(-5)); // output: -1
    print(sign(0));  // output: 0
    print(sign(9));  // output: 1

    mut int sum = 0;
    mut int i = 0;
    while (true) {
        i++;
        if (i > 10) {
            break;
        }
        if (i % 2 == 0) {
            continue;
        }
        sum += i;
    }
    print(sum); // output: 25

    for (mut int j = 0; j < 3; j++) {
        print(j > 0 ? j * 10 : -1);
    }
    // output: -1
    // output: 10
    // output: 20

    bool a = true;
    bool b = false;
    print(a && !b);     // output: true
    print(a || b);      // output: true
    print(!(a == b));   // output: true
}
