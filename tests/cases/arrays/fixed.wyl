struct Vec2 {
    float x;
    float y = 1;
}

struct Grid {
    int[3][2] cells;
    Vec2[2] points;
}

class Mesh {
    mut float[4] weights;
}

int sum(int[4] values) {
    mut int total = 0;
    for (int v : values) {
        total += v;
    }
    return total;
}

void fill(ref int[4] values, int value) {
    for (ref int v : values) {
        v = value;
    }
}

int[3] makeArray() {
    return [7, 8, 9];
}

void main() {
    mut int[4] a = [1, 2, 3, 4];
    std::print(a.length);       // output: 4
    std::print(makeArray().length); // output: 3
    std::print(a[0] + a[3]);    // output: 5
    a[1] = 20;
    a[2] += 10;
    std::print(sum(a));         // output: 38

    // A compound assignment reads its element once, though the index is computed.
    mut int[3] counted = [1, 2, 3];
    mut int at = 1;
    counted[at] += 4;
    std::print(counted[1]);     // output: 6

    // Arrays are values: assignment and passing copy them.
    mut int[4] b = a;
    b[0] = 100;
    std::print(a[0]);           // output: 1
    fill(ref b, 5);
    std::print(sum(b));         // output: 20
    std::print(a == b);         // output: false
    b = a;
    std::print(a == b);         // output: true

    // Without an initializer, a fixed array holds default values.
    Vec2[3] points;
    std::print(points[2].y);    // output: 1.0
    mut Grid grid = Grid();
    std::print(grid.points[1].y); // output: 1.0
    grid.cells[2][1] = 6;
    std::print(grid.cells[2][1]); // output: 6
    std::print(grid.cells.length); // output: 3
    std::print(grid.cells[0].length); // output: 2

    for (int i, int v : makeArray()) {
        std::print(i * 10 + v);
    }
    // output: 7
    // output: 18
    // output: 29

    var mesh = new Mesh();
    mesh.weights[3] = 0.5f;
    for (in float w : mesh.weights) {
        std::print(w);
    }
    // output: 0.0
    // output: 0.0
    // output: 0.0
    // output: 0.5

    ref int first = a[0];
    first = 42;
    std::print(a[0]);           // output: 42
    ref Vec2 corner = grid.points[0];
    corner.x = 3;
    std::print(grid.points[0].x); // output: 3.0
    in int[4] view = a;
    std::print(view[0]);        // output: 42

    String[2] names = ["ada", "grace"];
    std::print(names[1]);       // output: grace
}
