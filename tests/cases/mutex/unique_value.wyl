// A unique value moves into a mutex and out of it again, and its destructor runs on the thread that
// releases it.

import std::threading;
import std::threading::Mutex;

unique struct Buffer {
    pub int length;

    pub Buffer(int length) {
        this.length = length;
    }

    ~Buffer() {
        std::print($"buffer {length}");
    }
}

void main() {
    var slot = new Mutex<Buffer?>(Buffer(7));
    var worker = threading::spawn(() -> {
        Buffer? taken = slot.lock(b -> std::take(ref b));
        std::print($"child took {taken!.length}");
    });
    worker.join();
    // output: child took 7
    // output: buffer 7
    std::print(slot.lock(b -> b == null));
    // output: true
    var kept = new Mutex<Buffer>(Buffer(3));
    std::print("parent done");
    // output: parent done
    // output: buffer 3
}

// tsan
