// A sendable value converts to the box a mutex holds, and lock changes it in place and returns a
// sendable result.

import std::threading::Mutex;

void main() {
    var counter = new Mutex<int>(5);
    counter.lock(n -> {
        n = n + 2;
    });
    std::print(counter.lock(n -> n));
    // output: 7
    var name = new Mutex<String?>(null);
    name.lock(s -> {
        s = "alpha";
    });
    std::print(name.lock(s -> s ?? "none"));
    // output: alpha
}
