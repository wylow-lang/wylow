// While a thread holds a mutex's lock, the graph's cycle buffer is the thread's, so a collection
// inside lock frees the graph's cycles and leaves the thread's own cycles alone.

import std::threading::{Isolated, Mutex};
import std::{memory, print, Unit};

class Node {
    pub int value;
    mut Node? next;

    pub Node(int value) {
        this.value = value;
    }

    ~Node() { print($"node {value}"); }
}

class Graph {
    pub Unit makeCycle() {
        var first = new Node(1);
        var second = new Node(2);
        first.next = second;
        second.next = first;
    }
}

Unit threadCycle() {
    var first = new Node(3);
    var second = new Node(4);
    first.next = second;
    second.next = first;
}

void main() {
    threadCycle();
    var graph = new Mutex<Graph>(Isolated<Graph>(() -> new Graph()));
    graph.lock(g -> g.makeCycle());
    print("graph cycle made");
    // output: graph cycle made
    graph.lock(g -> memory::collectCycles());
    print("graph collected");
    // output: node 1
    // output: node 2
    // output: graph collected
    memory::collectCycles();
    print("thread collected");
    // output: node 3
    // output: node 4
    // output: thread collected
}
