// main(String[] args) receives the program's arguments, without its name, as UTF-8
// (spec programs.entry), and an int main's value is the exit status (spec programs.execution).
// args: alpha beta café
// exit: 3

int main(String[] args) {
    std::print(args[0]);                    // output: alpha
    std::print(args[2]);                    // output: café
    std::print(args[2].byteLength());       // output: 5
    return args.length;
}
