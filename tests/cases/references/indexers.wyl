struct Mat2 {
    float[4] m;

    mut ref float operator [](int row, int col) {
        return ref m[row * 2 + col];
    }

    in float at(int i) {
        return ref m[i];
    }

    float trace() {
        return m[0] + m[3];
    }
}

struct Holder {
    Mat2 mat;

    mut ref Mat2 inner() {
        return ref mat;
    }
}

class Bag {
    mut int[3] items;
    mut int used;

    int count() {
        return used;
    }

    bool isEmpty() {
        return used == 0;
    }

    ref int operator [](int i) {
        return ref items[i];
    }

    int total() {
        mut int sum = 0;
        for (int i : 0..count()) {
            sum += this[i];
        }
        return sum;
    }
}

int order(int value) {
    std::print(value);
    return value;
}

void main() {
    mut Mat2 m = Mat2();
    m[0, 0] = 1;
    m[1, 1] = 4;
    m[0, 1] += 2;
    std::print(m.trace());        // output: 5.0
    std::print(m.at(1));        // output: 2.0
    ref float corner = m[1, 0];
    corner = 7;
    std::print(m.m[2]);         // output: 7.0

    var bag = new Bag();
    std::print(bag.isEmpty());    // output: true
    bag[0] = 10;
    bag[1] = 20;
    bag.used = 2;
    std::print(bag.count());      // output: 2
    std::print(bag.isEmpty());    // output: false
    ref int slot = bag[1];
    slot += 5;
    std::print(bag.items[1]);   // output: 25
    // A reference defined by another refers to the place that one refers to.
    ref int alias = slot;
    alias += 1;
    std::print(bag.items[1]);   // output: 26
    std::print(bag.total());    // output: 36

    mut Holder h = Holder();
    h.inner()[0, 1] = 9;
    std::print(h.mat.m[1]);     // output: 9.0

    // The element is found before the value is evaluated, and its index is evaluated once.
    bag[order(2)] = order(3);
    // output: 2
    // output: 3
    std::print(bag.items[2]);   // output: 3
    bag[order(0)] += order(1);
    // output: 0
    // output: 1
    std::print(bag.items[0]);   // output: 11
}
