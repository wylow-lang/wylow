// A ref struct method may return what a chain of calls on 'this' returns: each call's result views
// only its receiver, so the chain views only 'this'. A ref struct made from such a chain views what
// the chain does.

ref struct Window {
    pub int n;

    pub Window(int n) {
        this.n = n;
    }

    pub Window(Window from) {
        this.n = from.n + 1;
    }

    pub Window self() {
        return this;
    }

    pub Window twice() {
        return this.self().self();
    }

    pub Window wrapped() {
        return Window(this.self());
    }
}

void main() {
    Window w = Window(4);
    std::print(w.twice().n); // output: 4
    std::print(w.wrapped().n); // output: 5
}
