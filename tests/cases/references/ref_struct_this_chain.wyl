// A ref struct method may return what a chain of calls on 'this' returns: each call's result views
// only its receiver, so the chain views only 'this'. A ref struct made from such a chain views what
// the chain does.

ref struct Window {
    public {
        int n;

        Window(int n) {
            this.n = n;
        }

        Window(Window from) {
            this.n = from.n + 1;
        }

        Window self() {
            return this;
        }

        Window twice() {
            return this.self().self();
        }

        Window wrapped() {
            return Window(this.self());
        }
    }
}

void main() {
    Window w = Window(4);
    print(w.twice().n);     // output: 4
    print(w.wrapped().n);   // output: 5
}
