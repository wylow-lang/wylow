import std::List;

struct Pair {
    int[2] items;

    mut ref? int at(int i) {
        if (i < 0 || i >= 2) {
            return null;
        }
        return ref items[i];
    }

    in? int peek(int i) {
        if (i < 0 || i >= 2) {
            return null;
        }
        return ref items[i];
    }
}

class Bag {
    String name;
    mut int[3] items;

    Bag(String name) {
        this.name = name;
    }

    ref? int get(int i) {
        if (i >= 3) {
            return null;
        }
        return ref items[i];
    }

    ~Bag() {
        std::print(name);
    }
}

void main() {
    mut Pair p = Pair();
    if (p.at(0) is ref int first) {
        first = 3;
    }
    std::print(p.items[0]);         // output: 3
    if (p.at(5) is ref int missing) {
        std::print(missing);
    } else {
        std::print("none");         // output: none
    }
    if (p.peek(0) is in int seen) {
        std::print(seen);           // output: 3
    }
    if (p.at(1) is ref var inferred) {
        inferred += 4;
    }
    std::print(p.items[1]);         // output: 4
    ref? int r = p.at(1);
    if (r is in int viewed) {
        std::print(viewed + r);     // output: 8
    }

    // The object a name points into is held while the name is in scope.
    mut var bag = new Bag("first");
    if (bag.get(2) is ref int slot) {
        bag = new Bag("second");
        slot = 9;
        std::print(slot);           // output: 9
    }                               // output: first
    // A failed test lets go of the object at once.
    if (bag.get(5) is ref int outside) {
        std::print(outside);
    } else {
        bag = new Bag("third");     // output: second
        std::print("replaced");     // output: replaced
    }

    mut int i = 0;
    while (p.at(i) is ref int each) {
        each *= 10;
        i++;
    }
    std::print(p.items[0]);         // output: 30
    std::print(p.items[1]);         // output: 40

    // Each test borrows the list again, and the last, failing one lets go of it.
    var list = new List<int>();
    list.add(1);
    list.add(2);
    mut int j = 0;
    while (list.get(j) is ref int element) {
        element += 100;
        j++;
    }
    list.add(3);
    std::print(list[1]);            // output: 102
    std::print(list.count());       // output: 3
    if (p.at(0) is ref int a && p.at(1) is ref int b) {
        std::print(a + b);          // output: 70
    }
    int n = switch (i) {
        case 2 -> p.at(0) is ref int z ? z : 0;
        default -> 0;
    };
    std::print(n);                  // output: 30
}                                   // output: third
