// Only objects of classes that may be cyclic are buffered when a release leaves their count above
// zero, and only on the heap. Each `onHeap` and `drop` below makes one such release.

import std::{List, Weak, memory, print};

class Leaf {
    int value;
}

// Holds references, but none that can lead back to a Holder.
class Holder {
    Leaf leaf = new Leaf();
    List<int> numbers = new List<int>();
    List<Leaf> leaves = new List<Leaf>();
    Weak<Holder> self;
}

class Node {
    Node? next;
}

// Cyclic through a struct, an enum, a fixed array, and a list.
struct Link {
    Linked? target;
}

enum Slot {
    Empty,
    Full(Slotted item),
}

class Linked {
    Link link;
}

class Slotted {
    Slot[2] slots;
}

// Holds Linked objects, but can't reach another Holds.
class Holds {
    Link link;
}

class Listed {
    List<Listed> others = new List<Listed>();
}

// Cyclic through a subclass: an Animal field may hold a Pet, which holds an Animal.
class Animal {
}

class Pet extends Animal {
    Animal? friend;
}

// Cyclic through an interface's implementation.
interface Shape {
}

class Group implements Shape {
    Shape? first;
}

// Decided per instantiation: Wrapper<Owner> is cyclic, Wrapper<int> is not.
class Wrapper<T> {
    T value;

    Wrapper(T value) {
        this.value = value;
    }
}

class Owner {
    Wrapper<Owner>? wrapper;
}

@Acyclic
class Declared {
    Declared? next;
}

void drop<T>(T value) {
}

// Returning an object keeps it on the heap.
T onHeap<T>(T value) {
    return value;
}

void report(String name) {
    var stats = memory::cycleStats();
    print(name);
    print(stats.buffered);
}

void main() {
    var holder = onHeap(new Holder());
    drop(holder);
    drop(holder.leaf);
    drop(holder.numbers);
    drop(holder.leaves);
    report("acyclic");                  // output: acyclic
    // output: 0

    var node = onHeap(new Node());
    drop(node);
    drop(node);
    report("buffered once");            // output: buffered once
    // output: 1

    var linked = onHeap(new Linked());
    var slotted = onHeap(new Slotted());
    var listed = onHeap(new Listed());
    drop(linked);
    drop(slotted);
    drop(listed);
    drop(listed.others);
    var holds = onHeap(new Holds());
    drop(holds);
    report("through values and lists"); // output: through values and lists
    // output: 4

    var pet = onHeap(new Pet());
    var animal = onHeap(new Animal());
    var group = onHeap(new Group());
    drop(pet);
    drop(animal);
    drop(group);
    report("through subtypes");         // output: through subtypes
    // output: 2

    var owned = onHeap(new Wrapper<Owner>(new Owner()));
    var number = onHeap(new Wrapper<int>(1));
    // Collecting empties the buffer, which onHeap added to, so that only the drops count.
    memory::collectCycles();
    _ = memory::cycleStats();
    drop(owned);
    drop(number);
    report("generic");                  // output: generic
    // output: 1

    var declared = onHeap(new Declared());
    drop(declared);
    report("declared acyclic");         // output: declared acyclic
    // output: 0

    // A collection leaves nothing buffered, so the object is buffered again.
    memory::collectCycles();
    drop(node);
    report("after collecting");         // output: after collecting
    // output: 1
}
