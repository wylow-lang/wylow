// A closure keeps what it captures alive, so it can be part of a cycle, which the collector frees.

import std::memory; import std::collections::List;

class Account {
    int id;
    mut fn() -> void onEvent = () -> std::print(0);

    Account(int id) {
        this.id = id;
    }

    void arm() {
        onEvent = () -> react(this);
    }

    ~Account() {
        std::print(id);
    }
}

void react(Account account) {
    std::print(account.id * 10);
}

class Bus {
    List<fn() -> void> handlers = new List<fn() -> void>();

    ~Bus() {
        std::print(-1);
    }
}

class Listener {
    int id;
    Bus bus;

    Listener(int id, Bus bus) {
        this.id = id;
        this.bus = bus;
        // Through a captured local rather than `this`: bus -> closure -> listener -> bus.
        var self = this;
        bus.handlers.add(() -> std::print(self.id));
    }

    ~Listener() {
        std::print(id * 100);
    }
}

class Box {
    mut (fn(int) -> int)? f = null;

    ~Box() {
        std::print(-2);
    }
}

void main() {
    // A closure capturing `this`, stored in a field of the same object.
    if (true) {
        var account = new Account(1);
        account.arm();
        account.onEvent();                              // output: 10
    }
    std::print(-9);                                 // output: -9
    memory::collectCycles();                         // output: 1

    // A cycle through a list of closures.
    if (true) {
        var bus = new Bus();
        _ = new Listener(2, bus);
        _ = new Listener(3, bus);
        for (fn() -> void h : bus.handlers) {
            h();                                    // output: 2
                                                    // output: 3
        }
    }
    memory::collectCycles();                         // output: -1
                                                    // output: 200
                                                    // output: 300

    // A closure capturing its holder through a nullable field.
    if (true) {
        var box = new Box();
        var held = box;
        box.f = x -> x + (held.f != null ? 1 : 0);
        std::print(box.f!(1));                      // output: 2
    }
    memory::collectCycles();                         // output: -2

    // Breaking the cycle by hand frees it without the collector.
    mut var account = new Account(4);
    account.arm();
    account.onEvent = () -> std::print(5);
    std::print(-9);                                 // output: -9
    account = new Account(6);                           // output: 4

    _ = memory::cycleStats();
    memory::collectCycles();
    std::print(memory::cycleStats().freed);          // output: 0
}
// output: 6
