// A function value can only hold the closure of a lambda of its type, so a class holding functions
// is cyclic only if a lambda of that type captures something that can lead back to it. Each `drop`
// below makes one release that leaves the count above zero.

import std::{List, memory};

class Leaf {
    int value;
}

// Every `fn() -> int` lambda captures only values or a Leaf.
class Button {
    fn() -> int onClick;
    List<fn() -> int> extra = new List<fn() -> int>();

    Button(escaping fn() -> int onClick) {
        this.onClick = onClick;
    }
}

// A `fn() -> bool` lambda captures a Widget, so Widgets and those closures are cyclic.
class Widget {
    bool ready;
    mut (fn() -> bool)? check = null;

    void arm() {
        check = () -> ready;
    }
}

// A lambda in generic code may capture anything, and be of any `fn(int) -> T` type.
class Cell {
    fn(int) -> long get;

    Cell(escaping fn(int) -> long get) {
        this.get = get;
    }
}

fn(int) -> T constant<T extends copyable>(T value) {
    return x -> value;
}

void drop<T>(T value) {
}

// Returning an object keeps it on the heap; an object that can be on the stack is never buffered.
T onHeap<T>(T value) {
    return value;
}

void report(String name) {
    var stats = memory::cycleStats();
    std::print(name);
    std::print(stats.buffered);
}

void main() {
    int base = 3;
    var leaf = onHeap(new Leaf());
    var button = onHeap(new Button(() -> base + 1));
    button.extra.add(() -> leaf.value);
    button.extra.add(() -> 7);
    escaping fn() -> int read = () -> leaf.value;
    drop(button);
    drop(button.onClick);
    drop(read);
    report("acyclic closures");         // output: acyclic closures
    // output: 0

    var widget = onHeap(new Widget());
    widget.arm();
    drop(widget);
    drop(widget.check);
    report("cyclic closure");           // output: cyclic closure
    // output: 2

    // The closure is released once too, after the constructor copies it.
    var cell = onHeap(new Cell(constant(5L)));
    drop(cell);
    report("generic lambda");           // output: generic lambda
    // output: 2

    std::print(button.onClick() + button.extra[0]() + button.extra[1]() + read() + cell.get(0)); // output: 16
    widget.check = null;
}
