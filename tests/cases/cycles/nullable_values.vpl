// A cycle through a nullable struct is found only when the value is there, and a class holding
// only nullable numbers is never buffered.

class Room {
    int number;
    mut Door? door;

    Room(int number) {
        this.number = number;
    }

    ~Room() {
        print(number);
    }
}

struct Door {
    Room to;
    int? lock;

    Door(Room to) {
        this.to = to;
    }
}

class Counter {
    int? best;
    List<int?> history = new List<int?>();
}

void main() {
    mut var a = new Room(1);
    mut var b = new Room(2);
    a.door = Door(b);
    b.door = Door(a);
    a = new Room(3);
    b = a;
    print(0);                           // output: 0
    Memory.collectCycles();
    // output: 1
    // output: 2
    print(Memory.cycleStats().freed);   // output: 2

    mut var c = new Counter();
    c.history.add(1);
    mut var d = c;
    d = new Counter();
    c = d;
    print(Memory.cycleStats().buffered);    // output: 0
}
// output: 3
