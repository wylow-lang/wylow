// Without a call to Memory.collectCycles, a cycle is never freed, not even at exit, while
// everything else is still freed as soon as nothing refers to it.

import std::print;

class Node {
    int id;
    mut Node? next;
    mut ((int) -> int)? onVisit = null;

    Node(int id) {
        this.id = id;
    }

    ~Node() {
        print(id);
    }
}

void main() {
    for (int i : 0..1000) {
        var a = new Node(-1);
        var b = new Node(-2);
        a.next = b;
        b.next = a;
    }
    // A closure capturing its holder.
    var watched = new Node(-3);
    watched.onVisit = x -> x + watched.id;
    mut var chain = new Node(1);
    chain.next = new Node(2);
    chain = new Node(3);
    // output: 1
    // output: 2
}
// output: 3
// warning: at exit, 2002 objects in cycles were never freed: 2001 Node, 1 lambda at never_collected.wyl:29:23.
