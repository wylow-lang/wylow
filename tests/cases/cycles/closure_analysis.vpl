// A function value can only hold the closure of a lambda of its type, so a class holding functions
// is cyclic only if a lambda of that type captures something that can lead back to it. Each `drop`
// below makes one release that leaves the count above zero.

class Leaf {
    int value;
}

// Every `() -> int` lambda captures only values or a Leaf.
class Button {
    () -> int onClick;
    List<() -> int> extra = new List<() -> int>();

    Button(@Escaping () -> int onClick) {
        this.onClick = onClick;
    }
}

// A `() -> bool` lambda captures a Widget, so Widgets and those closures are cyclic.
class Widget {
    bool ready;
    (() -> bool)? check = null;

    void arm() {
        check = () -> ready;
    }
}

// A lambda in generic code may capture anything, and be of any `(int) -> T` type.
class Cell {
    (int) -> long get;

    Cell(@Escaping (int) -> long get) {
        this.get = get;
    }
}

(int) -> T constant<T>(T value) {
    return x -> value;
}

void drop<T>(T value) {
}

// Returning an object keeps it on the heap; an object that can be on the stack is never buffered.
T onHeap<T>(T value) {
    return value;
}

void report(String name) {
    var stats = Memory.cycleStats();
    print(name);
    print(stats.buffered);
}

void main() {
    int base = 3;
    var leaf = onHeap(new Leaf());
    var button = onHeap(new Button(() -> base + 1));
    button.extra.add(() -> leaf.value);
    button.extra.add(() -> 7);
    @Escaping () -> int read = () -> leaf.value;
    drop(button);
    drop(button.onClick);
    drop(read);
    report("acyclic closures");         // output: acyclic closures
    // output: 0

    var widget = onHeap(new Widget());
    widget.arm();
    drop(widget);
    drop(widget.check);
    report("cyclic closure");           // output: cyclic closure
    // output: 2

    // The closure is released once too, after the constructor copies it.
    var cell = onHeap(new Cell(constant(5L)));
    drop(cell);
    report("generic lambda");           // output: generic lambda
    // output: 2

    print(button.onClick() + button.extra[0]() + button.extra[1]() + read() + cell.get(0));  // output: 16
    widget.check = null;
}
