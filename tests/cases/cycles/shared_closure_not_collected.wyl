import std::{Weak, memory};

shared class Node {
    pub int id;
    pub shared fn() -> int read;

    Node(int id) {
        this.id = id;
        this.read = () -> this.id;
    }

    ~Node() {
        std::print($"released {id}");
    }
}

shared class Kept {
    pub int id;

    Kept(int id) {
        this.id = id;
    }

    ~Kept() {
        std::print($"kept {id}");
    }
}

void main() {
    {
        var node = new Node(1);
        std::print(node.read());            // output: 1
    }
    memory::collectCycles();
    var stats = memory::cycleStats();
    std::print(stats.buffered);             // output: 0
    std::print(stats.freed);                // output: 0

    mut var kept = new Kept(2);
    Weak<Kept> weak = kept;
    kept = new Kept(3);
    // output: kept 2
    std::print(weak.get() == null);         // output: true
}
// output: kept 3
