// mode: release
// Release builds report no performance warnings.

import std::{memory, print};

class Node {
    mut Node? next;
}

void main() {
    for (int i : 0..10) {
        var n = new Node();
        n.next = n;
        memory::collectCycles();
    }
    var left = new Node();
    left.next = left;
    print(1);       // output: 1
}
