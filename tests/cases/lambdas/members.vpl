// Lambdas in members use `this` and its fields as the member itself does.
struct Accumulator {
    int total;

    Accumulator(int[3] values) {
        each(values, v -> {
            total += v;
        });
        // `return` in the lambda leaves the lambda, not the constructor.
        call(() -> {
            return;
        });
    }

    void addAll(int[3] values) {
        each(values, v -> {
            total += v;
        });
    }

    readonly int with((int) -> int f) {
        return f(total);
    }
}

class Stack<T> {
    List<T> items;

    Stack() {
        items = new List<T>();
    }

    void push(T item) {
        items.add(item);
    }

    void forEach((T) -> void action) {
        for (T item : items) {
            action(item);
        }
    }

    int count((T) -> bool test) {
        int found = 0;
        forEach(item -> {
            if (test(item)) {
                found++;
            }
        });
        return found;
    }
}

void call(() -> void f) {
    f();
}

void each(int[3] values, (int) -> void action) {
    for (int value : values) {
        action(value);
    }
}

void main() {
    Accumulator accumulator = Accumulator([1, 2, 3]);
    print(accumulator.total);                       // output: 6
    accumulator.addAll([10, 20, 30]);
    print(accumulator.total);                       // output: 66
    print(accumulator.with(t -> t * 2));            // output: 132

    Stack<int> numbers = new Stack<int>();
    numbers.push(1);
    numbers.push(22);
    numbers.push(1);
    numbers.forEach(n -> print(n));                 // output: 1
                                                    // output: 22
                                                    // output: 1
    print(numbers.count(n -> n == 1));              // output: 2
}
