// Constructors, and virtual methods that nothing overrides, take lambdas as templates; constructors
// sharing their parameter count with another, and overridden methods, call them indirectly.

class Box<T> {
    T value;

    Box(T seed, (T) -> T step) {
        value = step(step(seed));
    }
}

struct Point {
    int x, y;

    Point(int seed, (int) -> int f) {
        x = f(seed);
        y = f(x);
    }
}

class Counted {
    int total;

    Counted(int n, (int) -> int f) {
        total = f(n);
    }

    Counted(String name, (String) -> int f) {
        total = f(name) + 1000;
    }
}

class Tool {
    virtual int use((int) -> int f) {
        return f(1);
    }

    // Overridden below, by a subclass of a subclass.
    virtual int aim((int) -> int f) {
        return f(2);
    }
}

class Hammer extends Tool {
}

class Mallet extends Hammer {
    override int aim((int) -> int f) {
        return f(3) * 10;
    }
}

void main() {
    var box = new Box<long>(5L, v -> v * 2L);
    print(box.value);                               // output: 20
    mut int calls = 0;
    var p = Point(1, x -> {
        calls++;
        return x * 3;
    });
    print(p.x);                                     // output: 3
    print(p.y);                                     // output: 9
    print(calls);                                   // output: 2

    print(new Counted(4, n -> n * n).total);        // output: 16
    print(new Counted("ab", s -> 2).total);         // output: 1002

    Tool tool = new Mallet();
    print(tool.use(x -> x + 40));                   // output: 41
    print(tool.aim(x -> x + 40));                   // output: 430
    print(new Hammer().aim(x -> x));                // output: 2
}
