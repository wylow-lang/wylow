// A closure releases what it captured in the order it captured it, when its last reference goes
// (03-memory-model.md, When references are released).

class Noisy {
    String name;
    int id;

    Noisy(String name, int id) {
        this.name = name;
        this.id = id;
    }

    ~Noisy() {
        print(name);
    }
}

() -> int keep() {
    var first = new Noisy("first", 1);
    var second = new Noisy("second", 2);
    return () -> first.id + second.id;
}

void main() {
    {
        var f = keep();
        print(f());                 // output: 3
    }
    print("done");                  // output: first
                                    // output: second
                                    // output: done
}
