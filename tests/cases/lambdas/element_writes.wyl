// A call of a function value may run any lambda of its type, so a loop calling one keeps its own
// reference to each element if such a lambda may store over an element. Each loop below that calls
// one would print the replacing element, or read a freed one, if its element referred to the list
// in place.

import std::collections::List;

class Account {
    int total;

    Account(int total) {
        this.total = total;
    }

    ~Account() {
        std::print(-total);
    }
}

class Hooks {
    fn() -> void onTick;

    Hooks(escaping fn() -> void onTick) {
        this.onTick = onTick;
    }
}

// A lambda of generic type, `fn(T) -> void`, may be any `fn(X) -> void`.
fn(T) -> void storer<T extends copyable>(List<T> list, T value) {
    return x -> {
        list[0] = value;
    };
}

void tick(fn() -> void f) {
    f();
}

// Making a lambda doesn't run it: only a call of a function value of its type can.
Hooks replacer(List<Account> list) {
    return new Hooks(() -> {
        list[0] = new Account(60);
    });
}

void main() {
    var accounts = new List<Account>();
    accounts.add(new Account(1));
    accounts.add(new Account(2));

    var store = storer(accounts, new Account(7));
    for (Account e : accounts) {
        store(e);
        std::print(e.total);
    }
    // output: 1
    // output: -1
    // output: 2

    // An escaping lambda runs through a non-escaping parameter.
    var hooks = new Hooks(() -> {
        accounts[1] = new Account(50);
    });
    for (Account e : accounts) {
        tick(hooks.onTick);
        std::print(e.total);
    }
    // output: -2
    // output: 7
    // output: 50
    // output: -50

    for (Account e : accounts) { // in-place: 1
        var unused = replacer(accounts);
        std::print(e.total);
    }
    // output: 7
    // output: 50
}
// output: -50
// output: -7
