// A closure stays alive while it runs, and while a non-escaping copy of it is in use, even when the
// place it came from is replaced meanwhile. Each closure reads a capture after its place is
// replaced, which AddressSanitizer reports if the closure was freed.

import std::collections::List;

class Holder {
    mut fn() -> void action = () -> std::print(0);
    mut fn(int) -> int f = x -> x;
}

class Visitor {
    int visit(Holder holder, fn(int) -> int f) {
        holder.f = x -> -x;
        return f(1);
    }
}

int viaTemplate(Holder holder, fn(int) -> int f) {
    holder.f = x -> -x;
    return f(1);
}

void main() {
    var holder = new Holder();

    // The closure replaces itself, then still reads its own captures.
    String text = "still here";
    holder.action = () -> {
        holder.action = () -> std::print(1);
        std::print(text);
    };
    holder.action();                                // output: still here
    holder.action();                                // output: 1

    // A conditional's copy of the place keeps the closure alive while it runs, though its body
    // replaces the place it came from.
    holder.action = () -> {
        holder.action = () -> std::print(2);
        std::print(text);
    };
    (true ? holder.action : holder.action)();       // output: still here
    holder.action();                                // output: 2

    // A list cleared during a call of one of its closures.
    var handlers = new List<fn() -> void>();
    String other = "cleared";
    handlers.add(() -> {
        handlers.clear();
        std::print(other);
    });
    handlers[0]();                                  // output: cleared
    std::print(handlers.count());                   // output: 0

    // A non-escaping parameter given a field, which the callee replaces before calling it: a
    // template parameter, and a FunctionRef.
    int offset = 3;
    holder.f = x -> x + offset;
    std::print(viaTemplate(holder, holder.f));      // output: 4
    holder.f = x -> x + offset;
    std::print(new Visitor().visit(holder, holder.f)); // output: 4
    std::print(holder.f(1));                        // output: -1

    // A choice holds what it chose, though the field changes.
    holder.f = x -> x + offset * 2;
    bool flag = offset == 3;
    fn(int) -> int chosen = flag ? holder.f : x -> 0;
    holder.f = x -> -x;
    std::print(chosen(1));                          // output: 7
}
