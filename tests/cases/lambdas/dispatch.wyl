// Functions that can't be C++ templates take their function arguments as wyl::FunctionRef.

interface Visitor {
    void visit(fn(int) -> void action);
}

abstract class Shape {
    abstract int measure(fn(int) -> int scale);

    virtual void describe(fn() -> String name) {
        std::print("shape");
        std::print(name());
    }
}

class Square extends Shape implements Visitor {
    int side;

    Square(int side) {
        this.side = side;
    }

    override int measure(fn(int) -> int scale) {
        return scale(side) * scale(side);
    }

    override void describe(fn() -> String name) {
        std::print("square");
        std::print(name());
    }

    void visit(fn(int) -> void action) {
        action(side);
    }

    // Shares a name with Visitor.visit without implementing it, so it can be a template.
    void visit(fn() -> int size) {
        std::print(size() + side);
    }
}

// Implements Visitor.visit only through Floor, which overrides it in C++ by forwarding here.
class Cell {
    void visit(fn(int) -> void action) {
        action(7);
    }
}

class Floor extends Cell implements Visitor {
}

// A struct implements an interface only as a generic bound, so its method can be a template.
struct Stack implements Visitor {
    int height;

    void visit(fn(int) -> void action) {
        action(height);
    }
}

int deepest<T extends Visitor>(T visited) {
    mut int found = 0;
    visited.visit(n -> {
        found = n;
    });
    return found;
}

class Logger {
    int lines;

    // A constructor takes FunctionRefs, since its C++ name can't tell overloads apart.
    Logger(fn(int) -> int first) {
        lines = first(1);
    }

    Logger(fn(String) -> int first) {
        lines = first("one") + 100;
    }
}

// Recursion: each call could otherwise instantiate a new template for its new lambda.
int countDown(int n, fn(int) -> void each) {
    if (n == 0) {
        return 0;
    }
    each(n);
    return 1 + countDown(n - 1, x -> each(x * 10));
}

int applyTwice(fn(fn(int) -> int) -> int run) {
    return run(x -> x + 1) + run(x -> x + 2);
}

void main() {
    Square square = new Square(3);
    Shape shape = square;
    std::print(shape.measure(x -> x * 2));           // output: 36
    shape.describe(() -> "named");                   // output: square
                                                     // output: named
    mut Visitor visitor = square;
    mut int seen = 0;
    visitor.visit(side -> {
        seen = side;
    });
    std::print(seen);                                // output: 3
    square.visit(() -> 10);                          // output: 13

    Floor floor = new Floor();
    visitor = floor;
    visitor.visit(n -> std::print(n));               // output: 7
    floor.visit(n -> std::print(n + 1));             // output: 8
    std::print(deepest(Stack(4)));               // output: 4
    std::print(deepest(floor));                      // output: 7

    std::print(new Logger((int i) -> i + 1).lines);  // output: 2
    std::print(new Logger((String s) -> 5).lines);   // output: 105

    std::print(countDown(3, x -> std::print(x)));    // output: 3
                                                     // output: 20
                                                     // output: 100
                                                     // output: 3

    std::print(applyTwice(f -> f(10)));              // output: 23
}
