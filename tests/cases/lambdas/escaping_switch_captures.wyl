// A lambda an escaping choice makes is made in its case, so it may use the names the case declares.

enum Mode { Add(int n), Stop }

fn(int) -> int pick(Mode mode) {
    return switch (mode) {
        case Add(var n) -> x -> x + n;
        case Stop -> x -> x;
    };
}

void main() {
    std::print(pick(Mode.Add(2))(1));   // output: 3
    std::print(pick(Mode.Stop)(1));     // output: 1
}
