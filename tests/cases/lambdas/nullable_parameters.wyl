// A nullable function parameter is non-escaping unless declared 'escaping': it is passed a lambda,
// a function value, or null without allocating, and is narrowed by null checks like other values.

class Holder {
    mut fn(int) -> int f = x -> x * 10;
    mut (fn(int) -> int)? maybe = null;
    mut int calls = 0;

    int next() {
        calls++;
        return calls;
    }
}

int run(int value, (fn(int) -> int)? transform) {
    if (transform != null) {
        return transform(value);
    }
    return value;
}

int forward(int value, (fn(int) -> int)? transform) {
    return run(value, transform) + 1;
}

int unwrapped((fn(int) -> int)? f) {
    return f!(3);
}

int chosen(int value, (fn(int) -> int)? f, (fn(int) -> int)? g, bool first) {
    return (first ? f! : g!)(value);
}

int chosenMixed(int value, (fn(int) -> int)? f, bool first) {
    return (first ? f! : x -> x - 1)(value);
}

int chosenSwitch((fn(int) -> int)? f, int which) {
    return (switch (which) {
        case 0 -> f!;
        case 1 -> x -> x * 10;
        default -> x -> x + 100;
    })(3);
}

int twice(fn(int) -> int f) {
    return f(f(1));
}

int narrowed((fn(int) -> int)? f) {
    if (f == null) {
        return -1;
    }
    return twice(f);
}

int three(int a, (fn(int) -> int)? f, int b) {
    return run(a, f) * 10 + b;
}

int replacing(Holder holder, (fn(int) -> int)? f) {
    holder.maybe = null;
    holder.f = x -> 0;
    return run(1, f);
}

class Visitor {
    virtual int visit((fn(int) -> int)? f) {
        return run(2, f);
    }
}

void main() {
    // A lambda, null, and passing on.
    mut int total = 0;
    std::print(run(1, null));                       // output: 1
    std::print(run(1, x -> x + 1));                 // output: 2
    std::print(run(2, x -> {
        total += x;
        return total;
    }));                                            // output: 2
    std::print(forward(3, x -> x * 2));             // output: 7
    std::print(forward(3, null));                   // output: 4
    std::print(unwrapped(x -> x * 3));              // output: 9
    std::print(narrowed(x -> x + 2));               // output: 5
    std::print(narrowed(null));                     // output: -1
    std::print(new Visitor().visit(x -> x * 7));    // output: 14

    // Escaping values: a field, a nullable field, and a non-escaping local.
    var holder = new Holder();
    std::print(run(4, holder.f));                   // output: 40
    std::print(run(4, holder.maybe));               // output: 4
    holder.maybe = x -> -x;
    std::print(run(4, holder.maybe));               // output: -4
    fn(int) -> int local = x -> x + 100;
    std::print(run(1, local));                      // output: 101

    // The function passed stays alive when the place it came from is replaced during the call.
    holder.maybe = x -> x + holder.calls;
    std::print(replacing(holder, holder.maybe));    // output: 1
    holder.f = x -> x * 10;
    std::print(replacing(holder, holder.f));        // output: 10

    // Arguments evaluated in order, each into its own temporary, the lambda included.
    std::print(three(holder.next(), x -> x + 1, holder.next())); // output: 22

    // A choice of nullable function type is escaping, so its lambda is a closure.
    bool flag = holder.calls == 2;
    std::print(run(1, flag ? x -> x + 1 : null));   // output: 2
    std::print(run(1, !flag ? x -> x + 1 : null));  // output: 1

    // A '!' in a choice checks only where its option is chosen, so a null option that isn't
    // chosen does not panic.
    std::print(chosen(3, x -> x * 3, x -> x + 1, true));    // output: 9
    std::print(chosen(3, x -> x * 3, x -> x + 1, false));   // output: 4
    std::print(chosen(3, null, x -> x + 1, false));         // output: 4
    std::print(chosenMixed(3, x -> x * 3, true));           // output: 9
    std::print(chosenMixed(3, x -> x * 3, false));          // output: 2
    std::print(chosenMixed(3, null, false));                // output: 2
    std::print(chosenSwitch(x -> x * 3, 0));                // output: 9
    std::print(chosenSwitch(null, 1));                      // output: 30
    std::print(chosenSwitch(null, 2));                      // output: 103

    // A function type's nullable parameters are non-escaping too.
    fn((fn(int) -> int)?) -> int g = h -> h == null ? 7 : h(1);
    std::print(g(null));                            // output: 7
    std::print(g(x -> x + 8));                      // output: 9

    // The option the choice selects is checked, where the choice is made.
    std::print(chosen(3, null, x -> x + 1, true));  // panic: null value unwrapped with '!'
}
