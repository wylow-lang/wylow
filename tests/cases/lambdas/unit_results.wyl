// A lambda that returns nothing gives a generic result type Unit, and a lambda converted to a
// function type that returns Unit may leave its return out.

import std::{Unit, print};

T run<T>(fn() -> T f) {
    return f();
}

R apply<R>(int value, fn(int) -> R f) {
    return f(value);
}

void say(String text) {
    print(text);
}

void main() {
    Unit a = run(() -> { print("block"); });            // output: block
    Unit b = run(() -> say("expression"));              // output: expression
    run(() -> {
        if (true) {
            print("early");                             // output: early
            return;
        }
        print("not reached");
    });
    apply(4, n -> print(n));                            // output: 4
    int c = run(() -> 7);
    print(c);                                           // output: 7

    fn() -> Unit typed = () -> say("typed");
    typed();                                            // output: typed
    fn(int) -> Unit block = n -> {
        if (n > 1) {
            return;
        }
        print(n);
    };
    block(1);                                           // output: 1
    block(2);
    fn() -> Unit given = () -> Unit();
    given();
}
