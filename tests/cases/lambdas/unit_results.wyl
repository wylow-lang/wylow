// A lambda that returns nothing gives a generic result type Unit, and a lambda converted to a
// function type that returns Unit may leave its return out.

import std::Unit;

T run<T>(fn() -> T f) {
    return f();
}

R apply<R>(int value, fn(int) -> R f) {
    return f(value);
}

void say(String text) {
    std::print(text);
}

void main() {
    Unit a = run(() -> { std::print("block"); });       // output: block
    Unit b = run(() -> say("expression"));              // output: expression
    run(() -> {
        if (true) {
            std::print("early");                        // output: early
            return;
        }
        std::print("not reached");
    });
    apply(4, n -> std::print(n));                       // output: 4
    int c = run(() -> 7);
    std::print(c);                                      // output: 7

    fn() -> Unit typed = () -> say("typed");
    typed();                                            // output: typed
    fn(int) -> Unit block = n -> {
        if (n > 1) {
            return;
        }
        std::print(n);
    };
    block(1);                                           // output: 1
    block(2);
    fn() -> Unit given = () -> Unit();
    given();
}
