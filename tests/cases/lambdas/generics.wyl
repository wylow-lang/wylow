// Lambdas in generic classes, generic interfaces, bounds, static methods, and through '?.'.

import std::collections::List;

interface Visitor<T> {
    void visit(fn(T) -> void f);
}

class Bag<T extends copyable> implements Visitor<T> {
    List<T> items = new List<T>();

    void add(T item) {
        items.add(item);
    }

    void visit(fn(T) -> void f) {
        for (T item : items) {
            f(item);
        }
    }

    static Bag<T> of(T a, T b) {
        Bag<T> bag = new Bag<T>();
        bag.add(a);
        bag.add(b);
        return bag;
    }

    U fold<U extends copyable>(U start, fn(U, T) -> U step) {
        mut U acc = start;
        visit(item -> {
            acc = step(acc, item);
        });
        return acc;
    }
}

int total<V extends Visitor<int>>(V v) {
    mut int t = 0;
    v.visit(x -> {
        t += x;
    });
    return t;
}

int sumAll(Visitor<int> v) {
    mut int t = 0;
    v.visit(x -> {
        t += x;
    });
    return t;
}

void main() {
    Bag<int> bag = Bag<int>.of(3, 4);
    std::print(total(bag));                         // output: 7
    std::print(sumAll(bag));                        // output: 7
    std::print(bag.fold(10, (acc, x) -> acc + x));  // output: 17
    std::print(bag.fold(1L, (acc, x) -> acc * x));  // output: 12
    Bag<int>? none = null;
    none?.visit(x -> std::print(x));
    Bag<int>? some = bag;
    some?.visit(x -> std::print(x));                // output: 3
                                                    // output: 4
}
