// Operands are evaluated left to right around calls that may run a lambda changing what they read.
// Only those locals are kept in order; others are read where C++ reads them.

struct Vec {
    int x;
}

int add(int a, int b) {
    return a + b;
}

int run(() -> int f) {
    return f();
}

int runMaybe(((int) -> int)? f) {
    if (f != null) {
        return f(0);
    }
    return -1;
}

void main() {
    // A function value writes through a 'ref' argument.
    int x = 1;
    (ref int) -> int bump = v -> {
        v = v + 1;
        return 0;
    };
    print(add(x, bump(ref x)));                     // output: 1
    print(x);                                       // output: 2

    // A lambda passed to a nullable function parameter writes a local.
    int z = 1;
    print(add(z, runMaybe(n -> {
        z = 9;
        return n;
    })));                                           // output: 1
    print(z);                                       // output: 9

    // A lambda writes a field of a struct local.
    Vec v = Vec(1);
    print(add(v.x, run(() -> {
        v.x = 7;
        return 0;
    })));                                           // output: 1
    print(v.x);                                     // output: 7

    // A lambda that writes nothing the other operand reads.
    int w = 4;
    int other = 0;
    print(add(w, run(() -> {
        other = 3;
        return other;
    })));                                           // output: 7
}
