// Lambdas meeting patterns, nullables, loops, evaluation order, refs, and spans.

import std::{List, print};

class Mob {
    int hp;

    Mob(int hp) {
        this.hp = hp;
    }
}

enum Shape {
    Circle(float r),
    Square(float side),
}

struct Vec {
    int x;
}

void call(fn() -> void f) {
    f();
}

int run(fn() -> int f) {
    return f();
}

int add(int a, int b) {
    return a + b;
}

int count(List<Mob> mobs, fn(Mob) -> bool test) {
    mut int n = 0;
    for (Mob m : mobs) {
        if (test(m)) {
            n++;
        }
    }
    return n;
}

void edit(ref Vec v, fn(ref Vec) -> void f) {
    f(ref v);
}

void bump(ref int v, fn() -> void during) {
    during();
    v += 1;
}

void main() {
    List<Mob> mobs = new List<Mob>();
    mobs.add(new Mob(5));
    mobs.add(new Mob(50));
    int limit = 10;
    print(count(mobs, m -> m.hp < limit));                  // output: 1

    // Names declared by patterns and loops are captured like any local.
    Shape s = Shape.Circle(2.0);
    if (s is Circle(var r)) {
        call(() -> print(r * 2.0));                         // output: 4.0
    }
    switch (s) {
        case Circle(var r) -> call(() -> print(r));          // output: 2.0
        case Square(_) -> call(() -> print("square"));
    }
    for (mut int i = 0; i < 2; i++) {
        call(() -> print(i));                               // output: 0
                                                            // output: 1
    }
    mut int j = 0;
    while (run(() -> j) < 2) {
        j++;
    }
    print(j);                                               // output: 2

    int? n = 3;
    if (n != null) {
        call(() -> print(n! + 1));                          // output: 4
    }
    // A lambda's own locals and parameters are narrowed in it, however it assigns them.
    print(run(() -> {
        mut int? best = null;
        best = 5;
        if (best != null) {
            return best + 1;
        }
        return 0;
    }));                                                    // output: 6
    fn(int?) -> int orZero = (mut x) -> {
        if (x == null) {
            x = 0;
        }
        return x;
    };
    print(orZero(null));                                    // output: 0

    // Operands are evaluated left to right around a lambda that writes them.
    mut int[3] arr = [1, 2, 3];
    mut int i = 0;
    print(arr[i] + run(() -> {
        arr[0] = 100;
        return 0;
    }));                                                    // output: 1
    print(arr[run(() -> {
        i = 2;
        return i;
    })] + i);                                               // output: 5

    bool flag = true;
    fn(int) -> int f = x -> x + 1;
    mut int y = 1;
    print(add(y, (flag ? f : x -> x)(run(() -> {
        y = 50;
        return 1;
    }))));                                                  // output: 3

    // A lambda writes through a 'ref', a span, and a 'ref' to a local it also assigns.
    mut Vec[2] vs = [Vec(1), Vec(2)];
    edit(ref vs[1], v -> {
        v.x *= 10;
    });
    print(vs[1].x);                                         // output: 20

    List<int> list = new List<int>();
    list.add(1);
    Span<int> span = list.asSpan();
    call(() -> {
        span[0] = 42;
    });
    print(list[0]);                                         // output: 42

    mut int a = 1;
    bump(ref a, () -> {
        a = 10;
    });
    print(a);                                               // output: 11
}
