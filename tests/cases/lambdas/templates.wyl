// Constructors, and virtual methods that nothing overrides, take lambdas as templates; constructors
// sharing their parameter count with another, and overridden methods, call them indirectly.

class Box<T> {
    T value;

    Box(T seed, fn(T) -> T step) {
        value = step(step(seed));
    }
}

struct Point {
    int x, y;

    Point(int seed, fn(int) -> int f) {
        x = f(seed);
        y = f(x);
    }
}

class Counted {
    int total;

    Counted(int n, fn(int) -> int f) {
        total = f(n);
    }

    Counted(String name, fn(String) -> int f) {
        total = f(name) + 1000;
    }
}

class Tool {
    virtual int use(fn(int) -> int f) {
        return f(1);
    }

    // Overridden below, by a subclass of a subclass.
    virtual int aim(fn(int) -> int f) {
        return f(2);
    }
}

class Hammer extends Tool {
}

class Mallet extends Hammer {
    override int aim(fn(int) -> int f) {
        return f(3) * 10;
    }
}

void main() {
    var box = new Box<long>(5L, v -> v * 2L);
    std::print(box.value);                          // output: 20
    mut int calls = 0;
    var p = Point(1, x -> {
        calls++;
        return x * 3;
    });
    std::print(p.x);                                // output: 3
    std::print(p.y);                                // output: 9
    std::print(calls);                              // output: 2

    std::print(new Counted(4, n -> n * n).total);   // output: 16
    std::print(new Counted("ab", s -> 2).total);    // output: 1002

    Tool tool = new Mallet();
    std::print(tool.use(x -> x + 40));              // output: 41
    std::print(tool.aim(x -> x + 40));              // output: 430
    std::print(new Hammer().aim(x -> x));           // output: 2
}
