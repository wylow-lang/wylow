// A function or static method used as a value is the lambda that calls it, so the function type it
// is converted to picks the overload, and it can be passed, stored, chosen, and inferred from.

import std::{List, print};

class Mob {
    int depth;

    Mob(int depth) {
        this.depth = depth;
    }

    static int byDepth(Mob a, Mob b) {
        return a.depth - b.depth;
    }

    static int scaled(int x) {
        return x * 5;
    }

    int scaledTwice() {
        // A static method of the enclosing class, by its name alone.
        return apply(scaled, apply(scaled, depth));
    }
}

struct Vec {
    int x;

    static int read(in Vec v) {
        return v.x;
    }
}

int inc(int x) {
    return x + 1;
}

int twice(int x) {
    return x * 2;
}

long twice(long x) {
    return x * 3L;
}

void bump(ref int x) {
    x += 10;
}

T same<T>(T value) {
    return value;
}

String describe(Mob m) {
    return m.depth > 0 ? "deep mob" : "mob";
}

int fact(int n) {
    return n <= 1 ? 1 : n * apply(fact, n - 1);
}

int apply(fn(int) -> int f, int value) {
    return f(value);
}

U map<T, U>(T value, fn(T) -> U f) {
    return f(value);
}

int callRef(fn(ref int) -> void f) {
    mut int n = 1;
    f(ref n);
    return n;
}

void keep(List<fn(int) -> int> into, @Escaping fn(int) -> int f) {
    into.add(f);
}

interface Transform {
    mut int run(fn(int) -> int f, int value);
}

class Direct implements Transform {
    int run(fn(int) -> int f, int value) {
        return f(value);
    }
}

class Holder {
    mut fn(int) -> int f = inc;
}

fn(int) -> int pick(bool up) {
    return up ? inc : twice;
}

void main() {
    // Non-escaping: a template parameter, a FunctionRef, and a local.
    print(apply(inc, 1));                           // output: 2
    print(new Direct().run(inc, 2));                // output: 3
    fn(int) -> int local = inc;
    print(local(3));                                // output: 4

    // The function type picks the overload.
    fn(int) -> int intTwice = twice;
    fn(long) -> long longTwice = twice;
    print(intTwice(5));                             // output: 10
    print(longTwice(5L));                           // output: 15

    // Static methods, `in` and `ref` parameters, and a generic function.
    fn(Mob, Mob) -> int compare = Mob.byDepth;
    print(compare(new Mob(5), new Mob(2)));         // output: 3
    print(new Mob(1).scaledTwice());                // output: 25
    fn(in Vec) -> int read = Vec.read;
    print(read(Vec(7)));                            // output: 7
    print(callRef(bump));                           // output: 11
    fn(String) -> String echo = same;
    print(echo("echo"));                            // output: echo
    print(fact(5));                                 // output: 120

    // Generic inference from what the function returns.
    print(map(new Mob(4), describe));               // output: deep mob
    print(map(3, inc) + 1);                         // output: 5

    // Escaping: fields, returns, containers, and parameters.
    var holder = new Holder();
    print(holder.f(1));                             // output: 2
    holder.f = twice;
    print(holder.f(1));                             // output: 2
    print(pick(true)(1));                           // output: 2
    print(pick(false)(4));                          // output: 8
    var handlers = new List<fn(int) -> int>();
    handlers.add(inc);
    keep(handlers, twice);
    for (fn(int) -> int h : handlers) {
        print(h(10));                               // output: 11
                                                    // output: 20
    }

    // Choices, and a builtin with a result discarded.
    bool up = handlers.count() == 2;
    print(apply(up ? inc : twice, 3));              // output: 4
    fn(int) -> void show = print;
    show(42);                                       // output: 42
    fn(int) -> void discard = inc;
    discard(1);
}
