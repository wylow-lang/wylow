// A function type's parameter declared 'escaping' is escaping in the lambdas of that type, so they
// can store what they are passed.

import std::{List, memory, print};

class Bus {
    List<fn() -> void> handlers = new List<fn() -> void>();
    fn(escaping fn() -> void) -> void subscribe;

    Bus() {
        subscribe = h -> handlers.add(h);
    }

    void fire() {
        for (fn() -> void h : handlers) {
            h();
        }
    }
}

interface Registry {
    mut void each(fn(escaping fn(int) -> int) -> void visit);
}

class Doubler implements Registry {
    void each(fn(escaping fn(int) -> int) -> void visit) {
        visit(x -> x * 2);
        visit(x -> x * 3);
    }
}

int apply((fn(int) -> int)? f, int value) {
    return f == null ? value : f(value);
}

void subscribed() {
    var bus = new Bus();
    bus.subscribe(() -> print(1));
    int two = 2;
    bus.subscribe(() -> print(two));
    bus.fire();
}

void main() {
    // Stored by a lambda held in a field, then called later. The lambda captures its bus, a cycle.
    subscribed();                                   // output: 1
                                                    // output: 2
    memory::collectCycles();

    // A typed lambda declares the parameter 'escaping' too, and is passed through an interface.
    var kept = new List<fn(int) -> int>();
    Registry registry = new Doubler();
    registry.each((escaping fn(int) -> int f) -> kept.add(f));
    for (fn(int) -> int f : kept) {
        print(f(5));                                // output: 10
                                                    // output: 15
    }

    // A nullable parameter of a function type is non-escaping unless declared 'escaping'.
    fn((fn(int) -> int)?, int) -> int borrowed = apply;
    print(borrowed(x -> x + 1, 1));                 // output: 2
    print(borrowed(null, 1));                       // output: 1
    var maybes = new List<(fn(int) -> int)?>();
    fn(escaping (fn(int) -> int)?) -> void store = m -> maybes.add(m);
    store(x -> x * 4);
    store(null);
    print(apply(maybes[0], 2));                     // output: 8
    print(apply(maybes[1], 2));                     // output: 2

    // An escaping value passed where a function type's parameter is non-escaping.
    fn(fn() -> void) -> void call = h -> h();
    escaping fn() -> void stored = () -> print(9);
    call(stored);                                   // output: 9
}
