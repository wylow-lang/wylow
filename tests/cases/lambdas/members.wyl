// Lambdas in members use `this` and its fields as the member itself does.

import std::List;

struct Accumulator {
    int total;

    Accumulator(int[3] values) {
        each(values, v -> {
            total += v;
        });
        // `return` in the lambda leaves the lambda, not the constructor.
        call(() -> {
            return;
        });
    }

    mut void addAll(int[3] values) {
        each(values, v -> {
            total += v;
        });
    }

    int with(fn(int) -> int f) {
        return f(total);
    }
}

class Stack<T extends copyable> {
    List<T> items;

    Stack() {
        items = new List<T>();
    }

    void push(T item) {
        items.add(item);
    }

    void forEach(fn(T) -> void action) {
        for (T item : items) {
            action(item);
        }
    }

    int count(fn(T) -> bool test) {
        mut int found = 0;
        forEach(item -> {
            if (test(item)) {
                found++;
            }
        });
        return found;
    }
}

void call(fn() -> void f) {
    f();
}

void each(int[3] values, fn(int) -> void action) {
    for (int value : values) {
        action(value);
    }
}

void main() {
    mut Accumulator accumulator = Accumulator([1, 2, 3]);
    std::print(accumulator.total);                  // output: 6
    accumulator.addAll([10, 20, 30]);
    std::print(accumulator.total);                  // output: 66
    std::print(accumulator.with(t -> t * 2));       // output: 132

    Stack<int> numbers = new Stack<int>();
    numbers.push(1);
    numbers.push(22);
    numbers.push(1);
    numbers.forEach(n -> std::print(n));            // output: 1
                                                    // output: 22
                                                    // output: 1
    std::print(numbers.count(n -> n == 1));         // output: 2
}
