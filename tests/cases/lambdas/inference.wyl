// Type arguments inferred from what lambdas return.

import std::collections::List;

U apply<T, U>(T value, fn(T) -> U f) {
    return f(value);
}

U pick<U>(bool first, fn() -> U a, fn() -> U b) {
    return first ? a() : b();
}

C compose<A, B, C>(A a, fn(A) -> B f, fn(B) -> C g) {
    return g(f(a));
}

U run<U>(fn() -> U f) {
    return f();
}

U? whenPositive<U>(int x, fn(int) -> U? f) {
    return x > 0 ? f(x) : null;
}

struct Task {
    String name;
    int balance;
}

class Bag<T extends copyable> {
    List<T> items = new List<T>();

    void add(T item) {
        items.add(item);
    }

    List<U> map<U>(fn(T) -> U f) {
        List<U> result = new List<U>();
        for (T item : items) {
            result.add(f(item));
        }
        return result;
    }

    // Inside a generic class, the lambda's type depends on the class's own type parameter.
    List<String> names() {
        return map(item -> "item");
    }
}

Result<Task, String> find(bool ok) {
    if (ok) {
        return Result.Ok(Task("orc", 5));
    }
    return Result.Err("missing");
}

void main() {
    Task orc = Task("orc", 5);
    std::print(apply(orc, m -> m.name));                // output: orc
    std::print(apply(3, x -> x * 2L));                  // output: 6
    std::print(apply(3, (int x) -> x > 2));             // output: true
    fn(int) -> String describe = x -> "number";
    std::print(apply(3, describe));                     // output: number

    // Lambdas that disagree take a type both convert to.
    std::print(pick(false, () -> 1, () -> 2L));         // output: 2
    std::print(run(() -> {
        if (orc.balance > 3) {
            return 1;
        }
        return 2.5d;
    }));                                                // output: 1.0

    // Each lambda's parameters come from the lambdas before it.
    std::print(compose(2, x -> x + 0.5d, y -> y * 2d)); // output: 5.0
    std::print(compose(orc, m -> m.balance, h -> h > 3)); // output: true

    mut int calls = 0;
    std::print(run(() -> {
        calls++;
        return calls * 10;
    }));                                                // output: 10
    std::print(calls);                                  // output: 1

    int? half = whenPositive(4, x -> x / 2);
    std::print(half ?? -1);                             // output: 2

    Bag<Task> bag = new Bag<Task>();
    bag.add(orc);
    bag.add(Task("elf", 9));
    List<int> balances = bag.map(m -> m.balance);
    std::print(balances[1]);                             // output: 9
    std::print(bag.names()[0]);                         // output: item

    Result<String, String> name = find(true).map(m -> m.name);
    std::print(name.orElse("?"));                       // output: orc
    std::print(find(false).map(m -> m.balance).orElse(-1)); // output: -1
    std::print(find(false).mapErr(e -> 404) is Err);   // output: true
    var total = find(true).map(m -> find(false).map(n -> n.balance + m.balance).orElse(m.balance * 10));
    std::print(total.orElse(0));                        // output: 50
}
