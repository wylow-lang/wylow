// An unsafe function, method, constructor, or indexer is called only from unsafe code, and no
// call that needs no unsafe code can reach one: an override or interface implementation can't
// be 'unsafe' unless what it overrides is (spec unsafe.blocks).

unsafe int danger(int x) { return x; }

class Base {
    unsafe static int raw() { return 1; }
    unsafe virtual int risky() { return 1; }
    virtual int plain() { return 1; }
}

class Derived extends Base {
    // Safe in place of unsafe is allowed: a call through Base still needs unsafe code.
    override int risky() { return 2; }
    unsafe override int plain() { return 2; }   // error[WYL0127]: 'plain' cannot be 'unsafe'
}

pub interface Shape {
    int sides();
}

class Square implements Shape {
    pub unsafe int sides() { return 4; }    // error[WYL0189]: 'Square.sides' cannot be 'unsafe'
}

struct Shown implements Printable {
    int v;
    pub unsafe String toString() { return "shown"; }   // error[WYL0189]: 'Shown.toString' cannot be 'unsafe'
}

struct Ordered implements Comparable<Ordered> {
    int v;
    pub unsafe int compareTo(in Ordered other) { return 0; }   // error[WYL0189]: 'Ordered.compareTo' cannot be 'unsafe'
    pub bool equals(in Ordered other) { return true; }
}

struct Grid {
    int v;
    pub unsafe int operator [](int i) { return v; }
    pub int operator [](String s) { return v; }
    pub unsafe mut void operator []=(String s, int x) { v = x; }
}

unsafe int alreadyUnsafe() {
    // An unsafe function's body is unsafe code, and so is a lambda written in it.
    fn() -> int f = () -> danger(1);
    return danger(f());
}

void main() {
    std::print(danger(1));              // error[WYL0304]: 'danger' is unsafe and can only be called in 'unsafe' code
    std::print(Base.raw());             // error[WYL0304]: 'raw' is unsafe and can only be called in 'unsafe' code
    Base b = new Derived();
    std::print(b.risky());              // error[WYL0304]: 'risky' is unsafe and can only be called in 'unsafe' code
    Derived d = new Derived();
    std::print(d.risky());
    fn() -> int f = () -> danger(2);    // error[WYL0304]: 'danger' is unsafe and can only be called in 'unsafe' code
    fn(int) -> int g = danger;          // error[WYL0304]: 'danger' is unsafe and can only be called in 'unsafe' code
    mut var grid = Grid();
    std::print(grid[0]);                // error[WYL0304]: 'operator []' is unsafe and can only be called in 'unsafe' code
    std::print(grid["a"]);
    grid["a"] = 1;                      // error[WYL0304]: 'operator []=' is unsafe and can only be called in 'unsafe' code
    unsafe {
        std::print(danger(3) + Base.raw() + b.risky() + grid[0]);
        grid["a"] = 2;
        unsafe {
            fn() -> int h = () -> danger(4);
            std::print(h());
        }
    }
}
