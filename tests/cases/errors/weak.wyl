import std::Weak;

class Node {
    Weak<Node> parent;
    Weak<Node?> maybe;                  // error[WYL0402]: 'Weak' cannot take a nullable type
    Weak<int> number;                   // error[WYL0403]: 'Weak' type argument: expected a class or interface type, found 'int'
}

struct Vec { int x; }

class Box<T> {
    Weak<T> item;                       // error[WYL0403]: 'Weak' type argument: expected a class or interface type, found 'T'
}

void main() {
    var n = new Node();
    mut Weak<Node> w = n;
    Node strong = w;                    // error[WYL0079]: expected 'Node', found 'Weak<Node>'
    Node? read = n.parent;              // error[WYL0079]: expected 'Node?', found 'Weak<Node>'
    Weak<Vec> v;                        // error[WYL0403]: 'Weak' type argument: expected a class or interface type, found 'Vec'
    std::print(w == n.parent);          // error[WYL0311]: operator '==' cannot be applied to 'Weak<Node>' and 'Weak<Node>'
    w = 5;                              // error[WYL0079]: expected 'Weak<Node>', found 'int'
    std::print(w.get().parent);         // error[WYL0065]: 'w.get()' might be null
}
