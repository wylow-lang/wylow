import std::print;

class Item { }

class Base {
    Base(int x) { }
}

class NoSuper extends Base {
    NoSuper() { }                       // error: 'Base' has no parameterless constructor
}

class Implicit extends Base { }         // error: 'Base' has no parameterless constructor

class LateSuper extends Base {
    LateSuper() {                       // error: 'Base' has no parameterless constructor
        print(1);
        super(1);                       // error: 'super(...)' must be the first statement of a constructor
    }
}

class ThisInSuper extends Base {
    int field = 1;
    ThisInSuper() {
        super(field);                   // error: arguments to 'super(...)' cannot use 'this'
    }
}

class NoBase {
    NoBase() {
        super();                        // error: 'NoBase' has no base class
    }
}

class Chained extends Base {
    int field = 1;
    Chained(int x) { super(x); }
    Chained(String s) {                 // error: 'Base' has no parameterless constructor
        print(s);
        this(1);                        // error: 'this(...)' must be the first statement of a constructor
    }
    Chained(bool b) {
        this(1);
        super(1);                       // error: 'super(...)' must be the first statement of a constructor
    }
    Chained(char c) {
        this(field);                    // error: arguments to 'this(...)' cannot use 'this'
    }
    Chained(int x, int y) {
        this("no", "match");            // error: no constructor of 'Chained' accepts (String, String)
    }
    Chained(in int x, Span<int> view) { super(x); }
    Chained(Span<int> view, int i) {
        this(view[i], view);            // error: an argument to 'this(...)' for a reference or view parameter
    }
}

class Cycles {
    Cycles() {
        this();                         // error: recursive constructor invocation
    }
    Cycles(int x) {
        this(x, x);                     // error: recursive constructor invocation
    }
    Cycles(int x, int y) {
        this(x, y, x);                  // error: recursive constructor invocation
    }
    Cycles(int x, int y, int z) {
        this(x);                        // error: recursive constructor invocation
    }
    // Leads into the cycle without being on it.
    Cycles(String s) {
        this(1);
    }
}

void notConstructor() {
    this(1);                            // error: 'this(...)' can only be used in a constructor
}

struct ChainedStruct {
    int x;
    ChainedStruct(int x) { this.x = x; }
    ChainedStruct(bool b) {
        this(x);                        // error: arguments to 'this(...)' cannot use 'this'
    }
    ChainedStruct(String s) {
        super();                        // error: 'super(...)' can only be used in a class constructor
    }
}

struct NoDefault {
    Item item;
    NoDefault(Item item) { this.item = item; }
    NoDefault(int x) {
        this();                         // error: 'NoDefault' has no default value because field 'item' has type 'Item'
    }
}

class ViewBase {
    ViewBase(in int x, Span<int> view) { }
}

class ViewDerived extends ViewBase {
    ViewDerived(int x, int[] items, Span<int> view) {
        super(x, view);
    }
    ViewDerived(int x, Span<int> view) {
        super(x + 1, view);             // error: an argument to 'super(...)' for a reference or view parameter
    }
    ViewDerived(int x, int[] items) {
        super(x, items);                // error: an argument to 'super(...)' for a reference or view parameter
    }
    ViewDerived(Span<int> view, int i) {
        super(view[i], view);           // error: an argument to 'super(...)' for a reference or view parameter
    }
}

class Unassigned {
    Item item;                          // error: field 'item' of type 'Item' has no default value
}

struct Holder {
    Item item;

    Holder(int x) {
        item = new Item();
    }
}

void main() {
    var h = Holder();                   // error: 'Holder' has no default value because field 'item' has type 'Item'
}
