class Item { }

class Base {
    Base(int x) { }
}

class NoSuper extends Base {
    NoSuper() { }                       // error[WYL0140]: constructor must start with 'super(...)'
}

class Implicit extends Base { }         // error[WYL0140]: constructor must start with 'super(...)'

class LateSuper extends Base {
    LateSuper() {                       // error[WYL0140]: constructor must start with 'super(...)'
        std::print(1);
        super(1);                       // error[WYL0135]: 'super(...)' must be the first statement of a constructor
    }
}

class ThisInSuper extends Base {
    int field = 1;
    ThisInSuper() {
        super(field);                   // error[WYL0282]: instance field 'field' cannot be used here
    }
}

class NoBase {
    NoBase() {
        super();                        // error[WYL0139]: cannot call 'super(...)' in 'NoBase'
    }
}

class Chained extends Base {
    int field = 1;
    Chained(int x) { super(x); }
    Chained(String s) {                 // error[WYL0140]: constructor must start with 'super(...)'
        std::print(s);
        this(1);                        // error[WYL0137]: 'this(...)' must be the first statement of a constructor
    }
    Chained(bool b) {
        this(1);
        super(1);                       // error[WYL0135]: 'super(...)' must be the first statement of a constructor
    }
    Chained(char c) {
        this(field);                    // error[WYL0282]: instance field 'field' cannot be used here
    }
    Chained(int x, int y) {
        this("no", "match");            // error[WYL0236]: no constructor of 'Chained' accepts (String, String)
    }
    Chained(in int x, Span<int> view) { super(x); }
    Chained(Span<int> view, int i) {
        this(view[i], view);            // error[WYL0142]: argument to 'this(...)' for a reference or view parameter must be a parameter, a field of one, or 'null'
    }
}

class Cycles {
    Cycles() {
        this();                         // error[WYL0141]: constructor 'Cycles()' calls itself through 'this(...)'
    }
    Cycles(int x) {
        this(x, x);                     // error[WYL0141]: constructor 'Cycles(int)' calls itself through 'this(...)'
    }
    Cycles(int x, int y) {
        this(x, y, x);                  // error[WYL0141]: constructor 'Cycles(int, int)' calls itself through 'this(...)'
    }
    Cycles(int x, int y, int z) {
        this(x);                        // error[WYL0141]: constructor 'Cycles(int, int, int)' calls itself through 'this(...)'
    }
    // Leads into the cycle without being on it.
    Cycles(String s) {
        this(1);
    }
}

void notConstructor() {
    this(1);                            // error[WYL0138]: 'this(...)' can only be used in a constructor
}

struct ChainedStruct {
    int x;
    ChainedStruct(int x) { this.x = x; }
    ChainedStruct(bool b) {
        this(x);                        // error[WYL0282]: instance field 'x' cannot be used here
    }
    ChainedStruct(String s) {
        super();                        // error[WYL0136]: 'super(...)' can only be used in a class constructor
    }
}

struct NoDefault {
    Item item;
    NoDefault(Item item) { this.item = item; }
    NoDefault(int x) {
        this();                         // error[WYL0102]: 'NoDefault' has no default value
    }
}

class ViewBase {
    ViewBase(in int x, Span<int> view) { }
}

class ViewDerived extends ViewBase {
    ViewDerived(int x, int[] items, Span<int> view) {
        super(x, view);
    }
    ViewDerived(int x, Span<int> view) {
        super(x + 1, view);             // error[WYL0142]: argument to 'super(...)' for a reference or view parameter must be a parameter, a field of one, or 'null'
    }
    ViewDerived(int x, int[] items) {
        super(x, items);                // error[WYL0142]: argument to 'super(...)' for a reference or view parameter must be a parameter, a field of one, or 'null'
    }
    ViewDerived(Span<int> view, int i) {
        super(view[i], view);           // error[WYL0142]: argument to 'super(...)' for a reference or view parameter must be a parameter, a field of one, or 'null'
    }
}

class Unassigned {
    Item item;                          // error[WYL0143]: field 'item' of type 'Item' has no initial value
}

unique struct Token {
    int id;

    ~Token() { }
}

class UnassignedToken {
    Token token;                        // error[WYL0143]: field 'token' of type 'Token' has no initial value
}

struct Holder {
    Item item;

    Holder(int x) {
        item = new Item();
    }
}

void main() {
    var h = Holder();                   // error[WYL0102]: 'Holder' has no default value
}
