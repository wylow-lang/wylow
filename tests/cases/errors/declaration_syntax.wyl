struct S {
    ~S() { }                            // error[WYL0458]: only a 'unique' struct can have a destructor
}

enum E {
    A;

    ~E() { }                            // error[WYL0146]: enums cannot have destructors
}

class C {
    int operator +(int a) { return a; }  // error[WYL0247]: only 'operator []' and 'operator []=' can be declared
    int this[int i] { return i; }   // error[WYL0248]: indexer is not declared with 'operator []'
    +;                              // error[WYL0001]: expected a field, method, or constructor
    const int limit;                // error[WYL0004]: 'const' is a reserved word and cannot be used

    ~D() { }                            // error[WYL0147]: destructor is not named after its type
}

class Twice {
    ~Twice() { }
    ~Twice() { }                        // error[WYL0148]: 'Twice' already has a destructor
}

void main() {
    var a = new int[2][3];              // error[WYL0073]: 'new' cannot create an array of arrays
    int b = const;                      // error[WYL0004]: 'const' is a reserved word and cannot be used
    defer print(1);                     // error[WYL0004]: 'defer' is a reserved word and cannot be used
    if (b is ) { }                      // error[WYL0001]: expected a pattern
    for (int i = 0; i < 3; int j = 1) { }  // error[WYL0342]: variable cannot be declared here
}

struct Late {
    int value;

    int read(int extra, this Late late) {   // error[WYL0446]: 'this' parameter must come first
        return extra;
    }
