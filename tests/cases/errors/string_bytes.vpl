class Named {
    mut String name = "a";

    ReadOnlySpan<byte> view() {
        return name.bytes;              // error: a returned 'ReadOnlySpan<byte>' must view the method's receiver: fields or elements of 'this', or a span returned by its methods; 'name' holds its contents itself, and could be replaced while the caller uses them
    }
}

struct Holder {
    ReadOnlySpan<byte> bytes;           // error: 'ReadOnlySpan<byte>' cannot be the type of a field; like a 'ref', it can only be a local variable or parameter
}

void main() {
    String s = "abc";
    s.bytes[0] = 1;                     // error: cannot assign to 's.bytes[0]' because 'operator [](int)' returns 'in'
    Span<byte> writable = s.bytes;      // error: cannot implicitly convert 'ReadOnlySpan<byte>' to 'Span<byte>'
}
