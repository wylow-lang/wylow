abstract final class Both { }          // error: a class cannot be both 'abstract' and 'final'

final interface Flagged { }            // error: 'final' is not valid on an interface

struct S extends T { }                 // error: structs cannot inherit

struct WithDestructor {
    internal {
        mut virtual void m() { }               // error: 'virtual' is not valid on struct members
    }
}

interface I {
    int x;                             // error: interfaces cannot have fields
    mut void body() { }                    // error: interface methods cannot have a body
    public mut void m();                   // error: interface members cannot have modifiers
}

class C {
    internal {
        final void m() { }                 // error: 'final' can only be used on an 'override' method
        virtual override void n() { }      // error: only one of 'virtual', 'override', and 'abstract' is allowed
        static virtual void o() { }        // error: a static method cannot be 'virtual'
        abstract void q() { }              // error: abstract methods cannot have a body
        void r();                          // error: 'r' must have a body
        virtual int field;                 // error: 'virtual' is not valid on a field
    }

    private {
        virtual void p() { }       // error: a private method cannot be 'virtual'
    }

    ~C(int x) { }                      // error: destructors cannot have parameters
}

void main() {
}
