import std::print;

struct Plain {
    int x;
}

struct Pair<A, B> {
    A first;
    B second;
}

struct Node<T> {                  // error[WYL0106]: struct 'Node' contains itself
    Node<T> next;
}

struct Wrap<T> {
    T value;
}

struct Rec {                      // error[WYL0106]: struct 'Rec' contains itself
    Wrap<Rec> inner;
}

struct Grow<T> {                  // error[WYL0107]: struct 'Grow' has field types that nest without end
    Grow<Pair<T, T>> next;
}

struct Shadow<T> {
    mut void method<T>() {            // error[WYL0193]: type parameter 'T' hides the type parameter 'T' of its type
    }
}

T make<T>() {
    return T();                   // error[WYL0191]: cannot construct type parameter 'T'
}

bool same<T>(T a, T b) {
    return a == b;                // error[WYL0308]: operator '==' cannot be applied to 'T' and 'T'
}

void show<T>(T value) {
    print(value);                 // error[WYL0236]: no overload of 'print' accepts (T)
}

Pair<T, int> half<T>(T x) {
    return Pair<T, int>();        // error[WYL0102]: 'Pair<T, int>' has no default value
}

Pair<T, int> full<T>(T x) {
    return Pair<T, int>(first: x);
}

T choose<T>(fn(int) -> T f) {
    return f(0);
}

void main() {
    Pair p;                       // error[WYL0200]: type arguments of 'Pair': expected 2, found 0
    Pair<int> q;                  // error[WYL0200]: type arguments of 'Pair': expected 2, found 1
    int<bool> r;                  // error[WYL0199]: type 'int' takes no type arguments
    Plain<int> plain;             // error[WYL0199]: type 'Plain' takes no type arguments
    print(make());                // error[WYL0201]: cannot infer type argument 'T' of 'make'
    var w = Wrap<int>();
    print(w.value.first);         // error[WYL0296]: cannot find member 'first' in 'int'
    var pp = Pair<int, int>(1, 2, 3); // error[WYL0233]: no constructor of 'Pair<int, int>' takes 3 arguments
    var conflict = full<int, int>(1); // error[WYL0234]: no overload of 'full' takes 2 type arguments
    var mixed = choose(x -> {     // error[WYL0204]: cannot infer type argument 'T' of 'choose'
        mut int n = 1;
        if (x > 0) {
            return n;
        }
        return 0.5;
    });
    var bad = Pair<(fn() -> int)?, int>();
    print(bad == bad);            // error[WYL0310]: operator '==' cannot be applied to 'Pair<(fn() -> int)?, int>'
    same(print(1), print(2));     // error[WYL0202]: cannot infer type argument 'T' of 'same' from a 'void' value
}
