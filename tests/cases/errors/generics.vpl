struct Pair<A, B> {
    A first;
    B second;
}

struct Node<T> {                  // error: struct 'Node' contains itself (Node<T> -> Node<T>)
    Node<T> next;
}

struct Wrap<T> {
    T value;
}

struct Rec {                      // error: struct 'Rec' contains itself (Rec -> Wrap<Rec> -> Rec)
    Wrap<Rec> inner;
}

struct Grow<T> {                  // error: struct 'Grow' has field types that nest without end
    Grow<Pair<T, T>> next;
}

struct Shadow<T> {
    void method<T>() {            // error: type parameter 'T' hides the type parameter of the same name
    }
}

T make<T>() {
    return T();                   // error: 'T' is a type parameter and cannot be constructed
}

bool same<T>(T a, T b) {
    return a == b;                // error: operator '==' cannot be applied to 'T' and 'T'
}

void show<T>(T value) {
    print(value);                 // error: no overload of 'print' accepts (T)
}

Pair<T, int> half<T>(T x) {
    return Pair<T, int>();        // error: 'Pair<T, int>' has no default value because field 'first' has type 'T'
}

Pair<T, int> full<T>(T x) {
    return Pair<T, int> { first = x };
}

void main() {
    Pair p;                       // error: 'Pair' requires 2 type arguments
    Pair<int> q;                  // error: 'Pair' requires 2 type arguments
    int<bool> r;                  // error: 'int' is not generic
    print(make());                // error: cannot infer type argument 'T' of 'make'
    var w = Wrap<int> { value = 1 };
    print(w.value.first);         // error: 'int' has no member 'first'
    var pp = Pair<int, int>(1, 2, 3); // error: no constructor of 'Pair<int, int>' takes 3 arguments
    var conflict = full<int, int>(1); // error: no overload of 'full' takes 2 type arguments
    var bad = Pair<String, int>();
    print(bad == bad);            // error: its field 'first' of type 'String' does not support '=='
}
