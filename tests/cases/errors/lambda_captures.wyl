// An escaping lambda copies what it captures, so each captured local must not be 'mut', and can't be
// something only valid during the call.
struct Point {
    int x;

    mut void move() {
        x++;
    }

    int get() {
        return x;
    }

    mut fn() -> int getter() {
        return () -> x;                             // error[WYL0274]: escaping lambda cannot capture 'this' in a struct's method or constructor
    }
}

void bump(ref int value) {
    value++;
}

void each(fn(int) -> void f) {
    f(1);
}

void keep(escaping fn() -> int f) {
}

void parameters(ref int r, in int i, fn() -> int g, Span<int> view) {
    keep(() -> r);                                  // error[WYL0273]: escaping lambda cannot capture 'r'
    keep(() -> i);                                  // error[WYL0273]: escaping lambda cannot capture 'i'
    keep(() -> g());                                // error[WYL0273]: escaping lambda cannot capture 'g'
    keep(() -> view[0]);                            // error[WYL0273]: escaping lambda cannot capture 'view'
}

void changes() {
    mut int assigned = 1;
    keep(() -> assigned);                           // error[WYL0273]: escaping lambda cannot capture 'assigned'
    assigned = 2;

    // Only 'mut' decides, not whether the local actually changes.
    mut int unchanged = 1;
    keep(() -> unchanged);                          // error[WYL0273]: escaping lambda cannot capture 'unchanged'

    mut var moved = Point(1);
    moved.move();
    keep(() -> moved.get());                        // error[WYL0273]: escaping lambda cannot capture 'moved'

    var read = Point(1);
    keep(() -> read.get() + read.x);

    // Assigned once after its declaration, so not 'mut'.
    int late;
    late = 1;
    keep(() -> late);

    for (mut int i = 0; i < 2; i++) {
        keep(() -> i);                              // error[WYL0273]: escaping lambda cannot capture 'i'
    }

    // An escaping lambda inside a non-escaping one.
    mut int outer = 0;
    each(x -> {
        keep(() -> outer + x);                      // error[WYL0273]: escaping lambda cannot capture 'outer'
        outer = x;
    });
}

void copies() {
    int value = 1;
    var point = Point(1);
    keep(() -> {
        value = 2;                                  // error[WYL0351]: cannot assign to 'value'
        point.x = 3;                                // error[WYL0351]: cannot assign to 'point.x'
        point.move();                               // error[WYL0105]: cannot call 'mut' method 'move' on 'point'
        bump(ref value);                            // error[WYL0223]: cannot pass 'value' by 'ref'
        return value + point.get();
    });
    // A local the lambda declares is its own.
    keep(() -> {
        mut int own = 1;
        own++;
        return own;
    });
}

void main() {
}
