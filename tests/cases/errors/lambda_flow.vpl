void call(() -> void f) {
    f();
}

void check() {
    int unassigned;
    call(() -> {
        print(unassigned);                          // error: 'unassigned' might not have been assigned
    });

    int? outside = 5;
    if (outside != null) {
        call(() -> {
            int value = outside;                    // error: null checks outside a lambda don't narrow inside it
        });
    }

    mut int? cleared = 5;
    call(() -> {
        cleared = null;
    });
    if (cleared != null) {
        int value = cleared;                        // error: a lambda assigns it, so null checks don't narrow it
    }

    // Narrowing ends where the lambda is made, not before it.
    mut int? later = 5;
    if (later != null) {
        int before = later;
    }
    call(() -> {
        later = null;
    });
    if (later != null) {
        int after = later;                          // error: a lambda assigns it, so null checks don't narrow it
    }

    // A lambda made late in a loop may run in the next iteration.
    mut int? looped = 5;
    for (int i : 0..2) {
        if (looped != null) {
            int early = looped;                     // error: a lambda assigns it, so null checks don't narrow it
        }
        call(() -> {
            looped = null;
        });
    }

    mut int assignedInside;
    call(() -> {
        assignedInside = 1;
    });
    print(assignedInside);                          // error: 'assignedInside' might not have been assigned

    (int) -> int sign = x -> {
        if (x > 0) {
            return 1;
        }
    };                                              // error: this lambda must return a value on every path
}

void main() {
}
