// A value moves into an isolated box only if it is sendable, and the lambda that builds a graph
// captures only sendable values. A list is isolated only if its elements are sendable.

import std::threading::Isolated;
import std::List;

class Node {
    pub int count;
    pub Node(int count) { this.count = count; }
}

struct Graph {
    pub Node? root;
}

void main() {
    var node = new Node(1);
    var graph = Graph(null);
    Isolated<Graph> box = graph;                     // error[WYL0478]: 'Graph' is not 'sendable'
    var built = Isolated<int>(() -> node.count);     // error[WYL0472]: shared lambda cannot capture 'node'
    mut Isolated<int> number = 1;
    number.open(n -> new Node(n));                   // error[WYL0453]: 'Node' is not 'sendable'
    var nodes = new List<Node>();
    var isolatedNodes = nodes.isolate();             // error[WYL0456]: 'Node' is not 'sendable'
}
