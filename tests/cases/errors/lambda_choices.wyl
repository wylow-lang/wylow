enum Op {
    Add(int amount),
    Stop,
}

void main() {
    Op op = Op.Add(1);
    fn(int) -> int inc = x -> x + 1;

    // The lambdas a switch expression chooses from are made outside its cases.
    fn(int) -> int f = switch (op) {
        case Add(var a) -> x -> x + a;              // error[WYL0278]: lambda chosen by a switch expression cannot use 'a'
        case Stop -> op is Add(var b) ? x -> b : inc; // error[WYL0278]: lambda chosen by a switch expression cannot use 'b'
    };

    var u = op is Stop ? x -> x : y -> y;            // error[WYL0260]: lambda has no function type to take

    var g = switch (op) {
        case Add(_) -> x -> x;                      // error[WYL0260]: lambda has no function type to take
        case Stop -> y -> y;
    };

    // A choice of nullable function type is escaping.
    var h = switch (op) {
        case Add(_) -> inc;                         // error[WYL0271]: non-escaping variable 'inc' cannot be stored or returned
        case Stop -> null;
    };
}
