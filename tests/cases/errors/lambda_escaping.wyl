// Parameters and locals hold non-escaping functions unless declared 'escaping'; fields, returns,
// type arguments, array elements, and nullable variables are escaping.

import std::List;

class Button {
    fn(int) -> void onClick;                          // error[WYL0143]: field 'onClick' of type 'fn(int) -> void' has no initial value
    mut fn() -> void stored = () -> {};

    void set(fn() -> void f) {
        stored = f;                                 // error[WYL0271]: non-escaping parameter 'f' cannot be stored or returned
    }
}

enum Event {
    Click(fn() -> void handler),
    None,
}

void wrongType(escaping int x) {                   // error[WYL0270]: 'escaping' cannot be declared on a parameter of non-function type 'int'
}

void unknown(@Fast fn() -> void f) {                  // error[WYL0433]: cannot find annotation '@Fast'
}

void keep(escaping fn() -> void f) {
}

void keep(fn() -> void f) {                          // error[WYL0232]: function 'keep(fn() -> void)' is already defined
}

T identity<T>(T value) {
    return value;
}

fn(int) -> int give(fn(int) -> int f) {
    return f;                                       // error[WYL0271]: non-escaping parameter 'f' cannot be stored or returned
}

void check(bool flag, fn() -> void g) {
    fn(int) -> int inc = x -> x + 1;
    mut escaping fn(int) -> int dec = x -> x - 1;
    mut escaping int number = 1;                       // error[WYL0270]: 'escaping' cannot be declared on a variable of non-function type 'int'
    escaping var text = "a";                       // error[WYL0270]: 'escaping' cannot be declared on a variable of non-function type 'String'
    ref escaping int alias = number;               // error[WYL0090]: 'ref' variable cannot be declared 'escaping'
    @CallerLocation ref int located = number;       // error[WYL0432]: '@CallerLocation' can only be used on functions, methods, and constructors
    (fn(int) -> int)? maybe = dec;                    // error[WYL0269]: variable of nullable function type must be declared 'escaping'
    escaping (fn(int) -> int)? nullable = inc;       // error[WYL0271]: non-escaping variable 'inc' cannot be stored or returned
    fn(int) -> int later;                             // error[WYL0414]: variable of type 'fn(int) -> int' must be initialized where it is declared

    inc = dec;                                      // error[WYL0268]: cannot reassign non-escaping variable 'inc'
    g = () -> {};                                   // error[WYL0268]: cannot reassign non-escaping parameter 'g'
    dec = inc;                                      // error[WYL0271]: non-escaping variable 'inc' cannot be stored or returned

    keep(g);                                        // error[WYL0271]: non-escaping parameter 'g' cannot be stored or returned
    var same = identity(inc);                       // error[WYL0271]: non-escaping variable 'inc' cannot be stored or returned
    var handlers = new List<fn() -> void>();
    handlers.add(g);                                // error[WYL0271]: non-escaping parameter 'g' cannot be stored or returned
    var listed = [dec, inc];                        // error[WYL0271]: non-escaping variable 'inc' cannot be stored or returned
    (fn(int) -> int)?[] table = new (fn(int) -> int)?[2];
    table[0] = inc;                                 // error[WYL0271]: non-escaping variable 'inc' cannot be stored or returned
    var functions = new (fn(int) -> int)[2];          // error[WYL0078]: cannot fill a new array with default values of 'fn(int) -> int'
    escaping fn(int) -> int chosen = flag ? dec : inc; // error[WYL0271]: non-escaping variable 'inc' cannot be stored or returned
    var maybeInc = flag ? inc : null;               // error[WYL0271]: non-escaping variable 'inc' cannot be stored or returned
    escaping fn(int) -> int lambda = flag ? x -> x : inc; // error[WYL0271]: non-escaping variable 'inc' cannot be stored or returned
}

class Base {
    virtual void on(escaping fn() -> void f) {
    }

    virtual void off(fn() -> void f) {
    }
}

class Derived extends Base {
    override void on(fn() -> void f) {                // error[WYL0125]: 'on' does not match the parameter and return types of 'Base.on'
    }

    override void off(escaping fn() -> void f) {     // error[WYL0125]: 'off' does not match the parameter and return types of 'Base.off'
    }
}

interface Listener {
    mut void listen(escaping fn() -> void f);
}

class Quiet implements Listener {
    void listen(fn() -> void f) {                     // error[WYL0188]: 'Quiet.listen' does not match the parameter and return types of 'Listener.listen(escaping fn() -> void)'
    }
}

class Events {
    void on(fn() -> void f) {
    }

    void on(escaping fn() -> void f) {               // error[WYL0232]: method 'on(escaping fn() -> void)' is already defined
    }
}

void main() {
}
