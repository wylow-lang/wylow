// Parameters and locals hold non-escaping functions unless declared 'escaping'; fields, returns,
// type arguments, array elements, and nullable variables are escaping.

import std::List;

class Button {
    fn(int) -> void onClick;                          // error: field 'onClick' of type 'fn(int) -> void' has no default value; give it an initializer or assign it in a constructor
    mut fn() -> void stored = () -> {};

    void set(fn() -> void f) {
        stored = f;                                 // error: 'f' is a non-escaping parameter, so it cannot be stored or returned; declare it 'escaping'
    }
}

enum Event {
    Click(fn() -> void handler),
    None,
}

void wrongType(escaping int x) {                   // error: 'escaping' can only be declared on a parameter of function type, not 'int'
}

void unknown(@Fast fn() -> void f) {                  // error: unknown annotation '@Fast'
}

void keep(escaping fn() -> void f) {
}

void keep(fn() -> void f) {                          // error: function 'keep(fn() -> void)' is already defined as 'keep(escaping fn() -> void)'; overloads cannot differ only in which parameters are 'escaping'
}

T identity<T>(T value) {
    return value;
}

fn(int) -> int give(fn(int) -> int f) {
    return f;                                       // error: 'f' is a non-escaping parameter, so it cannot be stored or returned; declare it 'escaping'
}

void check(bool flag, fn() -> void g) {
    fn(int) -> int inc = x -> x + 1;
    mut escaping fn(int) -> int dec = x -> x - 1;
    mut escaping int number = 1;                       // error: 'escaping' can only be declared on a variable of function type, not 'int'
    escaping var text = "a";                       // error: 'escaping' can only be declared on a variable of function type, not 'String'
    ref escaping int alias = number;               // error: a 'ref' variable can't be declared 'escaping', since it refers to a place rather than holding a function
    @CallerLocation ref int located = number;       // error: '@CallerLocation' can only be used on functions, methods, and constructors
    (fn(int) -> int)? maybe = dec;                    // error: a variable of nullable function type must be declared 'escaping'; only a parameter can hold a nullable non-escaping function
    escaping (fn(int) -> int)? nullable = inc;       // error: 'inc' is a non-escaping variable, so it cannot be stored or returned; declare it 'escaping'
    fn(int) -> int later;                             // error: a 'fn(int) -> int' variable must be initialized where it is declared, since it cannot be reassigned

    inc = dec;                                      // error: 'inc' cannot be reassigned: a non-escaping variable keeps the function it was given; declare a new variable instead, or declare this one 'escaping'
    g = () -> {};                                   // error: 'g' cannot be reassigned: a non-escaping parameter keeps the function it was given; declare a new variable instead, or declare this one 'escaping'
    dec = inc;                                      // error: 'inc' is a non-escaping variable, so it cannot be stored or returned; declare it 'escaping'

    keep(g);                                        // error: 'g' is a non-escaping parameter, so it cannot be stored or returned; declare it 'escaping'
    var same = identity(inc);                       // error: 'inc' is a non-escaping variable, so it cannot be stored or returned; declare it 'escaping'
    var handlers = new List<fn() -> void>();
    handlers.add(g);                                // error: 'g' is a non-escaping parameter, so it cannot be stored or returned; declare it 'escaping'
    var listed = [dec, inc];                        // error: 'inc' is a non-escaping variable, so it cannot be stored or returned; declare it 'escaping'
    (fn(int) -> int)?[] table = new (fn(int) -> int)?[2];
    table[0] = inc;                                 // error: 'inc' is a non-escaping variable, so it cannot be stored or returned; declare it 'escaping'
    var functions = new (fn(int) -> int)[2];          // error: 'fn(int) -> int' has no default value to fill a new array with; use 'new Array<fn(int) -> int>(length, value)'
    escaping fn(int) -> int chosen = flag ? dec : inc; // error: 'inc' is a non-escaping variable, so it cannot be stored or returned; declare it 'escaping'
    var maybeInc = flag ? inc : null;               // error: 'inc' is a non-escaping variable, so it cannot be stored or returned; declare it 'escaping'
    escaping fn(int) -> int lambda = flag ? x -> x : inc; // error: 'inc' is a non-escaping variable, so it cannot be stored or returned; declare it 'escaping'
}

class Base {
    virtual void on(escaping fn() -> void f) {
    }

    virtual void off(fn() -> void f) {
    }
}

class Derived extends Base {
    override void on(fn() -> void f) {                // error: 'on' must have the same parameter and return types as 'Base.on' to override it; parameter 'f' is 'escaping' in 'Base.on' but not here
    }

    override void off(escaping fn() -> void f) {     // error: 'off' must have the same parameter and return types as 'Base.off' to override it; parameter 'f' is 'escaping' here but not in 'Base.off'
    }
}

interface Listener {
    mut void listen(escaping fn() -> void f);
}

class Quiet implements Listener {
    void listen(fn() -> void f) {                     // error: 'Quiet.listen' must have the same parameter and return types as 'Listener.listen(escaping fn() -> void)' to implement it; parameter 'f' is 'escaping' in 'Listener.listen(escaping fn() -> void)' but not here
    }
}

class Events {
    void on(fn() -> void f) {
    }

    void on(escaping fn() -> void f) {               // error: method 'on(escaping fn() -> void)' is already defined as 'on(fn() -> void)'; overloads cannot differ only in which parameters are 'escaping'
    }
}

void main() {
}
