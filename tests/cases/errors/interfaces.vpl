interface Shape {
    float area();
}

interface Named {
    readonly String name();
}

class Square implements Shape {         // error: 'Square' does not implement 'Shape.area()'
}

class Circle implements Shape {
    private float area() { return 1; }  // error: implements 'Shape.area()' and cannot be private
}

class Wrong implements Shape {
    int area() { return 1; }            // error: must have the same parameter and return types as 'Shape.area()'
}

struct Point implements Named {
    readonly String name() { return "p"; }
}

struct Changing implements Named {
    String name() { return "c"; }      // error: 'Changing.name' must be 'readonly', since it implements the 'readonly' method 'Named.name()'
}

// A class method never changes the reference it is called through.
class Label implements Named {
    String name() { return "l"; }
}

class Twice implements Shape, Shape {   // error: 'Shape' is listed more than once
    float area() { return 1; }
}

class NotInterface implements Point { } // error: 'Point' is not an interface

interface Sub extends Named {
    String name();                      // error: is already declared in interface 'Named'
}

interface Generic {
    void m<T>(T x);                     // error: interface methods cannot have type parameters
}

void describe<T extends Named>(T value) {
    print(value.name());
}

void area<T extends Shape>(T value) {
    print(value.name());                // error: 'T' has no method 'name'
}

void unbounded<T>(T value) {
    print(value.name());                // error: 'T' has no method 'name'
}

void badBound<T extends Point>(T value) { }   // error: 'Point' cannot be a bound

void main() {
    Named n = Point();                  // error: cannot implicitly convert 'Point' to 'Named'
    describe(Point());
    describe(1);                        // error: 'int' does not implement 'Named', which type parameter 'T' requires
    describe(new Circle());             // error: 'Circle' does not implement 'Named'
    Shape s = new Circle();
    Circle c = s;                       // error: cannot implicitly convert 'Shape' to 'Circle'
    var x = new Shape();                // error: cannot create an instance of interface 'Shape'
}
