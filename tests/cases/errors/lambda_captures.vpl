// An escaping lambda copies what it captures, so each captured local must not be 'mut', and can't be
// something only valid during the call.
struct Point {
    int x;

    mut void move() {
        x++;
    }

    int get() {
        return x;
    }

    mut () -> int getter() {
        return () -> x;                             // error: an escaping lambda cannot capture 'this' in a struct's method or constructor, since it is a reference to the struct; copy what the lambda needs to a local first
    }
}

void bump(ref int value) {
    value++;
}

void each((int) -> void f) {
    f(1);
}

void keep(@Escaping () -> int f) {
}

void parameters(ref int r, in int i, () -> int g, Span<int> view) {
    keep(() -> r);                                  // error: an escaping lambda cannot capture 'r', which is a 'ref' parameter; copy its value to a local first
    keep(() -> i);                                  // error: an escaping lambda cannot capture 'i', which is an 'in' parameter; copy its value to a local first
    keep(() -> g());                                // error: an escaping lambda cannot capture 'g', which is a non-escaping parameter; declare it '@Escaping'
    keep(() -> view[0]);                            // error: an escaping lambda cannot capture 'view', a 'Span<int>' that may not outlive what it views
}

void changes() {
    mut int assigned = 1;
    keep(() -> assigned);                           // error: an escaping lambda cannot capture 'assigned', which is 'mut', and the lambda would have only a copy; copy it to a variable that isn't 'mut'
    assigned = 2;

    // Only 'mut' decides, not whether the local actually changes.
    mut int unchanged = 1;
    keep(() -> unchanged);                          // error: an escaping lambda cannot capture 'unchanged', which is 'mut', and the lambda would have only a copy; copy it to a variable that isn't 'mut'

    mut var moved = Point(1);
    moved.move();
    keep(() -> moved.get());                        // error: an escaping lambda cannot capture 'moved', which is 'mut', and the lambda would have only a copy; copy it to a variable that isn't 'mut'

    var read = Point(1);
    keep(() -> read.get() + read.x);

    // Assigned once after its declaration, so not 'mut'.
    int late;
    late = 1;
    keep(() -> late);

    for (mut int i = 0; i < 2; i++) {
        keep(() -> i);                              // error: an escaping lambda cannot capture 'i', which is 'mut', and the lambda would have only a copy; copy it to a variable that isn't 'mut'
    }

    // An escaping lambda inside a non-escaping one.
    mut int outer = 0;
    each(x -> {
        keep(() -> outer + x);                      // error: an escaping lambda cannot capture 'outer', which is 'mut', and the lambda would have only a copy; copy it to a variable that isn't 'mut'
        outer = x;
    });
}

void copies() {
    int value = 1;
    var point = Point(1);
    keep(() -> {
        value = 2;                                  // error: cannot assign to 'value' because an escaping lambda only has a copy of 'value'
        point.x = 3;                                // error: cannot assign to 'point.x' because an escaping lambda only has a copy of 'point'
        point.move();                               // error: cannot call 'mut' method 'move' on 'point' because an escaping lambda only has a copy of 'point'
        bump(ref value);                            // error: cannot pass 'value' by 'ref' because an escaping lambda only has a copy of 'value'
        return value + point.get();
    });
    // A local the lambda declares is its own.
    keep(() -> {
        mut int own = 1;
        own++;
        return own;
    });
}

void main() {
}
