// Errors the binder finds in statements, before flow analysis, which runs only on a program that binds.

void returnsValue() {
    return 1;                 // error: returns 'void' and cannot return a value
}

int missingValue() {
    return;                   // error: must return a value of type 'int'
}

void main() {
    break;                    // error: 'break' can only be used inside a loop
}
