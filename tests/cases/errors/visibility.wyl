import std::{List, memory};

pub class Base {
    pub virtual void shown() { }
    pub(package) virtual void engine() { }
    virtual void local() { }
}

pub class Derived extends Base {
    override void shown() { }                   // error[WYL0126]: 'shown' must have 'pub'
    pub override void engine() { }              // error[WYL0126]: 'engine' must have 'pub(package)'
    pub(module) override void local() { }       // error[WYL0126]: 'local' must have no visibility
}

pub interface Named {
    String name();
}

pub struct Tag implements Named {
    pub(package) String name() { return "tag"; }    // error[WYL0187]: 'Tag.name' must have 'pub'
}

struct Secret {
