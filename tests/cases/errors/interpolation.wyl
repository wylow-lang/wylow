import std::print;

struct Plain {
    int x;
}

// Has the method, but hasn't opted in.
struct Unmarked {
    String toString() { return "unmarked"; }
}

struct Counted implements Printable {
    pub int toString() { return 1; }  // error[WYL0188]: 'Counted.toString' does not match the parameter and return types of 'Printable.toString()'
}

struct Changing implements Printable {
    pub mut String toString() { return "changing"; }  // error[WYL0190]: 'Changing.toString' cannot be 'mut'
}

class Animal implements Printable {
    pub String toString() { return "animal"; }
}

String describe<T extends Printable>(T value) { return $"{value}"; }

void nothing() {
}

void main() {
    var plain = Plain(1);
    print($"{plain}");                  // error[WYL0336]: cannot interpolate a value of type 'Plain'
    print($"{Unmarked()}");             // error[WYL0336]: cannot interpolate a value of type 'Unmarked'
    print($"{null}");                   // error[WYL0336]: cannot interpolate a value of type 'null'
    print($"{nothing()}");              // error[WYL0336]: cannot interpolate a value of type 'void'
    print(describe(plain));             // error[WYL0208]: 'Plain' does not implement 'Printable'
    Animal? maybe = null;
    print(describe(maybe));             // error[WYL0208]: 'Animal?' does not implement 'Printable'
    int? count = 1;
    print(describe(count));             // error[WYL0208]: 'int?' does not implement 'Printable'
    print(5.toString(1));               // error[WYL0233]: no overload of 'int.toString' takes 1 argument
    print(true.toString<int>());        // error[WYL0234]: no overload of 'bool.toString' takes 1 type argument
    int x = 1;
    print($"{x:F2}");                   // error[WYL0340]: format specifier 'F2' cannot format a value of type 'int'
    print($"{1.5:D}");                  // error[WYL0340]: format specifier 'D' cannot format a value of type 'float'
    print($"{"text":X}");               // error[WYL0340]: format specifier 'X' cannot format a value of type 'String'
    print($"{new Animal():F2}");            // error[WYL0340]: format specifier 'F2' cannot format a value of type 'Animal'
    print($"{x:Q}");                    // error[WYL0339]: cannot find format specifier 'Q'
    print($"{x:F123}");                 // error[WYL0338]: 'F123' is not a format specifier
    print($"{x:}");                     // error[WYL0338]: '' is not a format specifier
    print($"{x:D 2}");                  // error[WYL0338]: 'D 2' is not a format specifier
    print($"{undefined}");              // error[WYL0281]: cannot find 'undefined' in this scope
}
