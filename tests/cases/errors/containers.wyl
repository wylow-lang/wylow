import std::{List, print};

class Enemy {
}

struct Counter implements Borrowable {     // error[WYL0420]: only classes can be 'Borrowable'
    mut void beginBorrow() {
    }

    mut void endBorrow() {
    }
}

void main() {
    Enemy[] squad = new Enemy[3];           // error[WYL0078]: cannot fill a new array with default values of 'Enemy'
    var team = new Array<Enemy>(3);         // error[WYL0078]: cannot fill a new array with default values of 'Enemy'
    var list = new List<int>();
    list.beginBorrow();                     // error[WYL0419]: 'beginBorrow' cannot be called directly
    var numbers = new int[3];
    numbers.length = 4;                     // error[WYL0351]: cannot assign to 'numbers.length'
    print(list.size);                       // error[WYL0054]: field 'List.size' is not visible here
    Span<int> view = list;
    List<int> other = new List<int>();
    view = other;                           // error[WYL0417]: cannot reassign 'view'
    long[] wide = new int[2];               // error[WYL0079]: expected 'Array<long>', found 'Array<int>'
}
