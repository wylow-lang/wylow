import std::print;

String? maybe() {
    return null;
}

void main() {
    String s = "abc";
    for (ref char c : s) {              // error[WYL0357]: characters of a string cannot be borrowed with 'ref'
        print(c);
    }
    for (in char c : s) {               // error[WYL0357]: characters of a string cannot be borrowed with 'in'
    }
    for (byte b : s) {                  // error[WYL0079]: expected 'byte', found 'char'
    }
    for (long i, char c : s) {          // error[WYL0364]: loop index type: expected 'int', found 'long'
    }
    for (char c : maybe()) {            // error[WYL0353]: cannot loop over 'String?'
    }
    s.charAt(0);                        // error[WYL0054]: method 'String.charAt' is not visible here
}
