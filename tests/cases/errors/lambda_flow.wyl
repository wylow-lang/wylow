void call(fn() -> void f) {
    f();
}

void check() {
    int unassigned;
    call(() -> {
        std::print(unassigned);                     // error[WYL0394]: 'unassigned' might not have been assigned
    });

    int? outside = 5;
    if (outside != null) {
        call(() -> {
            int value = outside;                    // error[WYL0397]: 'outside' might be null
        });
    }

    mut int? cleared = 5;
    call(() -> {
        cleared = null;
    });
    if (cleared != null) {
        int value = cleared;                        // error[WYL0397]: 'cleared' might be null
    }

    // Narrowing ends where the lambda is made, not before it.
    mut int? later = 5;
    if (later != null) {
        int before = later;
    }
    call(() -> {
        later = null;
    });
    if (later != null) {
        int after = later;                          // error[WYL0397]: 'later' might be null
    }

    // A lambda made late in a loop may run in the next iteration.
    mut int? looped = 5;
    for (int i : 0..2) {
        if (looped != null) {
            int early = looped;                     // error[WYL0397]: 'looped' might be null
        }
        call(() -> {
            looped = null;
        });
    }

    mut int assignedInside;
    call(() -> {
        assignedInside = 1;
    });
    std::print(assignedInside);                     // error[WYL0394]: 'assignedInside' might not have been assigned

    fn(int) -> int sign = x -> {
        if (x > 0) {
            return 1;
        }
    };                                              // error[WYL0401]: lambda must return a value on every path
}

void main() {
}
