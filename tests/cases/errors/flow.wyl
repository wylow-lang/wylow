int noReturn(int n) {
    if (n > 0) {
        return 1;
    }
}                             // error[WYL0401]: 'noReturn' must return a value on every path

void main() {
    int x;
    std::print(x);            // error[WYL0394]: 'x' might not have been assigned
    int y;
    if (x > 0) {
        y = 1;
    }
    std::print(y);            // error[WYL0394]: 'y' might not have been assigned
}
