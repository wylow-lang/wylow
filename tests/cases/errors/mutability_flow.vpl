// A variable declared without a value can be assigned once.
void deferred(bool c) {
    int once;
    once = 1;
    once = 2;                               // error: 'once' might already have been assigned; declare it 'mut' to assign it more than once

    int branches;
    if (c) {
        branches = 1;
    }
    branches = 2;                           // error: 'branches' might already have been assigned

    int looped;
    while (c) {
        looped = 1;                         // error: 'looped' might already have been assigned
    }

    // Each iteration declares a new one.
    while (c) {
        int fresh;
        fresh = 1;
        print(fresh);
    }
}

void main() { }
