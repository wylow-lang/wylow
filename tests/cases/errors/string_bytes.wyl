class Named {
    mut String name = "a";

    ReadOnlySpan<byte> view() {
        return name.bytes();            // error[WYL0242]: returned 'ReadOnlySpan<byte>' must view the method's receiver
    }
}

struct Holder {
    ReadOnlySpan<byte> bytes;           // error[WYL0418]: 'ReadOnlySpan<byte>' cannot be the type of a field
}

void main() {
    String s = "abc";
    s.bytes()[0] = 1;                   // error[WYL0351]: cannot assign to 's.bytes()[0]'
    Span<byte> writable = s.bytes();    // error[WYL0079]: expected 'Span<byte>', found 'ReadOnlySpan<byte>'
}
