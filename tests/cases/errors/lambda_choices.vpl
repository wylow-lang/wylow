enum Op {
    Add(int amount),
    Stop,
}

void main() {
    Op op = Op.Add(1);
    (int) -> int inc = x -> x + 1;

    // The lambdas a switch expression chooses from are made outside its cases.
    (int) -> int f = switch (op) {
        case Add(var a) -> x -> x + a;              // error: a lambda chosen by a switch expression cannot use 'a', which its case declares
        case Stop -> op is Add(var b) ? x -> b : inc; // error: a lambda chosen by a switch expression cannot use 'b', which its case declares
    };

    var u = op is Stop ? x -> x : y -> y;            // error: a lambda needs a function type from where it is used

    var g = switch (op) {
        case Add(_) -> x -> x;                      // error: a lambda needs a function type from where it is used
        case Stop -> y -> y;                        // error: a lambda needs a function type from where it is used
    };

    var h = switch (op) {                           // error: '((int) -> int)?' is not supported yet
        case Add(_) -> inc;
        case Stop -> null;
    };
}
