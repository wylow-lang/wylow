import std::print;

enum IoError { Missing }
enum ParseError { Bad }

Result<int, IoError> read() {
    return Ok(1);
}

Result<int, ParseError> parse() {
    int a = try read();                 // error: 'try' would return an error of type 'IoError' from 'parse', whose error type is 'ParseError'
    return Ok(a);
}

Result<int, ParseError> parseLater() {
    fn() -> Result<int, ParseError> later = () -> {
        int a = try read();             // error: 'try' would return an error of type 'IoError' from this lambda, whose error type is 'ParseError'
        return Ok(a);
    };
    return later();
}

int plain() {
    int a = try read();                 // error: 'try' can only be used in a function that returns a 'Result'
    return a;
}

struct Holder {
    Result<int, IoError> result;
}

class Box {
    Result<int, IoError> result;        // error: field 'result' of type 'Result<int, IoError>' has no default value
}

Result<int, IoError> uses() {
    read();                             // error: the 'Result' returned by 'read' is not used; handle it, or discard it with '_ = ...'
    _ = read();
    _ = 1 + 2;
    _ = print(1);                       // error: there is no value to discard
    try read();
    int b = try 5;                      // error: 'try' needs a 'Result', not 'int'
    int c = 1 + try 5;                  // error: 'try' needs a 'Result', not 'int'
    var h = Holder();                   // error: 'Holder' has no default value because field 'result' has type 'Result<int, IoError>'
    Result<int, IoError> r = read();
    var e = Ok(1);                      // error: function 'Ok' is not defined; to create the 'Result' variant, write 'Result<...>.Ok', or use it where a 'Result' is expected
    return r;
}

// Arguments get no expected type when the overloads disagree, or from a generic function's own type parameters.
void store(Result<int, IoError> r) { }
void store(Result<long, IoError> r) { }
T unwrap<T>(Result<T, IoError> r) { return r.orPanic("none"); }

void arguments() {
    store(Ok(1));                       // error: function 'Ok' is not defined
    store(Result.Ok(1));                // error: cannot infer type argument 'E' of 'Result' from 'Ok'
    print(unwrap(Result.Ok(1)));        // error: cannot infer type argument 'E' of 'Result' from 'Ok'
    store(Result<int, IoError>.Ok(1));
    print(unwrap(Result<int, IoError>.Ok(2)));
}

void main() { }
