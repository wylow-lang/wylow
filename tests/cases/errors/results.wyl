enum IoError { Missing }
enum ParseError { Bad }

Result<int, IoError> read() {
    return Ok(1);
}

Result<int, ParseError> parse() {
    int a = try read();                 // error[WYL0335]: error type of 'try': expected 'ParseError', found 'IoError'
    return Ok(a);
}

Result<int, ParseError> parseLater() {
    fn() -> Result<int, ParseError> later = () -> {
        int a = try read();             // error[WYL0335]: error type of 'try': expected 'ParseError', found 'IoError'
        return Ok(a);
    };
    return later();
}

int plain() {
    int a = try read();                 // error[WYL0334]: 'try' can only be used in a function that returns a 'Result'
    return a;
}

struct Holder {
    Result<int, IoError> result;
}

class Box {
    Result<int, IoError> result;        // error[WYL0143]: field 'result' of type 'Result<int, IoError>' has no initial value
}

Result<int, IoError> uses() {
    read();                             // error[WYL0421]: 'Result' returned by 'read' is not used
    _ = read();
    _ = 1 + 2;
    _ = std::print(1);                  // error[WYL0344]: '_ =' has no value to discard
    try read();
    int b = try 5;                      // error[WYL0332]: operand of 'try': expected a 'Result', found 'int'
    int c = 1 + try 5;                  // error[WYL0332]: operand of 'try': expected a 'Result', found 'int'
    var h = Holder();                   // error[WYL0102]: 'Holder' has no default value
    Result<int, IoError> r = read();
    var e = Ok(1);                      // error[WYL0281]: cannot find function 'Ok' in this scope
    return r;
}

// Arguments get no expected type when the overloads disagree, or from a generic function's own type parameters.
void store(Result<int, IoError> r) { }
void store(Result<long, IoError> r) { }
T unwrap<T>(Result<T, IoError> r) { return r.orPanic("none"); }

void arguments() {
    store(Ok(1));                       // error[WYL0281]: cannot find function 'Ok' in this scope
    store(Result.Ok(1));                // error[WYL0160]: cannot infer type argument 'E' of 'Result' from 'Ok'
    std::print(unwrap(Result.Ok(1)));   // error[WYL0160]: cannot infer type argument 'E' of 'Result' from 'Ok'
    store(Result<int, IoError>.Ok(1));
    std::print(unwrap(Result<int, IoError>.Ok(2)));
}

void main() { }
