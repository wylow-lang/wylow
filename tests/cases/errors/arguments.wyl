struct Vec3 {
    internal {
        float x, y, z;
    }
}

struct Holder<T> {
    internal {
        int count;
        T? item;
    }
}

struct Tag {
    internal {
        int id;

        Tag(int value = 1) { id = value; }   // error: a struct constructor cannot have a default value for every parameter, since 'Tag()' is always the default value
    }
}

class Player {
    internal {
        String name;
        Player(String name) { this.name = name; }
    }
}

struct Hit {
    internal {
        Player target;
        int damage = 10;
    }
}

int compute() { return 1; }

String spawn(Vec3 pos, int count = 1, float spread = 0.5) { return "spawned"; }

void notConstant(int x = compute()) {}                 // error: a default value must be a constant or a struct constructor
void otherParameter(int x, int y = x) {}               // error: a default value must be a constant or a struct constructor
void byRef(ref int x = 1) {}                           // error: a 'ref' parameter cannot have a default value, since it must refer to a variable
void wrongType(int x = "text") {}                      // error: cannot implicitly convert 'String' to 'int'
void generic<T>(Holder<T> holder = Holder<T>()) {}     // error: the default value of 'holder' can only be 'null', since its type 'Holder<T>' involves a type parameter

String amb(int a, int b = 0) { return "int"; }
String amb(int a, String s = "") { return "String"; }

void pair(int a, long b) { }
void pair(long a, int b) { }

class Animal {
    internal {
        int size;

        virtual String speak(int times = 1) { return "..."; }
        String measure(int by = this.size) { return "measured"; }   // error: 'this' cannot be used here; default values cannot use 'this', fields, or instance methods
    }
}

class Dog extends Animal {
    internal {
        override String speak(int times = 2) { return "woof"; }   // error: 'Dog.speak' cannot declare default values, since it overrides or implements a method whose defaults it takes
    }
}

void main() {
    var pos = Vec3(0, 1, 0);
    spawn(pos, sprd: 2.0);                      // error: 'spawn' has no parameter named 'sprd'
    spawn(pos, spread: 2.0, count: 3);          // error: argument 'count' must come before 'spread', in the order of the parameters
    spawn(pos, 2, count: 3);                    // error: parameter 'count' is given more than one argument
    spawn(count: 3, pos);                       // error: a positional argument cannot follow a named one
    spawn();                                    // error: missing an argument for parameter 'pos' of 'spawn'
    spawn(pos, 1, 0.5, 4);                      // error: 'spawn' takes 3 arguments, but is given 4
    spawn(pos, count: "many");                  // error: no overload of 'spawn' accepts (Vec3, count: String)
    amb(1);                                     // error: call is ambiguous between 'amb(int, int)' and 'amb(int, String)'
    short narrow = 1;
    pair(narrow, narrow);                       // error: call is ambiguous between 'pair(int, long)' and 'pair(long, int)'
    Hit(damage: 3);                             // error: 'Hit' needs a value for field 'target', since its type 'Player' has no default value
    Vec3(z: 1, x: 2);                           // error: argument 'x' must come before 'z', in the order of the parameters
    (int) -> void callback = (int x) -> {};
    callback(x: 1);                             // error: arguments to 'callback' cannot be named, since a function type's parameters have no names
}
