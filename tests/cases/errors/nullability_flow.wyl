// A nullable local is used as its non-null type only where a null check narrows it (spec 02-types.md).

import std::{List, print};

class Node {
    int value;
    Node? next;
}

void take(Node n) { }

String? maybeString() {
    return null;
}

void throughRef(ref int? count) {
    if (count != null) {
        print(count + 1);               // error[WYL0397]: 'count' might be null
    }
}

void main() {
    Node? maybe = null;
    print(maybe.value);                 // error[WYL0397]: 'maybe' might be null
    take(maybe);                        // error[WYL0397]: 'maybe' might be null
    var n = new Node();

    // Narrowing ends when the local may be reassigned to null.
    mut Node? cur = n;
    while (cur != null) {
        cur = cur.next;
    }
    mut Node? loop = n;
    if (loop != null) {
        while (true) {
            print(loop.value);          // error[WYL0397]: 'loop' might be null
            loop = loop.next;           // error[WYL0397]: 'loop' might be null
        }
    }
    if (maybe != null || maybe.value == 1) { }  // error[WYL0397]: 'maybe' might be null
    bool some = n.value > 0;
    if (some ? maybe != null : true) {
        print(maybe.value);             // error[WYL0397]: 'maybe' might be null
    }
    // Only a condition narrows, not a variable holding what one found.
    bool found = maybe != null;
    if (found) {
        print(maybe.value);             // error[WYL0397]: 'maybe' might be null
    }

    int? maybeInt = null;
    print(maybeInt.toString());         // error[WYL0397]: 'maybeInt' might be null
    String? unchecked = maybeString();
    for (char c : unchecked) {          // error[WYL0397]: 'unchecked' might be null
    }
    List<int>? list = null;
    for (int item : list) {             // error[WYL0397]: 'list' might be null
    }
}
