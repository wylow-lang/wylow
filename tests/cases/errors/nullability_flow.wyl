// A nullable local is used as its non-null type only where a null check narrows it (spec flow.narrowing).

import std::collections::List;

class Node {
    int value;
    Node? next;
}

void take(Node n) { }

String? maybeString() {
    return null;
}

void throughRef(ref int? count) {
    if (count != null) {
        std::print(count + 1);          // error[WYL0397]: 'count' might be null
    }
}

void main() {
    Node? maybe = null;
    std::print(maybe.value);            // error[WYL0397]: 'maybe' might be null
    take(maybe);                        // error[WYL0397]: 'maybe' might be null
    var n = new Node();

    // Narrowing ends when the local may be reassigned to null.
    mut Node? cur = n;
    while (cur != null) {
        cur = cur.next;
    }
    mut Node? walk = n;
    if (walk != null) {
        while (true) {
            std::print(walk.value);     // error[WYL0397]: 'walk' might be null
            walk = walk.next;           // error[WYL0397]: 'walk' might be null
        }
    }
    if (maybe != null || maybe.value == 1) { }  // error[WYL0397]: 'maybe' might be null
    bool some = n.value > 0;
    if (some ? maybe != null : true) {
        std::print(maybe.value);        // error[WYL0397]: 'maybe' might be null
    }
    // Only a condition narrows, not a variable holding what one found.
    bool found = maybe != null;
    if (found) {
        std::print(maybe.value);        // error[WYL0397]: 'maybe' might be null
    }

    int? maybeInt = null;
    std::print(maybeInt.toString());    // error[WYL0397]: 'maybeInt' might be null
    String? unchecked = maybeString();
    for (char c : unchecked) {          // error[WYL0397]: 'unchecked' might be null
    }
    List<int>? list = null;
    for (int item : list) {             // error[WYL0397]: 'list' might be null
    }
}
