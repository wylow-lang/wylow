import std::{memory, print};

struct Raw {
    int* data;

    @CallerLocation                     // error: '@CallerLocation' can only be used on functions, methods, and constructors
    int count;

    unsafe Raw(int* data) {
        this.data = data;
    }

    mut int first() {
        return data[0];                 // error: indexing a pointer is only allowed in 'unsafe' code
    }
}

@Fast                                   // error: unknown annotation '@Fast'
void fast() {
}

extern void native();                   // error: extern functions are only supported in the standard library

class Base {
    @CallerLocation
    virtual void check() {              // error: '@CallerLocation' cannot be used on virtual, abstract, or interface methods yet
    }
}

void main() {
    int* p = memory::allocate<int>(4);   // error: 'allocate' is unsafe and can only be called from 'unsafe' code
    int* q = p + 1;                     // error: pointer arithmetic is only allowed in 'unsafe' code
    Raw r = Raw(p);                     // error: constructor 'Raw(int*)' is unsafe
    unsafe {
        Raw ok = Raw(p);
        print(ok.data[0] + q[0]);
        long* wrong = p;                // error: cannot implicitly convert 'int*' to 'long*'
        print(p * 2);                   // error: operator '*' cannot be applied to 'int*' and 'int'
    }
}
