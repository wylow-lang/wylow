// A function used as a value needs a function type to be converted to, and can only be a free
// function or static method.

class Task {
    int score(int x) {
        return x;
    }

    void test() {
        fn(int) -> int f = score;                     // error[WYL0275]: instance method 'score' cannot be used as a value
        var g = score;                              // error[WYL0280]: function 'score' is used as a value
    }

    static int rank(int x) {
        return x;
    }
}

int inc(int x) {
    return x + 1;
}

int add(int a, int b) {
    return a + b;
}

int add(int a) {
    return a;
}

String name(Task m) {
    return "task";
}

int apply(fn(int) -> int f, int value) {
    return f(value);
}

long apply(fn(long) -> long f, long value) {
    return f(value);
}

int applyInt(fn(int) -> int f, int value) {
    return f(value);
}

int pair(int a, fn(int, int) -> int f) {
    return f(a, a);
}

int pair(long a, fn(int) -> int f) {
    return f(1);
}

void main() {
    var f = inc;                                    // error[WYL0280]: function 'inc' is used as a value
    var r = Task.rank;                               // error[WYL0280]: method 'Task.rank' is used as a value
    int n = inc;                                    // error[WYL0280]: function 'inc' is used as a value
    std::print(applyInt(name, 1));                  // error[WYL0236]: no overload of 'name' accepts (int)
    fn(int, int) -> int two = inc;                    // error[WYL0233]: no overload of 'inc' takes 2 arguments
    fn(int) -> String text = inc;                     // error[WYL0079]: expected 'String', found 'int'
    std::print(apply(inc, 1));                      // error[WYL0237]: call to 'apply' is ambiguous
    std::print(pair(1, add));                       // error[WYL0276]: 'add' can only be used as a value where a function type is expected
    var chosen = n > 0 ? inc : inc;                 // error[WYL0277]: function 'inc' can only be used as a value where a function type is expected
}
