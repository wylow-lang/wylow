struct Plain {
    int x;
}

// Has the method, but hasn't opted in.
struct Unmarked {
    String toString() { return "unmarked"; }
}

struct Counted implements Printable {
    int toString() { return 1; }  // error: 'Counted.toString' must have the same parameter and return types as 'Printable.toString()' to implement it
}

struct Changing implements Printable {
    mut String toString() { return "changing"; }  // error: 'Changing.toString' cannot be 'mut', since 'Printable.toString()' isn't
}

class Animal implements Printable {
    String toString() { return "animal"; }
}

String describe<T extends Printable>(T value) { return $"{value}"; }

void nothing() {
}

void main() {
    var plain = Plain(1);
    print($"{plain}");                  // error: cannot interpolate a value of type 'Plain', which does not implement 'Printable'
    print($"{Unmarked()}");             // error: cannot interpolate a value of type 'Unmarked', which does not implement 'Printable'; its 'toString()' is used once 'Unmarked' declares 'implements Printable'
    print($"{null}");                   // error: cannot interpolate a value of type 'null', which does not implement 'Printable'
    print($"{nothing()}");              // error: cannot interpolate a value of type 'void', which does not implement 'Printable'
    print(describe(plain));             // error: 'Plain' does not implement 'Printable', which type parameter 'T' requires
    Animal? maybe = null;
    print(describe(maybe));             // error: 'Animal?' does not implement 'Printable', which type parameter 'T' requires
    print(5.toString(1));               // error: no overload of 'int.toString' takes 1 argument
    print(true.toString<int>());        // error: 'bool.toString' takes no type arguments
    int x = 1;
    print($"{x:F2}");                   // error: format specifier 'F2' applies to 'float' and 'double', not 'int'
    print($"{1.5:D}");                  // error: format specifier 'D' applies to integers, not 'float'
    print($"{"text":X}");               // error: format specifier 'X' applies to integers, not 'String'
    print($"{new Animal():F2}");            // error: format specifier 'F2' applies to 'float' and 'double', not 'Animal'
    print($"{x:Q}");                    // error: unknown format specifier 'Q'; the specifiers are D, X, and B for integers and F and E for floating point
    print($"{x:F123}");                 // error: 'F123' is not a format specifier; write a letter and an optional precision of up to two digits, as in 'F2'
    print($"{x:}");                     // error: '' is not a format specifier; write a letter and an optional precision of up to two digits, as in 'F2'
    print($"{x:D 2}");                  // error: 'D 2' is not a format specifier; write a letter and an optional precision of up to two digits, as in 'F2'
}
