struct Vec2 {
    float x, y;
}

struct Scaled {
    float x, y;

    Scaled(float both) {
        x = both;
        y = both;
    }
}

struct Hidden {
    int shown;
    private int secret;
}

void main() {
    var a = Vec2(1);                    // error: no constructor of 'Vec2' takes 1 argument
    var b = Vec2(1, "two");             // error: no constructor of 'Vec2' accepts (int, String)
    var c = Scaled(1, 2);               // error: no constructor of 'Scaled' takes 2 arguments
    var d = Hidden(1, 2);               // error: constructor 'Hidden(int, int)' is private
}
