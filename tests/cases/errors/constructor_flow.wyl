// A constructor assigns every field without a default before it uses 'this' or returns.

import std::print;

class Item { }

class Partial {
    Item item;
    Item other;
    int count;

    Partial(bool flag) {
        print(count);
        use(this);                      // error[WYL0400]: 'this' cannot be used until every field is assigned
        print(item == null);            // error[WYL0399]: field 'item' might not have been assigned
        item = new Item();
        if (flag) {
            other = item;
            return;
        }
    }                                   // error[WYL0398]: field 'other' must be assigned before the constructor returns

    Partial(int early) {
        if (early > 0) {
            return;                     // error[WYL0398]: field 'item' must be assigned before the constructor returns
        }
        item = new Item();
        other = item;
        use(this);
    }
}

struct Holder {
    Item item;

    Holder(int x) {
        describe();                     // error[WYL0400]: 'this' cannot be used until every field is assigned
        item = new Item();
    }

    mut void describe() { }
}

// A constructor that chains has every field once 'this(...)' returns, since the constructor it
// calls had to assign them; that one is still checked.
class Chain {
    Item item;

    Chain(Item item, bool flag) {
        if (flag) {
            this.item = item;
        }
    }                                   // error[WYL0398]: field 'item' must be assigned before the constructor returns

    Chain(Item item) {
        this(item, true);
        useChain(this);
        print(this.item == null);
    }
}

struct ChainHolder {
    Item item;

    ChainHolder(Item item) {
        this.item = item;
    }

    ChainHolder(int x) {
        this(new Item());
        describe();
    }

    ChainHolder(bool flag) {
        describe();                     // error[WYL0400]: 'this' cannot be used until every field is assigned
        this = ChainHolder(new Item());
        describe();
    }

    mut void describe() { }
}

void use(Partial p) { }

void useChain(Chain c) { }

void main() { }
