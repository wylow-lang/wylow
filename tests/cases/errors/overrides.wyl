interface A {
    void f(int x = 1);
}

interface B {
    void f(int x = 2);
}

class AB implements A, B {
    void f(int x) { }                      // error[WYL0214]: 'AB.f' inherits different default values for parameter 'x'
}

class Static implements A {
    static void f(int x) { }               // error[WYL0186]: static method 'Static.f' cannot implement 'A.f(int)'
}

class Base {
    Base() { }
    void g() { }
}

class Derived extends Base {
    Derived() { super(); }
    override void g() { }           // error[WYL0124]: cannot override 'Base.g'
}

struct Loop {
    int v;
    Loop(int a, Loop seed = Loop(1)) { v = a; }  // error[WYL0215]: default value of 'seed' depends on itself
}

void main() {
    int[3] cells = [1, 2, 3];
    for (ref int i, int v : cells) { }  // error[WYL0363]: loop index cannot be borrowed
}
