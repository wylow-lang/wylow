// A guard narrows and assigns into its case only where it is known to be true, as an 'if'
// condition does.
import std::print;

class Account {
    int total;

    Account(int total) {
        this.total = total;
    }
}

enum State { Idle, Chasing(Account? target) }

void use(State st, bool flag) {
    switch (st) {
        case Chasing(var t) when t != null || flag -> print(t.total);      // error[WYL0397]: 't' might be null
        case Chasing(var t) when t is Account e || flag -> print(e.total);   // error[WYL0394]: 'e' might not have been assigned
        case Chasing(var t) when t is Account e && flag -> print(e.total);
        default -> print(0);
    }
}

void main() { }
