// What 'operator []=' must be, and where an element it assigns is not a place (spec functions.indexers.setters).

struct Grid {
    int[4] cells;

    int operator [](int i) {
        return cells[i];
    }

    int operator [](String key) {
        return 0;
    }

    mut void operator []=(int i, int value) {
        cells[i] = value;
    }

    ref int wrong(int i) {
        return ref this[i];             // error[WYL0407]: returned 'ref' must refer to a variable, field, or element
    }
}

struct Both {
    int[4] cells;

    mut ref int operator [](int i) {
        return ref cells[i];
    }

    mut void operator []=(int i, int value) {   // error[WYL0250]: 'Both' cannot have both 'operator []=' and an 'operator []' that returns 'ref'
        cells[i] = value;
    }
}

class Base {
    mut int[4] cells;

    ref int operator [](int i) {
        return ref cells[i];
    }
}

class Derived extends Base {
    void operator []=(int i, int value) {       // error[WYL0250]: 'Derived' cannot have both 'operator []=' and an 'operator []' that returns 'ref'
    }
}

struct Shapes {
    int[4] cells;

    int operator [](int i) {
        return cells[i];
    }

    in? int operator [](short i) {
        return null;
    }

    int operator []=(int i, int value) {        // error[WYL0251]: 'operator []=' must return 'void'
        return 0;
    }

    mut void operator []=(int i) {              // error[WYL0253]: 'operator []=' must take the indices, then the assigned value
    }

    mut void operator []=(long i, int value) {  // error[WYL0256]: 'operator []=' has no matching 'operator [](long)'
    }

    mut void operator []=(short i, int value) { // error[WYL0256]: 'operator []=' has no matching 'operator [](short)'
    }

    mut void operator []=(int i, ref long value) {  // error[WYL0255]: value of 'operator []=' cannot be 'ref'
    }

    mut void operator []=(int i, long value) {  // error[WYL0257]: value of 'operator []=': expected 'int', found 'long'
    }

    static void operator []=(byte i, int value) {   // error[WYL0252]: 'operator []=' cannot be static
    }
}

struct Defaults {
    int operator [](int i, int j = 0) {
        return i + j;
    }

    mut void operator []=(int i, int j = 0, int value) {   // error[WYL0254]: 'operator []=' cannot have default values
    }
}

// Without an 'operator []', there is nothing to read an element with.
struct WriteOnly {
    mut void operator []=(int i, int value) {   // error[WYL0256]: 'operator []=' has no matching 'operator [](int)'
    }
}

class Maybe {
    mut int?[2] items;

    int? operator [](int i) {
        return items[i];
    }

    void operator []=(int i, int? value) {
        items[i] = value;
    }
}

class Holder {
    Grid fixed = Grid();
}

void bump(ref int x) {
    x += 1;
}

void change(in Grid read) {
    read[0] = 1;                        // error[WYL0105]: cannot call 'mut' method 'operator []=' on 'read'
}

void main() {
    Grid grid = Grid();
    grid[0] = 1;                        // error[WYL0105]: cannot call 'mut' method 'operator []=' on 'grid'
    mut Grid g = Grid();
    g["torch"] = 1;                     // error[WYL0249]: cannot assign an element of 'Grid'
    g[0] = "one";                       // error[WYL0079]: expected 'int', found 'String'
    ref int r = g[0];                   // error[WYL0407]: 'ref' variable must refer to a variable, field, or element
    bump(ref g[0]);                     // error[WYL0222]: 'ref' argument must be a variable, field, or element
    var holder = new Holder();
    holder.fixed[0] += 1;               // error[WYL0105]: cannot call 'mut' method 'operator []=' on 'holder.fixed'
    var maybe = new Maybe();
    maybe[0]++;                         // error[WYL0347]: '++' can only be applied to a numeric variable
    mut WriteOnly w = WriteOnly();
    w[0] = 1;                           // error[WYL0306]: 'WriteOnly' cannot be indexed
}
