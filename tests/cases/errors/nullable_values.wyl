struct Vec {
    int x;
    int[2] pair;

    mut void move(int dx) {
        x += dx;
    }

    mut void moveWith(ref Vec? other) {
        other = null;
        x += 1;
    }
}

struct Buf implements Spannable<int> {
    int[2] data;

    pub ReadOnlySpan<int> asReadOnlySpan() {
        return data;
    }

    pub mut Span<int> asSpan() {
        return data;
    }

    mut ref? int first() {
        return ref data[0];
    }
}

enum Direction { North, East }

struct Link {                           // error[WYL0106]: struct 'Link' contains itself
    Link? next;
}

struct Span2 {
    Span<int>? view;                    // error[WYL0067]: 'Span<int>' cannot be nullable
}

int? maybe() {
    return null;
}

Direction? heading() {
    return null;
}

void reset(ref int? value) {
    value = null;
}

void read(in Vec v, ref Vec? other) { }

int clear(ref Vec? v) {
    v = null;
    return 0;
}

bool same<T>(T? a, T? b) {
    return a == b;                      // error[WYL0311]: operator '==' cannot be applied to 'T?' and 'T?'
}

void main() {
    int? x = maybe();
    std::print(maybe() + 1);            // error[WYL0308]: operator '+' cannot be applied to 'int?' and 'int'
    std::print(-maybe());               // error[WYL0307]: operator '-' cannot be applied to 'int?'
    if (x is long n) { }                // error[WYL0380]: pattern 'long' can never match a value of type 'int?'
    switch (heading()) {                // error[WYL0390]: cannot switch on a value of nullable type 'Direction?' without a 'case null'
        case North -> std::print(0);
        case East -> std::print(1);
    }
    escaping (fn() -> int)? f = null;
    std::print(f == f);                 // error[WYL0311]: operator '==' cannot be applied to '(fn() -> int)?' and '(fn() -> int)?'
    var none = 1 == 2 ? null : null;    // error[WYL0319]: branches of '?:' have incompatible types 'null' and 'null'

    ref int? alias = x;                 // error[WYL0410]: 'ref' variable cannot refer to nullable variable 'x'

    // Nothing may keep referring into a nullable value that could be destroyed meanwhile.
    mut Vec? v = Vec(x: 1);
    if (v != null) {
        v.move(1);
    }
    if (v != null) {
        ref int r = v.x;                // error[WYL0406]: 'ref' variable cannot refer into nullable 'v'
        in int[2] p = v.pair;           // error[WYL0406]: 'in' variable cannot refer into nullable 'v'
        Span<int> span = v.pair;        // error[WYL0079]: expected 'Span<int>', found 'int[2]'
        for (int e : v.pair) { }        // error[WYL0352]: cannot loop over elements inside nullable 'v'
    }
    mut Buf? b = Buf(data: [1, 2]);
    if (b != null) {
        ref int r = b.asSpan()[0];      // error[WYL0406]: 'ref' variable cannot refer into nullable 'b'
        for (int e : b.asSpan()) { }    // error[WYL0352]: cannot loop over elements inside nullable 'b'
        Span<int> s = b.asSpan();       // error[WYL0416]: 'Span<int>' cannot view inside nullable 'b'
        if (b.first() is ref int g) { } // error[WYL0406]: 'ref' binding cannot refer into nullable 'b'
        ref? int q = b.first();         // error[WYL0406]: 'ref?' variable cannot refer into nullable 'b'
        ref? long w = b.first();        // error[WYL0405]: 'ref?' variable of type 'long' cannot refer to a 'int'
    }
    v?.move(1);                         // error[WYL0317]: '?.' would call 'mut' method 'move' on a copy of 'v'
    std::print(v!.x);
    v!.x = 2;                           // error[WYL0348]: cannot assign to a field of a temporary value
}
