import std::print;

struct Vec {
    int x;
    int[2] pair;

    mut void move(int dx) {
        x += dx;
    }

    mut void moveWith(ref Vec? other) {
        other = null;
        x += 1;
    }
}

struct Buf implements Spannable<int> {
    int[2] data;

    pub ReadOnlySpan<int> asReadOnlySpan() {
        return data;
    }

    pub mut Span<int> asSpan() {
        return data;
    }

    mut ref? int first() {
        return ref data[0];
    }
}

enum Direction { North, East }

struct Link {                           // error: struct 'Link' contains itself (Link -> Link)
    Link? next;
}

struct Span2 {
    Span<int>? view;                    // error: 'Span<int>' cannot be nullable, since it is a 'ref struct'
}

int? maybe() {
    return null;
}

Direction? heading() {
    return null;
}

void reset(ref int? value) {
    value = null;
}

void read(in Vec v, ref Vec? other) { }

int clear(ref Vec? v) {
    v = null;
    return 0;
}

bool same<T>(T? a, T? b) {
    return a == b;                      // error: since 'T' does not support '=='
}

void main() {
    int? x = maybe();
    print(maybe() + 1);                 // error: operator '+' cannot be applied to 'int?' and 'int'; check it for null first
    print(-maybe());                    // error: operator '-' cannot be applied to 'int?'; check it for null first
    if (x is long n) { }                // error: a 'int?' can never be a 'long'
    switch (heading()) {                // error: cannot switch on a nullable 'Direction?'
        case North -> print(0);
        case East -> print(1);
    }
    @Escaping (() -> int)? f = null;
    print(f == f);                      // error: since '() -> int' does not support '=='
    var none = 1 == 2 ? null : null;    // error: the branches of '?:' have incompatible types 'null' and 'null'

    ref int? alias = x;                 // error: a 'ref' variable cannot refer to the nullable variable 'x'

    // Nothing may keep referring into a nullable value that could be destroyed meanwhile.
    mut Vec? v = Vec(x: 1);
    if (v != null) {
        v.move(1);
    }
    if (v != null) {
        ref int r = v.x;                // error: a 'ref' variable cannot refer into the nullable 'v'
        in int[2] p = v.pair;           // error: a 'in' variable cannot refer into the nullable 'v'
        Span<int> span = v.pair;        // error: a span cannot view inside the nullable 'v'
        for (int e : v.pair) { }        // error: cannot loop over elements inside the nullable 'v'
    }
    mut Buf? b = Buf(data: [1, 2]);
    if (b != null) {
        ref int r = b.asSpan()[0];      // error: a 'ref' variable cannot refer into the nullable 'b'
        for (int e : b.asSpan()) { }    // error: cannot loop over elements inside the nullable 'b'
        Span<int> s = b.asSpan();       // error: this 'Span<int>' would view inside the nullable 'b'
        if (b.first() is ref int g) { } // error: a 'ref' binding cannot refer into the nullable 'b'
        ref? int q = b.first();         // error: a 'ref?' variable cannot refer into the nullable 'b'
        ref? long w = b.first();        // error: a 'ref?' variable must have exactly the type of what it refers to, 'int', not 'long'
    }
    v?.move(1);                         // error: '?.' would call 'move' on a copy of 'v'
    print(v!.x);
    v!.x = 2;                           // error: cannot assign to a field of a temporary value
}
