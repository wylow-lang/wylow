pub struct A {
    pub int x;

    static int count;
    static mut void f() {          // error[WYL0238]: static method cannot be 'mut'
    }
}

struct Grid {
    int[4] cells;
    mut int size() {
        return 4;
    }
    ref? int first;                // error[WYL0404]: fields cannot be references
}

static void g() {                  // error[WYL0209]: 'static' cannot be used on a function
}

void main() {
    for (int i : 0..) {            // error[WYL0001]: expected an expression
    }
    var g = Grid { cells = [1, 2, 3, 4] };      // error[WYL0286]: fields cannot be set in braces after a construction
    var h = Grid(cells: [1, 2, 3, 4]) { };      // error[WYL0286]: fields cannot be set in braces after a construction
}
