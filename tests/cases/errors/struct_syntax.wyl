protected struct A {              // error: 'protected' is not valid on a struct
    protected {                    // error: structs cannot be inherited, so they have no 'protected' block
        int x;
    }

    internal {
        static int count;              // error: static fields are not supported yet
        static mut void f() {          // error: a static method cannot be 'mut'
        }
    }
}

struct Grid {
    internal {
        int[4] cells;
        mut int size() {
            return 4;
        }
        ref? int first;                // error: fields cannot be references; only methods can return 'ref' or 'in'
    }
}

static void g() {                  // error: 'static' is not valid on a function
}

void main() {
    for (int i : 0..) {            // error: expected an expression
    }
    var g = Grid { cells = [1, 2, 3, 4] };      // error: fields are set by naming them in the constructor call, as in 'Grid(field: value)'
    var h = Grid(cells: [1, 2, 3, 4]) { };      // error: fields are set by naming them in the constructor call, as in 'Grid(field: value)'
}
