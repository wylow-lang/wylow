// 'unsafe' marks functions, methods, constructors, blocks, and interfaces; nothing else.

unsafe class K { }                      // error[WYL0210]: 'unsafe' cannot be used on a class
unsafe struct S { }                     // error[WYL0210]: 'unsafe' cannot be used on a struct
unsafe enum E { A }                     // error[WYL0210]: 'unsafe' cannot be used on an enum

class F {
    unsafe int field;                   // error[WYL0109]: 'unsafe' cannot be used on a field
    unsafe ~F() { }                     // error[WYL0144]: 'unsafe' cannot be used on a destructor
}

interface I {
    unsafe int m();                     // error[WYL0176]: 'unsafe' cannot be used on an interface method
}

void main() { }
