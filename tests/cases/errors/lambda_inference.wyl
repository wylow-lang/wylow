import std::print;

U apply<T, U>(T value, fn(T) -> U f) {
    return f(value);
}

U run<U>(fn() -> U f) {
    return f();
}

void make<T, U>(fn(T) -> U f) {
}

U pick<U>(bool first, fn() -> U a, fn() -> U b) {
    return first ? a() : b();
}

U chain<U>(fn() -> U a, fn(U) -> U b) {
    return b(a());
}

void each<U>(fn(int) -> U f) {
}

void each<U>(fn(bool) -> U f) {
}

void both<U>(fn(int) -> U f) {
}

void both(fn(int) -> int f) {
}

Result<int, String> parse() {
    return Result.Ok(1);
}

void main() {
    print(apply(3, x -> x.name));                   // error[WYL0296]: cannot find member 'name' in 'int'
    make(x -> 1);                                   // error[WYL0201]: cannot infer type argument 'T' of 'make'
    print(pick(true, () -> 1, () -> "a"));          // error[WYL0204]: cannot infer type argument 'U' of 'pick'
    print(chain(() -> 1, x -> 2L));                 // error[WYL0204]: cannot infer type argument 'U' of 'chain'
    run(() -> print(1));                            // error[WYL0205]: cannot infer type argument 'U' of 'run' from a lambda that returns no value
    each(x -> 1);                                   // error[WYL0206]: cannot infer type argument 'U' of 'each' from a lambda
    both(x -> 1);                                   // error[WYL0206]: cannot infer type argument 'U' of 'both' from a lambda
    print(run(() -> x -> x));                       // error[WYL0260]: lambda has no function type to take
    print(run(() -> try parse()));                  // error[WYL0333]: 'try' cannot be used in a lambda whose return type is inferred
    print(run(() -> null));                         // error[WYL0203]: cannot infer type argument 'U' of 'run' from 'null'
    print(run(() -> {
        if (true) {
            return;                                 // error[WYL0372]: lambda must return a value of type 'int'
        }
        return 1;
    }));
    print(run<long>(() -> "a"));                    // error[WYL0079]: expected 'long', found 'String'
}
