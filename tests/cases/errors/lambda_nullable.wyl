// A nullable function parameter is non-escaping unless declared 'escaping', and only a parameter
// can hold a nullable non-escaping function.
class Holder {
    mut (fn(int) -> int)? stored = null;
}

void keep(escaping (fn(int) -> int)? f) {
}

(fn(int) -> int)? give((fn(int) -> int)? f) {
    return f;                                       // error[WYL0271]: non-escaping parameter 'f' cannot be stored or returned
}

void uses(bool flag, (fn(int) -> int)? f, fn(int) -> int g, Holder holder) {
    var copy = f;                                   // error[WYL0269]: variable of nullable function type must be declared 'escaping'
    escaping var kept = f;                         // error[WYL0271]: non-escaping parameter 'f' cannot be stored or returned
    holder.stored = f;                              // error[WYL0271]: non-escaping parameter 'f' cannot be stored or returned
    keep(f);                                        // error[WYL0271]: non-escaping parameter 'f' cannot be stored or returned
    keep(f!);                                       // error[WYL0271]: non-escaping parameter 'f' cannot be stored or returned
    f = null;                                       // error[WYL0268]: cannot reassign non-escaping parameter 'f'
    var fallback = f ?? g;                          // error[WYL0315]: '??' cannot be applied to a nullable non-escaping function
    keep(x -> f!(x));                               // error[WYL0273]: escaping lambda cannot capture 'f'
    // A choice of nullable function type is escaping, so it can't choose a non-escaping value.
    keep(flag ? g : null);                          // error[WYL0271]: non-escaping parameter 'g' cannot be stored or returned
    var chosen = flag ? g : null;                   // error[WYL0271]: non-escaping parameter 'g' cannot be stored or returned
}

void main() {
}
