// A variable declared without a value can be assigned once.

import std::print;

void deferred(bool c) {
    int once;
    once = 1;
    once = 2;                               // error[WYL0395]: 'once' might already have been assigned

    int branches;
    if (c) {
        branches = 1;
    }
    branches = 2;                           // error[WYL0395]: 'branches' might already have been assigned

    int looped;
    while (c) {
        looped = 1;                         // error[WYL0395]: 'looped' might already have been assigned
    }

    // Each iteration declares a new one.
    while (c) {
        int fresh;
        fresh = 1;
        print(fresh);
    }
}

void main() { }
