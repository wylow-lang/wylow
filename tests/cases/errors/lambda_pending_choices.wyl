enum Op {
    Add(int amount),
    Stop;
}

int run(fn(int) -> int f) {
    return f(1);
}

int run(fn(String) -> int f) {
    return f("a");
}

U apply<T, U>(T value, fn(T) -> U f) {
    return f(value);
}

void main() {
    Op op = Op.Add(1);
    bool up = true;
    fn(int) -> int inc = x -> x + 1;

    // A choice waits for its type, but the rules for choices still hold.
    std::print(apply(1, switch (op) {
        case Add(var n) -> x -> x + n;              // error[WYL0278]: lambda chosen by a switch expression cannot use 'n'
        case Stop -> inc;
    }));
    std::print(run(up ? x -> 1 : y -> 2));          // error[WYL0237]: call to 'run' is ambiguous
    std::print(apply(1, up ? x -> 1 : x -> "a"));   // error[WYL0204]: cannot infer type argument 'U' of 'apply'
    std::print(apply(1, up ? inc : x -> "a"));      // error[WYL0079]: expected 'int', found 'String'
    std::print(up ? x -> x : y -> y);               // error[WYL0236]: no overload of 'print' accepts (choice of lambdas)
    std::print(apply(1, up ? x -> x.name : inc));   // error[WYL0296]: cannot find member 'name' in 'int'
}
