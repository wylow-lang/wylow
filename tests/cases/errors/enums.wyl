import std::Weak;

enum Direction { North, East, South, West }

enum Repeated {
    A,
    A,                                  // error[WYL0161]: variant 'A' is already defined
    B(int x, int x),                    // error[WYL0099]: field 'x' is already defined
    ;

    void B() { }                        // error[WYL0097]: 'B' is already defined as a variant
}

@Repr(int)
enum Typed {
    Zero,
    Two = 2,
    AlsoTwo = 2,                        // error[WYL0170]: 'AlsoTwo' has the same value as 'Two'
    Three,
    Big = 3000000000,                   // error[WYL0173]: value does not fit in the enum's integer type 'int'
    Computed = 1 + 1,                   // error[WYL0172]: variant's value must be an integer literal
}

@Repr(float)                            // error[WYL0168]: '@Repr' type: expected an integer type, found 'float'
enum Floating { A }

@Repr(long)                             // error[WYL0167]: enum whose variants carry data cannot have '@Repr'
enum DataWithType {
    A(int x),
}

@Repr                                   // error[WYL0165]: '@Repr' takes one integer type
enum NoType { A }

@Repr(int)
@Repr(long)                             // error[WYL0166]: '@Repr' can only be given once
enum Twice { A }

@Repr(int)                              // error[WYL0432]: '@Repr' can only be used on enums
struct NotEnum { }

@Acyclic(1)                             // error[WYL0431]: '@Acyclic' takes no arguments
class Annotated { }

enum DataWithValue {
    A(int x),
    B = 1,                              // error[WYL0169]: only enums whose variants carry no data can give variants values
}

enum Chain { End, Link(Chain next) }    // error[WYL0106]: enum 'Chain' contains itself

enum Named { Label(String text) }

enum Option<T> { None, Some(T value) }

class Thing { }

enum Watched { On(Weak<Thing> target) }

void main() {
    var d = Direction();                // error[WYL0288]: enum 'Direction' cannot be constructed
    var n = new Direction();            // error[WYL0290]: enum 'Direction' cannot be created with 'new'
    var u = Up;                         // error[WYL0281]: cannot find 'Up' in this scope
    var e = East;                       // error[WYL0281]: cannot find 'East' in this scope
    var none = None;                    // error[WYL0281]: cannot find 'None' in this scope
    var some = Option.None;             // error[WYL0160]: cannot infer type argument 'T' of 'Option' from 'None'
    Direction p = Direction.Up;         // error[WYL0293]: cannot find static member 'Up' in 'Direction'
    var l = Named.Label;                // error[WYL0157]: variant 'Named.Label' carries data
    var x = Direction.North();          // error[WYL0158]: variant 'Direction.North' carries no data
    var two = Named.Label("a", "b");    // error[WYL0159]: values of 'Named.Label': expected 1, found 2
    var wrong = Named.Label(1);         // error[WYL0236]: no variant 'Named.Label' accepts (int)
    var explicit = Option<int>.Some("s"); // error[WYL0236]: no variant 'Option.Some' accepts (String)
    var typed = Option.Some<int>(1);    // error[WYL0197]: type arguments belong to the enum, not its variant
    var label = Named.Label("a");
    std::print(label.text);             // error[WYL0295]: fields of a variant can only be read with a pattern
    var watched = Watched.On(null);
    std::print(watched == watched);     // error[WYL0310]: operator '==' cannot be applied to 'Watched'
    std::print(Direction.East == 1);    // error[WYL0308]: operator '==' cannot be applied to 'Direction' and 'int'
    std::print(Direction.North < Direction.East); // error[WYL0308]: operator '<' cannot be applied to 'Direction' and 'Direction'
    std::print((int)label);             // error[WYL0083]: cannot cast 'Named' to 'int'
    std::print((Direction)1.5f);         // error[WYL0083]: cannot cast 'float' to 'Direction'
    Option<int> o = Some(1);
    Option<Thing> t = Some(1);          // error[WYL0236]: no variant 'Option.Some' accepts (int)
    mut Direction q = Direction.North;
    q = Wesst;                          // error[WYL0281]: cannot find 'Wesst' in this scope
}
