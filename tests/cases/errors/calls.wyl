// Mistakes in what a call constructs, what 'super' reaches, and what a nullable reaches.

import std::print;

interface Shape {
    int area();
}

abstract class Base {
    static void stat() { }
    abstract void take();
}

class Made extends Base {
    override void take() { }
    void call() {
        super.stat();               // error[WYL0303]: static method 'stat' cannot be called through a value
        super.take();               // error[WYL0131]: cannot call abstract method 'Base.take' through 'super'
        super.nope();               // error[WYL0300]: cannot find method 'nope' in 'Base'
    }
}

class Plain {
    void call() {
        super.nope();               // error[WYL0111]: 'super' cannot be used in 'Plain'
    }
}

enum Color { Red }

struct Pair {
    int a;
}

void globalCall() {
    super.nope();                       // error[WYL0112]: 'super' can only be used in instance methods and constructors of a class
}

void main() {
    var shape = Shape();                // error[WYL0180]: cannot create an instance of interface 'Shape'
    var made = Made();                  // error[WYL0287]: class 'Made' cannot be created without 'new'
    var color = Color();                // error[WYL0288]: enum 'Color' cannot be constructed
    print(Base.nope());                 // error[WYL0300]: cannot find method 'nope' in 'Base'
    mut int n = 1;
    print(n.compareTo<int>(1));         // error[WYL0234]: no overload of 'int.compareTo' takes 1 type argument
    print(n.compareTo(ref n));          // error[WYL0221]: argument 1 of 'compareTo' cannot be passed with 'ref'
    String? text = "abc";
    print(text?.bytes().length());      // error[WYL0318]: '?.' cannot produce a nullable 'ReadOnlySpan<byte>'
    var bad = new int();                // error[WYL0291]: 'int' cannot be created with 'new'
    var pair = new Pair();              // error[WYL0289]: struct 'Pair' cannot be created with 'new'
    var shaded = new Color();           // error[WYL0290]: enum 'Color' cannot be created with 'new'
}
