// Operators applied to types that don't combine, and to values that need checking for null first.

class Holder {
    String? name;
}

struct Bag {
    int[2] items;

    mut ref? int at(int index) {
        return ref items[index];
    }
}

unsafe void main() {
    int? maybe = 1;
    std::print(maybe ?? true);          // error[WYL0308]: operator '??' cannot be applied to 'int?' and 'bool'
    std::print(1.5f << 2);               // error[WYL0308]: operator '<<' cannot be applied to 'float' and 'int'
    Holder holder = new Holder();
    std::print(holder.name + 1);        // error[WYL0308]: operator '+' cannot be applied to 'String?' and 'int'
    std::print(maybe == "x");           // error[WYL0308]: operator '==' cannot be applied to 'int?' and 'String'
    mut Bag bag = Bag();
    std::print(bag.at(0) + 1);          // error[WYL0308]: operator '+' cannot be applied to 'ref? int' and 'int'
    int* left = null;
    float* right = null;
    std::print(left == right);          // error[WYL0308]: operator '==' cannot be applied to 'int*' and 'float*'
    std::print(~true);                  // error[WYL0307]: operator '~' cannot be applied to 'bool'
    std::print(!1);                     // error[WYL0307]: operator '!' cannot be applied to 'int'
    std::print((int)"x");               // error[WYL0083]: cannot cast 'String' to 'int'
}
