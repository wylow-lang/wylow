// A place inside a narrowed nullable value is used while an operation runs; setting the variable
// to null meanwhile would destroy it. These are found on the IR, so they are reported only once
// nothing else is wrong with the program (see nullable_values.wyl for the rest).

import std::print;

struct Vec {
    int x;
    int[2] pair;

    mut void move(int dx) {
        x += dx;
    }

    mut void moveWith(ref Vec? other) {
        other = null;
        x += 1;
    }
}

int clear(ref Vec? v) {
    v = null;
    return 0;
}

void read(in Vec v, ref Vec? other) { }

void bump(ref int a, int b) {
    a += b;
}

void apply(in int a, fn() -> void f) {
    f();
}

void call(fn() -> void f) {
    f();
}

void main() {
    mut Vec? v = Vec(x: 1);
    if (v != null) {
        v.moveWith(ref v);              // error: 'v' is passed by 'ref' while its value is in use here
    }
    if (v != null) {
        read(v, ref v);                 // error: 'v' is passed by 'ref' while its value is in use here
    }
    if (v != null) {
        v.x = clear(ref v);             // error: 'v' is passed by 'ref' while its value is in use here
    }
    if (v != null) {
        v.pair[clear(ref v)] = 1;       // error: 'v' is passed by 'ref' while its value is in use here
    }
    if (v != null) {
        bump(ref v.x, clear(ref v));    // error: 'v' is passed by 'ref' while its value is in use here
    }
    if (v != null) {
        print(v.pair[clear(ref v)]);    // error: 'v' is passed by 'ref' while its value is in use here
    }
    // A lambda made during the operation can run while the place is used.
    if (v != null) {
        apply(v.x, () -> { v = null; });    // error: a lambda that may assign 'v' can run while its value is in use here
    }
    // Inside a lambda, its own operations are checked the same way.
    call(() -> {
        mut Vec? w = Vec(x: 1);
        if (w != null) {
            w.x = clear(ref w);             // error: 'w' is passed by 'ref' while its value is in use here
        }
    });
}
