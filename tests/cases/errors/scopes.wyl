void f(int n) {
    int n = 2;                // error[WYL0084]: 'n' is already defined in this scope
}

void f(int m) {               // error[WYL0232]: function 'f(int)' is already defined
}

void print(int x) {           // std's print is seen only through an import, so a module may declare its own
}

void pick(long x) {
}

void pick(float x) {
}

void main() {
    {
        int a = 1;
    }
    int a = 2;
    print(a);
    var v;                    // error[WYL0085]: 'var' declaration must have an initializer
    var w = f(1);             // error[WYL0086]: cannot assign a 'void' value to a variable
    x = 3;                    // error[WYL0281]: cannot find 'x' in this scope
    pick(1);                  // error[WYL0237]: call to 'pick' is ambiguous
    int g = f;                // error[WYL0280]: function 'f' is used as a value
}
