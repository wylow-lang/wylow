class Node {
    int value;
}

struct Mat2 {
    float[4] m;

    mut ref float operator [](int row, int col) {
        return ref m[row * 2 + col];
    }

    in float at(int i) {
        return ref m[i];
    }

    mut ref float bad(int i) {
        return m[i];                    // error[WYL0240]: 'bad' returns a reference, so 'return' must be 'return ref'
    }

    mut ref float other(ref Mat2 o) {
        return ref o.m[0];              // error[WYL0241]: returned 'ref' must point into the method's receiver
    }

    mut ref float temporary() {
        return ref 1.5f;                 // error[WYL0407]: returned 'ref' must refer to a variable, field, or element
    }

    ref float leak() {
        return ref m[0];                // error[WYL0408]: cannot bind 'ref' to read-only 'm[0]'
    }

    mut float plain() {
        return ref m[0];                // error[WYL0239]: 'return ref' can only be used in a method that returns 'ref' or 'in'
    }

    static ref float global() {         // error[WYL0244]: static method cannot return 'ref'
        return ref Mat2().m[0];         // error[WYL0407]: returned 'ref' must refer to a variable, field, or element
    }
}

class Holder {
    Node node = new Node();
    mut int size;
    mut (fn() -> void)? callback;

    ref? (fn() -> void)? cb() {           // error[WYL0409]: 'ref?' cannot be used with type 'fn() -> void'
        return ref callback;
    }

    ref Node first() {
        return ref node;                // error[WYL0408]: cannot bind 'ref' to read-only 'node'
    }

    virtual ref int sizeRef() {
        return ref size;
    }

    int count() {
        return size;
    }

    static void report() {
        std::print(count());            // error[WYL0282]: instance method 'count' cannot be used here
    }
}

Mat2 makeMat() {
    return Mat2();
}

void main() {
    Mat2 m = Mat2();
    m.at(0) = 3;                        // error[WYL0351]: cannot assign to 'm.at(0)'
    ref float r = m.at(0);              // error[WYL0408]: cannot bind 'ref' to read-only 'm.at(0)'
    ref float t = makeMat()[0, 0];      // error[WYL0104]: cannot call 'mut' method 'operator []' on a temporary value
    in float v = makeMat().at(0);       // error[WYL0407]: 'in' variable must refer to a variable, field, or element
    std::print(m[0]);                   // error[WYL0233]: no indexer of 'Mat2' takes 1 argument
    var h = new Holder();
    h.count() = 3;                      // error[WYL0350]: cannot assign to this expression
    std::print(h[0]);                   // error[WYL0306]: 'Holder' cannot be indexed
}
