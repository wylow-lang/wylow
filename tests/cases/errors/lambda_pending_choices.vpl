enum Op {
    Add(int amount),
    Stop;
}

int run((int) -> int f) {
    return f(1);
}

int run((String) -> int f) {
    return f("a");
}

U apply<T, U>(T value, (T) -> U f) {
    return f(value);
}

void main() {
    Op op = Op.Add(1);
    bool up = true;
    (int) -> int inc = x -> x + 1;

    // A choice waits for its type, but the rules for choices still hold.
    print(apply(1, switch (op) {
        case Add(var n) -> x -> x + n;              // error: a lambda chosen by a switch expression cannot use 'n', which its case declares
        case Stop -> inc;
    }));
    print(run(up ? x -> 1 : y -> 2));               // error: call is ambiguous between 'run((int) -> int)' and 'run((String) -> int)'
    print(apply(1, up ? x -> 1 : x -> "a"));        // error: cannot infer type argument 'U' of 'apply': it could be 'int' or 'String'
    print(apply(1, up ? inc : x -> "a"));           // error: cannot implicitly convert 'String' to 'int'
    print(up ? x -> x : y -> y);                    // error: no overload of 'print' accepts (lambda)
    print(apply(1, up ? x -> x.name : inc));        // error: 'int' has no member 'name'
}
