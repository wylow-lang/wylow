class Loose {
    int a;                              // error: a member belongs in an access block: 'public { ... }', 'protected { ... }', 'internal { ... }', or 'private { ... }'
    int b;
}

class Order {
    private {
        int a;
    }
    public {                            // error: the 'public' block must come before the 'private' block: the blocks go public, protected, internal, then private
        int b;
    }
}

class Twice {
    internal {
        int a;
    }
    internal {                          // error: a type has at most one 'internal' block
        int b;
    }
}

class Written {
    internal {
        public int a;                   // error: 'public' is given by the access block a member is in, not written on the member
    }
}

class Destroyed {
    internal {
        ~Destroyed() { }                // error: a destructor is declared after the access blocks, outside them, since only the runtime calls it
    }
}

class Early {
    ~Early() { }
    internal {                          // error: the destructor comes after the access blocks
        int a;
    }
}

enum Shape {
    Circle, Square;

    protected {                         // error: enums cannot be inherited, so they have no 'protected' block
        void f() { }
    }
}

interface Named {
    public {                            // error: an interface's members are all public, so it has no access blocks
        String name();
    }
}

internal class Top { }                  // error: a top-level declaration is internal unless declared 'public' or 'private', so it takes no 'internal'

internal void helper() { }              // error: a top-level declaration is internal unless declared 'public' or 'private', so it takes no 'internal'

void main() {
}
