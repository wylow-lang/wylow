// The rules for the standard library's extern structs, which a user's program reports alongside
// their being only for the standard library.
extern struct Handle {                  // error: extern structs are only supported in the standard library
    internal {
        int x;                          // error: an extern struct cannot declare fields; its C++ class holds its data
        Handle() { }                    // error: an extern struct cannot declare constructors
        void m() { }                    // error: the methods of an extern struct must be extern
    }
}

class Host {
    internal {
        extern void m();                // error: extern functions are only supported in the standard library // error: extern methods must be static, except in an extern struct
    }
}

void main() { }
