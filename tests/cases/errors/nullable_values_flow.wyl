// A nullable value is used as its value only where a null check narrows it (spec flow.narrowing, memory.references).

int? maybe() {
    return null;
}

void reset(ref int? value) {
    value = null;
}

void narrowParameter(ref int? value) {
    if (value != null) {
        std::print(value + 1);          // error[WYL0397]: 'value' might be null
    }
}

void main() {
    int? x = maybe();
    std::print(x + 1);                  // error[WYL0397]: 'x' might be null

    // Narrowing ends where the local may be assigned through a 'ref'.
    mut int? y = 1;
    reset(ref y);
    std::print(y + 1);                  // error[WYL0397]: 'y' might be null
    mut int? z = 1;
    while (z != null) {
        std::print(z + 1);
        reset(ref z);
    }
    mut int? w = 1;
    for (int i : 0..3) {
        std::print(w + 1);              // error[WYL0397]: 'w' might be null
        reset(ref w);
    }
    mut int? c = 1;
    for (int i : 0..3) {
        if (i == 1) {
            reset(ref c);
            continue;
        }
        std::print(c + 1);              // error[WYL0397]: 'c' might be null
    }
    mut int? d = 1;
    for (int i : 0..3) {
        for (int j : 0..3) {
            std::print(d + 1);          // error[WYL0397]: 'd' might be null
        }
        reset(ref d);
    }
}
