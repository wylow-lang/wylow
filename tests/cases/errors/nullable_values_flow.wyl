// A nullable value is used as its value only where a null check narrows it (spec 02-types.md).

import std::print;

int? maybe() {
    return null;
}

void reset(ref int? value) {
    value = null;
}

void narrowParameter(ref int? value) {
    if (value != null) {
        print(value + 1);               // error: a 'ref' parameter is not narrowed by null checks
    }
}

void main() {
    int? x = maybe();
    print(x + 1);                       // error: 'x' might be null here

    // Narrowing ends where the local may be assigned through a 'ref'.
    mut int? y = 1;
    reset(ref y);
    print(y + 1);                       // error: 'y' might be null here
    mut int? z = 1;
    while (z != null) {
        print(z + 1);
        reset(ref z);
    }
    mut int? w = 1;
    for (int i : 0..3) {
        print(w + 1);                   // error: 'w' might be null here
        reset(ref w);
    }
    mut int? c = 1;
    for (int i : 0..3) {
        if (i == 1) {
            reset(ref c);
            continue;
        }
        print(c + 1);                   // error: 'c' might be null here
    }
    mut int? d = 1;
    for (int i : 0..3) {
        for (int j : 0..3) {
            print(d + 1);               // error: 'd' might be null here
        }
        reset(ref d);
    }
}
