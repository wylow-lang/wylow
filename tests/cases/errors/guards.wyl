// What a guard can't be on, and how guarded cases count toward a switch's coverage.

enum Shape { Circle(int r), Rect(int w, int h) }

int? number() {
    return null;
}

void use(Shape s, bool flag) {
    switch (s) {
        case Circle(_) -> std::print(1);
        default when flag -> std::print(2);         // error[WYL0386]: case with 'default' cannot have a guard
    }
    switch (number()) {
        case null when flag -> std::print(1);       // error[WYL0387]: case with 'null' cannot have a guard
        default -> std::print(2);
    }
    switch (number()) {
        case null, default when flag -> std::print(1); // error[WYL0386]: case with 'default' cannot have a guard
    }
    switch (s) {
        case Circle(var r) when r -> std::print(1); // error[WYL0079]: expected 'bool', found 'int'
        default -> std::print(2);
    }

    // A guarded case covers nothing, but is itself unreachable if the cases above cover it.
    switch (s) {                                    // error[WYL0393]: switch does not handle every value of type 'Shape'
        case Circle(var r) when r > 1 -> std::print(1);
        case Rect(_, _) -> std::print(2);
    }
    switch (s) {
        case Circle(_), Rect(_, _) -> std::print(1);
        case Circle(var r) when r > 1 -> std::print(2); // error[WYL0391]: case can never be reached
    }
    switch (s) {
        case Circle(var r) when r > 1 -> std::print(1);
        case Circle(var r) -> std::print(2);
        case Rect(_, _) -> std::print(3);
    }

    // A name an 'is' in the guard binds is the case's.
    fn() -> int chosen = switch (s) {
        case Circle(var r) when number() is int n -> () -> n;   // error[WYL0278]: lambda chosen by a switch expression cannot use 'n'
        default -> () -> 0;
    };
}

void main() { }
