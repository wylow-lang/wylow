abstract final class Both { }          // error[WYL0128]: class cannot be both 'abstract' and 'final'

final interface Flagged { }            // error[WYL0210]: 'final' cannot be used on an interface

struct S extends T { }                 // error[WYL0095]: structs cannot extend a type

struct WithDestructor {
    mut virtual void m() { }               // error[WYL0096]: 'virtual' cannot be used on a struct member
}

interface I {
    int x;                             // error[WYL0178]: interfaces cannot have fields
    mut void body() { }                    // error[WYL0179]: interface methods cannot have a body
    pub mut void m();                      // error[WYL0175]: interface methods cannot have a visibility
}

class C {
    virtual int field;                 // error[WYL0109]: 'virtual' cannot be used on a field
    final void m() { }                 // error[WYL0119]: 'final' can only be used on an 'override' method
    virtual override void n() { }      // error[WYL0118]: only one of 'virtual', 'override', and 'abstract' can be used
    static virtual void o() { }        // error[WYL0238]: static method cannot be 'virtual'
    abstract void q() { }              // error[WYL0129]: abstract methods cannot have a body
    void r();                          // error[WYL0211]: 'r' has no body

    ~C(int x) { }                      // error[WYL0149]: destructors cannot have parameters
}

void main() {
}
