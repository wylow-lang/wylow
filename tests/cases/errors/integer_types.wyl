@Repr(byte)
enum TooBig {
    A = 256,                      // error[WYL0173]: value does not fit in the enum's integer type 'byte'
}

@Repr(byte)
enum Overflows {
    A = 255,
    B,                            // error[WYL0171]: value of 'B' does not fit in the enum's integer type 'byte'
}

@Repr(char)                       // error[WYL0168]: '@Repr' type: expected an integer type, found 'char'
enum NotInteger {
    A,
}

void main() {
    byte b = 300;                 // error[WYL0079]: expected 'byte', found 'int'
    int i = 1L;                   // error[WYL0079]: expected 'int', found 'long'
    uint u = -1;                  // error[WYL0079]: expected 'uint', found 'int'
    int big = 3000000000;         // error[WYL0080]: integer literal is too large for 'int'
    int huge = 5000000000;        // error[WYL0080]: integer literal is too large for 'int'
    uint ubig = 5000000000u;      // error[WYL0080]: integer literal is too large for 'uint'
    var negated = -5u;            // error[WYL0307]: operator '-' cannot be applied to 'uint'
    uint x = 5u;
    var y = -x;                   // error[WYL0307]: operator '-' cannot be applied to 'uint'

    mut byte hi = 1;
    var packed = hi << 8;         // error[WYL0309]: shift count 8 is out of range for 'byte'
    hi <<= 8;                     // error[WYL0309]: shift count 8 is out of range for 'byte'
    int n = 1;
    var tooFar = n << 32;         // error[WYL0309]: shift count 32 is out of range for 'int'
    var negative = n >> -1;       // error[WYL0309]: shift count -1 is out of range for 'int'

    long l = 1;
    ulong ul = 1uL;
    var mixed = l + ul;           // error[WYL0308]: operator '+' cannot be applied to 'long' and 'ulong'
    mut byte small = 1;
    small += n;                   // error[WYL0079]: expected 'byte', found 'int'

    uint uv = 1u;
    nint fromUint = uv;           // error[WYL0079]: expected 'nint', found 'uint'
    nint ni = 1;
    int fromNint = ni;            // error[WYL0079]: expected 'int', found 'nint'
    nuint nu = 1u;
    long fromNuint = nu;          // error[WYL0079]: expected 'long', found 'nuint'
    double fromLong = l;          // error[WYL0079]: expected 'double', found 'long'
    float fromShortOk = (short)1;
    float fromInt = n;            // error[WYL0079]: expected 'float', found 'int'

    char c = 65;                  // error[WYL0079]: expected 'char', found 'int'
    mut char d = (char)65;
    char next = d + 1;            // error[WYL0079]: expected 'char', found 'int'
    d++;                          // error[WYL0347]: '++' can only be applied to a numeric variable
    var negatedChar = -d;           // error[WYL0307]: operator '-' cannot be applied to 'char'
    std::print(d == 65);          // error[WYL0308]: operator '==' cannot be applied to 'char' and 'int'
    switch (d) {
        case 1 -> std::print(1);  // error[WYL0380]: pattern '1' can never match a value of type 'char'
        default -> std::print(2);
    }
    float f = (float)d;           // error[WYL0083]: cannot cast 'char' to 'float'
    bool flag = (bool)d;          // error[WYL0083]: cannot cast 'char' to 'bool'
}
