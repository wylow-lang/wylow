// Patterns that cannot be tested, and switch expressions that cannot produce a reference.

struct Bag {
    int[2] items;

    mut ref? int at(int index) {
        return ref items[index];
    }
}

void nothing() { }

void main() {
    mut Bag bag = Bag();
    nothing() is var value;                 // error[WYL0328]: 'is' cannot test a 'void' value
    if (bag.at(0) is int found) { }         // error[WYL0412]: 'bag.at(0)' might refer to nothing
    ReadOnlySpan<byte> bytes = "a".bytes();
    if (bytes is var copy) { }              // error[WYL0381]: cannot match a value of type 'ReadOnlySpan<byte>' against patterns
    mut int[2] a = [1, 2];
    Span<int> view = switch (1) {           // error[WYL0326]: switch expression cannot produce a value of type 'Span<int>'
        case 1 -> a;
        default -> a;
    };
    var reference = switch (1) {            // error[WYL0327]: switch expression cannot produce a reference
        case 1 -> bag.at(0);
        default -> bag.at(1);
    };
}

enum Shape { Circle(int r), Empty }

void variant(Shape shape) {
    switch (shape) {
        case Circle(ref var r) -> { }       // error[WYL0445]: cannot bind 'ref' to a field of a variant
        default -> { }
    }
}

struct Pair {
    pub int first;
    pub int second;
}

Pair makePair() {
    return Pair(1, 2);
}

void readOnly(Pair pair) {
    switch (pair) {
        case Pair(ref var first, _) -> { }   // error[WYL0408]: cannot bind 'ref' to read-only 'pair'
    }
    switch (pair) {
        case ref var whole -> { }           // error[WYL0408]: cannot bind 'ref' to read-only 'pair'
    }
}

void temporary() {
    switch (makePair()) {
        case Pair(ref var first, _) -> { }   // error[WYL0407]: a 'ref' binding must refer to a variable, field, or element
    }
}
