// A temporary struct or array is a value, not a variable, so nothing may write to it: what the
// write changed would be gone after the statement (spec 06-syntax.md §6.4).

struct Counter {
    int count;

    mut void add() {
        count++;
    }

    mut int take() {
        int taken = count;
        count = 0;
        return taken;
    }
}

struct Cells {
    int[2] items;

    int operator [](int i) {
        return items[i];
    }

    mut void operator []=(int i, int value) {
        items[i] = value;
    }
}

struct Holder {
    Counter counter;
}

Counter counter() {
    return Counter();
}

Cells cells() {
    return Cells();
}

Holder holder() {
    return Holder();
}

int[3] numbers() {
    return [1, 2, 3];
}

void main() {
    counter().add();                    // error[WYL0104]: cannot call 'mut' method 'add' on a temporary value
    int taken = counter().take();       // error[WYL0104]: cannot call 'mut' method 'take' on a temporary value
    Counter().add();                    // error[WYL0104]: cannot call 'mut' method 'add' on a temporary value
    holder().counter.add();             // error[WYL0104]: cannot call 'mut' method 'add' on a temporary value
    mut Counter a = Counter();
    mut Counter b = Counter();
    (true ? a : b).add();               // error[WYL0104]: cannot call 'mut' method 'add' on a temporary value
    mut Counter? maybe = Counter();
    maybe!.add();                       // error[WYL0104]: cannot call 'mut' method 'add' on a temporary value

    cells()[0] = 1;                     // error[WYL0346]: cannot assign to an element of a temporary value
    cells()[0] += 1;                    // error[WYL0346]: cannot assign to an element of a temporary value
    cells()[1]++;                       // error[WYL0346]: cannot assign to an element of a temporary value
    Cells()[0] = 1;                     // error[WYL0346]: cannot assign to an element of a temporary value

    for (ref int n : numbers()) {       // error[WYL0356]: cannot loop over a temporary array by 'ref'
        n += 1;
    }
}
