enum Fields {
    A, B;

    int count;                          // error: enums cannot have fields; data belongs to variants
    Fields(int x) { }                   // error: enums cannot have constructors
    ~Fields() { }                       // error: enums cannot have destructors
    mut void look() { }                 // error: enum methods cannot be 'mut', since an enum value cannot be modified
    virtual void spin() { }             // error: 'virtual' is not valid on enum members
}

enum Child extends Fields { C }         // error: enums cannot inherit

enum Late {
    A;
    void f() { }
    B,                                  // error: enum variants must come before the enum's methods
}

enum Missing {
    A, B                                // error: expected ',' or '}' after an enum variant, or ';' before the enum's methods
    void f() { }
}

enum Refs { A(ref int x) }              // error: 'ref' is only valid on parameters

enum Defaults { A(int x = 1) }          // error: a variant's fields cannot have default values

enum Empty { }                          // error: expected an enum variant

enum Colon : uint { A }                 // error: an enum's integer type is given with an annotation, as in '@Repr(uint) enum Colon'

void main() {
    int n = 1;
    switch (n) {
        case 1: print(1);               // error: cases are written with '->'
        default -> print(2);
    }
    var x = switch (n) {
        case 1 -> { print(1); }         // error: the cases of a switch expression must be expressions
        default -> 2;
    };
    switch (n) {
        case 1 -> int y = 2;            // error: a variable cannot be declared here
        default -> print(2);
    }
    switch (n) {
        print(1);                       // error: expected 'case' or 'default'
    }
    _ print(1);                         // error: expected '=' after '_'
}
