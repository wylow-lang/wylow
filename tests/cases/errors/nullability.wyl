import std::print;

class Node {
    int value;
    Node? next;
}

struct Vec { int x; }

class Animal { }
class Dog extends Animal { }
class Car { }

void take(Node n) { }
void takeRef(ref Node n) { }            // error: 'ref' cannot be used on a parameter of type 'Node'

void main() {
    var n = new Node();
    print(n.next.value);                // error: 'n.next' might be null; use '?.' or '!'
    Node definite = n.next;             // error: cannot implicitly convert 'Node?' to 'Node'; check it for null first, or use '!'
    print(n!.value);                    // error: '!' can only be applied to a nullable value
    print(n?.value);                    // error: '?.' is only needed on nullable values
    var x = null;                       // error: cannot infer a type from 'null'
    Node m = null;                      // error: cannot implicitly convert 'null' to 'Node'
    var k = n ?? n;                     // error: the left side of '??' must be nullable
    print(1 == null);                   // error: operator '==' cannot be applied to 'int' and 'null'
    Animal a = new Dog();
    if (a is Car c) { }                 // error: a 'Animal' can never be a 'Car'
    if (1 is Node q) { }                // error: 'is' can only test the type of class or interface values
    Dog d = a;                          // error: cannot implicitly convert 'Animal' to 'Dog'
}
