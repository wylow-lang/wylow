struct Point {
    int x;
    int y;

    Point() {                      // error: cannot declare a parameterless constructor
    }

    Point(int x, int y) {
        this.x = x;
        this.y = y;
        return 5;                  // error: constructors cannot return a value
    }

    void move() {
        x = 1;                     // error: cannot assign to 'x' because 'this' is read-only in a method that isn't 'mut'
        reset();                   // error: cannot call 'mut' method 'reset' on 'this' because 'this' is read-only
    }

    mut void reset() {
        x = 0;
    }

    static int origin() {
        return x;                  // error: 'x' is an instance field; static methods cannot use
    }

    private int secret;
}

struct Named {
    (() -> int)? name;
}

struct Loop {                      // error: struct 'Loop' contains itself (Loop -> Inner -> Loop)
    Inner inner;
}

struct Inner {
    Loop loop;
}

struct Defaults {
    int a = 1;
    int b = a;                     // error: field initializers cannot use
}

void setX(ref int value) {
    value = 3;
}

void readOnly(in Point p) {
    p.x = 3;                       // error: cannot assign to 'p.x' because 'p' is an 'in' parameter
    p.reset();                     // error: cannot call 'mut' method 'reset' on 'p' because 'p' is an 'in' parameter
    setX(ref p.x);                 // error: cannot pass 'p.x' by 'ref' because 'p' is an 'in' parameter
}

Point make() {
    return Point(1, 2);
}

void main() {
    var p = Point(1, 2);
    print(p.z);                    // error: 'Point' has no field 'z'
    print(p.secret);               // error: field 'Point.secret' is private
    p.missing();                   // error: 'Point' has no method 'missing'
    setX(p.x);                     // error: argument 1 must be passed with 'ref'
    setX(ref 5);                   // error: a 'ref' argument must be a variable or field
    make().x = 4;                  // error: cannot assign to a field of a temporary value
    var n1 = Named();
    var n2 = Named();
    print(n1 == n2);               // error: its field 'name' of type '(() -> int)?' does not support '=='
    print(p == 3);                 // error: operator '==' cannot be applied to 'Point' and 'int'
    print(this);                   // error: 'this' can only be used inside a struct
    Point.reset();                 // error: 'Point.reset' is an instance method
    p.origin();                    // error: static method 'origin' must be called through the type
    print(Point(1));               // error: no constructor of 'Point' takes 1 argument
    float f = 1;
    setX(ref f);                   // error: a 'ref' argument must have exactly type 'int', not 'float'
}
