import std::print;

struct Point {
    int x;
    int y;

    Point() {                      // error[WYL0101]: struct cannot declare a parameterless constructor
    }

    Point(int x, int y) {
        this.x = x;
        this.y = y;
        return 5;                  // error[WYL0373]: cannot return a value from a constructor
    }

    void move() {
        x = 1;                     // error[WYL0351]: cannot assign to 'x'
        reset();                   // error[WYL0105]: cannot call 'mut' method 'reset' on 'this'
    }

    mut void reset() {
        x = 0;
    }

    static int origin() {
        return x;                  // error[WYL0282]: instance field 'x' cannot be used here
    }
}

struct Named {
    (fn() -> int)? name;
}

struct Loop {                      // error[WYL0106]: struct 'Loop' contains itself
    Inner inner;
}

struct Inner {
    Loop cycle;
}

struct Defaults {
    int a = 1;
    int b = a;                     // error[WYL0282]: instance field 'a' cannot be used here
}

void setX(ref int value) {
    value = 3;
}

void readOnly(in Point p) {
    p.x = 3;                       // error[WYL0351]: cannot assign to 'p.x'
    p.reset();                     // error[WYL0105]: cannot call 'mut' method 'reset' on 'p'
    setX(ref p.x);                 // error[WYL0223]: cannot pass 'p.x' by 'ref'
}

Point make() {
    return Point(1, 2);
}

void main() {
    var p = Point(1, 2);
    print(p.z);                    // error[WYL0297]: cannot find field 'z' in 'Point'
    p.missing();                   // error[WYL0300]: cannot find method 'missing' in 'Point'
    setX(p.x);                     // error[WYL0224]: argument 1 of 'setX' must be passed with 'ref'
    setX(ref 5);                   // error[WYL0222]: 'ref' argument must be a variable, field, or element
    make().x = 4;                  // error[WYL0348]: cannot assign to a field of a temporary value
    var n1 = Named();
    var n2 = Named();
    print(n1 == n2);               // error[WYL0310]: operator '==' cannot be applied to 'Named'
    print(p == 3);                 // error[WYL0308]: operator '==' cannot be applied to 'Point' and 'int'
    print(this);                   // error[WYL0283]: 'this' can only be used inside a struct or class
    Point.reset();                 // error[WYL0302]: instance method 'Point.reset' cannot be called through its type
    p.origin();                    // error[WYL0303]: static method 'origin' cannot be called through a value
    print(Point(1));               // error[WYL0233]: no constructor of 'Point' takes 1 argument
    float f = 1;
    setX(ref f);                   // error[WYL0225]: 'ref' argument: expected 'int', found 'float'
}
