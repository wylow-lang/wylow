import std::print;

struct Holder {
    Span<int> held;                         // error[WYL0418]: 'Span<int>' cannot be the type of a field
}

enum Choice {
    Some(Span<int> view),                   // error[WYL0418]: 'Span<int>' cannot be the type of a variant's field
    None;
}

struct Samples {
    int[2] values;

    mut Span<int> edit() {
        return values;
    }

    ReadOnlySpan<int> view() {
        return values;
    }

    mut Span<int> other(Span<int> given) {
        return given;                       // error[WYL0242]: returned 'Span<int>' must view the method's receiver
    }

    static Span<int> make() {               // error[WYL0243]: only instance methods can return 'Span<int>'
        return Span<int>();
    }
}

// A ref struct made from another views what that one does, so it is not the receiver's to return.
ref struct Window {
    int n;

    Window(Window from) {
        n = from.n;
    }

    Window other(Window from) {
        return Window(from);                // error[WYL0242]: returned 'Window' must view the method's receiver
    }
}

Span<int> free() {                          // error[WYL0243]: only instance methods can return 'Span<int>'
    return Span<int>();
}

int[3] makeArray() {
    return [1, 2, 3];
}

Samples makeSamples() {
    return Samples();
}

void readOnly(in int[2] values) {
    Span<int> s = values;                   // error[WYL0079]: expected 'Span<int>', found 'int[2]'
    ReadOnlySpan<int> r = values;
}

void main() {
    mut int[2] a = [1, 2];
    int[2] b = [3, 4];
    Span<int> s = a;
    s = b;                                  // error[WYL0417]: cannot reassign 's'
    Span<int> later;                        // error[WYL0414]: variable of type 'Span<int>' must be initialized where it is declared
    Span<int> t = makeArray();              // error[WYL0079]: expected 'Span<int>', found 'int[3]'
    Span<int> e = makeSamples().edit();     // error[WYL0104]: cannot call 'mut' method 'edit' on a temporary value
    ReadOnlySpan<int> u = makeSamples().view(); // error[WYL0415]: 'ReadOnlySpan<int>' cannot view a temporary value
    for (int x : makeSamples().view()) {    // error[WYL0358]: cannot loop over the elements of a temporary value
    }
    bool flag = true;
    var either = flag ? s : s;              // error[WYL0320]: '?:' cannot choose between two values of type 'Span<int>'
    Span<int>[2] spans;                     // error[WYL0418]: 'Span<int>' cannot be an array's element
    var viewed = [s, s];                    // error[WYL0418]: 'Span<int>' cannot be an array's element
    Result<Span<int>, int> r;               // error[WYL0418]: 'Span<int>' cannot be a type argument
    Span<long> wide = a;                    // error[WYL0079]: expected 'Span<long>', found 'int[2]'
    switch (s) {                            // error[WYL0381]: cannot match a value of type 'Span<int>' against patterns
        default -> print(1);
    }
}
