// The flow analysis checks an assignment through 'operator []=' as it checks any call (spec 06-syntax.md §6.6).

struct Pair {
    int[2] items;

    int operator [](int i) {
        return items[i];
    }

    mut void operator []=(int i, int value) {
        items[i] = value;
    }
}

int clear(ref Pair? pair) {
    pair = null;
    return 1;
}

void main() {
    mut Pair unassigned;
    unassigned[0] = 1;                  // error[WYL0394]: 'unassigned' might not have been assigned

    mut Pair? maybe = Pair();
    if (maybe != null) {
        maybe[0] = clear(ref maybe);    // error[WYL0411]: 'maybe' might be set to null while its value is in use
    }
    mut Pair? other = Pair();
    if (other != null) {
        other[1] += clear(ref other);   // error[WYL0411]: 'other' might be set to null while its value is in use
    }
}
