class Node {
    internal {
        Weak<Node> parent;
        Weak<Node?> maybe;                  // error: write 'Weak<Node>': a weak reference can always be null
        Weak<int> number;                   // error: 'Weak' needs a class or interface type, not 'int'
    }
}

struct Vec { internal { int x; } }

class Box<T> {
    internal {
        Weak<T> item;                       // error: 'Weak' needs a class or interface type, not 'T'
    }
}

extern struct Native { }                // error: extern structs are only supported in the standard library

void main() {
    var n = new Node();
    mut Weak<Node> w = n;
    Node strong = w;                    // error: cannot implicitly convert 'Weak<Node>' to 'Node'
    Node? read = n.parent;              // error: cannot implicitly convert 'Weak<Node>' to 'Node?'
    Weak<Vec> v;                        // error: 'Weak' needs a class or interface type, not 'Vec'
    print(w == n.parent);               // error: operator '==' cannot be applied to 'Weak<Node>', since 'Weak<Node>' does not support '=='
    w = 5;                              // error: cannot implicitly convert 'int' to 'Weak<Node>'
    print(w.get().parent);              // error: 'w.get()' might be null; use '?.' or '!'
}
