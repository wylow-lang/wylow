import std::{memory, panic, print};

class Tracked {
    int id;

    Tracked(int id) {
        this.id = id;
    }

    ~Tracked() {
        print(id * -1);
    }
}

// A growable stack built on raw memory, the way the standard library's containers are.
class Stack<T> {
    mut T* data;
    mut int size;
    mut int capacity;

    void push(T value) {
        unsafe {
            if (size == capacity) {
                int grown = capacity == 0 ? 2 : capacity * 2;
                T* bigger = memory::allocate<T>(grown);
                memory::moveTo(data, bigger, size);
                memory::free(data);
                data = bigger;
                capacity = grown;
            }
            memory::initialize(data + size, value);
        }
        size++;
    }

    @CallerLocation
    ref T operator [](int index) {
        panic::checkIndex(index, size);
        unsafe {
            return ref data[index];
        }
    }

    // Rotates the elements one place to the right, moving them onto themselves.
    void shiftRight() {
        unsafe {
            memory::drop(data + size - 1);
            memory::moveTo(data, data + 1, size - 1);
            memory::initialize(data, this[size - 1]);
        }
    }

    ~Stack() {
        unsafe {
            for (int i : 0..size) {
                memory::drop(data + i);
            }
            memory::free(data);
        }
    }
}

unsafe int third(int* values) {
    return values[2];
}

// A `ref` or `in` pointer parameter is a reference to the pointer, so indexing it reads the
// pointer first; a place through it may also be written.
unsafe int thirdIn(in int* values) {
    return values[2];
}

unsafe int thirdRef(ref int* values) {
    return values[2];
}

unsafe void setThird(in int* values, int value) {
    values[2] = value;
}

void main() {
    var numbers = new Stack<int>();
    for (int i : 0..5) {
        numbers.push(i * i);
    }
    print(numbers[4]);          // output: 16
    numbers[0] = 7;
    print(numbers[0]);          // output: 7
    print(numbers.capacity);    // output: 8
    unsafe {
        print(third(numbers.data)); // output: 4
        print(thirdIn(numbers.data)); // output: 4
        print(thirdRef(ref numbers.data)); // output: 4
        setThird(numbers.data, 6);
        print(numbers.data[2]);     // output: 6
        print(numbers.data == null); // output: false
    }

    int* nothing = null;
    print(nothing == null);     // output: true

    // A pointer local assigned twice may point into either object.
    unsafe {
        int* first = memory::allocate<int>(1);
        int* second = memory::allocate<int>(1);
        memory::initialize(first, 4);
        memory::initialize(second, 9);
        mut int* chosen = first;
        chosen = second;
        print(chosen[0]);       // output: 9
        memory::free(first);
        memory::free(second);
    }

    mut var objects = new Stack<Tracked>();
    objects.push(new Tracked(1));
    objects.push(new Tracked(2));
    objects.push(new Tracked(3));
    print(objects[2].id);       // output: 3
    objects.shiftRight();
    // output: -3
    print(objects[0].id);       // output: 2
    print(objects[1].id);       // output: 1
    print(objects[2].id);       // output: 2
    // Elements 0 and 2 share one object, so the stack releases 1 before 2.
    objects = new Stack<Tracked>();
    // output: -1
    // output: -2
    print(0);                   // output: 0
}
