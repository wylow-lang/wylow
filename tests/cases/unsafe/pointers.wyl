// Pointers compare by address: the same element of the same storage, not the same type.

import std::{memory, print};

void main() {
    unsafe {
        int* first = memory::allocate<int>(2);
        memory::initialize(first, 4);
        memory::initialize(first + 1, 9);
        int* alias = first;
        int* second = first + 1;
        print(alias == first);      // output: true
        print(alias == second);     // output: false
        print(first != second);     // output: true
        memory::free(first);
    }
}
