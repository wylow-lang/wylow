void main() {
    std::print((byte)300);        // output: 44
    std::print((sbyte)200);       // output: -56
    std::print((ushort)70000);    // output: 4464
    std::print((short)40000);     // output: -25536
    std::print((uint)-1);         // output: 4294967295
    std::print((ulong)-1L);       // output: 18446744073709551615
    std::print((int)4000000000u); // output: -294967296
    std::print((long)18446744073709551615uL); // output: -1

    // Float to integer saturates to the target's range.
    std::print((byte)-1.5f);       // output: 0
    std::print((byte)1e10f);       // output: 255
    std::print((uint)-7.0f);       // output: 0
    std::print((ulong)1e30d);     // output: 18446744073709551615
    std::print((sbyte)-1000.0f);   // output: -128

    std::print((float)(byte)255); // output: 255.0
    std::print((double)4000000001u); // output: 4000000001.0

    char c = (char)65;
    std::print(c);                // output: A
    int code = c;
    std::print(code);             // output: 65
    std::print((byte)(char)300);  // output: 44
    std::print(c == (char)65);    // output: true
    std::print(c < (char)66);     // output: true
}
