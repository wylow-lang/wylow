// A case literal takes the subject's integer type, so matching reads every integer kind.

void main() {
    sbyte signed = -1;
    std::print(switch (signed) {
        case -1 -> "sbyte";
        default -> "no";
    });                              // output: sbyte

    short small = 2;
    std::print(switch (small) {
        case 2 -> "short";
        default -> "no";
    });                              // output: short

    ushort unsigned = 3;
    std::print(switch (unsigned) {
        case 3 -> "ushort";
        default -> "no";
    });                              // output: ushort

    ulong wide = 4uL;
    std::print(switch (wide) {
        case 4 -> "ulong";
        default -> "no";
    });                              // output: ulong

    nint sized = 5;
    std::print(switch (sized) {
        case 5 -> "nint";
        default -> "no";
    });                              // output: nint

    nuint native = 6u;
    std::print(switch (native) {
        case 6 -> "nuint";
        default -> "no";
    });                              // output: nuint
}
