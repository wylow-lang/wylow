import std::print;

void main() {
    print((int)3);             // output: 3
    print((int)3.9);           // output: 3
    print((int)-3.9);          // output: -3
    print((int)1e20);          // output: 2147483647
    print((int)-1e20);         // output: -2147483648
    print((long)1e30d);        // output: 9223372036854775807
    print((int)3000000000L);   // output: -1294967296
    print((float)16777217);    // output: 16777216.0
    print((float)1e300d);      // output: inf

    float zero = 0.0;
    float nan = zero / zero;
    print((int)nan);           // output: 0

    float f = 3;
    print(f);                  // output: 3.0
    double d = f;
    print(d);                  // output: 3.0
    long l = 5;
    print(l * 2);              // output: 10
    print(f * 2);              // output: 6.0
}
