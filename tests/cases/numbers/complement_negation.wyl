// A narrow call's complement is converted to double and then negated: /O2 must not fold the
// negation into the narrow type, which would wrap at the type's minimum.

short top() {
    return 32767;
}

void main() {
    // mode: release
    std::print(-((double)~top()));                            // output: 32768.0
    std::print(-((float)~top()));                             // output: 32768.0
    std::print(-((double)(short)(~top())));                   // output: 32768.0
    std::print(-((double)~((int)top())));                     // output: 32768.0
}
