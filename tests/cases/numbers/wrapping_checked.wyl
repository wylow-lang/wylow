// The wrapping and checked methods behave the same in a debug build as in a release build: a
// wrapping method never panics, and a checked method returns null where `+`, `-`, or `*` would
// overflow.

void main() {
    int max = 2147483647;
    int min = -2147483648;
    std::print(max.wrappingAdd(1));         // output: -2147483648
    std::print(min.wrappingSub(1));         // output: 2147483647
    std::print(65536.wrappingMul(65536));   // output: 0
    std::print(min.wrappingMul(-1));        // output: -2147483648
    std::print(3.wrappingAdd(4));           // output: 7

    byte b = 255;
    std::print(b.wrappingAdd(1));           // output: 0
    byte small = 2;
    std::print(small.wrappingSub(3));       // output: 255
    sbyte s = 100;
    std::print(s.wrappingMul(3));           // output: 44
    ulong big = 0xFFFF_FFFF_FFFF_FFFFUL;
    std::print(big.wrappingMul(big));       // output: 1
    std::print(big.wrappingAdd(2UL));       // output: 1
    long low = -9223372036854775808L;
    std::print(low.wrappingSub(1L));        // output: 9223372036854775807

    std::print($"{max.checkedAdd(1)}");     // output: null
    std::print($"{max.checkedAdd(-1)}");    // output: 2147483646
    std::print($"{min.checkedSub(1)}");     // output: null
    std::print($"{min.checkedMul(-1)}");    // output: null
    std::print($"{46341.checkedMul(46341)}"); // output: null
    std::print($"{46340.checkedMul(46340)}"); // output: 2147395600
    uint zero = 0u;
    std::print($"{zero.checkedSub(1u)}");   // output: null
    std::print($"{b.checkedAdd(0)}");       // output: 255
    std::print($"{big.checkedMul(1UL)}");   // output: 18446744073709551615
    std::print($"{big.checkedMul(2UL)}");   // output: null
    short neg = -200;
    std::print($"{neg.checkedMul(200)}");   // output: null
    std::print($"{neg.checkedMul(100)}");   // output: -20000
}
