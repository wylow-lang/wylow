// nint and long are the same C++ type on 64-bit targets, so these overloads need distinct names.

import std::print;

void show(nint value) {
    print(1);
}

void show(long value) {
    print(2);
}

void pick(byte value) {
    print(3);
}

void pick(int value) {
    print(4);
}

// So do overloads that differ only so inside function types, wherever those appear.
class Holder<T> {}

void run((fn(nint) -> void)? f) {
    print(5);
}

void run((fn(long) -> void)? f) {
    print(6);
}

void hold(Holder<fn(nint) -> void>? h) {
    print(7);
}

void hold(Holder<fn(long) -> void>? h) {
    print(8);
}

void main() {
    nint n = 5;
    show(n);       // output: 1
    show(5L);      // output: 2
    show(5);       // output: 1
    byte b = 1;
    pick(b);       // output: 3
    pick(1);       // output: 4
    short s = 1;
    pick(s);       // output: 4
    escaping (fn(nint) -> void)? a = null;
    run(a);        // output: 5
    escaping (fn(long) -> void)? c = null;
    run(c);        // output: 6
    Holder<fn(nint) -> void>? h = null;
    hold(h);       // output: 7
    Holder<fn(long) -> void>? k = null;
    hold(k);       // output: 8
    // One C++ class on 64-bit targets, whose traits are emitted once.
    Holder<nint> n1 = new Holder<nint>();
    Holder<long> n2 = new Holder<long>();
    print(9);      // output: 9
}
