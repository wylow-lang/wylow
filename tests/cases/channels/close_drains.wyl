import std::threading;
import std::threading::Channel;

void main() {
    var channel = new Channel<int>();
    var receiver = channel.receiver();
    var worker = threading::startThread(() -> {
        var first = channel.sender();
        var second = channel.sender();
        first.send(1);
        first.send(2);
        second.send(3);
        return 0;
    });
    worker.join();
    mut var total = 0;
    mut var value = receiver.receive();
    while (value != null) {
        total += value!;
        value = receiver.receive();
    }
    std::print(total);
    // output: 6
    // tsan
}
