import std::threading::Channel;

void main() {
    var channel = new Channel<int>();
    var receiver = channel.receiver();
    {
        var sender = channel.sender();
        sender.send(1);
        sender.send(2);
    }
    std::print(receiver.receive()!);
    std::print(receiver.receive()!);
    std::print(receiver.receive() == null);
    // output: 1
    // output: 2
    // output: true
}
