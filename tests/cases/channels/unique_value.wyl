import std::threading;
import std::threading::Channel;

unique struct Buffer {
    pub int length;

    pub Buffer(int length) {
        this.length = length;
    }

    ~Buffer() {
        std::print($"buffer {length}");
    }
}

void main() {
    var channel = new Channel<Buffer>();
    var sender = channel.sender();
    var receiver = channel.receiver();
    var worker = threading::spawn(() -> {
        mut var value = receiver.receive();
        if (value != null) {
            var buffer = value!;
            std::print($"got {buffer.length}");
        }
        std::print("child done");
        return 0;
    });
    sender.send(Buffer(7));
    worker.join();
    std::print("parent done");
    // output: got 7
    // output: buffer 7
    // output: child done
    // output: parent done
    // tsan
}
