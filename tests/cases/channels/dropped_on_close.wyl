import std::threading::Channel;

unique struct Buffer {
    pub int length;

    pub Buffer(int length) {
        this.length = length;
    }

    ~Buffer() {
        std::print($"buffer {length}");
    }
}

void main() {
    var channel = new Channel<Buffer>();
    {
        var sender = channel.sender();
        sender.send(Buffer(1));
        sender.send(Buffer(2));
        sender.send(Buffer(3));
    }
    std::print("closed");
    // output: buffer 1
    // output: buffer 2
    // output: buffer 3
    // output: closed
}
