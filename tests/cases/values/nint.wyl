// The `nint` kind: pointer-sized and signed. Its values are kept small, since what it holds depends
// on the target, but its operators, conversions, and formatting are the same (§2.1, §2.3).

void main() {
    nint value = 5;

    std::print(value + 3);      // output: 8
    std::print(value - 7);      // output: -2
    std::print(value * -2);     // output: -10
    std::print(value / 2);      // output: 2
    std::print(value % 3);      // output: 2
    std::print(value << 1);     // output: 10
    std::print(value >> 1);     // output: 2
    std::print(value & 3);      // output: 1
    std::print(~value);         // output: -6
    std::print(-value);         // output: -5
    std::print(value == 5);     // output: true
    std::print(value < 6);      // output: true

    std::print((int)(-value));  // output: -5
    std::print((long)value);    // output: 5
    std::print((nint)7);        // output: 7

    std::print($"{(-value):D3}"); // output: -005
    std::print($"{value:X}");   // output: 5
    std::print($"[{value,4}]"); // output: [   5]

    std::print(value.toString()); // output: 5

    // More operators, conversions, and formatting.
    std::print(value | 2);      // output: 7
    std::print(value ^ 1);      // output: 4
    std::print(value > 0);      // output: true
    std::print(value <= 5);     // output: true
    std::print((short)value);   // output: 5
    std::print((uint)value);    // output: 5
    std::print((double)value);  // output: 5.0
    std::print($"{value:D1}");  // output: 5
    std::print($"{value:B8}");  // output: 00000101
    std::print($"[{value,-4}]"); // output: [5   ]
    std::print(switch (value) {
        case 5 -> "five";
        default -> "other";
    });                         // output: five
}
