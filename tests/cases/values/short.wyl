// The `short` kind at its edges: a signed 16-bit type whose arithmetic keeps its type.

void main() {
    short min = -32768;
    short max = 32767;

    std::print(min + 1);        // output: -32767
    std::print(max - 1);        // output: 32766
    std::print(min / 3);        // output: -10922
    std::print(min % 3);        // output: -2
    std::print(max / 7);        // output: 4681
    std::print(max % 7);        // output: 0
    std::print(min >> 2);       // output: -8192
    std::print(min << 1);       // output: 0
    std::print(~min);           // output: 32767
    std::print(min < 0);        // output: true

    std::print((ushort)min);    // output: 32768
    std::print((int)min);       // output: -32768
    std::print((long)min);      // output: -32768
    std::print((short)65535);   // output: -1

    std::print($"{min:X4}");    // output: 8000
    std::print($"{min:B16}");   // output: 1000000000000000
    std::print($"{min:D6}");    // output: -032768
    std::print($"[{max,6}]");   // output: [ 32767]

    std::print(min.toString()); // output: -32768

    // More operators, conversions, and formatting.
    std::print(max * 1);        // output: 32767
    std::print(min + 32767);    // output: -1
    std::print(max & 0x0F);     // output: 15
    std::print(max ^ -1);       // output: -32768
    std::print((byte)min);      // output: 0
    std::print((ushort)max);    // output: 32767
    std::print((double)min);    // output: -32768.0
    std::print($"{max:D5}");    // output: 32767
    std::print($"[{min,7}]");   // output: [ -32768]
    std::print(max > min);      // output: true
    std::print(switch (min) {
        case -32768 -> "min";
        default -> "other";
    });                         // output: min
}
