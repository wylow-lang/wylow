// The `ushort` kind at its edges: an unsigned 16-bit type whose arithmetic keeps its type.

void main() {
    ushort max = 65535;

    std::print(max - 1);        // output: 65534
    std::print(max / 7);        // output: 9362
    std::print(max % 7);        // output: 1
    std::print(max / 2);        // output: 32767
    std::print(max >> 8);       // output: 255
    std::print(max << 1);       // output: 65534
    std::print(max & 0xFF);     // output: 255
    std::print(~max);           // output: 0
    std::print(max > 0);        // output: true
    std::print(max == 65535);   // output: true

    std::print((short)max);     // output: -1
    std::print((int)max);       // output: 65535
    std::print((long)max);      // output: 65535
    std::print((float)max);     // output: 65535.0

    std::print($"{max:X4}");    // output: FFFF
    std::print($"{max:B16}");   // output: 1111111111111111
    std::print($"{max:D6}");    // output: 065535
    std::print($"[{max,6}]");   // output: [ 65535]

    std::print(max.toString()); // output: 65535

    // More operators, conversions, and formatting.
    std::print(max + 0);        // output: 65535
    std::print(max | 0);        // output: 65535
    std::print(max ^ 0);        // output: 65535
    std::print((byte)max);      // output: 255
    std::print((sbyte)max);     // output: -1
    std::print((double)max);    // output: 65535.0
    std::print(max != 0);       // output: true
    std::print(max >= 65535);   // output: true
    std::print($"{max:D}");     // output: 65535
    std::print($"{255:X2}");    // output: FF
    std::print($"[{max,-6}]");  // output: [65535 ]
    std::print(switch (max) {
        case 65535 -> "max";
        default -> "other";
    });                         // output: max
}
