// The `String` kind: immutable UTF-8 text. Offsets and lengths count bytes, `==` compares contents,
// and interpolation is the one way to join strings (§2.10, §6.9).

void main() {
    String text = "héllo";
    String empty = "";

    std::print(text);                   // output: héllo
    std::print(text.byteLength());      // output: 6
    std::print(text.charCount());       // output: 5
    std::print(empty.byteLength());     // output: 0
    std::print(empty.charCount());      // output: 0
    std::print(empty.isEmpty());        // output: true
    std::print(text.isEmpty());         // output: false

    std::print(text.startsWith("hé"));  // output: true
    std::print(text.startsWith("hx"));  // output: false
    std::print(text.endsWith("llo"));   // output: true
    std::print(text.contains("él"));    // output: true
    std::print(text.contains("x"));     // output: false
    std::print(text.indexOf("l"));      // output: 3
    std::print(text.indexOf("z"));      // output: null
    std::print(empty.indexOf("") == 0); // output: true
    std::print(text.compareTo("héllo")); // output: 0
    std::print(text.compareTo("hello") > 0); // output: true
    std::print(text.compareTo("i") < 0); // output: true

    std::print(text == "héllo");        // output: true
    std::print(text == "hello");        // output: false
    std::print(text != "hello");        // output: true
    std::print($"{1}+{2}" == "1+2");    // output: true

    std::print(text.slice(0, 1));       // output: h
    std::print(text.slice(1, 2));       // output: é
    std::print(text.slice(3, 2));       // output: ll
    std::print(text.slice(0, 6) == text); // output: true
    std::print(empty.slice(0, 0) == empty); // output: true

    std::print(text.bytes().length());  // output: 6
    std::print(text.bytes()[0]);        // output: 104
    std::print(text.bytes()[1]);        // output: 195
    std::print(text.bytes()[5]);        // output: 111
    for (int at, char c : text) {
        std::print(at);
        std::print(c);
    }
    // output: 0
    // output: h
    // output: 1
    // output: é
    // output: 3
    // output: l
    // output: 4
    // output: l
    // output: 5
    // output: o

    std::print($"{text}!");             // output: héllo!
    std::print($"{text}{empty}");       // output: héllo
    std::print($"[{text,7}]");          // output: [  héllo]
    std::print($"{text,-7}|");          // output: héllo  |

    String built = $"{1}+{2}";
    std::print(built);                  // output: 1+2
    std::print(built.byteLength());     // output: 3
    std::print(built.charCount());      // output: 3
}
