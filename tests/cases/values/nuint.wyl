// The `nuint` kind: pointer-sized and unsigned. Its values are kept small, since what it holds
// depends on the target (§2.1, §2.3).

void main() {
    nuint value = 7u;

    std::print(value + 3u);     // output: 10
    std::print(value - 2u);     // output: 5
    std::print(value * 3u);     // output: 21
    std::print(value / 2u);     // output: 3
    std::print(value % 2u);     // output: 1
    std::print(value << 1);     // output: 14
    std::print(value >> 1);     // output: 3
    std::print(value & 3u);     // output: 3
    std::print(~value & 0xFu);  // output: 8
    std::print(value > 0u);     // output: true

    std::print((int)value);     // output: 7
    std::print((ulong)value);   // output: 7
    std::print((nuint)9u);      // output: 9

    std::print($"{value:D3}");  // output: 007
    std::print($"{value:B4}");  // output: 0111
    std::print($"[{value,4}]"); // output: [   7]

    std::print(value.toString()); // output: 7

    // More operators, conversions, and formatting.
    std::print(value | 8u);     // output: 15
    std::print(value ^ 3u);     // output: 4
    std::print(value > 6u);     // output: true
    std::print($"{value:D2}");  // output: 07
    std::print(value < 8u);     // output: true
    std::print(value >= 7u);    // output: true
    std::print((short)value);   // output: 7
    std::print((uint)value);    // output: 7
    std::print((double)value);  // output: 7.0
    std::print($"{value:D1}");  // output: 7
    std::print($"{value:X}");   // output: 7
    std::print($"[{value,-4}]"); // output: [7   ]
    std::print(switch (value) {
        case 7 -> "seven";
        default -> "other";
    });                         // output: seven
}
