// The `long` kind at its edges: past INT_MAX, at the ends of 64 bits, and where a conversion
// to a narrower or floating type loses something (§2.3, §2.4).

void main() {
    long max = 9223372036854775807L;
    long min = -9223372036854775808L;

    std::print(max - 1);                // output: 9223372036854775806
    std::print(min + 1);                // output: -9223372036854775807
    std::print(max / 3);                // output: 3074457345618258602
    std::print(max % 3);                // output: 1
    std::print(min / 3);                // output: -3074457345618258602
    std::print(min % 3);                // output: -2
    std::print(1L << 62);               // output: 4611686018427387904
    std::print(max >> 62);              // output: 1
    std::print(min >> 63);              // output: -1
    std::print(2147483648L * 4);        // output: 8589934592
    std::print(max & 0xFF);             // output: 255
    std::print(~min);                   // output: 9223372036854775807
    std::print(-9223372036854775808L < 0L); // output: true
    std::print(9223372036854775807L > 2147483647L); // output: true

    // Conversions: narrowing wraps, widening to float rounds, and a double saturates.
    std::print((int)max);               // output: -1
    std::print((int)min);               // output: 0
    std::print((uint)max);              // output: 4294967295
    std::print((short)2147483648L);     // output: 0
    std::print((float)16777217L);       // output: 16777216.0
    std::print((float)16777219L);       // output: 16777220.0
    std::print((float)-33554435L);      // output: -33554436.0
    std::print((double)9007199254740995L); // output: 9007199254740996.0
    std::print((double)9007199254740993L); // output: 9007199254740992.0
    std::print((long)1e30d);            // output: 9223372036854775807
    std::print((double)(1L << 63));     // output: -9223372036854775808.0

    // Formatting: 64-bit widths and the sign of a negative's two's-complement bits.
    std::print($"{max:D20}");           // output: 09223372036854775807
    std::print($"{min:D20}");           // output: -09223372036854775808
    std::print($"{max:X16}");           // output: 7FFFFFFFFFFFFFFF
    std::print($"{min:X16}");           // output: 8000000000000000
    std::print($"{5L:B8}");             // output: 00000101
    std::print($"[{max,20}]");          // output: [ 9223372036854775807]

    std::print(max.toString());         // output: 9223372036854775807

    std::print(switch (max) {
        case 9223372036854775807L -> "max";
        default -> "other";
    });                                 // output: max
}
