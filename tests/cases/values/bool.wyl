// The `bool` kind: its operators, its two values, and its default.

struct Flag {
    bool value;
}

void main() {
    bool yes = true;
    bool no = false;

    std::print(yes);               // output: true
    std::print(no);                // output: false
    std::print(!yes);              // output: false
    std::print(!no);               // output: true
    std::print(yes & no);          // output: false
    std::print(yes | no);          // output: true
    std::print(yes ^ yes);         // output: false
    std::print(yes ^ no);          // output: true
    std::print(yes == no);         // output: false
    std::print(yes != no);         // output: true
    std::print(yes && no);         // output: false
    std::print(yes || no);         // output: true
    std::print(!(yes && no) || no); // output: true

    std::print($"{yes}");          // output: true
    std::print($"[{no,6}]");       // output: [ false]
    std::print($"[{yes,-6}]");     // output: [true  ]
    std::print(yes.toString());    // output: true
    std::print(Flag().value);      // output: false

    std::print(switch (yes) {
        case true -> "yes";
        case false -> "no";
    });                            // output: yes
    std::print(switch (no) {
        case true -> "yes";
        case false -> "no";
    });                            // output: no

    // Both values through the remaining operators.
    std::print(no & no);           // output: false
    std::print(no | yes);          // output: true
    std::print(no ^ no);           // output: false
    std::print(no == no);          // output: true
    std::print(yes && yes);        // output: true
    std::print(no || no);          // output: false
    std::print(yes != yes);        // output: false
    std::print(!(yes || no));      // output: false
    std::print($"{no}");           // output: false
    std::print($"[{yes,6}]");      // output: [  true]
    std::print(no.toString());     // output: false
    std::print(Flag().value == false); // output: true
}
