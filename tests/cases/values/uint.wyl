// The `uint` kind at its edges: unsigned wrap-free arithmetic (debug builds panic on overflow),
// logical right shift, and reinterpretation as a signed value (§2.3, §2.4).

void main() {
    uint max = 4294967295u;
    uint one = 1u;

    std::print(max - 1u);           // output: 4294967294
    std::print(max / 3u);           // output: 1431655765
    std::print(max % 3u);           // output: 0
    std::print(max / 2u);           // output: 2147483647
    std::print(max >> 31);          // output: 1
    std::print(max << 1);           // output: 4294967294
    std::print(one << 31);          // output: 2147483648
    std::print(max & 0x0Fu);        // output: 15
    std::print(max ^ max);          // output: 0
    std::print(~0u);                // output: 4294967295
    std::print(~max);               // output: 0
    std::print(max > 0u);           // output: true
    std::print(max == 4294967295u); // output: true

    std::print((int)max);           // output: -1
    std::print((long)max);          // output: 4294967295
    std::print((ulong)max);         // output: 4294967295
    std::print((byte)max);          // output: 255
    std::print((double)max);        // output: 4294967295.0

    std::print($"{max:D10}");       // output: 4294967295
    std::print($"{max:D12}");       // output: 004294967295
    std::print($"{max:X8}");        // output: FFFFFFFF
    std::print($"{max:B32}");       // output: 11111111111111111111111111111111
    std::print($"[{max,12}]");      // output: [  4294967295]

    std::print(max.toString());     // output: 4294967295

    // More conversions and formatting.
    std::print(max | 0u);       // output: 4294967295
    std::print(max + 0u);       // output: 4294967295
    std::print((ushort)max);    // output: 65535
    std::print((sbyte)max);     // output: -1
    std::print((float)max);     // output: 4294967296.0
    std::print(max != 0u);      // output: true
    std::print($"{0u:B8}");     // output: 00000000
    std::print(switch (max) {
        case 4294967295u -> "max";
        default -> "other";
    });                         // output: max
}
