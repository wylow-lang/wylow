// The `double` kind at its edges: IEEE 754 double precision, and the places where binary floating
// point is not the decimal it looks like (§2.4).

void main() {
    double value = 1.5d;

    std::print(value);             // output: 1.5
    std::print(value + 0.5d);      // output: 2.0
    std::print(value * 3);         // output: 4.5
    std::print(value / 2);         // output: 0.75
    std::print(value % 1);         // output: 0.5
    std::print(-value);            // output: -1.5
    std::print(1.0d / 3);          // output: 0.3333333333333333
    std::print(0.1d + 0.2d);       // output: 0.30000000000000004
    std::print(0.1d + 0.2d == 0.3d); // output: false
    std::print(0.0d / 0.0d);       // output: nan
    std::print(1.0d / 0.0d);       // output: inf
    std::print(-1.0d / 0.0d);      // output: -inf
    std::print(value < 2.0d);      // output: true

    std::print((int)value);        // output: 1
    std::print((int)-1.5d);        // output: -1
    std::print((long)1e300d);      // output: 9223372036854775807
    std::print((int)1e300d);       // output: 2147483647
    std::print((float)0.1d);       // output: 0.1
    std::print((double)value);     // output: 1.5

    std::print(value.toString());  // output: 1.5
    std::print($"{value:F2}");     // output: 1.50
    std::print($"{value:E2}");     // output: 1.50E+000
    std::print($"{0.1d:F20}");     // output: 0.10000000000000000555
    std::print($"[{value,6}]");    // output: [   1.5]

    // More comparisons, conversions, and formatting.
    std::print(value >= 1.5d);    // output: true
    std::print(value != 1.6d);    // output: true
    std::print((short)value);     // output: 1
    std::print(1.5d % 1.0d);      // output: 0.5
    std::print(2.0d * 0.5d);      // output: 1.0
    std::print($"{0.1d:F3}");     // output: 0.100
}
