// An atomic's add follows the language's arithmetic: in a debug build an overflow panics, and the
// value is left as it was.

import std::threading::Atomic;

void main() {
    var count = new Atomic<byte>(255);
    std::print(count.subtract(255));          // output: 255
    std::print(count.get());                  // output: 0
    count.subtract(1);                        // panic-here: integer overflow
}
