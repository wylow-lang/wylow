// Two threads add to one atomic at once, and no addition is lost. A static holds a second atomic,
// which every thread reaches without being given it.

import std::threading;
import std::threading::{Atomic, AtomicBool};
import std::Unit;

class Counters {
    static Atomic<long> CALLS = new Atomic<long>(0L);
}

Unit addMany(Atomic<int> total, int times) {
    for (mut int i = 0; i < times; i++) {
        total.add(1);
        Counters.CALLS.add(1L);
    }
}

void main() {
    var total = new Atomic<int>(0);
    var done = new AtomicBool(false);
    var first = threading::spawn(() -> addMany(total, 1000));
    var second = threading::spawn(() -> {
        addMany(total, 1000);
        return done.exchange(true);
    });
    first.join();
    std::print(second.join());                // output: false
    std::print(total.get());                  // output: 2000
    std::print(Counters.CALLS.get());         // output: 2000
    std::print(done.get());                   // output: true
}

// tsan
