// An atomic's operations on one thread: get, set, exchange and compareExchange return what the
// atomic held, and add and subtract return the value before they change it.

import std::threading::{Atomic, AtomicBool};

void main() {
    var count = new Atomic<int>(5);
    std::print(count.get());                  // output: 5
    count.set(7);
    std::print(count.exchange(9));            // output: 7
    std::print(count.get());                  // output: 9
    std::print(count.compareExchange(4, 1));  // output: 9
    std::print(count.get());                  // output: 9
    std::print(count.compareExchange(9, 1));  // output: 9
    std::print(count.get());                  // output: 1
    std::print(count.add(10));                // output: 1
    std::print(count.subtract(3));            // output: 11
    std::print(count.get());                  // output: 8

    var small = new Atomic<byte>(250);
    std::print(small.add(5));                 // output: 250
    std::print(small.get());                  // output: 255
    var wide = new Atomic<long>(-1L);
    std::print(wide.subtract(9223372036854775807L)); // output: -1
    std::print(wide.get());                   // output: -9223372036854775808

    var flag = new AtomicBool(false);
    std::print(flag.get());                   // output: false
    std::print(flag.exchange(true));          // output: false
    std::print(flag.compareExchange(false, false)); // output: true
    std::print(flag.get());                   // output: true
    std::print(flag.compareExchange(true, false)); // output: true
    std::print(flag.get());                   // output: false
    flag.set(true);
    std::print(flag.get());                   // output: true
}
