@Repr(byte)
enum Small {
    A = 1,
    B = 255,
}

@Repr(sbyte)
enum Signed {
    Low = -128,
    High = 127,
}

@Repr(ulong)
enum Wide {
    Low = 1,
    High = 0x8000000000000000,
    Top,
}

@Repr(uint)
enum Format {
    Undefined = 0,
    Rgba = 4000000000,
}

void main() {
    std::print((int)Small.B);         // output: 255
    std::print((byte)Small.A);        // output: 1
    std::print((int)Signed.Low);      // output: -128
    std::print((ulong)Wide.High);     // output: 9223372036854775808
    std::print((ulong)Wide.Top);      // output: 9223372036854775809
    ulong code = 9223372036854775808uL;
    std::print((Wide)code == Wide.High); // output: true
    uint rgba = 4000000000u;
    std::print((Format)rgba == Format.Rgba); // output: true
    byte small = 255;
    std::print((Small)small == Small.B); // output: true
    long negative = -128L;
    std::print((Signed)negative == Signed.Low); // output: true
}
