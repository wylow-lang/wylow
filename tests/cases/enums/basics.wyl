enum Direction { North, East, South, West }

struct Vec2 {
    float x;
    float y;

    Vec2(float x, float y) {
        this.x = x;
        this.y = y;
    }
}

enum Shape {
    Point,
    Circle(Vec2 center, float radius),
    Rect(Vec2 min, Vec2 max),
}

String name(Direction d) {
    return switch (d) {
        case North -> "north";
        case East -> "east";
        case South -> "south";
        case West -> "west";
    };
}

Direction turnRight(Direction d) {
    switch (d) {
        case North -> { return Direction.East; }
        case East -> { return Direction.South; }
        case South -> { return Direction.West; }
        case West -> { return Direction.North; }
    }
}

float area(Shape s) {
    return switch (s) {
        case Point -> 0;
        case Circle(_, var r) -> 3 * r * r;
        case Rect(Vec2 min, Vec2 max) -> (max.x - min.x) * (max.y - min.y);
    };
}

void describe(Shape s) {
    switch (s) {
        case Point -> std::print("a point");
        case Circle(var c, _) -> {
            std::print("a circle at");
            std::print(c.x);
        }
        case Rect -> std::print("a rectangle");
    }
}

void main() {
    mut var d = Direction.North;
    std::print(name(d));                            // output: north
    d = turnRight(turnRight(d));
    std::print(name(d));                            // output: south
    std::print(d == Direction.South);               // output: true
    std::print(d != Direction.North);               // output: true

    // A variant's enum can be left out where the type is known.
    Direction w = West;
    std::print(name(w));                            // output: west

    Shape c = Shape.Circle(Vec2(1, 2), 2);
    std::print(area(c));                            // output: 12.0
    std::print(area(Shape.Rect(Vec2(0, 0), Vec2(2, 3)))); // output: 6.0
    std::print(area(Shape.Point));                  // output: 0.0
    describe(c);                                    // output: a circle at
                                                    // output: 1.0
    describe(Shape.Point);                          // output: a point
    describe(Shape.Rect(Vec2(0, 0), Vec2(1, 1)));   // output: a rectangle

    // Enums with data compare variant and fields.
    std::print(c == Shape.Circle(Vec2(1, 2), 2));   // output: true
    std::print(c == Shape.Circle(Vec2(1, 2), 3));   // output: false
    std::print(c == Shape.Point);                   // output: false

    // `is` tests a variant and binds its fields.
    if (c is Circle(var center, var radius)) {
        std::print(center.y + radius);              // output: 4.0
    }
    std::print(c is Rect);                          // output: false
    std::print(Shape.Point is Point);               // output: true
}
