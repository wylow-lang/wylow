// Two variants with payloads of one shape are different values: equality compares the variant
// before the payload.

enum Shape {
    Circle(int size),
    Square(int size),
    Point,
}

void main() {
    std::print(Shape.Circle(3) == Shape.Square(3)); // output: false
    std::print(Shape.Circle(3) != Shape.Square(3)); // output: true
    std::print(Shape.Circle(3) == Shape.Circle(3)); // output: true
    std::print(Shape.Point == Shape.Circle(0));   // output: false
}
