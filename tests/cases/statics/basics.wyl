struct Config {
    int limit;
    String name;
}

class Settings {
    static int RATE = 10;
    static Config LIMITS = Config(limit: 5, name: "main");
    static int DOUBLED = RATE * 2;
    static int ZERO;
    static String EMPTY;

    pub static int rate() {
        return RATE;
    }

    pub int limitPlus() {
        return LIMITS.limit + RATE;
    }
}

class Tables {
    static int[3] VALUES = [3, 4, 5];
    static Config CONFIG = Config(limit: 9, name: "table");

    pub static int middle() {
        return VALUES[1];
    }
}

void main() {
    std::print(Settings.RATE);               // output: 10
    std::print(Settings.LIMITS.limit);       // output: 5
    std::print(Settings.DOUBLED);            // output: 20
    std::print(Settings.rate());             // output: 10
    std::print(Settings.ZERO);               // output: 0
    std::print(Settings.EMPTY);              // output:
    var settings = new Settings();
    std::print(settings.limitPlus());        // output: 15
    std::print(Tables.VALUES[2]);            // output: 5
    std::print(Tables.CONFIG.name);          // output: table
    std::print(Tables.middle());             // output: 4
    std::print(Settings.RATE + Settings.LIMITS.limit); // output: 15
    in int rate = Settings.RATE;
    std::print(rate);                        // output: 10
    escaping fn() -> int read = () -> Tables.VALUES[0];
    std::print(read());                      // output: 3
}
