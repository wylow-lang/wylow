class First {
    static int A = first();
    static int B = A + 1;
}

class Second {
    static int C = First.B + 1;
    static int D = second();
}

int first() {
    std::print("first");                // output: first
    return 1;
}

int second() {
    std::print("second");               // output: second
    return 4;
}

class Unused {
    static int VALUE = announce();
}

int announce() {
    std::print("unused");               // output: unused
    return 3;
}

void main() {
    std::print(Second.C);               // output: 3
    std::print(First.B);                // output: 2
    std::print(Unused.VALUE);           // output: 3
}
