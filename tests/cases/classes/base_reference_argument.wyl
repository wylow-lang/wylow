// A 'ref?' parameter of a base constructor takes a place as a 'ref' argument.

import std::print;

class Base {
    int n;

    Base(ref? int source) {
        if (source is ref int value) {
            n = value;
        }
    }
}

class Derived extends Base {
    Derived(ref int source) {
        super(ref source);
    }
}

void main() {
    mut int mine = 5;
    var made = new Derived(ref mine);
    print(made.n);      // output: 5
}
