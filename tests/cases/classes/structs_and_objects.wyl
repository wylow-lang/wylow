class Tag {
    mut String name;

    Tag(String name) {
        this.name = name;
    }

    ~Tag() {
        std::print("tag destroyed");
    }
}

// A struct holding an object: copies share it, and == compares it by identity.
struct Labeled {
    Tag tag;
    int count;
}

interface Greeter {
    mut void greet();
}

abstract class Registry implements Greeter {
    mut int size = 0;

    void add(Member m) {
        size++;
        m.joined(this);
    }
}

class Club extends Registry {
    void greet() {
        std::print("welcome");
    }
}

class Member {
    mut Registry? club;

    void joined(Registry registry) {
        club = registry;
        registry.greet();
    }
}

void main() {
    mut var a = Labeled(tag: new Tag("x"), count: 1);
    mut var b = a;
    b.count = 2;
    std::print(a == b);                     // output: false
    b.count = 1;
    std::print(a == b);                     // output: true
    b.tag.name = "shared";
    std::print(a.tag.name);                 // output: shared
    b.tag = new Tag("y");
    std::print(a == b);                     // output: false
    a = b;
    // output: tag destroyed

    var club = new Club();
    var m = new Member();
    club.add(m);                            // output: welcome
    std::print(club.size);                  // output: 1
    m.club?.greet();                        // output: welcome
    Member? none = null;
    none?.joined(club);
    Registry? r = none?.club ?? m.club ?? club;
    std::print(r == club);                  // output: true
}
// output: tag destroyed
