class Box {
    mut int x = 1;

    int plus(int n) {
        return x + n;
    }
}

int bump(Box b) {
    b.x = 10;
    return 1;
}

int sum(int a, int b) {
    return a + b;
}

class Holder {
    mut Box box = new Box();
}

Box replace(Holder h) {
    h.box = new Box();
    h.box.x = 50;
    return h.box;
}

void main() {
    // Any call may write any object, so the field is read before the call.
    var b = new Box();
    std::print(b.x + bump(b));      // output: 2
    b.x = 1;
    std::print(sum(b.x, bump(b)));  // output: 2
    b.x = 1;
    std::print(bump(b) + b.x);      // output: 11

    // The assignment target's object is evaluated before the value.
    var h = new Holder();
    var old = h.box;
    h.box.x = replace(h).x + 1;
    std::print(old.x);              // output: 51
    std::print(h.box.x);            // output: 50

    // A call's receiver is evaluated before its arguments, so the call reaches the box they replace.
    var other = new Holder();
    std::print(other.box.plus(replace(other).x));  // output: 51
    // With nothing to replace it, a field receiver is used where it is.
    std::print(other.box.plus(2));  // output: 52
}
