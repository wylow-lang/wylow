shared class Registry {
    int entries;

    Registry(int entries) {
        this.entries = entries;
    }

    ~Registry() {
        std::print("released");
    }
}

class Settings {
    static Registry CURRENT = new Registry(3);
}

void main() {
    std::print(Settings.CURRENT.entries);   // output: 3
    var local = Settings.CURRENT;
    std::print(local.entries);              // output: 3
}
