import std::print;

shared class Registry {
    int entries;

    Registry(int entries) {
        this.entries = entries;
    }

    ~Registry() {
        print("released");
    }
}

class Settings {
    static Registry CURRENT = new Registry(3);
}

void main() {
    print(Settings.CURRENT.entries);        // output: 3
    var local = Settings.CURRENT;
    print(local.entries);                   // output: 3
}
