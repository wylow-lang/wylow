// A class definition comes after every interface it implements, wherever it is declared.

class Crate implements Adjustable {
    mut int total = 3;

    void amount(int amount) {
        total -= amount;
    }

    int balance() {
        return total;
    }
}

interface Adjustable {
    mut void amount(int amount);
    mut int balance();
}

void main() {
    var c = new Crate();
    c.amount(1);
    std::print(c.balance());   // output: 2
}
