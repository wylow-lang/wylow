// A field with no initializer holds its type's default value, however the object or struct holding it
// is made. A default runs once, in declaration order, and a constructor's body assigns over it.

import std::print;

int traced(int value) {
    print($"traced {value}");
    return value;
}

struct Point {
    pub int x = 5;
    pub String name = "origin";
}

struct Traced {
    pub int value = traced(7);
}

struct Line {
    pub Point start;
    pub Point[2] others;
}

struct Generic<T> {
    pub int size = 3;
}

class Plain {
    pub Point point;
    pub Line line;
    pub Generic<int> generic;
}

class Declared {
    pub int before = traced(1);
    pub Traced item;
    pub int after = traced(2);

    pub Declared() {
    }
}

class Assigned {
    pub Point point;

    pub Assigned() {
        print(point.x);
        point = Point(x: 6);
    }
}

class Base {
    pub Point base;
}

class Derived extends Base {
    pub Point own;
}

class Chained {
    pub Traced item;

    pub Chained(int unused) {
    }

    pub Chained() {
        this(0);
    }
}

class Holder<T> {
    pub Generic<T> generic;
}

struct Declaring {
    pub Point point;
    pub Traced item;

    pub Declaring(int unused) {
    }
}

struct Memberwise {
    pub Point point;
}

void main() {
    var plain = new Plain();
    print(plain.point.x);
    // output: 5
    print(plain.point.name);
    // output: origin
    print(plain.line.start.x);
    // output: 5
    print(plain.line.others[1].x);
    // output: 5
    print(plain.generic.size);
    // output: 3

    var declared = new Declared();
    // output: traced 1
    // output: traced 7
    // output: traced 2
    print(declared.item.value);
    // output: 7

    var assigned = new Assigned();
    // output: 5
    print(assigned.point.x);
    // output: 6

    var derived = new Derived();
    print(derived.base.x + derived.own.x);
    // output: 10

    var chained = new Chained();
    // output: traced 7
    print(chained.item.value);
    // output: 7

    print(new Holder<String>().generic.size);
    // output: 3

    var declaring = Declaring(0);
    // output: traced 7
    print(declaring.point.x);
    // output: 5
    print(declaring.point.name);
    // output: origin

    print(Memberwise().point.x);
    // output: 5
    print(Point().x);
    // output: 5
}
