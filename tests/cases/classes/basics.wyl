class Counter {
    mut int count = 0;

    Counter(int step) {
        this.step = step;
    }

    void tick() {
        count += step;
    }

    int get() {
        return count;
    }

    static Counter byOne() {
        return new Counter(1);
    }

    int step;
}

class Pair {
    Counter first;
    mut Counter second;

    Pair(Counter first, Counter second) {
        this.first = first;
        this.second = second;
    }
}

void bump(Counter c) {
    c.tick();
}

void main() {
    var a = new Counter(2);
    a.tick();
    bump(a);
    std::print(a.get());            // output: 4

    // References share the object.
    Counter b = a;
    b.tick();
    std::print(a.count);            // output: 6
    std::print(a == b);             // output: true
    std::print(a == new Counter(2)); // output: false

    var one = Counter.byOne();
    one.tick();
    std::print(one.get());          // output: 1

    var pair = new Pair(a, one);
    pair.first.tick();
    pair.second = pair.first;
    std::print(pair.second.get());  // output: 8
    std::print(pair.first == pair.second); // output: true
}
