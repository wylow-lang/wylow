// An object that no reference can outlive its scope is on the stack, which no program can observe:
// it is destroyed exactly where it would have been released. `stack:` counts the objects of a line
// that are; every other object made in the program is on the heap.

class Noisy {
    String name;
    mut Noisy? other;

    Noisy(String name) {
        this.name = name;
    }

    ~Noisy() {
        print(name);
    }

    String label() {
        return name;
    }

    Noisy self() {
        return this;
    }
}

class Registered {
    Registered(List<Registered> all) {
        all.add(this);
    }
}

class Keeper {
    mut Noisy? kept;
}

interface Visitor {
    void visit(Noisy n);
}

class Reader implements Visitor {
    void visit(Noisy n) {
        print(n.label());
    }
}

class Storer implements Visitor {
    Keeper keeper = new Keeper();

    void visit(Noisy n) {
        keeper.kept = n;
    }
}

// Only the methods a call may dispatch to count: Bin.put keeps its argument, but no Shelf is a Bin.
class Shelf {
    virtual void put(Noisy n) {
        print(n.label());
    }
}

class Bin {
    mut Noisy? kept;

    virtual void put(Noisy n) {
        kept = n;
    }
}

class Ledger {
    virtual void put(Noisy n) {
    }
}

class Hoard extends Ledger {
    mut Noisy? kept;

    override void put(Noisy n) {
        kept = n;
    }
}

class Box<T> {
    T value;

    Box(T value) {
        this.value = value;
    }
}

class Big {
    mut int[200] values;
}

// Its borrows keep it, so it escapes; other Borrowable classes, such as List, don't.
class Clinging implements Borrowable {
    mut Clinging? self;

    void beginBorrow() {
        self = this;
    }

    void endBorrow() {
        self = null;
    }
}

String read(Noisy n) {
    return n.name;
}

Noisy pass(Noisy n) {
    return n;
}

void keep(Keeper keeper, Noisy n) {
    keeper.kept = n;
}

// Recursion passes the object on without storing it.
int depth(Noisy n, int count) {
    if (count == 0) {
        return 0;
    }
    return 1 + depth(n, count - 1);
}

void run(() -> void f) {
    f();
}

Noisy give(() -> Noisy f) {
    return f();
}

// A function that returns its argument gives the caller the object, which escapes only if the
// caller lets it.
void returnedBriefly() {
    var n = new Noisy("brief"); // stack: 1
    var same = n.self();
    print(pass(same).label());
}

Noisy passedOn() {
    return pass(new Noisy("passed on")); // stack: 0
}

void storeResult(Keeper keeper) {
    keeper.kept = pass(new Noisy("kept")); // stack: 0
}

// What a lambda returns goes to whatever calls it, which may keep it.
void lend(Keeper keeper) {
    var lent = new Noisy("lent"); // stack: 0
    keeper.kept = give(() -> lent);
}

void scope() {
    var a = new Noisy("a"); // stack: 1
    var b = new Noisy("b"); // stack: 1
    print(read(a));
    print(b.label());
    print("end of scope");
}

Noisy returned() {
    var n = new Noisy("returned"); // stack: 0
    return n;
}

void visitWith(Visitor v) {
    var n = new Noisy("visited"); // stack: 0
    v.visit(n);
}

void main() {
    scope();
    // output: a
    // output: b
    // output: end of scope
    // output: b
    // output: a

    // A temporary is destroyed at the end of its statement.
    print(new Noisy("t").label()); // stack: 1
    // output: t
    // output: t
    print(depth(new Noisy("u"), 1)); // stack: 1
    // output: 1
    // output: u
    var length = new Noisy("v").label(); // stack: 1
    // output: v
    print(length);
    // output: v

    // One object per iteration, each destroyed at the end of its iteration.
    for (int i : 0..2) {
        var item = new Noisy("item"); // stack: 1
        print(depth(item, 3));
    }
    // output: 3
    // output: item
    // output: 3
    // output: item

    // Locals the object is copied to, pattern bindings, and non-escaping lambdas don't outlive it.
    {
        var x = new Noisy("x"); // stack: 1
        var y = x;
        Noisy? z = x;
        if (z is Noisy w) {
            print(w.label());
        }
        run(() -> print(y.label()));
    }
    // output: x
    // output: x
    // output: x

    // A function's result that is only used briefly, even when it is the object itself.
    print(pass(new Noisy("passed")).name); // stack: 1
    // output: passed
    // output: passed
    print(new Noisy("self").self().name); // stack: 1
    // output: self
    // output: self
    returnedBriefly();
    // output: brief
    // output: brief

    // Escapes: returned, stored, given to code that stores it, or returned to code that does.
    print(returned().name);
    // output: returned
    // output: returned
    print(passedOn().name);
    // output: passed on
    // output: passed on
    storeResult(new Keeper()); // stack: 1
    // output: kept
    lend(new Keeper()); // stack: 1
    // output: lent
    // Objects can be on the stack while the objects they refer to are not.
    var keeper = new Keeper(); // stack: 1
    var stored = new Noisy("stored"); // stack: 0
    keeper.kept = stored;
    var given = new Noisy("given"); // stack: 0
    keep(keeper, given);
    var list = new List<Noisy>(); // stack: 1
    var clinging = new Clinging(); // stack: 0
    var element = new Noisy("element"); // stack: 0
    list.add(element);
    @Escaping () -> String f = () -> element.name;
    var captured = new Noisy("captured"); // stack: 0
    @Escaping () -> String g = () -> captured.name;
    print(g());
    // output: captured
    Weak<Noisy> weak = new Noisy("weak"); // stack: 0
    // output: weak
    mut Noisy? outer = null;
    {
        var inner = new Noisy("inner"); // stack: 0
        outer = inner;
    }
    var looped = new Noisy("looped"); // stack: 0
    run(() -> { keeper.kept = looped; });

    // A constructor that stores `this`, a call that may dispatch to a method that stores its
    // argument, and a variable that is reassigned.
    var all = new List<Registered>(); // stack: 1
    var registered = new Registered(all); // stack: 0
    visitWith(new Reader()); // stack: 1
    // output: visited
    // output: visited
    visitWith(new Storer()); // stack: 1
    // output: visited
    mut var changing = new Noisy("first"); // stack: 1
    changing = new Noisy("second"); // stack: 1
    // output: first

    {
        var shelf = new Shelf(); // stack: 1
        shelf.put(new Noisy("shelved")); // stack: 1
        Ledger ledger = new Hoard(); // stack: 1
        ledger.put(new Noisy("hoarded")); // stack: 0
    }
    // output: shelved
    // output: shelved
    // output: hoarded

    // Generic classes, and objects too large for the stack, which stay on the heap at run time.
    var box = new Box<Noisy>(new Noisy("boxed")); // stack: 1
    print(box.value.name);
    // output: boxed
    var big = new Big(); // stack: 1
    big.values[3] = 4;
    print(big.values[3]);
    // output: 4

    // Changing what an object holds, even through a 'ref' or a span, doesn't change the variable.
    var counts = new int[3]; // stack: 1
    for (ref int c : counts) {
        c += 2;
    }
    Span<int> view = counts;
    view[0] = 5;
    print(counts[0] + counts[1]);
    // output: 7

    // A cyclic class on the stack is never buffered: collecting finds nothing.
    {
        var node = new Noisy("node"); // stack: 1
        node.other = new Noisy("next"); // stack: 0
        print(read(node));
        Memory.collectCycles();
        print(Memory.cycleStats().freed);
    }
    // output: node
    // output: 0
    // output: node
    // output: next
    print("end");
    // output: end
}
// output: boxed
// output: second
// output: inner
// output: captured
// output: element
// output: given
// output: stored
// output: looped
