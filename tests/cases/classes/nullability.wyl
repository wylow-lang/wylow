class Node {
    int value;
    mut Node? next;

    Node(int value) {
        this.value = value;
    }

    Node? after() {
        return next;
    }
}

class Animal {
    virtual String sound() {
        return "...";
    }
}

class Dog extends Animal {
    override String sound() {
        return "woof";
    }

    void fetch() {
        print("fetching");
    }
}

int sum(Node? list) {
    mut int total = 0;
    mut Node? current = list;
    while (current != null) {
        total += current.value;
        current = current.next;
    }
    return total;
}

int valueOrZero(Node? node) {
    if (node == null) {
        return 0;
    }
    return node.value;
}

void main() {
    var head = new Node(1);
    head.next = new Node(2);
    head.next!.next = new Node(3);
    print(sum(head));                       // output: 6
    print(sum(null));                       // output: 0
    print(valueOrZero(head.next));          // output: 2
    print(valueOrZero(head.next?.next?.next));  // output: 0

    // `?.` gives null when the receiver is null, and skips the call.
    Node? missing = null;
    print(missing?.after() == null);        // output: true
    missing?.after();
    print(head.after()?.next == null);      // output: false

    // `??` falls back when the left side is null.
    Node fallback = missing ?? head;
    print(fallback.value);                  // output: 1
    print((head.next ?? head).value);       // output: 2

    // `is` tests, downcasts, and binds a strong reference.
    Animal a = new Dog();
    print(a.sound());                       // output: woof
    if (a is Dog d) {
        d.fetch();                          // output: fetching
    }
    print(a is Dog);                        // output: true
    Animal plain = new Animal();
    if (plain is Dog d2) {
        d2.fetch();
    } else {
        print("not a dog");                 // output: not a dog
    }

    // Narrowing with && and on the else branch.
    Node? maybe = head.next;
    if (maybe != null && maybe.value == 2) {
        print("two");                       // output: two
    }
    if (maybe == null) {
        print("none");
    } else {
        print(maybe.value);                 // output: 2
    }
    print(maybe != null ? maybe.value : -1);    // output: 2
}
