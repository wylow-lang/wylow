// Each case would read freed memory without pinning; the output order shows when objects die.

import std::Weak;

struct Stats {
    int total;
}

struct Gear {
    Product spare;
}

class Customer {
    String name;
    mut Product product;
    mut Stats stats;
    mut Gear gear;

    Customer(String name) {
        product = new Product("old");
        gear = Gear(new Product("spare"));
        this.name = name;
        product.owner = this;
        gear.spare.owner = this;
    }

    ~Customer() {
        std::print("customer destroyed");
    }
}

class Product {
    String name;
    mut Weak<Customer> owner;

    Product(String name) {
        this.name = name;

    }

    // Replaces the owner's product, which is `this`, while running on it.
    void fire() {
        if (owner.get() is Customer p) {
            p.product = new Product("new");
        }
        std::print(name);
    }

    // Replaces the owner's spare, which is `this`, through a reference to the struct holding it.
    void swap() {
        if (owner.get() is Customer p) {
            restock(ref p.gear);
        }
        std::print(name);
    }

    ~Product() {
        std::print("product destroyed");
    }
}

class World {
    mut Customer customer;

    World(Customer customer) {
        this.customer = customer;
    }
}

class Team {
    Customer leader;

    // Its constructors can still replace a field that isn't 'mut', so `s` holds the first leader.
    Team() {
        leader = new Customer("x");
        ref Stats s = leader.stats;
        leader = new Customer("y");
        s.total = 3;
        std::print(s.total);
    }

    // Elsewhere it is never replaced, so nothing holds it while `heal` runs.
    void rally(World world) {
        heal(ref leader.stats, world);
        std::print(leader.name);
    }
}

void restock(ref Gear gear) {
    gear.spare = new Product("restocked");
}

// Replaces the customer that `s` points into.
void heal(ref Stats s, World world) {
    world.customer = new Customer("b");
    s.total += 5;
    std::print(s.total);
}

void main() {
    var customer = new Customer("a");


    // The call holds the receiver: "old" prints before the old product is destroyed.
    customer.product.fire();
    // output: old
    // output: product destroyed
    customer.gear.spare.swap();
    // output: spare
    // output: product destroyed

    // The call holds the object that a 'ref' argument points into.
    var world = new World(new Customer("p"));
    world.customer.stats.total = 10;
    heal(ref world.customer.stats, world);
    // output: 15
    // output: customer destroyed
    // output: product destroyed
    // output: product destroyed
    std::print(world.customer.stats.total);  // output: 0

    {
        var team = new Team();
        // output: 3
        // output: customer destroyed
        // output: product destroyed
        // output: product destroyed
        team.rally(world);
        // output: customer destroyed
        // output: product destroyed
        // output: product destroyed
        // output: 5
        // output: y
    }
    // output: customer destroyed
    // output: product destroyed
    // output: product destroyed
}
// output: customer destroyed
// output: product destroyed
// output: product destroyed
// output: customer destroyed
// output: product destroyed
// output: product destroyed
