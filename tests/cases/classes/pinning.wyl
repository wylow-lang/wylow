// Each case would read freed memory without pinning; the output order shows when objects die.

import std::{Weak, print};

struct Stats {
    int hp;
}

struct Gear {
    Weapon spare;
}

class Player {
    String name;
    mut Weapon weapon;
    mut Stats stats;
    mut Gear gear;

    Player(String name) {
        weapon = new Weapon("old");
        gear = Gear(new Weapon("spare"));
        this.name = name;
        weapon.owner = this;
        gear.spare.owner = this;
    }

    ~Player() {
        print("player destroyed");
    }
}

class Weapon {
    String name;
    mut Weak<Player> owner;

    Weapon(String name) {
        this.name = name;

    }

    // Replaces the owner's weapon, which is `this`, while running on it.
    void fire() {
        if (owner.get() is Player p) {
            p.weapon = new Weapon("new");
        }
        print(name);
    }

    // Replaces the owner's spare, which is `this`, through a reference to the struct holding it.
    void swap() {
        if (owner.get() is Player p) {
            restock(ref p.gear);
        }
        print(name);
    }

    ~Weapon() {
        print("weapon destroyed");
    }
}

class World {
    mut Player player;

    World(Player player) {
        this.player = player;
    }
}

class Team {
    Player leader;

    // Its constructors can still replace a field that isn't 'mut', so `s` holds the first leader.
    Team() {
        leader = new Player("x");
        ref Stats s = leader.stats;
        leader = new Player("y");
        s.hp = 3;
        print(s.hp);
    }

    // Elsewhere it is never replaced, so nothing holds it while `heal` runs.
    void rally(World world) {
        heal(ref leader.stats, world);
        print(leader.name);
    }
}

void restock(ref Gear gear) {
    gear.spare = new Weapon("restocked");
}

// Replaces the player that `s` points into.
void heal(ref Stats s, World world) {
    world.player = new Player("b");
    s.hp += 5;
    print(s.hp);
}

void main() {
    var player = new Player("a");


    // The call holds the receiver: "old" prints before the old weapon is destroyed.
    player.weapon.fire();
    // output: old
    // output: weapon destroyed
    player.gear.spare.swap();
    // output: spare
    // output: weapon destroyed

    // The call holds the object that a 'ref' argument points into.
    var world = new World(new Player("p"));
    world.player.stats.hp = 10;
    heal(ref world.player.stats, world);
    // output: 15
    // output: player destroyed
    // output: weapon destroyed
    // output: weapon destroyed
    print(world.player.stats.hp);       // output: 0

    {
        var team = new Team();
        // output: 3
        // output: player destroyed
        // output: weapon destroyed
        // output: weapon destroyed
        team.rally(world);
        // output: player destroyed
        // output: weapon destroyed
        // output: weapon destroyed
        // output: 5
        // output: y
    }
    // output: player destroyed
    // output: weapon destroyed
    // output: weapon destroyed
}
// output: player destroyed
// output: weapon destroyed
// output: weapon destroyed
// output: player destroyed
// output: weapon destroyed
// output: weapon destroyed
