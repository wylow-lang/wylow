// Each case would read freed memory without pinning; the output order shows when objects die.

struct Stats {
    int hp;
}

class Player {
    String name;
    mut Weapon weapon;
    mut Stats stats;

    Player(String name) {
        weapon = new Weapon("old");
        weapon.owner = this;
        this.name = name;
    }

    ~Player() {
        print("player destroyed");
    }
}

class Weapon {
    String name;
    mut Weak<Player> owner;

    Weapon(String name) {
        this.name = name;

    }

    // Replaces the owner's weapon, which is `this`, while running on it.
    void fire() {
        if (owner.get() is Player p) {
            p.weapon = new Weapon("new");
        }
        print(name);
    }

    ~Weapon() {
        print("weapon destroyed");
    }
}

class World {
    mut Player player;

    World(Player player) {
        this.player = player;
    }
}

// Replaces the player that `s` points into.
void heal(ref Stats s, World world) {
    world.player = new Player("b");
    s.hp += 5;
    print(s.hp);
}

void main() {
    var player = new Player("a");


    // The call holds the receiver: "old" prints before the old weapon is destroyed.
    player.weapon.fire();
    // output: old
    // output: weapon destroyed

    // The call holds the object that a 'ref' argument points into.
    var world = new World(new Player("p"));
    world.player.stats.hp = 10;
    heal(ref world.player.stats, world);
    // output: 15
    // output: player destroyed
    // output: weapon destroyed
    print(world.player.stats.hp);       // output: 0
}
// output: player destroyed
// output: weapon destroyed
// output: player destroyed
// output: weapon destroyed
