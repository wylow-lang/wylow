// A base constructor that takes the caller's location gets it after its computed arguments.

class Base {
    @CallerLocation
    Base(int a, int b) {
        std::print($"{a} {b}");
    }
}

class Derived extends Base {
    Derived() {
        super(one(), two());
    }
}

int one() {
    std::print("one");
    return 1;
}

int two() {
    std::print("two");
    return 2;
}

void main() {
    var made = new Derived();
    // output: one
    // output: two
    // output: 1 2
    std::print("made"); // output: made
}
