import std::print;

interface Named {
    String name();
}

interface Adjustable extends Named {
    mut void amount(int amount);
    mut int balance();
}

class Crate implements Adjustable {
    mut int total = 30;

    String name() {
        return "crate";
    }

    void amount(int amount) {
        total -= amount;
    }

    int balance() {
        return total;
    }
}

class Unit {
    mut int total = 100;

    void amount(int amount) {
        total -= amount * 2;
    }

    int balance() {
        return total;
    }
}

// The interface is implemented with methods inherited from Unit.
class Employee extends Unit implements Adjustable {
    String name() {
        return "employee";
    }
}

// Adjustable through an interface reference: dynamic dispatch.
void apply(Adjustable target) {
    target.amount(5);
    print(target.name());
    print(target.balance());
}

// Through a bound: static dispatch, for structs and classes alike.
struct Counter implements Named {
    int n;

    String name() {
        return "counter";
    }
}

void describe<T extends Named>(T value) {
    print(value.name());
}

void main() {
    apply(new Crate());
    // output: crate
    // output: 25
    apply(new Employee());
    // output: employee
    // output: 90

    Named n = new Employee();
    print(n.name());              // output: employee

    describe(new Crate());        // output: crate
    describe(Counter(n: 1));// output: counter
    describe<Named>(n);           // output: employee
}
