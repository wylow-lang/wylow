import std::{List, Weak, print};

class Parent {
    String name;
    mut Child? child;

    Parent(String name) {
        this.name = name;
    }

    ~Parent() {
        print("parent destroyed");
    }
}

class Child {
    mut Weak<Parent> parent;

    void greet() {
        if (parent.get() is Parent p) {
            print(p.name);
        } else {
            print("orphan");
        }
    }

    ~Child() {
        print("child destroyed");
    }
}

interface Identified {
    mut int key();
}

class Account implements Identified {
    int id;

    Account(int id) {
        this.id = id;
    }

    int key() {
        return id;
    }

    ~Account() {
        print(id);
    }
}

// A struct holding a weak reference is an ordinary value.
struct Target {
    Weak<Identified> who;
    int priority = 1;
}

// An enum's payload copies and destroys its weak reference like any other field.
enum Watch {
    Nobody,
    Someone(Weak<Identified> who),
}

void describe(Weak<Identified> weak) {
    if (weak.get() is Identified n) {
        print(n.key());
    } else {
        print("gone");
    }
}

Weak<Account> pick(Account e) {
    return e;
}

class SelfWatcher {
    mut Weak<SelfWatcher> self;

    // A weak reference taken while being destroyed reads as null too.
    ~SelfWatcher() {
        self = this;
        print(self.get() == null);
    }
}

void main() {
    var child = new Child();
    if (true) {
        var parent = new Parent("mom");
        parent.child = child;
        child.parent = parent;
        child.greet();          // output: mom
    }
    // The weak reference did not keep the parent alive, and became null.
    // output: parent destroyed
    child.greet();              // output: orphan
    print(child.parent.get() == null);  // output: true

    // A cycle through a weak reference is freed.
    mut var p = new Parent("dad");
    p.child = new Child();
    p.child!.parent = p;
    p = new Parent("other");
    // output: parent destroyed
    // output: child destroyed

    // Locals, parameters, return values, and copies, converting from a class to an interface.
    mut var a = new Account(1);
    mut Weak<Identified> w = a;
    Weak<Identified> copy = w;
    Weak<Identified> none = null;
    describe(w);                // output: 1
    describe(none);             // output: gone
    describe(pick(a).get());    // output: 1
    w = null;
    describe(w);                // output: gone
    describe(copy);             // output: 1
    a = new Account(2);           // output: 1
    describe(copy);             // output: gone

    // In a struct.
    mut Target t = Target();
    t.who = a;
    describe(t.who);            // output: 2
    var moved = t;
    t.who = null;
    describe(moved.who);        // output: 2

    // In an enum.
    mut Watch seen = Watch.Someone(a);
    Watch kept = seen;
    seen = Watch.Nobody;
    if (kept is Someone(var who)) {
        describe(who);          // output: 2
    }

    // In a list, across growth.
    var accounts = new List<Account>();
    var watched = new List<Weak<Account>>();
    for (int i : 0..10) {
        var e = new Account(10 + i);
        accounts.add(e);
        watched.add(e);
    }
    accounts.removeAt(3);        // output: 13
    mut int alive = 0;
    for (Weak<Account> weak : watched) {
        if (weak.get() is Account e) {
            alive++;
        }
    }
    print(alive);               // output: 9
    print(watched[3].get() == null);    // output: true
    print(watched[9].get()!.id);        // output: 19

    _ = new SelfWatcher();
    // output: true
}
// output: 19
// output: 18
// output: 17
// output: 16
// output: 15
// output: 14
// output: 12
// output: 11
// output: 10
// output: 2
// output: parent destroyed
// output: child destroyed
