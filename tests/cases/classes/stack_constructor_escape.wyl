// A base or chained constructor runs on the object being made, so where it lets 'this' go, the
// object goes: an object whose base constructor or this(...) stores it is never on the stack.

import std::List;

class Base {
    String name;

    Base(String name, List<Base> all) {
        this.name = name;
        all.add(this);
    }

    ~Base() {
        std::print($"release {name}");
    }
}

class Derived extends Base {
    Derived(String name, List<Base> all) {
        super(name, all);
    }
}

class Chained {
    String name;

    Chained(String name, List<Chained> all) {
        this.name = name;
        all.add(this);
    }

    Chained(List<Chained> all) {
        this("chained", all);
    }

    ~Chained() {
        std::print($"release {name}");
    }
}

// A chain that keeps 'this' to itself may still be on the stack.
class Local {
    int n;

    Local(int n) {
        this.n = n;
    }

    Local() {
        this(5);
    }
}

void make(List<Base> all, List<Chained> chained) {
    var d = new Derived("derived", all); // stack: 0
    var c = new Chained(chained); // stack: 0
    var l = new Local(); // stack: 1
    std::print($"end of make {l.n}");
}

void main() {
    mut var all = new List<Base>(); // stack: 1
    mut var chained = new List<Chained>(); // stack: 1
    make(all, chained);
    // output: end of make 5
    std::print($"{all.count()} {chained.count()} {all[0].name} {chained[0].name}");
    // output: 1 1 derived chained
}
// output: release chained
// output: release derived
