// Handing a local to its last use must not release its object earlier than its scope's end when
// that can be seen: here a destructor runs, so the local keeps the object alive.

import std::{List, Weak};

class Noisy {
    String name;

    Noisy(String name) {
        this.name = name;
    }

    ~Noisy() {
        std::print($"~{name}");
    }
}

class Box {
    Noisy item;

    Box(Noisy item) {
        this.item = item;
    }
}

void main() {
    var item = new Noisy("a");
    {
        var box = new Box(item);
        std::print("boxed");
    }
    std::print("scope ended");
    weak();
    // output: boxed
    // output: scope ended
    // output: true
    // output: true
    // output: 1
}
// output: ~a

// A weak reference to one class doesn't stop moves of values that can't hold it, and does stop
// them where the weak reference would see the object die early.

class Target {
    int id;

    Target(int id) {
        this.id = id;
    }
}

class Other {
    int id;

    Other(int id) {
        this.id = id;
    }
}

class Keeper {
    Target target;

    Keeper(Target target) {
        this.target = target;
    }
}

void weak() {
    var target = new Target(1);
    Weak<Target> seen = target;
    {
        var keeper = new Keeper(target);
        std::print(seen.get() is Target);
    }
    std::print(seen.get() is Target);
    var other = new Other(2);
    var list = new List<Other>();
    list.add(other);
    std::print(list.count());
}
