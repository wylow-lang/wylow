// Handing a local to its last use must not release its object earlier than its scope's end when
// that can be seen: here a destructor runs, so the local keeps the object alive.

import std::Weak; import std::collections::List;

class Noisy {
    String name;

    Noisy(String name) {
        this.name = name;
    }

    ~Noisy() {
        std::print($"~{name}");
    }
}

class Box {
    Noisy item;

    Box(Noisy item) {
        this.item = item;
    }
}

void main() {
    var item = new Noisy("a");
    {
        var box = new Box(item);
        std::print("boxed");
    }
    std::print("scope ended");
    weak();
    held();
    // output: boxed
    // output: scope ended
    // output: true
    // output: true
    // output: 1
    // output: 7
    // output: scope ends
    // output: token 7
}
// output: ~a

// A weak reference to one class doesn't stop moves of values that can't hold it, and does stop
// them where the weak reference would see the object die early.

class Target {
    int id;

    Target(int id) {
        this.id = id;
    }
}

class Other {
    int id;

    Other(int id) {
        this.id = id;
    }
}

class Keeper {
    Target target;

    Keeper(Target target) {
        this.target = target;
    }
}

void weak() {
    var target = new Target(1);
    Weak<Target> seen = target;
    {
        var keeper = new Keeper(target);
        std::print(seen.get() is Target);
    }
    std::print(seen.get() is Target);
    var other = new Other(2);
    var list = new List<Other>();
    list.add(other);
    std::print(list.count());
}

// An object whose field holds a unique struct with a destructor runs that destructor when the
// object is destroyed, so a local holding the object keeps it alive until its scope ends.

unique struct Token {
    pub int id;

    ~Token() {
        std::print($"token {id}");
    }
}

class Holder {
    mut Token token;

    Holder(Token token) {
        this.token = token;
    }
}

void held() {
    var token = Token(7);
    var holder = new Holder(token);
    std::print([holder][0].token.id);
    std::print("scope ends");
}
