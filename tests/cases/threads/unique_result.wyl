import std::threading;

unique struct Buffer {
    pub int length;

    pub Buffer(int length) {
        this.length = length;
    }

    ~Buffer() {
        std::print($"buffer {length}");
    }
}

void main() {
    var thread = threading::spawn(() -> Buffer(7));
    var buffer = thread.join();
    std::print(buffer.length);
    // output: 7
    // output: buffer 7
}

