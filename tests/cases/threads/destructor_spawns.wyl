// A shared class's destructor may start a thread whose body captures 'this'. Releasing the thread
// joins it before the destructor returns, so no reference to the object outlives the destructor.

import std::threading;

shared class Worker {
    pub int id;

    pub Worker(int id) {
        this.id = id;
    }

    ~Worker() {
        var joined = threading::startThread(() -> this.id * 2);
        std::print(joined.join());
        var released = threading::startThread(() -> this.id * 3);
    }
}

void main() {
    var worker = new Worker(7);
    std::print(worker.id);
    // output: 7
    // output: 14
}

// tsan
