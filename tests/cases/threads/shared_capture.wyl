import std::print;
import std::thread::spawn;

shared class Name {
    pub String text;

    pub Name(String text) {
        this.text = text;
    }
}

int length(Name name) {
    return name.text.byteLength();
}

void main() {
    var name = new Name("worker");
    var thread = spawn(() -> length(name));
    print(thread.join());
    // output: 6
}
