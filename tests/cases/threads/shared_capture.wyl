import std::threading;

shared class Name {
    pub String text;

    pub Name(String text) {
        this.text = text;
    }
}

int length(Name name) {
    return name.text.byteLength();
}

void main() {
    var name = new Name("worker");
    var thread = threading::startThread(() -> length(name));
    std::print(thread.join());
    // output: 6
}

