// A thread frees the cycles left in its buffer when it ends, and the destructors run oldest first,
// as they do on the main thread.

import std::threading;

class Node {
    pub int value;
    pub mut Node? next;

    pub Node(int value) {
        this.value = value;
    }

    ~Node() {
        std::print($"node {value}");
    }
}

void main() {
    var thread = threading::spawn(() -> {
        var first = new Node(1);
        var second = new Node(2);
        first.next = second;
        second.next = first;
        return 0;
    });
    thread.join();
    // output: node 1
    // output: node 2
}

// tsan
