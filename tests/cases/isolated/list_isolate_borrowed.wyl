// A loop over a list borrows it, so isolating the list inside the loop panics, as clearing it does.

import std::List;

void main() {
    var values = new List<int>();
    values.add(1);
    values.add(2);
    for (int value : values) {
        var box = values.isolate();           // panic-here: cannot change the length or capacity of a list while it is borrowed by a reference, span, or loop
    }
}
