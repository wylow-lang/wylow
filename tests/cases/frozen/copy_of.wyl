// copyOf copies the elements a span views, so an array or part of a list can be frozen, and the
// original keeps its elements.

import std::threading::Frozen;
import std::collections::List;

void main() {
    var squares = new Array<int>(4, 0);
    for (mut int i = 0; i < 4; i++) {
        squares[i] = i * i;
    }
    var frozen = Frozen<int>.copyOf(squares);
    squares[0] = 100;
    std::print(frozen[0]);                    // output: 0
    std::print(frozen[3]);                    // output: 9
    var list = new List<int>();
    list.add(5);
    list.add(6);
    list.add(7);
    var tail = Frozen<int>.copyOf(list.asReadOnlySpan().slice(1, 2));
    std::print(tail.length());                // output: 2
    std::print(tail[0] + tail[1]);            // output: 13
    std::print(list.count());                 // output: 3
}
