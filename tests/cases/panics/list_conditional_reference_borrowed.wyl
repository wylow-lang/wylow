// A call through 'list.get(i)?.' borrows the list until it returns, since it runs in the element.

import std::{List, print};

struct Counter {
    int count;

    mut void run(() -> void f) {
        f();
        count++;
    }
}

void main() {
    var counters = new List<Counter>();
    counters.add(Counter());
    counters.get(0)?.run(() -> {
        print(counters.count());  // output: 1
        counters.add(Counter()); // panic-here: cannot change the length or capacity of a list while it is borrowed
    });
}
