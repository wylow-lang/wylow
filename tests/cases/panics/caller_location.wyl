struct Pair {
    int[2] values;

    @CallerLocation
    mut int get(int index) {
        if (index < 0 || index >= 2) {
            panic($"index {index} is out of bounds for length 2");
        }
        return values[index];
    }
}

void main() {
    mut Pair p = Pair();
    print(p.get(1));            // output: 0
    print(p.get(2));            // panic-here: index 2 is out of bounds for length 2
}
