import std::panic;

struct Pair {
    int[2] values;

    @CallerLocation
    mut int get(int index) {
        panic::checkIndex(index, 2);
        return values[index];
    }
}

void main() {
    mut Pair p = Pair();
    std::print(p.get(1));       // output: 0
    std::print(p.get(2));       // panic-here: index 2 is out of bounds for length 2
}
