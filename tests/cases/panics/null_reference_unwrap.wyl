import std::print;

struct Pair {
    int[2] items;

    mut ref? int at(int i) {
        if (i < 0 || i >= 2) {
            return null;
        }
        return ref items[i];
    }
}

void main() {
    mut Pair p = Pair();
    p.at(1)! = 3;
    print(p.items[1]);          // output: 3
    p.at(2)! = 4;               // panic-here: null reference unwrapped with '!'
}
